      "blocks": {
        "step1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "1. Cleanse",
            "heading_size": "sm",
            "content": "<p>Massage a single pump of gel cleanser over damp skin for 30 seconds, then rinse with lukewarm water.</p>",
            "content_size": "md"
          }
        },
        "step2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "2. Tone and treat",
            "heading_size": "sm",
            "content": "<p>Mist toner while skin is still damp. In the evening, press in three drops of night serum.</p>",
            "content_size": "md"
          }
        },
        "step3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "3. Moisturize",
            "heading_size": "sm",
            "content": "<p>Warm a pea-sized amount of cream between your fingertips and press it over face and neck.</p>",
            "content_size": "md"
          }
        },
        "ingredients": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What we never use",
            "heading_size": "sm",
            "content": "<p>No synthetic fragrance, no parabens, no mineral oil and no microplastics. Every ingredient is listed in full on the product page.</p>",
            "content_size": "md"
          }
        }
      },
      "block_order": [
