          "type": "feature",
          "settings": {
            "image": "shopify://shop_images/demo-layered_1.jpg",
            "title": "Material first",
            "description": "<p>We start from fabric hand-feel and drape before sketching silhouettes, so each piece holds its own structure and movement.</p>",
            "reverse": false
          }
        },
        "feature_2": {
