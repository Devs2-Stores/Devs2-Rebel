        "iwt_text": {
          "type": "text",
          "settings": {
            "text": "<p>Founded on the belief that luxury is not loud — it whispers, lasts, and improves with wear. Every Devs2 Rebel piece is cut by hand from rare European fabrics and finished in ateliers that have stood for generations.</p>",
            "content_size": "md"
          }
        },
        "iwt_btn": {
          "type": "button",
          "settings": {
