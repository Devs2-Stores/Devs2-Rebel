{% doc %}
  @description Product card component with image, title, price, badges and quick actions
  @param {product} product - Product object (required)
  @param {boolean} [show_vendor] - Show vendor/brand. Default: false
  @param {boolean} [show_secondary_image] - Show the second image on hover. Default: settings.card_hover_image_enable
  @param {boolean} [show_quickview] - Show the quick view button. Default: settings.card_quick_view_enable
  @param {boolean} [show_add_to_cart] - Show the add to cart button. Default: settings.card_add_button_enable
  @param {string} [lazyload] - Loading strategy: lazy or eager. Default: 'lazy'
  @param {string} [fetchpriority] - Fetch priority: auto or high. Default: 'auto'
  @param {string} [image_ratio] - Image ratio: adapt, portrait, square, landscape. Default: 'portrait'
  @param {string} [sizes] - Full sizes attribute for the card images. Overrides columns. Default: derived from columns or '(max-width: 749px) 50vw, 25vw'
  @param {number} [columns] - Desktop column count of the grid the card sits in; used to build sizes
  @param {number} [columns_mobile] - Mobile column count of the grid the card sits in; used to build sizes. Default: 2
  @param {string} [heading_tag] - Heading element for the title: h2, h3 or h4. Default: 'h3'
  @example {% render 'product-card', product: product, show_vendor: true %}
{% enddoc %}

{%- liquid
  comment
    Boolean defaults use a nil check because | default: true would override false
  endcomment

  if show_vendor == nil
    assign show_vendor = false
  endif
  if show_secondary_image == nil
    assign show_secondary_image = true
    if settings.card_hover_image_enable == false
      assign show_secondary_image = false
    endif
  endif
  if show_quickview == nil
    assign show_quickview = true
    if settings.card_quick_view_enable == false
      assign show_quickview = false
    endif
  endif
  if show_add_to_cart == nil
    assign show_add_to_cart = true
    if settings.card_add_button_enable == false
      assign show_add_to_cart = false
    endif
  endif

  assign card_sizes = sizes
  if card_sizes == blank
    assign card_sizes = '(max-width: 749px) 50vw, 25vw'
    assign columns_count = columns | plus: 0
    if columns_count > 0
      assign columns_mobile_count = columns_mobile | default: 2 | plus: 0
      assign vw_mobile = 100.0 | divided_by: columns_mobile_count | round: 1
      assign vw_desktop = 100.0 | divided_by: columns_count | round: 1
      assign card_sizes = '(max-width: 749px) ' | append: vw_mobile | append: 'vw, ' | append: vw_desktop | append: 'vw'
    endif
  endif
  assign lazyload = lazyload | default: 'lazy'
  assign fetchpriority = fetchpriority | default: 'auto'
  assign image_ratio = image_ratio | default: 'portrait'
  assign title_tag = 'h3'
  if heading_tag == 'h2' or heading_tag == 'h4'
    assign title_tag = heading_tag
  endif

  assign variant = product.selected_or_first_available_variant
  assign price = variant.price
  assign compare = variant.compare_at_price
  assign discount_percentage = 0
  if compare > price and compare > 0
    assign discount = compare | minus: price
    assign discount_percentage = discount | times: 100 | divided_by: compare | round
  endif

  assign t_view_product = 'products.product_card.view_product' | t
  assign t_quick_view = 'products.product_card.quick_view' | t
  assign t_add_to_cart = 'products.product_card.add_to_cart' | t
  assign t_choose_options = 'products.product.choose_options' | t
  assign t_sold_out = settings.product_soldout_text | strip
  if t_sold_out == blank
    assign t_sold_out = 'products.product_card.sold_out' | t
  endif
  assign t_new = 'products.product_card.new' | t
  assign t_contact = settings.product_contact_text | strip
  if t_contact == blank
    assign t_contact = 'products.product_card.contact_price' | t
  endif
  assign card_style = settings.product_card_style | default: 'standard'
  assign badge_position = settings.badge_anchor | default: 'bottom left' | replace: ' ', '-'
  assign is_new = false
  if product.tags contains 'new' or product.tags contains 'New'
    assign is_new = true
  endif
-%}

{%- if product and product != empty -%}
<product-card class="product-card product-card--{{ card_style }}">
  <article class="product-card__wrapper{% if card_style == 'card' and settings.product_card_scheme != blank %} color-{{ settings.product_card_scheme }}{% endif %}">
    {%- comment %} ── Media ─────────────────────── {% endcomment -%}
    <div class="product-card__media">
      {%- capture media_badges -%}
        {%- unless product.available %} {{ t_sold_out | escape }}{% endunless -%}
        {%- if is_new and product.available %} {{ t_new | escape }}{% endif -%}
        {%- if discount_percentage > 0 and product.available %} -{{ discount_percentage }}%{% endif -%}
      {%- endcapture -%}
      <a class="product-card__media-inner" href="{{ product.url }}" aria-label="{{ t_view_product }} {{ product.title | escape }}{{ media_badges }}" title="{{ product.title | escape }}">
        {%- if product.featured_image -%}
          <div class="product-card__media-image image-ratio--{{ image_ratio }}">
            {%- assign primary_image_alt = product.featured_image.alt | default: product.title | escape -%}
            {{
              product.featured_image
              | image_url: width: 800
              | image_tag:
                widths: '300, 400, 600, 800',
                sizes: card_sizes,
                alt: primary_image_alt,
                loading: lazyload,
                fetchpriority: fetchpriority,
                decoding: 'async',
                class: 'product-card__img-primary'
            }}

            {%- if show_secondary_image and product.images[1] -%}
              {%- assign secondary_alt = product.images[1].alt | default: product.title | escape -%}
              {{
                product.images[1]
                | image_url: width: 800
                | image_tag:
                  widths: '300, 400, 600, 800',
                  sizes: card_sizes,
                  alt: secondary_alt,
                  loading: 'lazy',
                  decoding: 'async',
                  class: 'product-card__img-secondary'
              }}
            {%- endif -%}
          </div>
        {%- else -%}
          <div class="product-card__media-image image-ratio--{{ image_ratio }}">
            <div class="product-card__media-placeholder">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M3.75 21h16.5A1.5 1.5 0 0 0 21.75 19.5V4.5A1.5 1.5 0 0 0 20.25 3H3.75A1.5 1.5 0 0 0 2.25 4.5v15A1.5 1.5 0 0 0 3.75 21Z" />
              </svg>
            </div>
          </div>
        {%- endif -%}

        {%- unless product.available and is_new == false and discount_percentage == 0 -%}
          <div class="product-card__badges product-card__badges--{{ badge_position }}">
            {%- unless product.available -%}
              <span class="product-card__badge product-card__badge--soldout{% if settings.badge_sold_out_scheme != blank %} color-{{ settings.badge_sold_out_scheme }}{% endif %}">{{ t_sold_out | escape }}</span>
            {%- endunless -%}
            {%- if is_new and product.available -%}
              <span class="product-card__badge product-card__badge--new">{{ t_new }}</span>
            {%- endif -%}
            {%- if discount_percentage > 0 and product.available -%}
              <span class="product-card__badge product-card__badge--discount{% if settings.badge_sale_scheme != blank %} color-{{ settings.badge_sale_scheme }}{% endif %}">-{{ discount_percentage }}%</span>
            {%- endif -%}
          </div>
        {%- endunless -%}
      </a>

      {%- comment %} Quick actions {% endcomment -%}
      {%- if show_quickview -%}
        <button type="button" class="product-card__quickview" data-action="open-quickview" data-product-handle="{{ product.handle }}" aria-label="{{ t_quick_view }} {{ product.title | escape }}" title="{{ t_quick_view }}">
          {%- render 'icon', name: 'eye-show' -%}
        </button>
      {%- endif -%}

      {%- if show_add_to_cart -%}
        {%- if product.has_only_default_variant -%}
          <form class="product-card__add-form" method="POST">
            <input type="hidden" name="id" value="{{ variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button type="submit" formaction="{{ routes.cart_add_url }}" class="product-card__add-btn" aria-label="{{ t_add_to_cart }} {{ product.title | escape }}" title="{{ t_add_to_cart }}"{% unless product.available %} disabled{% endunless %}>
              {%- render 'icon', name: 'cart' -%}
            </button>
          </form>
        {%- elsif show_quickview -%}
          <div class="product-card__add-form">
            <button type="button" class="product-card__add-btn" data-action="open-quickview" data-product-handle="{{ product.handle }}" aria-label="{{ t_choose_options }} {{ product.title | escape }}" title="{{ t_choose_options }}"{% unless product.available %} disabled{% endunless %}>
              {%- render 'icon', name: 'cart' -%}
            </button>
          </div>
        {%- else -%}
          <div class="product-card__add-form">
            <a class="product-card__add-btn" href="{{ product.url }}" aria-label="{{ t_choose_options }} {{ product.title | escape }}" title="{{ t_choose_options }}">
              {%- render 'icon', name: 'cart' -%}
            </a>
          </div>
        {%- endif -%}
      {%- endif -%}

    </div>

    {%- comment %} ── Content ────────────────────── {% endcomment -%}
    <div class="product-card__content">
      {%- if show_vendor and product.vendor != blank -%}
        <div class="product-card__vendor">{{ product.vendor | escape }}</div>
      {%- endif -%}

      <{{ title_tag }} class="product-card__title">
        <a href="{{ product.url }}" title="{{ product.title | escape }}">{{ product.title | escape }}</a>
      </{{ title_tag }}>

      {%- if product.options_with_values != blank -%}
        {%- for option in product.options_with_values -%}
          {%- assign option_name = option.name | downcase -%}
          {%- assign has_swatches = false -%}
          {%- if option_name contains 'color' or option_name contains 'colour' or option_name contains 'pattern' -%}
            {%- assign has_swatches = true -%}
          {%- else -%}
            {%- for val in option.values -%}
              {%- if val.swatch != blank -%}
                {%- assign has_swatches = true -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          {%- if has_swatches -%}
            <div class="product-card__swatches" aria-label="{{ option.name | escape }}">
              {%- for swatch_value in option.values limit: 6 -%}
                {%- assign option_key = 'option' | append: option.position -%}
                {%- assign swatch_variant = product.variants | where: option_key, swatch_value | first -%}
                {%- assign swatch_image = swatch_variant.featured_image | default: product.featured_image -%}
                {%- liquid
                  assign swatch_style = ''
                  if swatch_value.swatch.image
                    assign img_url = swatch_value.swatch.image | image_url: width: 80
                    assign swatch_style = 'background-image: url(' | append: img_url | append: '); background-size: cover; background-position: center;'
                  elsif swatch_value.swatch.color
                    assign swatch_style = 'background-color: ' | append: swatch_value.swatch.color | append: ';'
                  elsif swatch_image != blank
                    assign img_url = swatch_image | image_url: width: 80
                    assign swatch_style = 'background-image: url(' | append: img_url | append: '); background-size: cover; background-position: center;'
                  endif
                -%}
                <a
                  href="{{ swatch_variant.url | default: product.url }}"
                  class="product-card__swatch"
                  title="{{ swatch_value | escape }}"
                  aria-label="{{ swatch_value | escape }}"
                  {% if swatch_style != '' %}style="{{ swatch_style }}"{% endif %}
                ></a>
              {%- endfor -%}
            </div>
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      <div class="product-card__price">
        {%- if price == 0 -%}
          <span class="product-card__price-contact">{{ t_contact | escape }}</span>
          {%- elsif product.price_varies -%}
            {%- if product.compare_at_price > product.price -%}
              <del class="product-card__price-compare">{%- if settings.price_currency_code_enabled -%}{{ product.compare_at_price | money_with_currency }}{%- else -%}{{ product.compare_at_price | money }}{%- endif -%}</del>
            {%- endif -%}
            <span class="product-card__price-range{% if product.compare_at_price > product.price %} product-card__price-sale--on-sale{% endif %}">
            {%- if settings.price_currency_code_enabled -%}
              <span class="product-card__price-amount">{{ product.price_min | money_with_currency }}</span> – <span class="product-card__price-amount">{{ product.price_max | money_with_currency }}</span>
            {%- else -%}
              <span class="product-card__price-amount">{{ product.price_min | money }}</span> – <span class="product-card__price-amount">{{ product.price_max | money }}</span>
            {%- endif -%}
          </span>
        {%- else -%}
          {%- if compare > price -%}
            <del class="product-card__price-compare">{{ compare | money }}</del>
          {%- endif -%}
          <span class="product-card__price-sale{% if compare > price %} product-card__price-sale--on-sale{% endif %}">
            {%- if settings.price_currency_code_enabled -%}{{ price | money_with_currency }}{%- else -%}{{ price | money }}{%- endif -%}
          </span>
          {%- if product.selected_or_first_available_variant.unit_price -%}
            <span class="product-card__unit-price">
              <span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
              {{ product.selected_or_first_available_variant.unit_price | money }}/{{ product.selected_or_first_available_variant.unit_price_measurement.reference_value }}{{ product.selected_or_first_available_variant.unit_price_measurement.reference_unit }}
            </span>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </article>
</product-card>
{%- endif -%}

{% stylesheet %}
.product-card {
  display: block;
  height: 100%;
}

.product-card__wrapper {
  height: 100%;
  display: flex;
  flex-direction: column;
  padding: var(--card-image-padding);
  border: var(--card-border);
  border-radius: var(--card-corner-radius);
  box-shadow: var(--card-shadow);
  background: transparent;
}

.product-card__media {
  position: relative;
  overflow: hidden;
  border-radius: var(--media-radius);
  border: var(--media-border);
  box-shadow: var(--media-shadow);
  background: rgba(var(--color-foreground), 0.04);
}
.product-card__media:hover .product-card__quickview,
.product-card__media:hover .product-card__add-btn,
.product-card__wrapper:focus-within .product-card__quickview,
.product-card__wrapper:focus-within .product-card__add-btn,
.product-card__quickview.is-active {
  opacity: 1;
  visibility: visible;
  transition-property: opacity, background, color, transform;
}
.product-card__media-inner {
  display: block;
  color: inherit;
}
.product-card__media-image {
  aspect-ratio: 2/3;
  overflow: hidden;
  position: relative;
  border-radius: inherit;
  background: rgba(var(--color-foreground), 0.04);
}
.product-card__media-image.image-ratio--portrait { aspect-ratio: 2/3; }
.product-card__media-image.image-ratio--square { aspect-ratio: 1/1; }
.product-card__media-image.image-ratio--landscape { aspect-ratio: 3/2; }
.product-card__media-image.image-ratio--adapt { aspect-ratio: auto; }
.product-card__media-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-secondary);
  color: var(--color-gray);
}
.product-card__media-placeholder svg { width: 3rem; height: 3rem; }
.product-card__media-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  position: absolute;
  top: 0;
  left: 0;
  transform: scale(1.01);
  transition: opacity var(--transition-base), transform var(--transition-base);
}
@media (hover: hover) {
  .product-card__media:hover .product-card__media-image img { transform: scale(1.03); }
}
.product-card__media-image .product-card__img-secondary { opacity: 0; }
.product-card__media:hover .product-card__media-image .product-card__img-secondary { opacity: 1; }
.product-card__quickview,
.product-card__add-btn {
  --button-hover-transform: translateY(-3px);
  --button-active-transform: translateY(0) scale(0.96);
  position: absolute;
  bottom: 0.75rem;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2.75rem;
  height: 2.75rem;
  padding: 0;
  border-radius: 999px;
  color: var(--color-ink);
  background: rgb(var(--color-background));
  border: 0;
  cursor: pointer;
  opacity: 0;
  visibility: hidden;
  transition: opacity var(--transition-base), visibility var(--transition-base), background var(--transition-fast), color var(--transition-fast);
  z-index: 2;
}
.product-card__quickview svg,
.product-card__add-btn svg { width: 1.25rem; height: 1.25rem; }
.product-card__quickview:focus-visible,
.product-card__add-btn:focus-visible {
  background: var(--color-ink);
  color: rgb(var(--color-background));
}
@media (hover: hover) {
  .product-card__quickview:hover,
  .product-card__add-btn:hover {
    background: var(--color-ink);
    color: rgb(var(--color-background));
  }
}
.product-card__quickview {
  left: 50%;
  transform: translateX(calc(-50% - 3.25rem));
}
.product-card__content {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 0.875rem 0 0;
  text-align: var(--card-text-alignment);
}
.product-card--card .product-card__wrapper { background: rgb(var(--color-background)); }
.product-card--card .product-card__content { padding: 0.875rem var(--space-sm) var(--space-md); }
.product-card__vendor {
  margin-bottom: 0.25rem;
  font-size: var(--eyebrow-size);
  font-weight: var(--font-weight-medium);
  color: var(--color-muted);
  letter-spacing: 0.08em;
  line-height: 1.2;
  text-transform: uppercase;
}
.product-card__title {
  font-size: 0.9375rem;
  font-weight: var(--font-weight-medium);
  line-height: 1.4;
  letter-spacing: var(--h3-tracking);
  text-transform: var(--h3-case, inherit);
  margin: 0;
  color: var(--color-ink);
}
.product-card__title a {
  display: block;
  min-height: 2.7em;
  color: inherit;
  text-decoration: none;
  overflow-wrap: anywhere;
}
.product-card__title a:hover,
.product-card__title a:focus-visible { text-decoration: underline; text-underline-offset: 3px; }
.product-card__swatches { display: flex; flex-wrap: wrap; align-items: center; justify-content: var(--card-text-alignment); gap: 0.5rem; margin-top: 0.5rem; }
.product-card__swatch {
  width: 1.5rem;
  height: 1.5rem;
  min-width: 24px;
  min-height: 24px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 1px solid rgba(var(--color-foreground), 0.2);
  background-color: rgba(var(--color-foreground), 0.08);
  background-size: cover;
  background-position: center;
  transition: border-color var(--transition-fast), transform var(--transition-fast);
}
.product-card__swatch:focus-visible { border-color: var(--color-ink); }
@media (hover: hover) {
  .product-card__swatch:hover { border-color: var(--color-ink); }
}
.product-card__price {
  margin-top: auto;
  padding-top: 0.375rem;
  font-size: 0.9375rem;
  font-weight: var(--font-weight-normal);
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: var(--card-text-alignment);
  gap: 0.25rem 0.5rem;
  line-height: 1.3;
  color: rgb(var(--color-price));
}
.product-card__price-contact,
.product-card__price-sale { color: rgb(var(--color-price)); font-size: inherit; line-height: inherit; }
.product-card__price-sale--on-sale { color: rgb(var(--color-sale-price)); }
.product-card__price-amount { white-space: nowrap; }
.product-card__price-compare {
  color: var(--color-gray);
  text-decoration: line-through;
  font-weight: var(--font-weight-normal);
  font-size: inherit;
  line-height: inherit;
}
.product-card__add-form {
  position: absolute;
  bottom: 0.75rem;
  left: 50%;
  transform: translateX(-50%);
  z-index: 2;
}
.product-card__add-form .product-card__add-btn { position: static; }
.product-card__badges {
  position: absolute;
  inset-inline: 0.625rem;
  display: flex;
  flex-wrap: wrap;
  gap: 0.25rem;
  pointer-events: none;
  z-index: 1;
}
.product-card__badges--top-left,
.product-card__badges--top-right { top: 0.625rem; }
.product-card__badges--bottom-left,
.product-card__badges--bottom-right { bottom: 0.625rem; }
.product-card__badges--top-right,
.product-card__badges--bottom-right { justify-content: flex-end; }
.product-card__badge {
  background: rgb(var(--color-background));
  color: var(--color-ink);
  padding: 0.3125rem 0.5rem;
  border-radius: var(--badge-corner-radius);
  font-size: 0.75rem;
  font-weight: var(--font-weight-semibold);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  line-height: 1;
}
.product-card__badge--discount { background: rgb(var(--color-button)); color: rgb(var(--color-button-text)); }
.product-card__badge--new { background: var(--color-ink); color: rgb(var(--color-background)); }
.product-cards {
  display: grid;
  grid-template-columns: repeat(var(--columns-mobile, 2), 1fr);
  gap: var(--grid-vertical-spacing, 2rem) var(--grid-horizontal-spacing, 0.75rem);
  list-style: none;
  padding: 0;
  margin: 0;
}
.product-cards.swiper-wrapper { display: flex; gap: 0; }
.swiper-slide:has(> .product-card) { height: auto; }
@media (min-width: 750px) {
  .product-cards { grid-template-columns: repeat(3, 1fr); }
}
@media (min-width: 1024px) {
  .product-cards { grid-template-columns: repeat(var(--columns-desktop, 4), 1fr); }
}
.product-cards__item { min-width: 0; }
@media (hover: hover) and (min-width: 750px) {
  .product-card__badges { transition: bottom var(--transition-base); }
  .product-card__media:has(.product-card__quickview, .product-card__add-btn):hover :is(.product-card__badges--bottom-left, .product-card__badges--bottom-right),
  .product-card__wrapper:focus-within .product-card__media:has(.product-card__quickview, .product-card__add-btn) :is(.product-card__badges--bottom-left, .product-card__badges--bottom-right) {
    bottom: 4rem;
  }
}

@media (hover: none), (max-width: 749px) {
  .product-card__quickview { display: none; }
  .product-card__add-btn {
    opacity: 1;
    visibility: visible;
  }
  .product-card__add-form {
    right: 0.625rem;
    left: auto;
    transform: none;
  }
  .product-card__media:has(.product-card__add-form) .product-card__badges--bottom-left { inset-inline-end: 3.625rem; }
  .product-card__media:has(.product-card__add-form) .product-card__badges--bottom-right { bottom: 3.625rem; }
  .product-card__add-btn {
    --button-hover-transform: none;
    --button-active-transform: none;
    right: 0.625rem;
    left: auto;
    width: 2.5rem;
    height: 2.5rem;
    transform: none;
  }
  .product-card__add-btn:hover,
  .product-card__add-btn:focus-visible { transform: none; }
  .product-card__content { padding-top: 0.625rem; }
  .product-card__title { font-size: 0.875rem; }
}

@supports (grid-template-rows: subgrid) {
  .product-card {
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
  }
  .product-card__media { grid-row: 1; }
  .product-card__vendor { grid-row: 2; }
  .product-card__title { grid-row: 3; }
  .product-card__price { grid-row: 4; }
  .product-card__swatches { grid-row: 5; }
}
{% endstylesheet %}
