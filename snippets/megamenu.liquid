{{ 'megamenu.css' | asset_url | stylesheet_tag }}
<script src="{{ 'megamenu.js' | asset_url }}" defer="defer"></script>
<mega-menu class="megamenu" role="navigation" aria-label="{{ 'accessibility.navigation' | t }}">
  <button type="button" class="megamenu__arrow megamenu__arrow--left" aria-label="{{ 'accessibility.scroll_left' | t }}" hidden>
    {%- render 'icon', name: 'chevron-left', size: '16' -%}
  </button>
  <div class="megamenu__container">
    <nav class="megamenu__nav">
      <ul class="megamenu__list">
        {%- assign nav_menu = menu | default: linklists['main-menu'] -%}
        {%- if nav_menu != blank and nav_menu.links != blank -%}
        {%- for link in nav_menu.links -%}
        {%- assign menu_index = forloop.index -%}
        {%- assign has_children = false -%}
        {%- if link.links.size > 0 -%}{%- assign has_children = true -%}{%- endif -%}

        {%- if has_children -%}
        <li class="megamenu__item">
          <button type="button" class="megamenu__trigger" aria-expanded="false" aria-controls="megamenu-{{ menu_index }}">
            <span>{{ link.title | escape }}</span>
            {%- render 'icon', name: 'chevron-down', size: '13', class: 'megamenu__icon' -%}
          </button>

          <div id="megamenu-{{ menu_index }}" class="megamenu__dropdown">
            <div class="megamenu__dropdown-inner">
              <div class="megamenu__simple">
                <ul class="megamenu__simple-list">
                  {%- for link_2 in link.links -%}
                  {%- assign has_level3 = false -%}
                  {%- if link_2.links.size > 0 -%}{%- assign has_level3 = true -%}{%- endif -%}
                  <li{% if has_level3 %} class="megamenu__simple-parent"{% endif %}>
                    <a href="{{ link_2.url }}" title="{{ link_2.title | escape }}" class="megamenu__simple-link">
                      <span>{{ link_2.title | escape }}</span>
                      {%- if has_level3 -%}{%- render 'icon', name: 'chevron-right', size: '13' -%}{%- endif -%}
                    </a>
                    {%- if has_level3 -%}
                    <ul class="megamenu__simple-sub">
                      {%- for link_3 in link_2.links -%}
                      <li>
                        <a href="{{ link_3.url }}" title="{{ link_3.title | escape }}" class="megamenu__simple-sublink">{{ link_3.title | escape }}</a>
                      </li>
                      {%- endfor -%}
                    </ul>
                    {%- endif -%}
                  </li>
                  {%- endfor -%}
                </ul>
              </div>
            </div>
          </div>
        </li>
        {%- else -%}
        <li class="megamenu__item">
          <a href="{{ link.url }}" title="{{ link.title | escape }}" class="megamenu__trigger megamenu__trigger--link">
            <span>{{ link.title | escape }}</span>
          </a>
        </li>
        {%- endif -%}
        {%- endfor -%}
        {%- else -%}
        <li class="megamenu__item">
          <span class="megamenu__trigger megamenu__trigger--text">{{ 'general.updating' | t }}</span>
        </li>
        {%- endif -%}
      </ul>
    </nav>
  </div>
  <button type="button" class="megamenu__arrow megamenu__arrow--right" aria-label="{{ 'accessibility.scroll_right' | t }}" hidden>
    {%- render 'icon', name: 'chevron-right', size: '16' -%}
  </button>
  <div class="megamenu__overlay" aria-hidden="true"></div>
</mega-menu>