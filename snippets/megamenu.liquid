<script src="{{ 'megamenu.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign mega_show_images = settings.megamenu_show_images
  assign mega_show_featured = settings.megamenu_show_featured
-%}
<mega-menu class="megamenu megamenu--ratio-{{ settings.megamenu_image_ratio | default: 'portrait' }}">
  <button type="button" class="megamenu__arrow megamenu__arrow--left" aria-label="{{ 'accessibility.scroll_left' | t }}" hidden>
    {%- render 'icon', name: 'chevron-left', size: '16' -%}
  </button>
  <div class="megamenu__container">
    <nav class="megamenu__nav" aria-label="{{ 'accessibility.navigation' | t }}">
      <ul class="megamenu__list">
        {%- assign nav_menu = menu | default: linklists['main-menu'] -%}
        {%- if nav_menu != blank and nav_menu.links != blank -%}
        {%- for link in nav_menu.links -%}
        {%- assign menu_index = forloop.index -%}
        {%- assign has_children = false -%}
        {%- if link.links.size > 0 -%}{%- assign has_children = true -%}{%- endif -%}

        {%- if has_children -%}
        {%- assign card_count = 0 -%}
        {%- assign featured_media = '' -%}
        {%- capture cards_markup -%}
          {%- if mega_show_images -%}
            {%- for link_2 in link.links -%}
              {%- capture card_media -%}{%- render 'mega-menu-image', link: link_2 -%}{%- endcapture -%}
              {%- assign card_media = card_media | strip -%}
              {%- if card_media != blank -%}
                {%- assign card_count = card_count | plus: 1 -%}
                {%- render 'mega-menu-card', link: link_2, media: card_media -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endcapture -%}
        {%- if mega_show_images and mega_show_featured -%}
          {%- capture featured_media -%}{%- render 'mega-menu-image', link: link -%}{%- endcapture -%}
          {%- assign featured_media = featured_media | strip -%}
        {%- endif -%}
        {%- assign is_visual = false -%}
        {%- if card_count > 0 or featured_media != blank -%}{%- assign is_visual = true -%}{%- endif -%}
        {%- assign card_columns = card_count | at_most: 4 -%}

        <li class="megamenu__item">
          <button type="button" class="megamenu__trigger" aria-expanded="false" aria-controls="megamenu-{{ menu_index }}">
            <span>{{ link.title | escape }}</span>
            {%- render 'icon', name: 'chevron-down', size: '13', class: 'megamenu__icon' -%}
          </button>

          <div id="megamenu-{{ menu_index }}" class="megamenu__dropdown{% if is_visual %} megamenu__dropdown--visual{% endif %}">
            <div class="megamenu__dropdown-inner">
              {%- if is_visual -%}
              <div class="megamenu__panel">
                <div class="megamenu__panel-main">
                  {%- if card_count > 0 -%}
                  <div class="megamenu__cards" style="--megamenu-columns: {{ card_columns }}">
                    {{ cards_markup }}
                  </div>
                  {%- endif -%}
                  {%- capture text_markup -%}
                    {%- for link_2 in link.links -%}
                      {%- capture text_media -%}{%- if card_count > 0 -%}{%- render 'mega-menu-image', link: link_2 -%}{%- endif -%}{%- endcapture -%}
                      {%- assign text_media = text_media | strip -%}
                      {%- if text_media == blank -%}
                        {%- render 'mega-menu-link', link: link_2 -%}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endcapture -%}
                  {%- assign text_markup = text_markup | strip -%}
                  {%- if text_markup != blank -%}
                  <div class="megamenu__simple">
                    <ul class="megamenu__simple-list">
                      {{ text_markup }}
                    </ul>
                  </div>
                  {%- endif -%}
                </div>
                {%- if featured_media != blank -%}
                  {%- render 'mega-menu-card', link: link, media: featured_media, featured: true -%}
                {%- endif -%}
              </div>
              {%- else -%}
              <div class="megamenu__simple">
                <ul class="megamenu__simple-list">
                  {%- for link_2 in link.links -%}
                    {%- render 'mega-menu-link', link: link_2 -%}
                  {%- endfor -%}
                </ul>
              </div>
              {%- endif -%}
            </div>
          </div>
        </li>
        {%- else -%}
        <li class="megamenu__item">
          <a href="{{ link.url }}" title="{{ link.title | escape }}" class="megamenu__trigger megamenu__trigger--link">
            <span>{{ link.title | escape }}</span>
          </a>
        </li>
        {%- endif -%}
        {%- endfor -%}
        {%- else -%}
        <li class="megamenu__item">
          <span class="megamenu__trigger megamenu__trigger--text">{{ 'general.updating' | t }}</span>
        </li>
        {%- endif -%}
      </ul>
    </nav>
  </div>
  <button type="button" class="megamenu__arrow megamenu__arrow--right" aria-label="{{ 'accessibility.scroll_right' | t }}" hidden>
    {%- render 'icon', name: 'chevron-right', size: '16' -%}
  </button>
  <div class="megamenu__overlay" aria-hidden="true"></div>
</mega-menu>

{% stylesheet %}
.megamenu {
  position: relative;
  display: none;
  align-items: center;
  gap: 0;
  width: 100%;
  max-width: 100%;
  z-index: 1;
}
@media (min-width: 1024px) {
  .megamenu {
    display: flex;
  }
}
.megamenu__arrow {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 1.75rem;
  height: 1.75rem;
  background: var(--color-surface);
  border: 1px solid var(--color-hairline);
  border-radius: var(--buttons-radius);
  cursor: pointer;
  transition: background-color var(--transition-fast), border-color var(--transition-fast);
  z-index: 2;
}
.megamenu__arrow:hover {
  background: var(--color-gray-light);
  border-color: var(--color-ink);
}
.megamenu__arrow[hidden] {
  display: none;
}
.megamenu__arrow--left {
  margin-right: var(--space-sm);
}
.megamenu__arrow--right {
  margin-left: var(--space-sm);
}
.megamenu__arrow .icon {
  color: var(--color-ink);
}
.megamenu__container {
  flex: 1;
  min-width: 0;
  overflow: visible;
}
.megamenu__nav {
  width: 100%;
}
.megamenu__list {
  display: flex;
  align-items: center;
  gap: var(--space-xl);
  list-style: none;
  margin: 0;
  padding: 0;
  flex-wrap: nowrap;
  transition: transform var(--transition-base);
}
@media (min-width: 1200px) {
  .megamenu__list {
    gap: var(--space-2xl);
  }
}
.megamenu__item {
  position: relative;
  flex-shrink: 0;
}
.megamenu__item:hover > .megamenu__dropdown,
.megamenu__item:focus-within > .megamenu__dropdown,
.megamenu__item.is-open > .megamenu__dropdown {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
  pointer-events: auto;
}
.megamenu__item.is-dismissed > .megamenu__dropdown {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}
.megamenu__item:hover > .megamenu__trigger,
.megamenu__item:focus-within > .megamenu__trigger,
.megamenu__item.is-open > .megamenu__trigger {
  color: var(--color-ink);
}
.megamenu__item:hover > .megamenu__trigger .icon,
.megamenu__item:focus-within > .megamenu__trigger .icon,
.megamenu__item.is-open > .megamenu__trigger .icon {
  color: var(--color-ink);
  transform: rotate(180deg);
}
.megamenu__item.is-dismissed > .megamenu__trigger .icon {
  transform: none;
}
.megamenu__item .megamenu__trigger {
  display: inline-flex;
  align-items: center;
  gap: 0.3125rem;
  padding: 1.5rem 0;
  background: none;
  border: none;
  cursor: pointer;
  font-size: 0.9375rem;
  font-weight: var(--font-weight-medium);
  line-height: var(--line-height-snug);
  color: var(--header-text, var(--color-ink));
  text-decoration: none;
  transition: color var(--transition-fast);
  white-space: nowrap;
}
.megamenu__item .megamenu__trigger span {
  position: relative;
}
.megamenu__item .megamenu__trigger span::after {
  content: "";
  position: absolute;
  bottom: -3px;
  left: 0;
  width: 0;
  height: 1px;
  background: var(--color-ink);
  transition: width var(--transition-base);
}
.megamenu__item .megamenu__trigger .icon,
.megamenu__item .megamenu__trigger .megamenu__icon {
  width: 0.8125rem;
  height: 0.8125rem;
  flex-shrink: 0;
  color: var(--color-muted);
  transition: transform var(--transition-base), color var(--transition-fast);
}
.megamenu__item .megamenu__trigger:hover,
.megamenu__item .megamenu__trigger:focus:not(:focus-visible) {
  color: var(--color-ink);
  outline: none;
}
.megamenu__item .megamenu__trigger:focus-visible {
  outline: 2px solid var(--color-focus);
  outline-offset: 2px;
}
.megamenu__item .megamenu__trigger:hover span::after,
.megamenu__item .megamenu__trigger:focus span::after,
.megamenu__item:hover > .megamenu__trigger span::after,
.megamenu__item:focus-within > .megamenu__trigger span::after {
  width: 100%;
}
.megamenu__item .megamenu__trigger--text {
  cursor: default;
  color: var(--color-muted);
}
.megamenu__item .megamenu__dropdown {
  position: absolute;
  top: 100%;
  left: 0;
  transform: translateY(4px);
  min-width: 12.5rem;
  max-width: calc(100vw - 2rem);
  background: var(--color-surface);
  border: var(--popup-border);
  border-radius: var(--popup-corner-radius);
  box-shadow: var(--popup-shadow);
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity var(--transition-fast), visibility var(--transition-fast), transform var(--transition-fast);
  z-index: var(--z-dropdown, 100);
}
.megamenu__item .megamenu__dropdown.is-flipped {
  left: auto;
  right: 0;
}
.megamenu__item .megamenu__dropdown .megamenu__dropdown-inner {
  padding: var(--space-md);
}
.megamenu__item .megamenu__dropdown .megamenu__dropdown-inner .megamenu__simple {
  min-width: 12rem;
  max-width: 17.5rem;
}
.megamenu__item .megamenu__dropdown .megamenu__dropdown-inner .megamenu__simple .megamenu__simple-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
}
.megamenu__item .megamenu__dropdown .megamenu__dropdown-inner .megamenu__simple .megamenu__simple-link,
.megamenu__item .megamenu__dropdown .megamenu__dropdown-inner .megamenu__simple .megamenu__simple-sublink {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  padding: 0.5rem 0.75rem;
  font-size: var(--font-sm);
  color: var(--color-ink);
  text-decoration: none;
  border-radius: var(--popup-corner-radius);
  transition: background-color var(--transition-fast), color var(--transition-fast);
}
.megamenu__item .megamenu__dropdown .megamenu__dropdown-inner .megamenu__simple .megamenu__simple-link .icon,
.megamenu__item .megamenu__dropdown .megamenu__dropdown-inner .megamenu__simple .megamenu__simple-sublink .icon {
  width: 0.8125rem;
  height: 0.8125rem;
  flex-shrink: 0;
  color: var(--color-muted);
}
.megamenu__item .megamenu__dropdown .megamenu__dropdown-inner .megamenu__simple .megamenu__simple-link:hover,
.megamenu__item .megamenu__dropdown .megamenu__dropdown-inner .megamenu__simple .megamenu__simple-sublink:hover {
  background: var(--color-gray-light);
  color: var(--color-ink);
}
.megamenu__item .megamenu__dropdown .megamenu__dropdown-inner .megamenu__simple .megamenu__simple-link:hover .icon,
.megamenu__item .megamenu__dropdown .megamenu__dropdown-inner .megamenu__simple .megamenu__simple-sublink:hover .icon {
  color: var(--color-ink);
}
.megamenu__item .megamenu__dropdown .megamenu__dropdown-inner .megamenu__simple .megamenu__simple-sublink {
  color: var(--color-muted);
}
.megamenu__item .megamenu__dropdown .megamenu__dropdown-inner .megamenu__simple .megamenu__simple-parent {
  position: relative;
}
.megamenu__item .megamenu__dropdown .megamenu__dropdown-inner .megamenu__simple .megamenu__simple-parent:hover > .megamenu__simple-sub,
.megamenu__item .megamenu__dropdown .megamenu__dropdown-inner .megamenu__simple .megamenu__simple-parent:focus-within > .megamenu__simple-sub {
  opacity: 1;
  visibility: visible;
  transform: translateX(0);
}
.megamenu__item .megamenu__dropdown .megamenu__dropdown-inner .megamenu__simple .megamenu__simple-parent:hover > .megamenu__simple-sub.is-flipped,
.megamenu__item .megamenu__dropdown .megamenu__dropdown-inner .megamenu__simple .megamenu__simple-parent:focus-within > .megamenu__simple-sub.is-flipped {
  transform: translateX(0);
}
.megamenu__item .megamenu__dropdown .megamenu__dropdown-inner .megamenu__simple .megamenu__simple-parent.is-sub-flipped > .megamenu__simple-link > .icon,
.megamenu__item .megamenu__dropdown .megamenu__dropdown-inner .megamenu__simple .megamenu__simple-parent.is-sub-flipped > .megamenu__simple-sublink > .icon {
  transform: rotate(180deg);
}
.megamenu__item .megamenu__dropdown .megamenu__dropdown-inner .megamenu__simple .megamenu__simple-sub {
  position: absolute;
  left: 100%;
  top: 0;
  min-width: 11rem;
  max-width: 14rem;
  background: var(--color-surface);
  border: var(--popup-border);
  border-radius: var(--popup-corner-radius);
  box-shadow: var(--popup-shadow);
  padding: var(--space-xs);
  margin-left: 2px;
  list-style: none;
  opacity: 0;
  visibility: hidden;
  transform: translateX(-6px);
  transition: opacity var(--transition-fast), visibility var(--transition-fast), transform var(--transition-fast);
  z-index: 10;
}
.megamenu__item .megamenu__dropdown .megamenu__dropdown-inner .megamenu__simple .megamenu__simple-sub.is-flipped {
  left: auto;
  right: 100%;
  margin-left: 0;
  margin-right: 2px;
  transform: translateX(6px);
}
.megamenu--ratio-portrait {
  --megamenu-image-ratio: 4 / 5;
}
.megamenu--ratio-square {
  --megamenu-image-ratio: 1 / 1;
}
.megamenu--ratio-landscape {
  --megamenu-image-ratio: 4 / 3;
}
.megamenu__item .megamenu__dropdown--visual {
  content-visibility: hidden;
  transition: opacity var(--transition-fast), visibility var(--transition-fast), transform var(--transition-fast), content-visibility var(--transition-fast) allow-discrete;
}
.megamenu__item:hover > .megamenu__dropdown--visual,
.megamenu__item:focus-within > .megamenu__dropdown--visual,
.megamenu__item.is-open > .megamenu__dropdown--visual {
  content-visibility: visible;
}
.megamenu__item.is-dismissed > .megamenu__dropdown--visual {
  content-visibility: hidden;
}
.megamenu__item .megamenu__dropdown--visual .megamenu__dropdown-inner {
  padding: var(--space-lg);
}
.megamenu__panel {
  display: flex;
  align-items: flex-start;
  gap: var(--space-xl);
}
.megamenu__panel-main {
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
  min-width: 0;
}
.megamenu__cards {
  display: grid;
  grid-template-columns: repeat(var(--megamenu-columns, 1), 9rem);
  gap: var(--space-lg) var(--space-md);
}
.megamenu__card {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  min-width: 0;
}
.megamenu__card--featured {
  flex: 0 0 auto;
  width: 12rem;
}
.megamenu__card-link {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  color: var(--color-ink);
  text-decoration: none;
}
.megamenu__card-link:focus-visible {
  outline: 2px solid var(--color-focus);
  outline-offset: 2px;
}
.megamenu__card-media {
  display: block;
  aspect-ratio: var(--megamenu-image-ratio, 4 / 5);
  overflow: hidden;
  border-radius: var(--media-radius);
  background: var(--color-gray-light);
}
.megamenu__card-img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform var(--transition-base);
}
@media (hover: hover) {
  .megamenu__card-link:hover .megamenu__card-img {
    transform: scale(1.03);
  }
}
.megamenu__card-title {
  font-size: var(--font-sm);
  font-weight: var(--font-weight-medium);
  line-height: var(--line-height-snug);
}
.megamenu__card-link:hover .megamenu__card-title,
.megamenu__card-link:focus-visible .megamenu__card-title {
  text-decoration: underline;
  text-underline-offset: 3px;
}
.megamenu__card-cta {
  font-size: var(--eyebrow-size, 0.75rem);
  font-weight: var(--eyebrow-weight, 600);
  letter-spacing: var(--eyebrow-tracking, 0.14em);
  text-transform: uppercase;
  color: var(--color-muted);
}
.megamenu__card-sub {
  display: flex;
  flex-direction: column;
  gap: var(--space-2xs);
  list-style: none;
  margin: 0;
  padding: 0;
}
.megamenu__card-sublink {
  font-size: var(--font-xs);
  color: var(--color-muted);
  text-decoration: none;
}
.megamenu__card-sublink:hover {
  color: var(--color-ink);
  text-decoration: underline;
  text-underline-offset: 3px;
}
.megamenu__card-sublink:focus-visible {
  color: var(--color-ink);
  outline: 2px solid var(--color-focus);
  outline-offset: 2px;
}
.megamenu__overlay {
  position: fixed;
  inset: 0;
  background: var(--bg-overlay);
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity var(--transition-base), visibility var(--transition-base);
  z-index: calc(var(--z-dropdown) - 1);
}
.megamenu__overlay.is-active {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}
{% endstylesheet %}
