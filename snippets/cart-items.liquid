<cart-items role="list">
  <form action="{{ routes.cart_url }}" method="post" id="cart" novalidate>
    <div class="cart-template__data-head" aria-hidden="true">
      <span class="head-image">{{ 'sections.cart.headings.image' | t }}</span>
      <span class="head-info">{{ 'sections.cart.headings.product' | t }}</span>
    </div>
    {%- for item in cart.items -%}
      <cart-item data-var-id="{{ item.variant_id }}" data-product-id="{{ item.product.id }}" data-line-item="{{ forloop.index }}" role="listitem">
        <a class="cart-item__image" href="{{ item.url }}" aria-label="{{ item.product.title | escape }}">
          {%- if item.image != blank -%}
            {%- assign cart_item_alt = item.image.alt | default: item.product.title | escape -%}
            {{
              item.image
              | image_url: width: 320
              | image_tag:
                widths: '120, 160, 240, 320',
                sizes: '(max-width: 749px) 90px, 16vw',
                alt: cart_item_alt,
                loading: 'lazy',
                decoding: 'async'
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'cart-item__placeholder' }}
          {%- endif -%}
        </a>
        <div class="cart-item__info">
          <div>
            <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title | escape }}</a>
            {%- render 'cart-line-details', item: item -%}
            <div class="cart-item__price-mobile">
              {%- render 'cart-line-price', item: item -%}
            </div>
          </div>
          <div class="cart-item__quantity">
            <span class="sr-only">{{ 'products.product.quantity.label' | t }}</span>
            {%- render 'quantity-selector',
              form: 'cart',
              name: 'updates[]',
              product: item.product,
              variant: item.variant,
              cart_item: item,
              id_suffix: forloop.index,
              value: item.quantity
            -%}
            <button type="button" data-action="delete-item" title="{{ 'sections.cart.remove_title' | t: title: item.product.title }}" class="cart-item__delete" aria-label="{{ 'sections.cart.remove_title' | t: title: item.product.title }}">{{ 'sections.cart.remove' | t }}</button>
            <p class="cart-item__quantity-error" data-quantity-error role="alert"></p>
          </div>
        </div>
        <div class="cart-item__actions">
          {%- render 'cart-line-price', item: item -%}
          <button type="button" data-action="delete-item" title="{{ 'sections.cart.remove_title' | t: title: item.product.title }}" class="cart-item__delete" aria-label="{{ 'sections.cart.remove_title' | t: title: item.product.title }}">{{ 'sections.cart.remove' | t }}</button>
        </div>
      </cart-item>
    {%- endfor -%}
  </form>
</cart-items>
