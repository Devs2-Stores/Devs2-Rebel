{%- assign resolved_menu_handle = menu_handle | default: 'main-menu' -%}
<script src="{{ 'mobile-menu.js' | asset_url }}" defer="defer"></script>
<mobile-menu class="mobile-menu" role="dialog" aria-modal="true" aria-label="{{ 'accessibility.navigation' | t }}">
  <button type="button" class="mobile-menu__overlay" data-action="close-mobile-menu" aria-label="{{ 'accessibility.close' | t }}" tabindex="-1"></button>
  <div class="mobile-menu__drawer">
    <div class="mobile-menu__header">
      <span class="mobile-menu__title">{{ 'accessibility.navigation' | t }}</span>
      <button type="button" class="mobile-menu__close" data-action="close-mobile-menu" aria-label="{{ 'accessibility.close' | t }}">
        {%- render 'icon', name: 'close' -%}
      </button>
    </div>
    <div class="mobile-menu__body">
      <nav class="mobile-menu__nav" aria-label="{{ 'accessibility.mobile_navigation' | t }}">
        <ul class="mobile-menu__list">
          {%- if resolved_menu_handle != blank -%}
            {%- for link in linklists[resolved_menu_handle].links -%}
              {%- if link.links.size > 0 -%}
                {%- assign submenu_index = forloop.index -%}
                <li class="mobile-menu__item mobile-menu__item--has-children">
                  <button type="button" class="mobile-menu__trigger" aria-expanded="false" aria-controls="mobile-submenu-{{ submenu_index }}">
                    <span>{{ link.title }}</span>
                    {%- render 'icon', name: 'chevron-right' -%}
                  </button>
                  <ul id="mobile-submenu-{{ submenu_index }}" class="mobile-menu__submenu">
                    <li class="mobile-menu__submenu-back">
                      <button type="button" class="mobile-menu__back-btn" aria-label="{{ 'general.breadcrumbs.back' | t }}">
                        {%- render 'icon', name: 'chevron-left' -%}
                        <span>{{ 'general.breadcrumbs.back' | t }}</span>
                      </button>
                    </li>
                    <li class="mobile-menu__submenu-title">
                      <a href="{{ link.url }}">{{ link.title }}</a>
                    </li>
                    {%- for link_1 in link.links -%}
                      {%- if link_1.links.size > 0 -%}
                        <li class="mobile-menu__item mobile-menu__item--has-children">
                          <button type="button" class="mobile-menu__trigger" aria-expanded="false" aria-controls="mobile-submenu-{{ submenu_index }}-{{ forloop.index }}">
                            <span>{{ link_1.title }}</span>
                            {%- render 'icon', name: 'chevron-right' -%}
                          </button>
                          <ul id="mobile-submenu-{{ submenu_index }}-{{ forloop.index }}" class="mobile-menu__submenu">
                            <li class="mobile-menu__submenu-back">
                              <button type="button" class="mobile-menu__back-btn" aria-label="{{ 'general.breadcrumbs.back' | t }}">
                                {%- render 'icon', name: 'chevron-left' -%}
                                <span>{{ 'general.breadcrumbs.back' | t }}</span>
                              </button>
                            </li>
                            <li class="mobile-menu__submenu-title">
                              <a href="{{ link_1.url }}">{{ link_1.title }}</a>
                            </li>
                            {%- for link_2 in link_1.links -%}
                              <li class="mobile-menu__item">
                                <a href="{{ link_2.url }}" class="mobile-menu__link">{{ link_2.title }}</a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        </li>
                      {%- else -%}
                        <li class="mobile-menu__item">
                          <a href="{{ link_1.url }}" class="mobile-menu__link">{{ link_1.title }}</a>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                </li>
              {%- else -%}
                <li class="mobile-menu__item">
                  <a href="{{ link.url }}" class="mobile-menu__link">{{ link.title }}</a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </nav>
    </div>
    <div class="mobile-menu__footer">
      <div class="mobile-menu__actions">
        {%- if shop.customer_accounts_enabled -%}
          <shopify-account menu="{{ customer_account_menu }}">
            <span slot="signed-out-avatar" class="mobile-menu__action-link">
              {%- render 'icon', name: 'user' -%}
              <span>{{ 'customer.account.title' | t }}</span>
            </span>
          </shopify-account>
        {%- else -%}
          <a href="{{ routes.account_url }}" class="mobile-menu__action-link">
            {%- render 'icon', name: 'user' -%}
            <span>{{ 'customer.account.title' | t }}</span>
          </a>
        {%- endif -%}
      </div>
      {%- if show_country or show_language -%}
        <div class="mobile-menu__localization">
          {%- if show_country -%}
            {%- render 'localization-selector', kind: 'country', form_id: 'MobileCountryForm', variant: 'inline' -%}
          {%- endif -%}
          {%- if show_language -%}
            {%- render 'localization-selector', kind: 'language', form_id: 'MobileLanguageForm', variant: 'inline' -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</mobile-menu>

{% stylesheet %}
mobile-menu {
  position: fixed;
  inset: 0;
  z-index: var(--z-modal, 9000);
  opacity: 0;
  visibility: hidden;
  transition: opacity var(--transition-base), visibility 0s linear var(--duration-medium);
}
mobile-menu.show {
  opacity: 1;
  visibility: visible;
  transition: opacity var(--transition-base), visibility 0s;
}
mobile-menu.show .mobile-menu__overlay {
  opacity: 1;
}
mobile-menu.show .mobile-menu__drawer {
  transform: none;
}
mobile-menu .mobile-menu__overlay {
  position: fixed;
  inset: 0;
  background: var(--bg-overlay);
  border: none;
  padding: 0;
  transition: opacity var(--transition-base);
  opacity: 0;
}
mobile-menu .mobile-menu__drawer {
  position: fixed;
  left: 0;
  top: 0;
  bottom: 0;
  width: min(88vw, 24rem);
  background: var(--color-surface);
  border-right: var(--drawer-border);
  box-shadow: var(--drawer-shadow);
  border-radius: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform var(--transition-base);
  transform: translateX(-100%);
}
mobile-menu .mobile-menu__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem 1.5rem;
  border-bottom: 1px solid var(--color-hairline);
  flex-shrink: 0;
  background: var(--color-surface);
}
mobile-menu .mobile-menu__title {
  font-size: var(--eyebrow-size, 0.75rem);
  font-weight: var(--eyebrow-weight, 600);
  text-transform: uppercase;
  letter-spacing: var(--eyebrow-tracking, 0.14em);
  color: var(--color-ink);
  margin: 0;
}
mobile-menu .mobile-menu__close {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2.5rem;
  height: 2.5rem;
  padding: 0;
  border-radius: var(--buttons-radius);
  transition: background-color var(--transition-fast), color var(--transition-fast);
  color: var(--color-ink);
  background: transparent;
  border: none;
  cursor: pointer;
}
mobile-menu .mobile-menu__close:hover {
  background: var(--color-gray-light);
}
mobile-menu .mobile-menu__close:focus-visible {
  outline: 2px solid var(--color-focus);
  outline-offset: 2px;
}
mobile-menu .mobile-menu__close svg {
  width: 1.125rem;
  height: 1.125rem;
}
mobile-menu .mobile-menu__body {
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
  min-height: 0;
}
mobile-menu .mobile-menu__nav {
  position: relative;
  height: 100%;
}
mobile-menu .mobile-menu__list,
mobile-menu .mobile-menu__submenu {
  list-style: none;
  margin: 0;
  padding: 0;
}
mobile-menu .mobile-menu__item {
  border-bottom: 1px solid var(--color-hairline);
}
mobile-menu .mobile-menu__link,
mobile-menu .mobile-menu__trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 1rem 1.5rem;
  background: transparent;
  border: none;
  text-decoration: none;
  color: var(--color-ink);
  font-size: 0.9375rem;
  font-weight: var(--font-weight-medium);
  cursor: pointer;
  text-align: left;
  transition: background-color var(--transition-fast), color var(--transition-fast);
}
mobile-menu .mobile-menu__link svg,
mobile-menu .mobile-menu__trigger svg {
  width: 0.875rem;
  height: 0.875rem;
  flex-shrink: 0;
  color: var(--color-muted);
}
mobile-menu .mobile-menu__link:hover,
mobile-menu .mobile-menu__trigger:hover {
  background: var(--color-gray-light);
  color: var(--color-ink);
}
mobile-menu .mobile-menu__link:focus-visible,
mobile-menu .mobile-menu__trigger:focus-visible,
mobile-menu .mobile-menu__back-btn:focus-visible,
mobile-menu .mobile-menu__action-link:focus-visible {
  outline: 2px solid var(--color-focus);
  outline-offset: -2px;
}
mobile-menu .mobile-menu__submenu {
  position: absolute;
  top: 0;
  left: 100%;
  width: 100%;
  height: 100%;
  background: var(--color-surface);
  visibility: hidden;
  transition: transform var(--transition-base), visibility 0s linear var(--duration-medium);
  transform: translateX(0);
}
mobile-menu .mobile-menu__submenu.is-open {
  transform: translateX(-100%);
  visibility: visible;
  transition-delay: 0s;
}
mobile-menu .mobile-menu__submenu-back {
  border-bottom: 1px solid var(--color-hairline);
}
mobile-menu .mobile-menu__back-btn {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  width: 100%;
  padding: 0.875rem 1.5rem;
  background: var(--color-gray-lighter);
  border: none;
  font-size: var(--meta-size, 0.8125rem);
  font-weight: var(--font-weight-medium);
  color: var(--color-muted);
  cursor: pointer;
  transition: background-color var(--transition-fast), color var(--transition-fast);
}
mobile-menu .mobile-menu__back-btn:hover {
  background: var(--color-gray-light);
  color: var(--color-ink);
}
mobile-menu .mobile-menu__back-btn svg {
  width: 0.875rem;
  height: 0.875rem;
}
mobile-menu .mobile-menu__submenu-title {
  border-bottom: 1px solid var(--color-hairline);
}
mobile-menu .mobile-menu__submenu-title a {
  display: block;
  padding: 1rem 1.5rem;
  font-size: 0.9375rem;
  font-weight: var(--font-weight-semibold);
  color: var(--color-ink);
  text-decoration: none;
}
mobile-menu .mobile-menu__footer {
  padding: 1.25rem 1.5rem;
  border-top: 1px solid var(--color-hairline);
  flex-shrink: 0;
  background: var(--color-surface);
  max-height: 70%;
  overflow-y: auto;
}
mobile-menu .mobile-menu__actions {
  display: flex;
  gap: 0.75rem;
}
mobile-menu .mobile-menu__localization {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  margin-top: var(--space-sm);
}
mobile-menu .mobile-menu__action-link {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  min-height: 2.75rem;
  padding: 0.625rem 1rem;
  background: transparent;
  border: 1px solid var(--color-hairline);
  border-radius: var(--buttons-radius);
  text-decoration: none;
  color: var(--color-ink);
  font-family: var(--font-body-family);
  font-size: var(--font-sm);
  font-weight: var(--font-weight-medium);
  transition: background-color var(--transition-fast), border-color var(--transition-fast);
}
mobile-menu .mobile-menu__action-link svg {
  width: 1.125rem;
  height: 1.125rem;
}
mobile-menu .mobile-menu__action-link:hover {
  background: var(--color-gray-light);
  border-color: var(--color-ink);
}
{% endstylesheet %}
