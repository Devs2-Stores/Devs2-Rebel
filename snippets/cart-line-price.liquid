{% doc %}
  @description Renders original, final, and unit pricing for a cart line item.
  @param {line_item} item Cart line item.
{% enddoc %}

{%- liquid
  assign is_line_sale = false
  if item.original_line_price > item.final_line_price
    assign is_line_sale = true
  endif
-%}
<div class="cart-line-price">
  {%- if is_line_sale -%}
    <del class="cart-line-price__original">{%- render 'money', amount: item.original_line_price -%}</del>
  {%- endif -%}
  <strong class="cart-line-price__final{% if is_line_sale %} cart-line-price__final--sale{% endif %}">{%- render 'money', amount: item.final_line_price -%}</strong>
  {%- if item.unit_price != blank -%}
    <span class="cart-line-price__unit">
      <span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
      {% render 'money', amount: item.unit_price %}/{{ item.unit_price_measurement.reference_value }}{{ item.unit_price_measurement.reference_unit }}
    </span>
  {%- endif -%}
</div>
