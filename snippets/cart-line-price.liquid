{% doc %}
  @description Renders original, final, and unit pricing for a cart line item.
  @param {line_item} item Cart line item.
{% enddoc %}

<div class="cart-line-price">
  {%- if item.original_line_price > item.final_line_price -%}
    <del class="cart-line-price__original">{{ item.original_line_price | money }}</del>
  {%- endif -%}
  <strong class="cart-line-price__final">{{ item.final_line_price | money }}</strong>
  {%- if item.unit_price != blank -%}
    <span class="cart-line-price__unit">
      <span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
      {{ item.unit_price | money }}/{{ item.unit_price_measurement.reference_value }}{{ item.unit_price_measurement.reference_unit }}
    </span>
  {%- endif -%}
</div>
