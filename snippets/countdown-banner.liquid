{% doc %}
  @description Countdown banner with a timer, supports horizontal and stacked layouts
  @param {string} [heading] - Banner heading
  @param {string} [subheading] - Subheading
  @param {string} [button_text] - CTA button text
  @param {string} [button_link] - CTA button URL
  @param {string} [end_date] - End date (YYYY-MM-DD), store time zone
  @param {string} [end_time] - End time (HH:MM), store time zone. Default: '23:59'
  @param {boolean} [show_after_expired] - Keep showing after expiry. Default: false
  @param {string} [layout] - Layout: horizontal or stacked. Default: 'horizontal'
  @param {object} [image] - Banner image (image_picker)
  @param {string} [bg_color] - Background color. Default: the scheme text color
  @param {string} [text_color] - Text color. Default: the scheme background color
  @param {string} [accent_color] - Accent (button) color. Default: the scheme button color
  @param {string} [block_id] - Block ID unique
  @example {%- render 'countdown-banner', heading: 'SALE', end_date: '2026-12-31', block_id: block.id -%}
{% enddoc %}

{%- liquid
  assign subheading = subheading | default: ''
  assign end_time = end_time | default: '23:59'
  assign layout = layout | default: 'horizontal'
  assign unique_id = block_id | default: 'countdown'
  assign banner_style = ''
  assign banner_text = text_color
  assign button_fill = accent_color
  if bg_color != blank
    if banner_text == blank
      assign bg_on_white = bg_color | color_contrast: '#FFFFFF'
      assign bg_on_black = bg_color | color_contrast: '#000000'
      assign banner_text = '#FFFFFF'
      if bg_on_black > bg_on_white
        assign banner_text = '#000000'
      endif
    endif
    if button_fill == blank
      assign button_fill = banner_text
    endif
    assign banner_style = banner_style | append: '--countdown-bg: ' | append: bg_color | append: '; '
  endif
  if banner_text != blank
    assign banner_style = banner_style | append: '--countdown-text: ' | append: banner_text | append: '; '
  endif
  if button_fill != blank
    assign fill_on_white = button_fill | color_contrast: '#FFFFFF'
    assign fill_on_black = button_fill | color_contrast: '#000000'
    assign button_label = '#FFFFFF'
    if fill_on_black > fill_on_white
      assign button_label = '#000000'
    endif
    assign banner_style = banner_style | append: '--countdown-accent: ' | append: button_fill | append: '; --countdown-btn-text: ' | append: button_label | append: ';'
  endif

  if show_after_expired == nil
    assign show_after_expired = false
  endif
-%}

{%- if end_date != blank -%}
  {{ 'countdown-banner.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'countdown-banner.js' | asset_url }}" defer="defer"></script>

  <countdown-banner
    class="countdown-banner countdown-banner--{{ layout }}"
    {% if banner_style != blank %}style="{{ banner_style | strip }}"{% endif %}
    data-end-date="{{ end_date }}"
    data-end-time="{{ end_time }}"
    data-tz-offset="{{ 'now' | date: '%z' }}"
    data-show-after-expired="{{ show_after_expired }}"
    id="CountdownBanner-{{ unique_id }}"
  >
    <div class="countdown-banner__inner">
      {%- if image != blank -%}
        <div class="countdown-banner__media">
          {{ image | image_url: width: 440 | image_tag:
            widths: '220, 440',
            sizes: '220px',
            alt: heading,
            loading: 'lazy',
            decoding: 'async',
            class: 'countdown-banner__image'
          }}
        </div>
      {%- endif -%}

      <div class="countdown-banner__content">
        {%- if heading != blank -%}
          <h3 class="countdown-banner__heading">{{ heading | escape }}</h3>
        {%- endif -%}
        {%- if subheading != blank -%}
          <p class="countdown-banner__subheading">{{ subheading | escape }}</p>
        {%- endif -%}
        {%- if button_text != blank and button_link != blank -%}
          <a href="{{ button_link }}" class="countdown-banner__btn">{{ button_text | escape }}</a>
        {%- endif -%}
      </div>

      <div class="countdown-banner__timer" role="timer">
        <div class="countdown-banner__unit">
          <span class="countdown-banner__number" data-countdown-days>00</span>
          <span class="countdown-banner__label">{{ 'sections.countdown.days' | t }}</span>
        </div>
        <span class="countdown-banner__separator" aria-hidden="true">:</span>
        <div class="countdown-banner__unit">
          <span class="countdown-banner__number" data-countdown-hours>00</span>
          <span class="countdown-banner__label">{{ 'sections.countdown.hours' | t }}</span>
        </div>
        <span class="countdown-banner__separator" aria-hidden="true">:</span>
        <div class="countdown-banner__unit">
          <span class="countdown-banner__number" data-countdown-minutes>00</span>
          <span class="countdown-banner__label">{{ 'sections.countdown.minutes' | t }}</span>
        </div>
        <span class="countdown-banner__separator" aria-hidden="true">:</span>
        <div class="countdown-banner__unit">
          <span class="countdown-banner__number" data-countdown-seconds>00</span>
          <span class="countdown-banner__label">{{ 'sections.countdown.seconds' | t }}</span>
        </div>
      </div>
    </div>
  </countdown-banner>

{%- endif -%}
