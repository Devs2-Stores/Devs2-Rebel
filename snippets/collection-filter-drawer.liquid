{% doc %}
  Collection Filter Drawer / Modal snippet.
  Renders the sidebar drawer (also the desktop sidebar) or the slide-in modal depending on filter_layout.
  On narrow screens the panel carries the sort control and a footer with the live result count.

  @param {boolean} enable_filtering - Render the panel
  @param {string} filter_layout - sidebar, modal or horizontal
  @param {object} [results] - Collection or Search object. Default: collection
  @param {string} [price_filter_style] - Price filter style
  @param {boolean} [enable_sorting] - Render the sort control inside the panel on narrow screens. Default: false
  @param {string} [allowed_sort_options] - Comma-separated list of allowed sort values
{% enddoc %}

{%- liquid
  assign results = results | default: collection
  assign sort_by = results.sort_by | default: results.default_sort_by
  if results.url
    assign results_url = results.url
  else
    assign terms_encoded = results.terms | replace: '&amp;', '&' | replace: '&#39;', "'" | replace: '&quot;', '"' | replace: '&lt;', '<' | replace: '&gt;', '>' | url_encode
    assign results_url = routes.search_url | append: '?q=' | append: terms_encoded | append: '&type=product,article,page'
  endif
  if results_url contains '?'
    assign clear_url = results_url | append: '&sort_by=' | append: sort_by
  else
    assign clear_url = results_url | append: '?sort_by=' | append: sort_by
  endif
  assign result_count = results.products_count | default: results.results_count | default: 0
-%}

{%- if enable_filtering -%}
  {%- if filter_layout == 'sidebar' or filter_layout == 'horizontal' -%}
    <div class="collection-template__facet-filter" id="CollectionFilterDrawer">
      <div class="collection-template__facet-filter-header">
        <span class="collection-template__facet-filter-header-title" id="CollectionFilterDrawerTitle">
          {{- 'products.facets.filter_button' | t -}}
        </span>
        <button
          type="button"
          class="collection-template__close-filter"
          data-action="close-filter"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          {%- render 'icon', name: 'close' -%}
        </button>
      </div>
      {%- if enable_sorting -%}
        <div class="collection-template__facet-filter-sort">
          <label for="SortByDrawer" class="collection-sort__label">{{ 'products.facets.sort_by_label' | t }}</label>
          {%- render 'collection-sort-select', results: results, select_id: 'SortByDrawer', allowed_sort_options: allowed_sort_options -%}
        </div>
      {%- endif -%}
      <div class="collection-template__facet-filter-title">
        <strong>{{ 'products.facets.filter_by_label' | t }}</strong>
      </div>
      <div class="collection-template__facet-filter-content" id="FacetFiltersContainer">
        {%- render 'collection-facet-filter', results: results, price_filter_style: price_filter_style -%}
      </div>
      <div class="collection-template__facet-filter-footer">
        <a href="{{ clear_url }}" class="collection-template__facet-filter-clear" data-filter-remove>
          {{ 'products.facets.clear_all_filters' | t }}
        </a>
        <button type="button" class="collection-template__facet-filter-apply" data-action="close-filter" data-filter-apply-label>
          {{- 'products.facets.see_results' | t: count: result_count -}}
        </button>
      </div>
    </div>
    <div class="collection-template__filter-overlay" data-action="close-filter"></div>

  {%- elsif filter_layout == 'modal' -%}
    <div
      class="collection-filter-modal"
      id="CollectionFilterModal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="filter-modal-title"
      aria-hidden="true"
    >
      <button
        type="button"
        class="collection-filter-modal__overlay"
        data-action="close-filter-modal"
        aria-label="{{ 'accessibility.close' | t }}"
        tabindex="-1"
      ></button>
      <div class="collection-filter-modal__panel">
        <div class="collection-filter-modal__header">
          <h2 class="collection-filter-modal__title" id="filter-modal-title">
            {{ 'products.facets.filter_by_label' | t }}
          </h2>
          <button
            type="button"
            class="collection-filter-modal__close"
            data-action="close-filter-modal"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            {%- render 'icon', name: 'close' -%}
          </button>
        </div>
        {%- if enable_sorting -%}
          <div class="collection-template__facet-filter-sort">
            <label for="SortByDrawer" class="collection-sort__label">{{ 'products.facets.sort_by_label' | t }}</label>
            {%- render 'collection-sort-select', results: results, select_id: 'SortByDrawer', allowed_sort_options: allowed_sort_options -%}
          </div>
        {%- endif -%}
        <div class="collection-filter-modal__body" id="FacetFiltersContainer">
          {%- render 'collection-facet-filter', results: results, collapse_filters: false, price_filter_style: price_filter_style -%}
        </div>
        <div class="collection-filter-modal__footer">
          <a
            href="{{ clear_url }}"
            class="collection-filter-modal__clear-btn"
            data-filter-remove
          >
            {{ 'products.facets.clear_all_filters' | t }}
          </a>
          <button type="button" class="collection-filter-modal__apply-btn" data-action="close-filter-modal" data-filter-apply-label>
            {{- 'products.facets.see_results' | t: count: result_count -}}
          </button>
        </div>
      </div>
    </div>
  {%- endif -%}
{%- endif -%}
