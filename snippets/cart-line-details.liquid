{% doc %}
  @description Renders cart line variant options, properties, selling plan, and line-level discounts.
  @param {line_item} item Cart line item.
{% enddoc %}

{%- if item.variant.title != 'Default Title' -%}
  <dl class="cart-line-details__options">
    {%- for option in item.options_with_values -%}
      <div class="cart-line-details__option">
        <dt>{{ option.name | escape }}:</dt>
        <dd>{{ option.value | escape }}</dd>
      </div>
    {%- endfor -%}
  </dl>
{%- endif -%}

{%- if item.selling_plan_allocation != blank -%}
  <p class="cart-line-details__selling-plan">
    <strong>{{ item.selling_plan_allocation.selling_plan.name | escape }}</strong>
  </p>
{%- endif -%}

{%- assign visible_property_count = 0 -%}
{%- for property in item.properties -%}
  {%- assign property_name_first_character = property.first | slice: 0 -%}
  {%- if property.last != blank and property_name_first_character != '_' -%}
    {%- assign visible_property_count = visible_property_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}
{%- if visible_property_count > 0 -%}
  <dl class="cart-line-details__properties">
    {%- for property in item.properties -%}
      {%- assign property_name_first_character = property.first | slice: 0 -%}
      {%- if property.last != blank and property_name_first_character != '_' -%}
        <div class="cart-line-details__property">
          <dt>{{ property.first | escape }}:</dt>
          <dd>
            {%- if property.last contains '/uploads/' -%}
              <a href="{{ property.last | escape }}" target="_blank" rel="noopener">{{ property.last | split: '/' | last | escape }}</a>
            {%- else -%}
              {{ property.last | escape }}
            {%- endif -%}
          </dd>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </dl>
{%- endif -%}

{%- if item.line_level_discount_allocations != blank -%}
  <ul class="cart-line-details__discounts" role="list">
    {%- for discount_allocation in item.line_level_discount_allocations -%}
      <li class="cart-line-details__discount">
        <svg aria-hidden="true" focusable="false" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1.5 1.5h3.75l5.25 5.25-3.75 3.75L1.5 5.25V1.5Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/><circle cx="4.125" cy="3.875" r=".375" fill="currentColor"/></svg>
        <span>{{ discount_allocation.discount_application.title | escape }} (-{{ discount_allocation.amount | money }})</span>
      </li>
    {%- endfor -%}
  </ul>
{%- endif -%}
