{%- comment %}
  Global scripts and configuration.
  All config under window.themeConfig — includes routes, i18n strings, and per-template JS.
{% endcomment %}

<script>
  window.themeConfig = {
    shopUrl: '{{ request.origin }}',
    formatMoney: {{ shop.money_format | json }},
    priceFormat: {% if settings.price_currency_code_enabled %}{{ shop.money_with_currency_format | json }}{% else %}{{ shop.money_format | json }}{% endif %},

    routes: {
      root_url: {{ routes.root_url | append: '/' | replace: '//', '/' | json }},
      cart_url: '{{ routes.cart_url }}',
      cart_add_url: '{{ routes.cart_add_url }}',
      cart_change_url: '{{ routes.cart_change_url }}',
      cart_update_url: '{{ routes.cart_update_url }}',
      get_cart_url: '{{ routes.cart_url }}.js',
      checkout_url: '/checkout',
      all_products_url: '{{ routes.all_products_collection_url }}',
      predictive_search_url: '{% if settings.search_suggest_enabled %}{{ routes.predictive_search_url }}{% endif %}',
      search_url: '{{ routes.search_url }}'
    },

    cart: {
      events: {
        quantity_changed: "cart-quantity-changed",
        item_delete: "cart-item-deleted",
        item_add: "cart-item-added",
        item_update: "cart-item-updated",
        item_remove: "cart-item-removed",
        updated: "cart:updated"
      },
      type: {{ settings.cart_mode | default: 'drawer' | json }},
      auto_open_sidebar: {% if settings.cart_mode == 'page' or settings.cart_mode == 'notification' %}false{% else %}true{% endif %}
    },

    strings: {
      cart: {
        error: `{{ 'sections.cart.cart_error' | t }}`,
        quantityError: `{{ 'sections.cart.cart_quantity_error' | t: quantity: '[quantity]' }}`,
        noteError: `{{ 'sections.cart.note_error' | t }}`,
        noteSaved: `{{ 'sections.cart.note_saved' | t }}`,
        invoiceError: `{{ 'sections.cart.invoice_error' | t }}`,
        removeConfirm: `{{ 'sections.cart.remove_confirm' | t }}`,
        itemAdded: `{{ 'products.product.add_to_cart_success' | t }}`,
        itemError: `{{ 'products.product.add_to_cart_error' | t }}`
      },
      variant: {
        addToCart: `{{ 'products.product.add_to_cart' | t }}`,
        buyNow: `{{ 'products.product.buy_now' | t }}`,
        soldOut: `{{ 'products.product.sold_out' | t }}`,
        unavailable: `{{ 'products.product.unavailable' | t }}`,
        unavailable_with_option: `{{ 'products.product.value_unavailable' | t: option_value: '[value]' }}`,
        contact: `{{ 'products.product.price.contact' | t }}`,
        inStock: `{{ 'products.product.inventory_in_stock' | t }}`,
        updating: `{{ 'products.product.updating' | t }}`,
        adding: `{{ 'products.product.adding' | t }}`,
        selectAllOptions: `{{ 'products.product.select_all_options' | t }}`,
        loadError: `{{ 'products.product.load_error' | t }}`
      },
      share: {
        success: `{{ 'general.share.success_message' | t }}`,
        copyFailed: `{{ 'general.share.copy_failed' | t }}`,
        copied: `{{ 'general.share.copied' | t }}`,
        copyArticleLink: `{{ 'general.share.copy_article_link' | t }}`
      },
      collection: {
        moreLoaded: `{{ 'products.facets.more_products_loaded' | t }}`,
        loadError: `{{ 'products.facets.load_error' | t }}`
      },
      search: {
        unavailable: `{{ 'templates.search.suggestions_unavailable' | t }}`,
        viewResults: `{{ 'templates.search.view_search_results' | t }}`
      },
      accessibility: {
        close: `{{ 'accessibility.close' | t }}`,
        imageAvailable: `{{ 'products.product.media.image_available' | t: index: '[index]' }}`,
        shareSuccess: `{{ 'general.share.success_message' | t }}`,
        previousSlide: `{{ 'accessibility.previous_slide' | t }}`,
        nextSlide: `{{ 'accessibility.next_slide' | t }}`
      }
    },

    collection: {},

    {%- if template contains 'product' -%}
    product: {
      events: {
        variant_change: "variant:change"
      },
      data: {{ product | json }}
    },
    {%- endif -%}

    quickview: {}

  }
</script>

<script>
  /*
    Swiper loader. swiperReady(cb) loads swiper.css + swiper.js now (user-triggered or critical sliders).
    swiperReady(cb, el) waits until el is near the viewport, then loads after window load + idle,
    or on the first user input, so off-screen and hero sliders never compete with first paint.
    Pre-init layout of every slider is covered by .swiper:not(.swiper-initialized) rules in theme.css.
  */
  (function(){
    var SWIPER_CSS = '{{ "swiper.css" | asset_url }}';
    var SWIPER_JS  = '{{ "swiper.js" | asset_url }}';
    var queue = [];
    var state = 0;
    var armed = false;
    var INPUTS = ['pointerdown', 'keydown', 'touchstart', 'wheel', 'scroll'];

    function flush(){
      state = 2;
      queue.splice(0).forEach(function(cb){
        try { cb(); } catch (e) { console.error(e); }
      });
    }

    function load(){
      if (state) return;
      state = 1;
      var pending = 2;
      var done = function(){ if (--pending === 0) flush(); };
      var l = document.createElement('link');
      l.rel = 'stylesheet'; l.href = SWIPER_CSS;
      l.onload = l.onerror = done;
      document.head.appendChild(l);
      var s = document.createElement('script');
      s.src = SWIPER_JS;
      s.onload = s.onerror = done;
      document.head.appendChild(s);
    }

    function loadSoon(){
      if (state || armed) return;
      armed = true;
      var go = function(){
        INPUTS.forEach(function(type){ window.removeEventListener(type, go); });
        load();
      };
      INPUTS.forEach(function(type){ window.addEventListener(type, go, { passive: true, once: true }); });
      var idle = function(){
        if ('requestIdleCallback' in window) requestIdleCallback(go, { timeout: 1200 });
        else setTimeout(go, 200);
      };
      if (document.readyState === 'complete') idle();
      else window.addEventListener('load', idle, { once: true });
    }

    window.swiperReady = function(cb, el){
      if (state === 2) return cb();
      queue.push(cb);
      if (state === 1) return;
      if (!el) return load();
      if (!('IntersectionObserver' in window)) return loadSoon();
      var io = new IntersectionObserver(function(entries){
        if (!entries[0].isIntersecting) return;
        io.disconnect();
        loadSoon();
      }, { rootMargin: '200px 0px' });
      io.observe(el);
    };
  })();
</script>
<script defer src="{{ 'theme.js' | asset_url }}"></script>
{%- if settings.motion_reveal_on_scroll -%}
  <script defer src="{{ 'reveal-on-scroll.js' | asset_url }}"></script>
{%- endif -%}
{%- if request.design_mode -%}
  <script defer src="{{ 'theme-editor.js' | asset_url }}"></script>
{%- endif -%}
<script defer src="{{ 'toast.js' | asset_url }}"></script>
<script defer src="{{ 'back-to-top.js' | asset_url }}"></script>

{%- if template == 'collection' -%}
  <script defer src="{{ 'collection.js' | asset_url }}"></script>
{%- elsif template == 'product' -%}
  <script defer src="{{ 'product.js' | asset_url }}"></script>
{%- elsif template == 'cart' -%}
  <script defer src="{{ 'cart.js' | asset_url }}"></script>
{%- elsif template contains 'customer' -%}
  <script defer src="{{ 'customer.js' | asset_url }}"></script>
{%- elsif template == 'page.contact' -%}
  <script defer src="{{ 'page-contact.js' | asset_url }}"></script>
{%- elsif template == 'page.stores' -%}
  <script defer src="{{ 'page-stores.js' | asset_url }}"></script>
{%- elsif template == 'page.faq' -%}
  <script defer src="{{ 'page-faq.js' | asset_url }}"></script>
{%- elsif template contains 'search' -%}
  <script defer src="{{ 'collection.js' | asset_url }}"></script>
  <script defer src="{{ 'search.js' | asset_url }}"></script>
{%- endif -%}

<script type="speculationrules">
{
  "prefetch": [
    {
      "source": "document",
      "where": {
        "and": [
          { "href_matches": "/*" },
          { "not": { "href_matches": ["/cart", "/cart/*", "/checkout", "/checkout/*", "/account", "/account/*", "/search*", "/*/cart", "/*/cart/*", "/*/checkout", "/*/checkout/*", "/*/account", "/*/account/*", "/*/search*"] } }
        ]
      },
      "eagerness": "moderate"
    }
  ]
}
</script>
