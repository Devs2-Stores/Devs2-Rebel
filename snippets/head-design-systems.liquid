{%- comment %}
  Design system CSS variables.
  Layout, typography, buttons, inputs, cards, media, popups, drawers.
  Color schemes are in head-color-schemes.liquid.

  ══ BREAKPOINTS (mobile-first, use min-width) ══
  --breakpoint-sm:  750px   ← Tablet+
  --breakpoint-md:  1024px  ← Desktop
  --breakpoint-lg:  1200px  ← Large desktop
  NOTE: CSS var() cannot be used in @media queries.
        Always use the raw px values above.
{% endcomment -%}

{% style %}
  :root {

    /* ═══════════ BREAKPOINTS (reference only — cannot use var() in @media) ═══════════ */
    --breakpoint-sm: 750px;
    --breakpoint-md: 1024px;
    --breakpoint-lg: 1200px;

    /* ═══════════ FIXED COLORS ═══════════ */
    --color-black: #000;
    --color-white: #fff;
    --bg-overlay: rgba(0, 0, 0, 0.5);
    --border-width: 1px;



    --font-heading-family: {{ settings.type_font_heading.family }}, {{ settings.type_font_heading.fallback_families }};
    --font-heading-style: {{ settings.type_font_heading.style }};
    --font-heading-weight: {{ settings.type_font_heading.weight }};

    --font-subheading-family: {{ settings.type_font_subheading.family }}, {{ settings.type_font_subheading.fallback_families }};
    --font-subheading-style: {{ settings.type_font_subheading.style }};
    --font-subheading-weight: {{ settings.type_font_subheading.weight }};

    --font-body-family: {{ settings.type_font_body.family }}, {{ settings.type_font_body.fallback_families }};
    --font-body-style: {{ settings.type_font_body.style }};
    --font-body-weight: {{ settings.type_font_body.weight }};

    --font-body-scale: {{ settings.type_scale_body | divided_by: 100.0 }};
    --font-heading-scale: {{ settings.type_scale_heading | divided_by: 100.0 }};

    {%- if settings.type_accent_custom %}
    --font-accent-family: {{ settings.type_accent_face.family }}, {{ settings.type_accent_face.fallback_families }};
    --font-accent-style: {{ settings.type_accent_face.style }};
    --font-accent-weight: {{ settings.type_accent_face.weight }};
    {%- endif %}

    --type-mobile-ratio: {{ settings.type_mobile_size_ratio | divided_by: 100.0 }};
    --display-scale: {{ settings.type_display_scale | divided_by: 100.0 }};
    --display-scale-mobile: calc(1 + (var(--display-scale) - 1) * var(--type-mobile-ratio));

    --h1-scale: {{ settings.type_h1_scale | divided_by: 100.0 }};
    --h1-scale-mobile: calc(1 + (var(--h1-scale) - 1) * var(--type-mobile-ratio));
    --h1-line-height: {{ settings.type_h1_line_height | divided_by: 100.0 }};
    --h1-tracking: {{ settings.type_h1_tracking | divided_by: 1000.0 }}em;
    {%- if settings.type_h1_case == 'uppercase' %}
    --h1-case: uppercase;
    {%- endif %}
    --h2-scale: {{ settings.type_h2_scale | divided_by: 100.0 }};
    --h2-scale-mobile: calc(1 + (var(--h2-scale) - 1) * var(--type-mobile-ratio));
    --h2-line-height: {{ settings.type_h2_line_height | divided_by: 100.0 }};
    --h2-tracking: {{ settings.type_h2_tracking | divided_by: 1000.0 }}em;
    {%- if settings.type_h2_case == 'uppercase' %}
    --h2-case: uppercase;
    {%- endif %}
    --h3-scale: {{ settings.type_h3_scale | divided_by: 100.0 }};
    --h3-scale-mobile: calc(1 + (var(--h3-scale) - 1) * var(--type-mobile-ratio));
    --h3-line-height: {{ settings.type_h3_line_height | divided_by: 100.0 }};
    --h3-tracking: {{ settings.type_h3_tracking | divided_by: 1000.0 }}em;
    {%- if settings.type_h3_case == 'uppercase' %}
    --h3-case: uppercase;
    {%- endif %}
    --h4-scale: {{ settings.type_h4_scale | divided_by: 100.0 }};
    --h4-scale-mobile: calc(1 + (var(--h4-scale) - 1) * var(--type-mobile-ratio));
    --h4-line-height: {{ settings.type_h4_line_height | divided_by: 100.0 }};
    --h4-tracking: {{ settings.type_h4_tracking | divided_by: 1000.0 }}em;
    {%- if settings.type_h4_case == 'uppercase' %}
    --h4-case: uppercase;
    {%- endif %}
    --h5-scale: {{ settings.type_h5_scale | divided_by: 100.0 }};
    --h5-scale-mobile: calc(1 + (var(--h5-scale) - 1) * var(--type-mobile-ratio));
    --h5-line-height: {{ settings.type_h5_line_height | divided_by: 100.0 }};
    --h5-tracking: {{ settings.type_h5_tracking | divided_by: 1000.0 }}em;
    {%- if settings.type_h5_case == 'uppercase' %}
    --h5-case: uppercase;
    {%- endif %}
    --h6-scale: {{ settings.type_h6_scale | divided_by: 100.0 }};
    --h6-scale-mobile: calc(1 + (var(--h6-scale) - 1) * var(--type-mobile-ratio));
    --h6-line-height: {{ settings.type_h6_line_height | divided_by: 100.0 }};
    --h6-tracking: {{ settings.type_h6_tracking | divided_by: 1000.0 }}em;
    {%- if settings.type_h6_case == 'uppercase' %}
    --h6-case: uppercase;
    {%- endif %}

    /* ═══════════ FONT SIZES ═══════════ */
    --font-xs: calc(0.75rem * var(--font-body-scale));
    --font-sm: calc(0.875rem * var(--font-body-scale));
    --font-input: var(--font-sm);
    --font-base: calc(1rem * var(--font-body-scale));
    --font-lg: calc(1.125rem * var(--font-body-scale));
    --font-xl: calc(1.25rem * var(--font-heading-scale));
    --font-2xl: calc(1.5rem * var(--font-heading-scale));
    --font-3xl: calc(1.875rem * var(--font-heading-scale));
    --font-4xl: calc(2.25rem * var(--font-heading-scale));
    --font-5xl: calc(3rem * var(--font-heading-scale));
    --font-6xl: calc(4rem * var(--font-heading-scale));

    /* ═══════════ FONT WEIGHTS ═══════════ */
    --font-weight-normal: 400;
    --font-weight-medium: 500;
    --font-weight-semibold: 600;
    --font-weight-bold: 700;

    /* ═══════════ LINE HEIGHTS ═══════════ */
    --line-height-none: 1;
    --line-height-tight: 1.25;
    --line-height-snug: 1.375;
    --line-height-normal: 1.5;
    --line-height-relaxed: 1.625;
    --line-height-loose: 2;

    /* ═══════════ SPACING ═══════════ */
    --space-xs: 0.25rem;
    --space-sm: 0.5rem;
    --space-md: 0.75rem;
    --space-lg: 1rem;
    --space-xl: 1.25rem;
    --space-2xl: 1.5rem;
    --space-3xl: 1.75rem;
    --space-4xl: 2rem;
    --space-6xl: 4rem;
    --space-7xl: 6rem;
    --section-head-gap: 2rem;
    --stack-gap: 1.25rem;

    /* ═══════════ LAYOUT (from settings_schema) ═══════════ */
    --page-width: {{ settings.layout_page_width }}px;
    --header-height: 80px;
    --spacing-sections-desktop: {{ settings.layout_section_gap }}px;
    --spacing-sections-mobile: {%- if settings.layout_section_gap < 24 -%}{{ settings.layout_section_gap }}{%- else -%}{{ settings.layout_section_gap | times: 0.7 | round | at_least: 20 }}{%- endif -%}px;
    --grid-horizontal-spacing: {{ settings.layout_grid_gap_x }}px;
    --grid-vertical-spacing: {{ settings.layout_grid_gap_y }}px;

    /* ═══════════ BORDERS ═══════════ */
    --radius-sm: 4px;
    --radius-md: 8px;
    --radius-lg: 12px;
    --radius-full: 9999px;
    --radius-control: 4px;
    --radius-control-lg: 8px;

    /* ═══════════ BUTTONS (from settings_schema) ═══════════ */
    --buttons-radius: {{ settings.button_corner_radius }}px;
    --buttons-border-width: {{ settings.button_stroke_width }}px;
    --buttons-border-opacity: {{ settings.button_stroke_opacity | divided_by: 100.0 }};
    --buttons-shadow-opacity: {{ settings.button_shadow_alpha | divided_by: 100.0 }};
    --buttons-shadow-horizontal-offset: {{ settings.button_shadow_offset_x }}px;
    --buttons-shadow-vertical-offset: {{ settings.button_shadow_offset_y }}px;
    --buttons-shadow-blur-radius: {{ settings.button_shadow_blur_radius }}px;

    /* ═══════════ INPUTS ═══════════ */
    --inputs-radius: {{ settings.input_corner_radius }}px;
    --inputs-border-width: {{ settings.input_stroke_width }}px;
    --inputs-border-opacity: {{ settings.input_stroke_opacity | divided_by: 100.0 }};
    --inputs-shadow-opacity: {{ settings.input_shadow_alpha | divided_by: 100.0 }};
    --inputs-shadow-horizontal-offset: {{ settings.input_shadow_offset_x }}px;
    --inputs-shadow-vertical-offset: {{ settings.input_shadow_offset_y }}px;
    --inputs-shadow-blur-radius: {{ settings.input_shadow_blur_radius }}px;

    /* ═══════════ VARIANT PILLS ═══════════ */
    --variant-pills-radius: {{ settings.variant_chip_corner_radius }}px;
    --variant-pills-border-width: {{ settings.variant_chip_stroke_width }}px;
    --variant-pills-border-opacity: {{ settings.variant_chip_stroke_opacity | divided_by: 100.0 }};
    --variant-pills-shadow-opacity: {{ settings.variant_chip_shadow_alpha | divided_by: 100.0 }};
    --variant-pills-shadow-horizontal-offset: {{ settings.variant_chip_shadow_offset_x }}px;
    --variant-pills-shadow-vertical-offset: {{ settings.variant_chip_shadow_offset_y }}px;
    --variant-pills-shadow-blur-radius: {{ settings.variant_chip_shadow_blur_radius }}px;

    /* ═══════════ CARDS ═══════════ */
    --card-image-padding: {{ settings.product_card_image_inset | divided_by: 10.0 }}rem;
    --card-corner-radius: {{ settings.product_card_corner_radius | divided_by: 10.0 }}rem;
    --card-text-alignment: {{ settings.product_card_text_align }};
    --card-border-width: {{ settings.product_card_stroke_width | divided_by: 10.0 }}rem;
    --card-border-opacity: {{ settings.product_card_stroke_opacity | divided_by: 100.0 }};
    --card-shadow-opacity: {{ settings.product_card_shadow_alpha | divided_by: 100.0 }};
    --card-shadow-horizontal-offset: {{ settings.product_card_shadow_offset_x | divided_by: 10.0 }}rem;
    --card-shadow-vertical-offset: {{ settings.product_card_shadow_offset_y | divided_by: 10.0 }}rem;
    --card-shadow-blur-radius: {{ settings.product_card_shadow_blur_radius | divided_by: 10.0 }}rem;

    /* ═══════════ MEDIA ═══════════ */
    --media-border-width: {{ settings.media_frame_stroke_width }}px;
    --media-border-opacity: {{ settings.media_frame_stroke_opacity | divided_by: 100.0 }};
    --media-radius: {{ settings.media_frame_corner_radius }}px;
    --media-shadow-opacity: {{ settings.media_frame_shadow_alpha | divided_by: 100.0 }};
    --media-shadow-horizontal-offset: {{ settings.media_frame_shadow_offset_x }}px;
    --media-shadow-vertical-offset: {{ settings.media_frame_shadow_offset_y }}px;
    --media-shadow-blur-radius: {{ settings.media_frame_shadow_blur_radius }}px;

    /* ═══════════ TEXT BOXES ═══════════ */
    --text-boxes-border-width: {{ settings.content_box_stroke_width | divided_by: 10.0 }}rem;
    --text-boxes-border-opacity: {{ settings.content_box_stroke_opacity | divided_by: 100.0 }};
    --text-boxes-radius: {{ settings.content_box_corner_radius | divided_by: 10.0 }}rem;
    --text-boxes-shadow-opacity: {{ settings.content_box_shadow_alpha | divided_by: 100.0 }};
    --text-boxes-shadow-horizontal-offset: {{ settings.content_box_shadow_offset_x | divided_by: 10.0 }}rem;
    --text-boxes-shadow-vertical-offset: {{ settings.content_box_shadow_offset_y | divided_by: 10.0 }}rem;
    --text-boxes-shadow-blur-radius: {{ settings.content_box_shadow_blur_radius | divided_by: 10.0 }}rem;

    /* ═══════════ POPUPS & DRAWERS ═══════════ */
    --popup-border-width: {{ settings.modal_stroke_width }}px;
    --popup-border-opacity: {{ settings.modal_stroke_opacity | divided_by: 100.0 }};
    --popup-corner-radius: {{ settings.modal_corner_radius }}px;
    --popup-shadow-opacity: {{ settings.modal_shadow_alpha | divided_by: 100.0 }};
    --popup-shadow-horizontal-offset: {{ settings.modal_shadow_offset_x }}px;
    --popup-shadow-vertical-offset: {{ settings.modal_shadow_offset_y }}px;
    --popup-shadow-blur-radius: {{ settings.modal_shadow_blur_radius }}px;

    --drawer-border-width: {{ settings.panel_stroke_width }}px;
    --drawer-border-opacity: {{ settings.panel_stroke_opacity | divided_by: 100.0 }};
    --drawer-shadow-opacity: {{ settings.panel_shadow_alpha | divided_by: 100.0 }};
    --drawer-shadow-horizontal-offset: {{ settings.panel_shadow_offset_x }}px;
    --drawer-shadow-vertical-offset: {{ settings.panel_shadow_offset_y }}px;
    --drawer-shadow-blur-radius: {{ settings.panel_shadow_blur_radius }}px;

    /* ═══════════ BADGES ═══════════ */
    --badge-corner-radius: {{ settings.badge_corner }}px;

    /* ═══════════ TRANSITIONS ═══════════ */
    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
    --transition-fast: 150ms var(--ease-out);
    --transition-base: 300ms var(--ease-out);
    --transition-slow: 500ms var(--ease-out);
    --duration-short: 100ms;
    --duration-default: 200ms;
    --duration-medium: 300ms;
    --duration-long: 500ms;

    /* ═══════════ Z-INDEX (unified scale) ═══════════ */
    --z-header: 49;
    --z-float: 90;
    --z-dropdown: 100;
    --z-sticky: 200;
    --z-toast: 900;
    --z-modal: 9000;
    --z-overlay: 9500;

    /* ═══════════ SHADOWS ═══════════ */
    --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.05);
    --shadow-md: 0 4px 6px rgba(0, 0, 0, 0.1);
    --shadow-lg: 0 10px 15px rgba(0, 0, 0, 0.1);
    --shadow-xl: 0 20px 25px rgba(0, 0, 0, 0.15);
    --shadow-float: 0 16px 40px rgba(0, 0, 0, 0.12);

    /* ═══════════ COMPONENT TOKENS (clean system, see DESIGN.md) ═══════════ */
    --btn-height: 3rem;
    --btn-padding-x: 1.75rem;
    --btn-font-size: 0.875rem;
    --btn-font-weight: 600;
    --btn-letter-spacing: 0.01em;
    --eyebrow-size: 0.75rem;
    --eyebrow-weight: 600;
    --eyebrow-tracking: 0.14em;
    --heading-tracking: -0.02em;
    --meta-size: 0.8125rem;

    /* ═══════════ ASPECT RATIOS ═══════════ */
    --aspect-ratio-product: 2 / 3;
    --aspect-ratio-collection: 1 / 1;
    --aspect-ratio-blog: 4 / 3;
    --aspect-ratio-article: 16 / 9;

    /* ═══════════ ALIASES (compat with existing CSS) ═══════════ */
    /* Color aliases */
    --color-overlay: var(--bg-overlay);
    --color-error-border: var(--color-error);
    --color-error-bg: color-mix(in srgb, var(--color-error) 10%, transparent);
    --color-success-border: var(--color-success);
    --color-success-bg: color-mix(in srgb, var(--color-success) 10%, transparent);
    --color-success-light: color-mix(in srgb, var(--color-success) 10%, transparent);

    /* Layout aliases */
    --header-height-sticky: var(--header-height);
    --arrow-offset: 0px;

    /* Font aliases (legacy naming) */
    --font-family-body: var(--font-body-family);
    --fs-xs: var(--font-xs);
    --line-height-base: var(--line-height-normal);

    /* Spacing extras */
    --space-2xs: 0.125rem;
    --space-5xl: 3rem;

    /* Radius extras */
    --radius-xl: 16px;

    /* Animation defaults */
    --marquee-duration: 30s;
    --read-more-height: 4.5em;
  }
  @media (max-width: 749px) {
    :root {
      --font-input: 16px;
    }
  }

  {%- if settings.type_accent_custom %}
  [class*="eyebrow"],
  .font-accent {
    font-family: var(--font-accent-family);
    font-style: var(--font-accent-style);
  }
  .font-accent { font-weight: var(--font-accent-weight); }
  {%- endif %}

  {%- liquid
    assign scheme_selectors = ':root'
    for scheme in settings.color_schemes
      assign scheme_selectors = scheme_selectors | append: ', .color-' | append: scheme.id
    endfor
  -%}
  {{ scheme_selectors }} {
    /* ═══════════ SEMANTIC COLORS (derived per color scheme) ═══════════ */
    --color-primary: rgb(var(--color-button));
    --color-primary-hover: rgba(var(--color-button), 0.85);
    --color-primary-rgb: var(--color-button);
    --color-secondary: rgb(var(--color-secondary-button-text));
    --color-text: rgb(var(--color-foreground));
    --color-paragraph: rgba(var(--color-foreground), max(0.75, var(--text-alpha-floor)));
    --color-bg: rgb(var(--color-background));
    --color-gray: rgba(var(--color-foreground), max(0.7, var(--text-alpha-floor)));
    --color-gray-light: rgba(var(--color-foreground), 0.06);
    --color-gray-lighter: rgba(var(--color-foreground), 0.03);
    --color-gray-dark: rgba(var(--color-foreground), max(0.7, var(--text-alpha-floor)));
    --color-border: rgb(var(--color-border-rgb));
    --color-info: rgb(var(--color-button));
    --border-color: var(--color-border);
    --color-bg-secondary: var(--color-gray-lighter);
    --color-body: var(--color-paragraph);
    --color-border-hover: rgba(var(--color-foreground), 0.3);
    --color-heading: var(--color-text);
    --color-text-secondary: var(--color-paragraph);
    --announcement-bg: var(--color-bg);
    --announcement-text: var(--color-text);
    --header-bg: var(--color-bg);
    --header-text: var(--color-text);
    --bg-footer: var(--color-bg);
    --color-ink: var(--color-text);
    --color-muted: var(--color-subtext-text);
    --color-hairline: var(--color-border);
    --color-primary-strong: color-mix(in srgb, rgb(var(--color-button)) 86%, #000);
    --color-selected: var(--color-text);
    --color-focus: var(--color-text);
    --card-border: var(--card-border-width) solid rgba(var(--color-foreground), var(--card-border-opacity));
    --card-shadow: var(--card-shadow-horizontal-offset) var(--card-shadow-vertical-offset) var(--card-shadow-blur-radius) rgba(var(--color-shadow), var(--card-shadow-opacity));
    --buttons-outline-border: rgba(var(--color-secondary-button-border), var(--buttons-border-opacity));
    --buttons-shadow: var(--buttons-shadow-horizontal-offset) var(--buttons-shadow-vertical-offset) var(--buttons-shadow-blur-radius) rgba(var(--color-shadow), var(--buttons-shadow-opacity));
    --inputs-border: var(--inputs-border-width) solid rgba(var(--color-border-rgb), var(--inputs-border-opacity));
    --inputs-shadow: var(--inputs-shadow-horizontal-offset) var(--inputs-shadow-vertical-offset) var(--inputs-shadow-blur-radius) rgba(var(--color-shadow), var(--inputs-shadow-opacity));
    --variant-pills-border: var(--variant-pills-border-width) solid rgba(var(--color-border-rgb), var(--variant-pills-border-opacity));
    --variant-pills-shadow: var(--variant-pills-shadow-horizontal-offset) var(--variant-pills-shadow-vertical-offset) var(--variant-pills-shadow-blur-radius) rgba(var(--color-shadow), var(--variant-pills-shadow-opacity));
    --media-border: var(--media-border-width) solid rgba(var(--color-border-rgb), var(--media-border-opacity));
    --media-shadow: var(--media-shadow-horizontal-offset) var(--media-shadow-vertical-offset) var(--media-shadow-blur-radius) rgba(var(--color-shadow), var(--media-shadow-opacity));
    --text-boxes-border: var(--text-boxes-border-width) solid rgba(var(--color-border-rgb), var(--text-boxes-border-opacity));
    --text-boxes-shadow: var(--text-boxes-shadow-horizontal-offset) var(--text-boxes-shadow-vertical-offset) var(--text-boxes-shadow-blur-radius) rgba(var(--color-shadow), var(--text-boxes-shadow-opacity));
    --popup-border: var(--popup-border-width) solid rgba(var(--color-border-rgb), var(--popup-border-opacity));
    --popup-shadow: var(--popup-shadow-horizontal-offset) var(--popup-shadow-vertical-offset) var(--popup-shadow-blur-radius) rgba(var(--color-shadow), var(--popup-shadow-opacity));
    --drawer-border: var(--drawer-border-width) solid rgba(var(--color-border-rgb), var(--drawer-border-opacity));
    --drawer-shadow: var(--drawer-shadow-horizontal-offset) var(--drawer-shadow-vertical-offset) var(--drawer-shadow-blur-radius) rgba(var(--color-shadow), var(--drawer-shadow-opacity));
  }
{% endstyle %}