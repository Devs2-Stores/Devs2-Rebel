{% doc %}
  @description Collection sort toolbar — filter button, product count, sort dropdown, view and density toggles
  @param {object} [results] - Collection or Search object. Default: collection
  @param {number} limit - Products per page (for count calculation)
  @param {object} paginate - Paginate object from {% paginate %} block
  @param {string} allowed_sort_options - Comma-separated list of allowed sort option values
  @param {boolean} [show_product_count] - Show product count. Default: true
  @param {boolean} [enable_sorting] - Show sort dropdown. Default: true
  @param {boolean} [enable_filtering] - Enable filtering. Default: true
  @param {string} [filter_layout] - Filter layout type (sidebar, modal or horizontal). Default: 'sidebar'
  @param {number} [active_filter_count] - Number of active filters shown as a badge on the filter button. Default: 0
  @param {boolean} [density_toggle] - Show the mobile one/two column toggle. Default: false
  @example {%- render 'collection-sort', limit: 20, paginate: paginate, allowed_sort_options: 'best-selling,price-ascending' -%}
{% enddoc %}

{%- liquid
  assign results = results | default: collection
  assign total_count = results.products_count | default: results.results_count | default: 0
  if results.products_count == nil and results.results != blank and paginate.pages == 1
    assign total_count = 0
    for item in results.results
      if item.object_type == 'product'
        assign total_count = total_count | plus: 1
      endif
    endfor
  endif
  assign t_showing = 'products.facets.showing' | t
  assign t_products_label = 'products.facets.products_label' | t
  assign t_sort_by = 'products.facets.sort_by_label' | t
  assign t_filter = 'products.facets.filter_button' | t

  if show_product_count == nil
    assign show_product_count = true
  endif
  if enable_sorting == nil
    assign enable_sorting = true
  endif
  if enable_filtering == nil
    assign enable_filtering = true
  endif
  if filter_layout == nil
    assign filter_layout = 'sidebar'
  endif
  assign active_filter_count = active_filter_count | default: 0
  assign sort_in_drawer = false
  if enable_filtering and enable_sorting
    assign sort_in_drawer = true
  endif
  assign filter_action = 'open-filter'
  if filter_layout == 'modal'
    assign filter_action = 'open-filter-modal'
  endif
-%}

<div class="collection-sort collection-sort--{{ filter_layout }}{% if enable_filtering %} collection-sort--has-filter{% endif %}{% if sort_in_drawer %} collection-sort--sort-in-drawer{% endif %}{% if density_toggle %} collection-sort--has-density{% endif %}">
  {%- if enable_filtering -%}
    <div class="collection-sort__filter-trigger">
      <button
        type="button"
        class="collection-sort__filter-btn"
        data-action="{{ filter_action }}"
        aria-label="{{ t_filter }}"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
        <span>{{ t_filter }}</span>
        {%- if active_filter_count > 0 -%}
          <span class="collection-template__filter-badge">{{ active_filter_count }}</span>
        {%- endif -%}
      </button>
    </div>
  {%- endif -%}

  {%- if show_product_count -%}
    <div class="collection-sort__count">
      {%- if total_count > 0 -%}
        {%- assign current_count = paginate.current_page | times: limit -%}
        {%- if current_count > total_count -%}
          {%- assign current_count = total_count -%}
        {%- endif -%}
        <span class="collection-sort__count-text">
          {{ t_showing }} <b>{{ current_count }}</b> / {{ total_count }} {{ t_products_label }}
        </span>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if enable_sorting -%}
    <div class="collection-sort__by">
      <label for="SortBy" class="collection-sort__label">{{ t_sort_by }}:</label>
      {%- render 'collection-sort-select', results: results, select_id: 'SortBy', allowed_sort_options: allowed_sort_options -%}
    </div>
  {%- endif -%}

  <div class="collection-sort__view">
    <button type="button" class="collection-sort__view-btn collection-sort__view-btn--active" data-view="grid" aria-label="{{ 'products.facets.grid_view' | t }}">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
    </button>
    <button type="button" class="collection-sort__view-btn" data-view="list" aria-label="{{ 'products.facets.list_view' | t }}">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
    </button>
  </div>

  {%- if density_toggle -%}
    <div class="collection-sort__density" role="group" aria-label="{{ 'products.facets.density_label' | t }}">
      <button type="button" class="collection-sort__view-btn collection-sort__density-btn" data-density="1" aria-pressed="false" aria-label="{{ 'products.facets.density_one' | t }}">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="4" width="14" height="16"/></svg>
      </button>
      <button type="button" class="collection-sort__view-btn collection-sort__density-btn" data-density="2" aria-pressed="false" aria-label="{{ 'products.facets.density_two' | t }}">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="7" height="16"/><rect x="14" y="4" width="7" height="16"/></svg>
      </button>
    </div>
  {%- endif -%}
</div>