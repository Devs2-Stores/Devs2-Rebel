{%- if settings.float_social_enable -%}
{{ 'float-social.css' | asset_url | stylesheet_tag }}
<script src="{{ 'float-social.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign panel_title = settings.float_social_title
  if panel_title == blank
    assign panel_title = 'general.social.panel_title' | t
  endif
  assign panel_subtitle = settings.float_social_subtitle
  if panel_subtitle == blank
    assign panel_subtitle = 'general.social.panel_subtitle' | t
  endif
  assign channels = 'hotline,facebook,messenger,tiktok,telegram,email,map,instagram,youtube' | split: ','
  assign channel_icons = 'icon-hotline,icon-facebook,icon-comments,icon-tiktok,icon-telegram,icon-email,icon-location,icon-instagram,icon-youtube' | split: ','
  assign item_index = 0
-%}
<float-social class="float-social" data-position="{{ settings.float_social_position | default: 'right' }}">
  <button type="button" class="float-social__toggle" aria-label="{{ 'general.social.contact' | t }}" aria-expanded="false" aria-controls="float-social-panel">
    <span class="float-social__toggle-icon">
      <svg class="icon" width="24" height="24" aria-hidden="true"><use href="#icon-comments" /></svg>
    </span>
    <span class="float-social__toggle-close">
      <svg class="icon" width="20" height="20" aria-hidden="true"><use href="#icon-close" /></svg>
    </span>
    <span class="float-social__badge"></span>
  </button>

  <div id="float-social-panel" class="float-social__panel" aria-hidden="true">
    <div class="float-social__header">
      <p class="float-social__title">{{ panel_title }}</p>
      {%- if panel_subtitle != blank -%}
        <p class="float-social__subtitle">{{ panel_subtitle }}</p>
      {%- endif -%}
    </div>
    <ul class="float-social__list">
      {%- for channel in channels -%}
        {%- liquid
          assign setting_prefix = 'float_' | append: channel
          assign enable_key = setting_prefix | append: '_enable'
          assign link_key = setting_prefix | append: '_link'
          assign channel_link = settings[link_key] | strip
        -%}
        {%- if settings[enable_key] and channel_link != blank -%}
          {%- liquid
            assign image_key = setting_prefix | append: '_image'
            assign text_key = setting_prefix | append: '_text'
            assign channel_image = settings[image_key]
            assign channel_label = settings[text_key]
            if channel_label == blank
              case channel
                when 'hotline'
                  assign channel_label = 'general.social.channels.hotline' | t
                when 'facebook'
                  assign channel_label = 'general.social.channels.facebook' | t
                when 'messenger'
                  assign channel_label = 'general.social.channels.messenger' | t
                when 'tiktok'
                  assign channel_label = 'general.social.channels.tiktok' | t
                when 'telegram'
                  assign channel_label = 'general.social.channels.telegram' | t
                when 'email'
                  assign channel_label = 'general.social.channels.email' | t
                when 'map'
                  assign channel_label = 'general.social.channels.map' | t
                when 'instagram'
                  assign channel_label = 'general.social.channels.instagram' | t
                when 'youtube'
                  assign channel_label = 'general.social.channels.youtube' | t
              endcase
            endif
            assign opens_new_window = true
            assign channel_href = channel_link
            if channel == 'hotline'
              assign opens_new_window = false
              assign channel_href = 'tel:' | append: channel_link
            elsif channel == 'email'
              assign opens_new_window = false
              assign channel_href = 'mailto:' | append: channel_link
            endif
          -%}
          <li class="float-social__item" style="--item-index: {{ item_index }};">
            <a
              href="{{ channel_href | escape }}"
              class="float-social__link float-social__link--{{ channel }}"
              {%- if opens_new_window %}
                target="_blank" rel="noopener noreferrer" aria-describedby="a11y-new-window-message"
              {%- endif %}
            >
              <span class="float-social__icon">
                {%- if channel_image != blank -%}
                  {{ channel_image | image_url: width: 56 | image_tag: widths: '28, 56', sizes: '28px', width: 28, height: 28, alt: '', loading: 'lazy', decoding: 'async' }}
                {%- else -%}
                  <svg class="icon" width="28" height="28" aria-hidden="true"><use href="#{{ channel_icons[forloop.index0] }}"/></svg>
                {%- endif -%}
              </span>
              <span class="float-social__text">{{ channel_label }}</span>
              <span class="float-social__arrow"><svg class="icon" width="14" height="14" aria-hidden="true"><use href="#icon-chevron-right" /></svg></span>
            </a>
          </li>
          {%- assign item_index = item_index | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</float-social>
{%- endif -%}
