{% doc %}
  @description Blog article card with image, title, meta, excerpt, tags and read-more
  @param {article} article - Article object (required)
  @param {string} [layout] - Card layout: grid or list. Default: 'grid'
  @param {string} [lazyload] - Loading strategy: lazy or eager. Default: 'lazy'
  @param {string} [fetchpriority] - Fetch priority: auto or high. Default: 'auto'
  @param {string} [image_shape] - Image shape: landscape, portrait, square, wide or auto. Default: 'landscape'
  @param {string} [image_alignment] - Image focal position: top, center or bottom. Default: 'center'
  @param {boolean} [show_date] - Show the publish date. Default: true
  @param {boolean} [show_author] - Show the author. Default: true
  @param {boolean} [show_excerpt] - Show the excerpt. Default: true
  @param {boolean} [show_read_more] - Show the read more link. Default: true
  @param {boolean} [show_comment_count] - Show the comment count. Default: false
  @param {boolean} [show_tags] - Show up to three article tags. Default: false
  @param {boolean} [show_category] - Show the blog title above the heading. Default: false
  @param {string} [heading_tag] - Heading element for the title: h2, h3 or h4. Default: 'h3'
  @example {% render 'article-card', article: article, show_tags: true %}
{% enddoc %}

{%- liquid
  assign layout = layout | default: 'grid'
  assign lazyload = lazyload | default: 'lazy'
  assign fetchpriority = fetchpriority | default: 'auto'
  assign image_shape = image_shape | default: 'landscape'
  assign image_alignment = image_alignment | default: 'center'
  assign show_date = show_date | default: true, allow_false: true
  assign show_author = show_author | default: true, allow_false: true
  assign show_excerpt = show_excerpt | default: true, allow_false: true
  assign show_read_more = show_read_more | default: true, allow_false: true
  assign show_comment_count = show_comment_count | default: false, allow_false: true
  assign show_tags = show_tags | default: false, allow_false: true
  assign show_category = show_category | default: false, allow_false: true
  assign title_tag = 'h3'
  if heading_tag == 'h2' or heading_tag == 'h4'
    assign title_tag = heading_tag
  endif

  assign card_class = 'article-card'
  if layout == 'list'
    assign card_class = card_class | append: ' article-card--list'
  endif
  assign card_class = card_class | append: ' article-card--shape-' | append: image_shape
  assign card_class = card_class | append: ' article-card--pos-' | append: image_alignment

  assign card_blog_handle = article.url | split: '/blogs/' | last | split: '/' | first
  assign card_blog = blogs[card_blog_handle]
-%}

<article class="{{ card_class }}">
  <div class="article-card__media">
    <div class="article-card__media-inner">
      {%- if article.image -%}
        {%- assign card_alt = article.image.alt | default: article.title | escape -%}
        {{-
          article.image
          | image_url: width: 720
          | image_tag:
            class: 'article-card__media-image',
            widths: '360,540,720,1080',
            sizes: '(max-width: 575px) calc(100vw - 2rem), (max-width: 1199px) calc(50vw - 2rem), calc(33vw - 2rem)',
            alt: card_alt,
            loading: lazyload,
            fetchpriority: fetchpriority
        -}}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'article-card__media-image article-card__media-image--placeholder' }}
      {%- endif -%}
    </div>
  </div>

  <div class="article-card__content">
    {%- if show_category and card_blog.title != blank -%}
      <div class="article-card__category">
        <a href="{{ card_blog.url | escape }}" class="article-card__category-link">
          {{ card_blog.title | escape }}
        </a>
      </div>
    {%- endif -%}

    <{{ title_tag }} class="article-card__title">
      <a href="{{ article.url | escape }}" title="{{ article.title | escape }}">{{ article.title | escape }}</a>
    </{{ title_tag }}>

    {%- if show_date or show_author or show_comment_count -%}
      <div class="article-card__meta">
        {%- if show_date -%}
          <span class="article-card__date">
            {%- render 'icon', name: 'calendar' -%}
            <time datetime="{{ article.published_at | date: '%Y-%m-%dT%H:%M' }}">
              {{- article.published_at | date: '%B %d, %Y' -}}
            </time>
          </span>
        {%- endif -%}
        {%- if show_author and article.author != blank -%}
          <span class="article-card__author">
            {%- render 'icon', name: 'user' -%}
            <span class="article-card__author-name">{{ article.author | escape }}</span>
          </span>
        {%- endif -%}
        {%- if show_comment_count and article.comments_count > 0 -%}
          <span class="article-card__comments">
            {%- render 'icon', name: 'comments' -%}
            <span>{{ article.comments_count }}</span>
          </span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if show_excerpt -%}
      <div class="article-card__description">
        {%- if article.excerpt_or_content != blank -%}
          {{ article.excerpt_or_content | strip_html | truncatewords: 25 | escape }}
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if show_tags and article.tags.size > 0 -%}
      <div class="article-card__tags">
        {%- for tag in article.tags limit: 3 -%}
          <a href="{{ card_blog.url | escape }}/tagged/{{ tag | handle }}" class="article-card__tag">{{ tag | escape }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if show_read_more -%}
      <div class="article-card__button" aria-hidden="true">
        <span class="article-card__read-more">
          {{ 'blogs.article.read_more' | t }}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
          </svg>
        </span>
      </div>
    {%- endif -%}
  </div>
</article>
