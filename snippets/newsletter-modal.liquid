{%- if settings.newsletter_modal_enable -%}
{{- 'newsletter-modal.css' | asset_url | stylesheet_tag -}}
<script src="{{ 'newsletter-modal.js' | asset_url }}" defer="defer"></script>
<newsletter-modal data-delay="{{ settings.newsletter_modal_delay }}" data-msg-email="{{ 'newsletter.error_email' | t | escape }}">
  <div id="newsletter-popup" role="dialog" aria-modal="true" aria-labelledby="newsletter-popup-title">
    <div class="newsletter-popup-wrapper color-{{ settings.newsletter_modal_color_scheme }}">
      {%- if settings.newsletter_modal_image != blank -%}
      <div class="newsletter-popup-banner">
        {%- assign newsletter_alt = settings.newsletter_modal_heading | escape -%}
        {{ settings.newsletter_modal_image | image_url: width: 600 | image_tag:
          alt: newsletter_alt,
          width: 900, height: 1400,
          loading: 'lazy', decoding: 'async'
        }}
      </div>
      {%- endif -%}
      <div class="newsletter-popup-content">
        <button type="button" data-action="close-newsletter-popup" class="newsletter-popup-close" aria-label="{{ 'accessibility.close' | t }}">
          {%- render 'icon', name: 'close' -%}
        </button>

        <h2 class="global-heading" id="newsletter-popup-title">{% if settings.newsletter_modal_heading != blank %}{{ settings.newsletter_modal_heading }}{% else %}{{ 'newsletter.button_label' | t }}{% endif %}</h2>
        <p class="global-content">{{ settings.newsletter_modal_description }}</p>
        {%- form 'customer', id: 'NewsletterPopupForm' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="form-group">
          <label>
            <span class="visually-hidden">{{ 'newsletter.label' | t }}</span>
            <input class="form-control newsletter-popup-input" title="{{ 'newsletter.label' | t }}" type="email" placeholder="{% if settings.newsletter_modal_placeholder != blank %}{{ settings.newsletter_modal_placeholder | escape }}{% else %}{{ 'newsletter.label' | t }}{% endif %}" name="contact[email]" required autocomplete="email" {% if form.errors %}aria-invalid="true" aria-describedby="NewsletterPopupError"{% endif %}>
          </label>
        </div>
        <div class="form-group">
          <button class="button-primary active newsletter-popup-submit" type="submit" title="{{ 'newsletter.button_label' | t }}">{% if settings.newsletter_modal_button != blank %}{{ settings.newsletter_modal_button | escape }}{% else %}{{ 'newsletter.button_label' | t }}{% endif %}</button>
        </div>
        {%- if form.posted_successfully? -%}
          <p class="newsletter-popup-message newsletter-popup-message--success" role="status" data-newsletter-result>{{ 'general.newsletter.success' | t }}</p>
        {%- elsif form.errors -%}
          <div class="newsletter-popup-message newsletter-popup-message--error" id="NewsletterPopupError" role="alert" data-newsletter-result>{{ form.errors | default_errors }}</div>
        {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</newsletter-modal>
{%- endif -%}