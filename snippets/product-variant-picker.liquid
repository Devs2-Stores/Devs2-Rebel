{%- doc -%}
  @description Product variant selector using button pills or native Category Swatches
  @param {boolean} [cross_out_unavailable=false] - Strike-through unavailable variants
{%- enddoc -%}
{%- assign cross_out_unavailable = cross_out_unavailable | default: false, allow_false: true -%}
{%- if product.variants.size > 1 -%}
{{ 'variant-picker.css' | asset_url | stylesheet_tag }}
<script src="{{ 'variant-picker.js' | asset_url }}" defer="defer"></script>
{%- assign size_guide_shown = false -%}
<product-variant-picker class="variant-picker-wrapper"{% if cross_out_unavailable %} data-cross-out-unavailable{% endif %}>
  <script type="application/json" id="main-product-json">{{ product | json }}</script>
  {%- for option in product.options_with_values -%}
    {%- liquid
      assign option_name_lower = option.name | downcase
      assign is_swatch_option = false
      if option_name_lower contains 'color' or option_name_lower contains 'colour' or option_name_lower contains 'pattern'
        assign is_swatch_option = true
      endif
      for val in option.values
        if val.swatch != blank
          assign is_swatch_option = true
          break
        endif
      endfor

      assign is_size_option = false
      if option_name_lower contains 'size'
        assign is_size_option = true
      endif
      assign option_position = 'option' | append: option.position
    -%}
    <product-variant-picker-item class="variant-picker" data-option-index="{{ forloop.index0 }}" data-option-name="{{ option.name | escape }}">
      <div class="variant-picker__label">
        {{ option.name }}:
        {%- if is_swatch_option -%}<span class="variant-picker__selected-value" data-selected-value>{{ option.selected_value }}</span>{%- endif -%}
        {%- if settings.product_size_guide_enable and size_guide_shown == false and is_size_option -%}
          {%- assign size_guide_shown = true -%}
          <button type="button" class="variant-picker__size-guide-btn" data-size-guide-trigger>
            {%- render 'icon', name: 'grid' -%}
            <span>{{ settings.product_size_guide_button | default: 'products.product.size_guide' | t }}</span>
          </button>
        {%- endif -%}
      </div>
      <div class="variant-picker__items" role="radiogroup" aria-label="{{ option.name | escape }}">
        {%- for value in option.values -%}
          {%- capture id -%}product-variant-picker-item-{{ option_position }}-{{ forloop.index }}{%- endcapture -%}
          {%- liquid
            assign has_native_swatch = false
            assign swatch_style = ''
            if value.swatch != blank
              assign has_native_swatch = true
              if value.swatch.image
                assign swatch_img_url = value.swatch.image | image_url: width: 80
                assign swatch_style = 'background-image: url(' | append: swatch_img_url | append: '); background-size: cover; background-position: center;'
              elsif value.swatch.color
                assign swatch_style = 'background-color: ' | append: value.swatch.color | append: ';'
              endif
            endif
          -%}
          <div class="variant-picker__item">
            <input
              type="radio"
              class="variant-picker__item-input"
              id="{{ id }}"
              name="product-variant-picker-item-{{ option_position }}"
              value="{{ value | escape }}"
              data-value="{{ value | escape }}"
              {% if value.selected %}checked{% endif %}
            >
            <label
              class="variant-picker__item-label{% if is_swatch_option %} variant-picker__item-label--image{% endif %}"
              for="{{ id }}"
              title="{{ value | escape }}"
              {% if swatch_style != '' %}style="{{ swatch_style }}"{% endif %}
            >
              {%- if is_swatch_option -%}
                {%- if has_native_swatch -%}
                  {%- render 'swatch', swatch: value.swatch -%}
                  <span class="visually-hidden">{{ value | escape }}</span>
                {%- else -%}
                  <product-variant-picker-image class="variant-picker__item-image" data-option="{{ option_position }}" data-value="{{ value | escape }}"></product-variant-picker-image>
                {%- endif -%}
              {%- else -%}
                <span>{{ value }}</span>
              {%- endif -%}
            </label>
          </div>
        {%- endfor -%}
      </div>
    </product-variant-picker-item>
  {%- endfor -%}
</product-variant-picker>
{%- endif -%}
