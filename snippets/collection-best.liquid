{% doc %}
  @description Best sellers carousel — reads block settings instead of orphan global settings
  @param {boolean} [enabled=true] - Show/hide best sellers
  @param {string} [title='Best Sellers'] - Section title
  @param {string} [source='current'] - 'current' collection or 'manual'
  @param {object} [manual_collection] - Collection object when source=manual
  @param {number} [limit=10] - Max products to show
  @param {number} [columns_mobile=2] - Number of products to show on mobile
  @param {number} [columns_desktop=4] - Number of products to show on desktop
  @example {%- render 'collection-best', enabled: block.settings.enabled, title: block.settings.title, source: block.settings.source, manual_collection: block.settings.manual_collection, limit: block.settings.limit, columns_mobile: block.settings.columns_mobile, columns_desktop: block.settings.columns_desktop -%}
{% enddoc %}

{%- liquid
  if enabled == nil
    assign enabled = true
  endif
  assign limit = limit | default: 10
  assign title = title | default: 'Best Sellers'
  assign source = source | default: 'current'
  assign columns_mobile = columns_mobile | default: 2
  assign columns_desktop = columns_desktop | default: 4
  assign columns_tablet = columns_tablet | default: columns_desktop
  assign columns_laptop = columns_laptop | default: columns_desktop
-%}

{%- if enabled -%}
  {%- liquid
    if source == 'manual' and manual_collection != blank
      assign target_collection = manual_collection
    else
      assign target_collection = collection
    endif
  -%}

  {%- if target_collection and target_collection.products_count > 0 -%}
    <collection-best class="collection-best">
      <div class="collection-best__header">
        <h2 class="collection-best__title">{{ title | escape }}</h2>
      </div>
      <div
        class="collection-best__content swiper"
        data-columns-mobile="{{ columns_mobile }}"
        data-columns-tablet="{{ columns_tablet }}"
        data-columns-laptop="{{ columns_laptop }}"
        data-columns-desktop="{{ columns_desktop }}"
        style="--swiper-cols-mobile: {{ columns_mobile }}; --swiper-cols-tablet: {{ columns_tablet }}; --swiper-cols-laptop: {{ columns_laptop }}; --swiper-cols-desktop: {{ columns_desktop }}; --swiper-gap-mobile: 10px; --swiper-gap-tablet: 15px; --swiper-gap-laptop: 20px; --swiper-gap-desktop: 20px;"
      >
        <div class="swiper-wrapper">
          {%- for product in target_collection.products limit: limit -%}
            <div class="swiper-slide">
              {%- render 'product-card', product: product -%}
            </div>
          {%- endfor -%}
        </div>
        <div class="swiper-pagination"></div>
      </div>
    </collection-best>
  {%- endif -%}
{%- endif -%}