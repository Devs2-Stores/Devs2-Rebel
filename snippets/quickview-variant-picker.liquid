{%- doc -%}
  @description Quickview product variant selector using button pills or native Category Swatches
{%- enddoc -%}

{%- if product.variants.size > 1 -%}
<quickview-variant-picker class="variant-picker-wrapper">
  {%- for option in product.options_with_values -%}
    {%- liquid
      assign option_name_lower = option.name | downcase
      assign is_swatch_option = false
      if option_name_lower contains 'color' or option_name_lower contains 'colour' or option_name_lower contains 'pattern'
        assign is_swatch_option = true
      endif
      for val in option.values
        if val.swatch != blank
          assign is_swatch_option = true
          break
        endif
      endfor
      assign option_position = 'option' | append: option.position
    -%}
    <quickview-variant-picker-item class="variant-picker" data-option-index="{{ forloop.index0 }}" data-option-name="{{ option.name | escape }}">
      <div class="variant-picker__label">
        {{ option.name }}:
        <span class="variant-picker__selected-value" data-selected-value>{{ option.selected_value }}</span>
      </div>
      <div class="variant-picker__items" role="radiogroup" aria-label="{{ option.name | escape }}">
        {%- for value in option.values -%}
          {%- capture id -%}quickview-variant-picker-item-{{ option_position }}-{{ forloop.index }}{%- endcapture -%}
          {%- liquid
            assign has_native_swatch = false
            assign swatch_style = ''
            if value.swatch != blank
              assign has_native_swatch = true
              if value.swatch.image
                assign swatch_img_url = value.swatch.image | image_url: width: 80
                assign swatch_style = 'background-image: url(' | append: swatch_img_url | append: '); background-size: cover; background-position: center;'
              elsif value.swatch.color
                assign swatch_style = 'background-color: ' | append: value.swatch.color | append: ';'
              endif
            endif
          -%}
          <div class="variant-picker__item">
            <input
              type="radio"
              class="variant-picker__item-input"
              id="{{ id }}"
              name="quickview-variant-picker-item-{{ option_position }}"
              value="{{ value | escape }}"
              data-value="{{ value | escape }}"
              {% if value.selected %}checked{% endif %}
            >
            <label
              class="variant-picker__item-label{% if is_swatch_option %} variant-picker__item-label--image{% endif %}"
              for="{{ id }}"
              title="{{ value | escape }}"
              {% if swatch_style != '' %}style="{{ swatch_style }}"{% endif %}
            >
              {%- if is_swatch_option -%}
                {%- if has_native_swatch -%}
                  <span class="visually-hidden">{{ value | escape }}</span>
                {%- else -%}
                  <quickview-variant-picker-image class="variant-picker__item-image" data-option="{{ option_position }}" data-value="{{ value | escape }}"></quickview-variant-picker-image>
                {%- endif -%}
              {%- else -%}
                <span>{{ value }}</span>
              {%- endif -%}
            </label>
          </div>
        {%- endfor -%}
      </div>
    </quickview-variant-picker-item>
  {%- endfor -%}
</quickview-variant-picker>
{%- endif -%}
