{% doc %}
  @description Collection card with image, title and product count
  @param {collection} collection - Collection object (required)
  @param {string} [image_shape] - Image shape: adapt, square, portrait, portrait-tall, landscape, landscape-wide. Default: 'square'
  @param {string} [image_position] - Image position: top-left, top-center, ..., bottom-right. Default: 'middle-center'
  @param {string} [card_heading_size] - Heading size: sm, md, lg. Default: 'md'
  @param {boolean} [show_product_count] - Show product count. Default: true
  @param {string} [columns_mobile] - Mobile column count (used for the sizes attribute). Default: '2'
  @param {number} [columns_desktop] - Desktop column count (used for the sizes attribute). Default: 3
  @param {string} [lazyload] - Loading strategy: lazy or eager. Default: 'lazy'
  @example {% render 'collection-card', collection: collection, image_shape: 'square' %}
{% enddoc %}

{%- liquid
  assign image_shape = image_shape | default: 'square'
  assign image_position = image_position | default: 'middle-center'
  assign card_heading_size = card_heading_size | default: 'md'
  assign show_product_count = show_product_count | default: true, allow_false: true
  assign columns_mobile = columns_mobile | default: '2'
  assign columns_desktop = columns_desktop | default: 3
  assign lazyload = lazyload | default: 'lazy'
  assign fetchpriority = fetchpriority | default: 'auto'
  assign collection_image = collection.image | default: collection.products.first.featured_image
  assign product_count = collection.products_count | default: collection.all_products_count
-%}

<a href="{{ collection.url | escape }}" class="collection-card" title="{{ collection.title | escape }}">
  <div class="collection-card__image image-shape image-shape--{{ image_shape }} image-position--{{ image_position }}">
    {%- if collection_image -%}
    {%- assign image_alt = collection_image.alt | default: collection.title | escape -%}
    {%- capture sizes_attr -%}(max-width: 749px) {% if columns_mobile == '1' %}100vw{% else %}50vw{% endif %}, calc(100vw / {{ columns_desktop }}){%- endcapture -%}
    {{
      collection_image
      | image_url: width: 1200
      | image_tag:
        widths: '400, 600, 800, 1200',
        sizes: sizes_attr,
        alt: image_alt,
        loading: lazyload,
        fetchpriority: fetchpriority,
        decoding: 'async'
    }}
    {%- else -%}
    <div class="collection-card__placeholder image-shape image-shape--{{ image_shape }}">
      {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
    {%- endif -%}
  </div>
  <div class="collection-card__info">
    <div class="collection-card__text">
      <h3 class="collection-card__title card-heading-size-{{ card_heading_size }}">{{ collection.title | escape }}</h3>
      {%- if show_product_count -%}
      <p class="collection-card__count">
        {%- if product_count == 0 -%}
          {{ 'sections.collection_list.no_products' | t }}
        {%- else -%}
          {{ 'sections.collection_list.product_count' | t: count: product_count }}
        {%- endif -%}
      </p>
      {%- endif -%}
    </div>
    <span class="collection-card__arrow" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M7 17 17 7"/><path d="M7 7h10v10"/>
      </svg>
    </span>
  </div>
</a>
