{%- doc -%}
  Renders the article table of contents. When `content` is passed, the entries are
  rendered on the server so the client build swaps in a box of the same size.

  @param {string} [content] - Article HTML to read h2/h3 headings from.
{%- enddoc -%}
{%- liquid
  assign toc_trigger_label = 'accessibility.open_menu' | t
  assign toc_label = settings.toc_title
  if toc_label == blank
    assign toc_label = 'blogs.article.table_of_contents' | t
  else
    assign toc_trigger_label = toc_trigger_label | append: ' ' | append: settings.toc_title
  endif
  assign toc_levels = settings.toc_heading_levels | default: 'h2h3'

  capture toc_items
    if content != blank
      assign toc_chunks = content | split: '<h'
      assign h2_count = 0
      assign h3_count = 0
      for chunk in toc_chunks offset: 1
        assign level = chunk | slice: 0
        assign after_level = chunk | slice: 1
        if after_level != '>' and after_level != ' '
          continue
        endif
        if level != '2' and level != '3'
          continue
        endif
        if level == '3' and toc_levels == 'h2'
          continue
        endif
        assign heading_html = chunk | split: '</h' | first
        assign open_tag = heading_html | split: '>' | first
        assign heading_text = heading_html | remove_first: open_tag | remove_first: '>' | strip_html | strip
        if heading_text == blank
          continue
        endif
        if settings.toc_show_numbers == true
          if level == '2'
            assign h2_count = h2_count | plus: 1
            assign h3_count = 0
            assign heading_text = h2_count | append: '. ' | append: heading_text
          else
            assign h3_count = h3_count | plus: 1
            assign heading_text = h2_count | append: '.' | append: h3_count | append: '. ' | append: heading_text
          endif
        endif
        echo '<li class="toc__item toc__item--h' | append: level | append: '"><span class="toc__link">' | append: heading_text | append: '</span></li>'
      endfor
    endif
  endcapture
-%}
{%- if content == blank or toc_items != blank -%}
{{ 'content-toc.css' | asset_url | stylesheet_tag }}
<script src="{{ 'content-toc.js' | asset_url }}" defer="defer"></script>
<content-toc class="toc{% if toc_items != blank %} toc--ready{% endif %} color-{{ settings.toc_color_scheme }}" role="navigation" aria-label="{{ toc_label | escape }}" aria-busy="true" data-heading-levels="{{ toc_levels }}"{% if settings.toc_show_numbers == true %} data-show-numbers{% endif %}{% if settings.toc_collapsed == true %} data-collapsible{% endif %}>
	{% if settings.toc_collapsed == true %}
		<button type="button" class="toc__title toc__toggle" aria-expanded="true">{{ toc_label | escape }}</button>
	{% else %}
		<div class="toc__title">{{ toc_label | escape }}</div>
	{% endif %}
	{%- if toc_items != blank -%}
		<ul class="toc__list">{{ toc_items }}</ul>
	{%- endif -%}
</content-toc>
{%- if settings.toc_floating_enable == true -%}
<toc-floating class="toc-floating" aria-label="{{ toc_label | escape }}">
	<div class="toc-floating__overlay"></div>
	<button type="button" class="toc-floating__trigger color-{{ settings.toc_color_scheme }}" aria-label="{{ toc_trigger_label | escape }}" aria-expanded="false" aria-controls="floating-table-of-contents">
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
	</button>
	<div id="floating-table-of-contents" class="toc-floating__panel color-{{ settings.toc_color_scheme }}" role="navigation" aria-label="{{ toc_label | escape }}">
		<div class="toc-floating__header">
			<span class="toc-floating__title">{{ toc_label | escape }}</span>
			<button type="button" class="toc-floating__close" aria-label="{{ 'accessibility.close' | t }}">&times;</button>
		</div>
	</div>
</toc-floating>
{%- endif -%}
{%- endif -%}
