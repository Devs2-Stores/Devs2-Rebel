<div class="password-content color-{{ section.settings.color_scheme }}">
  <h1 class="password-content__heading">{{ 'general.password_page.opening_soon' | t }}</h1>

  {%- if shop.password_message != blank -%}
    <div class="password-content__message rte">
      {{ shop.password_message }}
    </div>
  {%- endif -%}

  {%- if section.settings.show_newsletter -%}
    <div class="password-content__newsletter">
      <p class="password-content__newsletter-text">{{ 'general.password_page.signup_form_subtext' | t }}</p>
      {%- form 'customer', id: 'PasswordNewsletter' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,password-page">
        <div class="password-content__newsletter-form">
          <input
            type="email"
            name="contact[email]"
            id="password-email"
            class="password-content__newsletter-input"
            placeholder="{{ 'general.password_page.signup_form_email_placeholder' | t }}"
            required
            autocomplete="email"
            aria-label="{{ 'general.password_page.signup_form_email_label' | t }}"
          >
          <button type="submit" class="password-content__newsletter-btn button-primary active">
            {{ 'general.password_page.signup_form_button_label' | t }}
          </button>
        </div>
        {%- if form.posted_successfully? -%}
          <p class="password-content__newsletter-success" role="status">
            {{ 'general.password_page.signup_form_success' | t }}
          </p>
        {%- endif -%}
        {%- if form.errors -%}
          <p class="password-content__newsletter-error" role="alert">
            {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
          </p>
        {%- endif -%}
      {%- endform -%}
    </div>
  {%- endif -%}

  <div class="password-content__login">
    <details class="password-content__login-details">
      <summary class="password-content__login-toggle">
        {{ 'general.password_page.login_form_heading' | t }}
      </summary>
      <div class="password-content__login-form-wrapper">
        {%- form 'storefront_password', id: 'PasswordLogin' -%}
          {%- if form.errors -%}
            <p class="password-content__login-error" role="alert">
              {{ form.errors.messages['form'] }}
            </p>
          {%- endif -%}
          <div class="password-content__login-form">
            <input
              type="password"
              name="password"
              id="password-input"
              class="password-content__login-input"
              placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
              required
              aria-label="{{ 'general.password_page.login_form_password_label' | t }}"
            >
            <button type="submit" class="password-content__login-btn button-primary active">
              {{ 'general.password_page.login_form_submit' | t }}
            </button>
          </div>
        {%- endform -%}
      </div>
    </details>
  </div>
</div>

{% schema %}
{
  "name": "Password content",
  "tag": "section",
  "class": "section-password-content",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    }
  ]
}
{% endschema %}
