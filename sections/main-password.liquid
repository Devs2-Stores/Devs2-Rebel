<div class="password-content color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="password-content__inner">
      <h1 class="password-content__heading">{{ 'general.password_page.opening_soon' | t }}</h1>

      {%- if shop.password_message != blank -%}
        <div class="password-content__message rte">
          {{ shop.password_message }}
        </div>
      {%- endif -%}

      {%- if section.settings.show_newsletter -%}
        <div class="password-content__newsletter">
          <p class="password-content__newsletter-text">{{ 'general.password_page.signup_form_subtext' | t }}</p>
          {%- form 'customer', id: 'PasswordNewsletter' -%}
            <input type="hidden" name="contact[tags]" value="newsletter,password-page">
            <label class="visually-hidden" for="PasswordNewsletterEmail">
              {{- 'general.password_page.signup_form_email_label' | t -}}
            </label>
            <div class="password-content__field">
              <input
                type="email"
                name="contact[email]"
                id="PasswordNewsletterEmail"
                class="password-content__input"
                placeholder="{{ 'general.password_page.signup_form_email_placeholder' | t }}"
                required
                autocomplete="email"
                {% if form.errors %}
                  aria-invalid="true" aria-describedby="PasswordNewsletterError"
                {% endif %}
              >
              <button type="submit" class="password-content__submit button-primary active">
                {{ 'general.password_page.signup_form_button_label' | t }}
              </button>
            </div>
            {%- if form.posted_successfully? -%}
              <p class="password-content__success" role="status">
                {{ 'general.password_page.signup_form_success' | t }}
              </p>
            {%- endif -%}
            {%- if form.errors -%}
              <p class="password-content__error" id="PasswordNewsletterError" role="alert">
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </p>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}

      <div class="password-content__login">
        {%- form 'storefront_password', id: 'PasswordLogin' -%}
          <details class="password-content__login-details"{% if form.errors %} open{% endif %}>
            <summary class="password-content__login-toggle">
              {{ 'general.password_page.login_form_heading' | t }}
            </summary>
            <div class="password-content__login-body">
              <label class="visually-hidden" for="PasswordLoginInput">
                {{- 'general.password_page.login_form_password_label' | t -}}
              </label>
              <div class="password-content__field">
                <input
                  type="password"
                  name="password"
                  id="PasswordLoginInput"
                  class="password-content__input"
                  placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
                  required
                  autocomplete="current-password"
                  {% if form.errors %}
                    aria-invalid="true" aria-describedby="PasswordLoginError"
                  {% endif %}
                >
                <button type="submit" class="password-content__submit button-primary active">
                  {{ 'general.password_page.login_form_submit' | t }}
                </button>
              </div>
              {%- if form.errors -%}
                <p class="password-content__error" id="PasswordLoginError" role="alert">
                  {{ 'general.password_page.login_form_error' | t }}
                </p>
              {%- endif -%}
              <p class="password-content__admin">{{ 'general.password_page.admin_link_html' | t }}</p>
            </div>
          </details>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_password.name",
  "tag": "section",
  "class": "section-password-content",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:sections.main_password.settings.show_newsletter.label",
      "default": true
    }
  ]
}
{% endschema %}
