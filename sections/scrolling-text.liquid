{%- comment -%}
  Section: Scrolling Text Marquee
  Mô tả: Text chạy ngang vô hạn — tagline, thông báo, branding.
{%- endcomment -%}

{%- liquid
  assign speed = section.settings.speed
  assign separator = section.settings.separator
-%}

<div
  id="section-{{ section.id }}"
  class="section-marquee color-{{ section.settings.color_scheme }}"
  style="
    --mq-dt: {{ section.settings.padding_top_desktop }}px;
    --mq-db: {{ section.settings.padding_bottom_desktop }}px;
    --mq-mt: {{ section.settings.padding_top_mobile }}px;
    --mq-mb: {{ section.settings.padding_bottom_mobile }}px;
    --mq-speed: {{ speed }}s;
  "
>
  <div class="section-marquee__track">
    {%- for i in (1..3) -%}
      <div class="section-marquee__segment" aria-hidden="{% if i > 1 %}true{% else %}false{% endif %}">
        {%- for block in section.blocks -%}
          {%- if block.settings.text != blank -%}
            <span class="section-marquee__item heading-size-{{ section.settings.text_size }}" {{ block.shopify_attributes }}>
              {{- block.settings.text -}}
            </span>
            <span class="section-marquee__sep" aria-hidden="true">{{ separator }}</span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .section-marquee {
    padding-block: var(--mq-mt) var(--mq-mb);
    background: rgb(var(--color-background));
    overflow: hidden;
  }
  @media (min-width: 750px) {
    .section-marquee { padding-block: var(--mq-dt) var(--mq-db); }
  }

  @keyframes marquee-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-33.333%); }
  }

  .section-marquee__track {
    display: flex; width: fit-content;
    animation: marquee-scroll var(--mq-speed, 20s) linear infinite;
  }
  .section-marquee:hover .section-marquee__track {
    animation-play-state: paused;
  }

  .section-marquee__segment {
    display: flex; align-items: center; flex-shrink: 0;
  }

  .section-marquee__item {
    white-space: nowrap; color: rgb(var(--color-foreground));
    font-weight: var(--font-heading-weight, 700);
    font-family: var(--font-heading-family);
    line-height: 1;
  }

  .section-marquee__sep {
    margin: 0 1.5rem; color: rgb(var(--color-accent));
    font-size: 1.25rem; flex-shrink: 0;
  }
  @media (min-width: 750px) {
    .section-marquee__sep { margin: 0 2.5rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Scrolling text",
  "tag": "section",
  "class": "section-marquee-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Text size",
      "options": [
        {
          "value": "sm",
          "label": "S"
        },
        {
          "value": "md",
          "label": "M"
        },
        {
          "value": "lg",
          "label": "L"
        },
        {
          "value": "xl",
          "label": "XL"
        },
        {
          "value": "2xl",
          "label": "2XL"
        }
      ],
      "default": "xl"
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator",
      "default": "✦"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 5,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Speed",
      "default": 20
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom",
      "default": 20
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Top",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Bottom",
      "default": 10
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping on orders over $50"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Scrolling text",
      "category": "Custom",
      "blocks": [
        {
          "type": "text"
        },
        {
          "type": "text",
          "settings": {
            "text": "New arrivals every week"
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "Handcrafted with love"
          }
        }
      ]
    }
  ]
}
{% endschema %}
