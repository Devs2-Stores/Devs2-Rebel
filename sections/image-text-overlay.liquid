{%- comment %}
  Section: Image with Text Overlay
  Mô tả: Full-width image + text overlay trên ảnh (khác IWT 2 cột).
{% endcomment -%}

{%- liquid
  assign ito_alt = section.settings.heading_alt | default: section.settings.image.alt
  assign ito_mobile_alt = section.settings.heading_alt | default: section.settings.image_mobile.alt
-%}

<div
  id="section-{{ section.id }}"
  class="section-ito color-{{ section.settings.color_scheme }}"
  style="
    --ito-height: {{ section.settings.section_height }}vh;
    --ito-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  "
>
  {%- if section.settings.image_mobile != blank and section.settings.image != blank -%}
    <div class="section-ito__media section-ito__media--mobile">
      {{ section.settings.image_mobile | image_url: width: 750 | image_tag:
        loading: 'lazy', class: 'section-ito__img', alt: ito_mobile_alt
      }}
      <div class="section-ito__overlay"></div>
    </div>
  {%- endif -%}

  <div class="section-ito__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1920 | image_tag:
        widths: '750, 1080, 1440, 1920', sizes: '100vw',
        loading: 'lazy', class: 'section-ito__img', alt: ito_alt
      }}
    {%- elsif section.settings.image_mobile != blank -%}
      {{ section.settings.image_mobile | image_url: width: 750 | image_tag:
        loading: 'lazy', class: 'section-ito__img', alt: ito_mobile_alt
      }}
    {%- else -%}
      <div class="section-ito__placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {%- endif -%}
    <div class="section-ito__overlay"></div>
  </div>

  <div class="section-ito__content section-ito__content--{{ section.settings.content_position }}">
    <div class="{% if section.settings.section_width == 'fixed' %}page-width{% endif %}">
      <div class="section-ito__inner section-ito__inner--{{ section.settings.text_align }}" style="--ito-content-max-width: {{ section.settings.content_width }}rem;">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'subheading' -%}
              <p class="section-ito__subheading subheading-size-{{ block.settings.size }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
            {%- when 'heading' -%}
              <{{ block.settings.tag }} class="section-ito__heading heading-size-{{ block.settings.size }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</{{ block.settings.tag }}>
            {%- when 'text' -%}
              <div class="section-ito__text content-size-{{ block.settings.size }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- when 'button' -%}
              <div class="section-ito__buttons" {{ block.shopify_attributes }}>
                {%- if block.settings.label_1 != blank -%}
                  <a href="{{ block.settings.link_1 | default: '#' }}" class="section-ito__btn section-ito__btn--primary button-size-{{ block.settings.size }}">{{ block.settings.label_1 }}</a>
                {%- endif -%}
                {%- if block.settings.label_2 != blank -%}
                  <a href="{{ block.settings.link_2 | default: '#' }}" class="section-ito__btn section-ito__btn--secondary button-size-{{ block.settings.size }}">{{ block.settings.label_2 }}</a>
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
      {%- capture app_blocks -%}
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}{%- render block -%}{%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- if app_blocks != blank -%}
        <div class="section-apps">{{ app_blocks }}</div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .section-ito {
    position: relative; min-height: var(--ito-height, 60vh);
    display: flex; color: var(--color-white); overflow: hidden;
  }

  .section-ito__media { position: absolute; inset: 0; }
  .section-ito__media--mobile { display: none; }
  @media (max-width: 749px) {
    .section-ito__media--mobile + .section-ito__media:not(.section-ito__media--mobile) { display: none !important; }
    .section-ito__media--mobile { display: block; }
  }
  .section-ito__img { width: 100%; height: 100%; object-fit: cover; }
  .section-ito__placeholder {
    width: 100%; height: 100%;
    background: var(--color-black);
  }
  .section-ito__placeholder .placeholder-svg { width: 100%; height: 100%; object-fit: cover; fill: rgba(255, 255, 255, 0.35); }
  .section-ito__overlay {
    position: absolute; inset: 0;
    background: rgba(0, 0, 0, var(--ito-overlay, 0.3));
  }

  .section-ito__content {
    position: relative; z-index: 2; width: 100%;
    display: flex;
    padding: 3rem max(15px, calc((100% - var(--page-width, 1200px)) / 2 + 15px));
  }
  @media (min-width: 750px) {
    .section-ito__content {
      padding: 4rem max(30px, calc((100% - var(--page-width, 1200px)) / 2 + 30px));
    }
  }
  @media (min-width: 1024px) {
    .section-ito__content {
      padding: 4.5rem max(75px, calc((100% - var(--page-width, 1200px)) / 2 + 75px));
    }
  }
  .section-ito__content--top-left { align-items: flex-start; justify-content: flex-start; }
  .section-ito__content--top-center { align-items: flex-start; justify-content: center; }
  .section-ito__content--center-left { align-items: center; justify-content: flex-start; }
  .section-ito__content--center { align-items: center; justify-content: center; }
  .section-ito__content--center-right { align-items: center; justify-content: flex-end; }
  .section-ito__content--bottom-left { align-items: flex-end; justify-content: flex-start; }
  .section-ito__content--bottom-center { align-items: flex-end; justify-content: center; }

  .section-ito__inner { display: flex; flex-direction: column; gap: 0.875rem; max-width: var(--ito-content-max-width); }
  .section-ito__inner--left { text-align: left; }
  .section-ito__inner--center { text-align: center; align-items: center; }

  .section-ito__subheading {
    margin: 0;
    font-weight: var(--eyebrow-weight);
    letter-spacing: var(--eyebrow-tracking);
    text-transform: uppercase;
    color: var(--color-white);
  }
  .section-ito__heading {
    margin: 0;
    color: var(--color-white);
    line-height: 1.08;
    letter-spacing: var(--heading-tracking);
  }
  .section-ito__text {
    margin: 0;
    color: var(--color-white);
    line-height: 1.6;
    max-width: 60ch;
  }
  .section-ito__text p { margin: 0; }

  .section-ito__buttons { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 0.5rem; }
  .section-ito__inner--center .section-ito__buttons { justify-content: center; }

  .section-ito__btn {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: var(--btn-height);
    padding: 0 var(--btn-padding-x);
    font-size: var(--btn-font-size);
    font-weight: var(--btn-font-weight);
    letter-spacing: var(--btn-letter-spacing);
    text-decoration: none; border-radius: var(--buttons-radius, 0);
    cursor: pointer; transition: background-color var(--duration-default) ease, color var(--duration-default) ease, border-color var(--duration-default) ease;
  }
  .section-ito__btn:focus-visible { outline: 2px solid var(--color-white); outline-offset: 2px; }
  .section-ito__btn--primary { background: var(--color-white); color: var(--color-black); border: 1px solid var(--color-white); }
  .section-ito__btn--primary:hover { background: rgba(255, 255, 255, 0.88); border-color: rgba(255, 255, 255, 0.88); }
  .section-ito__btn--secondary { background: transparent; color: var(--color-white); border: 1px solid var(--color-white); }
  .section-ito__btn--secondary:hover { background: var(--color-white); color: var(--color-black); border-color: var(--color-white); }
{% endstylesheet %}

