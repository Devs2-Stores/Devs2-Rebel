          "id": "size",
          "label": "Size",
          "options": [
            {
              "value": "md",
              "label": "M"
            },
            {
              "value": "lg",
              "label": "L"
            }
          ],
          "default": "lg"
        }
      ]
    },
    {
      "type": "@app"
    }
