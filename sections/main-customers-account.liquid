{%- style -%}
  .section-main-customers-account { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
{%- endstyle -%}

<div class="account-template color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <h1 class="account-template__title">{{ 'customer.account.title' | t }}</h1>
    <div class="account-template__grid">
      <main class="account-template__orders-column">
        <section class="account-template__order" aria-labelledby="account-orders-title">
          <h2 id="account-orders-title" class="account-template__section-title"><i>{%- render 'icon', name: 'order' -%}</i>{{ 'customer.orders.title' | t }}</h2>
          {%- paginate customer.orders by 20 -%}
            {%- if customer.orders.size > 0 -%}
              <div class="account-template__order-table-wrapper">
                <table class="account-template__order-table">
                  <thead><tr><th scope="col">{{ 'customer.orders.order_number' | t }}</th><th scope="col">{{ 'customer.orders.date' | t }}</th><th scope="col">{{ 'customer.orders.payment_status' | t }}</th><th scope="col">{{ 'customer.orders.fulfillment_status' | t }}</th><th scope="col">{{ 'customer.orders.total' | t }}</th></tr></thead>
                  <tbody>{%- for order in customer.orders -%}<tr>
                    <td data-label="{{ 'customer.orders.order_number' | t }}"><a href="{{ order.customer_url }}" class="account-template__order-name" title="{{ 'customer.orders.view_order' | t }}: {{ order.name }}">{{ order.name }}</a></td>
                    <td data-label="{{ 'customer.orders.date' | t }}">{{ order.created_at | date: '%B %d, %Y' }}</td>
                    <td data-label="{{ 'customer.orders.payment_status' | t }}"><span class="account-template__status account-template__status--{{ order.financial_status }}">{{ order.financial_status_label }}</span></td>
                    <td data-label="{{ 'customer.orders.fulfillment_status' | t }}"><span class="account-template__status account-template__status--{{ order.fulfillment_status }}">{{ order.fulfillment_status_label }}</span></td>
                    <td data-label="{{ 'customer.orders.total' | t }}"><strong>{{ order.total_price | money }}</strong></td>
                  </tr>{%- endfor -%}</tbody>
                </table>
              </div>
              {%- if paginate.pages > 1 -%}<nav class="account-template__pagination" aria-label="{{ 'general.pagination.label' | t }}">{{ paginate | default_pagination }}</nav>{%- endif -%}
            {%- else -%}<div class="account-template__order-empty"><i>{%- render 'icon', name: 'sad' -%}</i><p>{{ 'customer.orders.none' | t }}</p><a href="{{ routes.all_products_collection_url }}" class="button-primary active" title="{{ 'general.continue_shopping' | t }}">{{ 'general.continue_shopping' | t }}</a></div>{%- endif -%}
          {%- endpaginate -%}
        </section>
      </main>
      <aside class="account-template__details-column">
        {%- render 'customer-sidebar' -%}
        <section class="account-template__wrapper" aria-labelledby="account-details-title">
          <div class="account-template__info">
            <h2 id="account-details-title" class="account-template__info-title"><i class="icon">{%- render 'icon', name: 'info' -%}</i>{{ 'customer.account.details' | t }}</h2>
            <ul class="account-template__info-list">
              <li><strong>{{ 'customer.account.name' | t }}:</strong> {{ customer.name }}</li>
              <li><strong>{{ 'customer.login_page.email' | t }}:</strong> {{ customer.email }}</li>
              {%- if customer.default_address -%}<li><strong>{{ 'customer.addresses.title' | t }}:</strong> {{ customer.default_address | format_address }}</li>{%- endif -%}
            </ul>
            <a href="{{ routes.account_addresses_url }}" class="button-primary active" title="{{ 'customer.addresses.manage' | t }}">{{ 'customer.addresses.manage' | t }}</a>
          </div>
        </section>
      </aside>
    </div>
  </div>
</div>

{% schema %}
{"name":"t:sections.main_customers_account.name","tag":"section","class":"section-main-customers-account","settings":[{"type":"color_scheme","id":"color_scheme","label":"t:sections.all.colors.label","default":"scheme-1"},{"type":"range","id":"padding_top","label":"t:sections.all.padding_top.label","min":0,"max":100,"step":4,"unit":"px","default":36},{"type":"range","id":"padding_bottom","label":"t:sections.all.padding_bottom.label","min":0,"max":100,"step":4,"unit":"px","default":36}]}
{% endschema %}
