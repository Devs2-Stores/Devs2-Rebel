{%- comment -%}
  Section: Image with Text Slider
  Mô tả: Image-with-text dạng slider nhiều slides — Swiper.
{%- endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-iwts color-{{ section.settings.color_scheme }}"
  style="
    --iwts-dt: {{ section.settings.padding_top_desktop }}px;
    --iwts-db: {{ section.settings.padding_bottom_desktop }}px;
    --iwts-mt: {{ section.settings.padding_top_mobile }}px;
    --iwts-mb: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-iwts__head">
        <{{ section.settings.heading_tag }} class="section-iwts__heading heading-size-{{ section.settings.heading_size }}">
          {{- section.settings.heading -}}
        </{{ section.settings.heading_tag }}>
      </div>
    {%- endif -%}

    <div class="swiper section-iwts__swiper" data-iwts-slider>
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          <div class="swiper-slide" {{ block.shopify_attributes }}>
            <div class="section-iwts__slide section-iwts__slide--{{ section.settings.image_position }}">
              <div class="section-iwts__media">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 800 | image_tag:
                    loading: 'lazy', class: 'section-iwts__img'
                  }}
                {%- else -%}
                  <div class="section-iwts__ph">{{ 'image' | placeholder_svg_tag }}</div>
                {%- endif -%}
              </div>
              <div class="section-iwts__content">
                {%- if block.settings.subheading != blank -%}
                  <p class="section-iwts__subheading subheading-size-sm">{{ block.settings.subheading }}</p>
                {%- endif -%}
                {%- if block.settings.heading != blank -%}
                  <h3 class="section-iwts__title heading-size-{{ block.settings.heading_size }}">{{ block.settings.heading }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="section-iwts__text content-size-md">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- if block.settings.button_label != blank -%}
                  <a href="{{ block.settings.button_link | default: '#' }}" class="section-iwts__btn section-iwts__btn--{{ block.settings.button_style }} button-size-md">
                    {{ block.settings.button_label }}
                  </a>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
      <div class="section-iwts__pagination" data-iwts-pagination></div>
    </div>

    <div class="section-iwts__nav">
      <button class="section-iwts__nav-btn section-iwts__prev" aria-label="{{ 'accessibility.previous_slide' | t }}">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <button class="section-iwts__nav-btn section-iwts__next" aria-label="{{ 'accessibility.next_slide' | t }}">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>
  </div>
</div>

<script>
(function() {
  if (typeof Swiper === 'undefined') return;
  var w = document.getElementById('section-{{ section.id }}');
  if (!w) return;
  new Swiper(w.querySelector('[data-iwts-slider]'), {
    slidesPerView: 1, spaceBetween: 20, speed: 600, loop: true,
    pagination: { el: w.querySelector('[data-iwts-pagination]'), clickable: true },
    navigation: { prevEl: w.querySelector('.section-iwts__prev'), nextEl: w.querySelector('.section-iwts__next') }
  });
})();
</script>

{% stylesheet %}
  .section-iwts {
    padding-block: var(--iwts-mt) var(--iwts-mb);
    background: rgb(var(--color-background));
    color: rgba(var(--color-foreground), 0.85);
  }
  @media (min-width: 750px) {
    .section-iwts { padding-block: var(--iwts-dt) var(--iwts-db); }
  }
  .section-iwts__head { text-align: center; margin-bottom: 2rem; }
  .section-iwts__heading { margin: 0; color: rgb(var(--color-foreground)); }

  .section-iwts__swiper { overflow: hidden; }

  .section-iwts__slide { display: grid; gap: 1.5rem; align-items: center; }
  @media (min-width: 750px) {
    .section-iwts__slide { grid-template-columns: 1fr 1fr; gap: 3rem; }
    .section-iwts__slide--right .section-iwts__media { order: 2; }
    .section-iwts__slide--right .section-iwts__content { order: 1; }
  }

  .section-iwts__media { border-radius: 0.75rem; overflow: hidden; }
  .section-iwts__img { width: 100%; height: auto; display: block; }
  .section-iwts__ph {
    aspect-ratio: 4/3; background: rgba(var(--color-foreground), 0.04);
    display: flex; align-items: center; justify-content: center;
  }
  .section-iwts__ph svg { width: 25%; opacity: 0.1; }

  .section-iwts__content { display: flex; flex-direction: column; gap: 0.75rem; }
  .section-iwts__subheading { margin: 0; text-transform: uppercase; letter-spacing: 0.12em; color: rgb(var(--color-accent)); font-weight: 600; }
  .section-iwts__title { margin: 0; color: rgb(var(--color-foreground)); line-height: 1.2; }
  .section-iwts__text { color: rgba(var(--color-foreground), 0.7); line-height: 1.7; }
  .section-iwts__text p { margin: 0; }

  .section-iwts__btn {
    display: inline-flex; align-items: center; justify-content: center;
    font-weight: 600; text-decoration: none; border-radius: var(--buttons-radius, 0);
    cursor: pointer; transition: opacity 0.2s; align-self: flex-start;
  }
  .section-iwts__btn:hover { opacity: 0.85; }
  .section-iwts__btn--primary { background: rgb(var(--color-button)); color: rgb(var(--color-button-text)); border: 1px solid rgb(var(--color-button)); }
  .section-iwts__btn--secondary { background: transparent; color: rgb(var(--color-foreground)); border: 1px solid rgba(var(--color-foreground), 0.3); }

  .section-iwts__pagination { text-align: center; margin-top: 1.5rem; }
  .section-iwts__pagination .swiper-pagination-bullet { background: rgba(var(--color-foreground), 0.2); }
  .section-iwts__pagination .swiper-pagination-bullet-active { background: rgb(var(--color-accent)); }

  .section-iwts__nav { display: flex; justify-content: center; gap: 0.5rem; margin-top: 1rem; }
  .section-iwts__nav-btn {
    width: 2.25rem; height: 2.25rem; border-radius: 50%;
    border: 1px solid rgba(var(--color-foreground), 0.15);
    background: rgb(var(--color-background)); cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    color: rgb(var(--color-foreground)); transition: border-color 0.3s;
  }
  .section-iwts__nav-btn:hover { border-color: rgb(var(--color-accent)); color: rgb(var(--color-accent)); }
{% endstylesheet %}

