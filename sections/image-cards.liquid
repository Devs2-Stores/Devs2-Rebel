{%- comment -%}
  Section: Image Cards
  Mô tả: Grid ảnh đơn giản + heading + link — flexible banner grid.
{%- endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-image-cards color-{{ section.settings.color_scheme }}"
  style="
    --ic-dt: {{ section.settings.padding_top_desktop }}px;
    --ic-db: {{ section.settings.padding_bottom_desktop }}px;
    --ic-mt: {{ section.settings.padding_top_mobile }}px;
    --ic-mb: {{ section.settings.padding_bottom_mobile }}px;
    --ic-cols-d: {{ section.settings.columns_desktop }};
    --ic-cols-m: {{ section.settings.columns_mobile }};
  "
>
  <div class="{% if section.settings.section_width == 'fixed' %}page-width{% endif %}">
    {%- if section.settings.heading != blank -%}
      <div class="section-image-cards__head page-width">
        {%- if section.settings.subheading != blank -%}
          <p class="section-image-cards__subheading subheading-size-{{ section.settings.subheading_size }}">{{ section.settings.subheading }}</p>
        {%- endif -%}
        <{{ section.settings.heading_tag }} class="section-image-cards__heading heading-size-{{ section.settings.heading_size }}">
          {{- section.settings.heading -}}
        </{{ section.settings.heading_tag }}>
      </div>
    {%- endif -%}

    <div class="section-image-cards__grid">
      {%- for block in section.blocks -%}
        <div class="section-image-cards__item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="section-image-cards__link">{%- endif -%}
            <div class="section-image-cards__media section-image-cards__media--{{ section.settings.image_ratio }}">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 800 | image_tag:
                  widths: '300, 450, 600, 800',
                  sizes: '(max-width: 749px) 50vw, 25vw',
                  loading: 'lazy', class: 'section-image-cards__img'
                }}
              {%- else -%}
                <div class="section-image-cards__ph">{{ 'image' | placeholder_svg_tag }}</div>
              {%- endif -%}
              {%- if section.settings.overlay_text -%}
                <div class="section-image-cards__overlay">
                  {%- if block.settings.heading != blank -%}
                    <h3 class="section-image-cards__card-heading">{{ block.settings.heading }}</h3>
                  {%- endif -%}
                  {%- if block.settings.subtext != blank -%}
                    <span class="section-image-cards__card-sub">{{ block.settings.subtext }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
            {%- unless section.settings.overlay_text -%}
              {%- if block.settings.heading != blank -%}
                <h3 class="section-image-cards__card-title">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.subtext != blank -%}
                <p class="section-image-cards__card-desc">{{ block.settings.subtext }}</p>
              {%- endif -%}
            {%- endunless -%}
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .section-image-cards {
    padding-block: var(--ic-mt) var(--ic-mb);
    background: rgb(var(--color-background));
  }
  @media (min-width: 750px) {
    .section-image-cards { padding-block: var(--ic-dt) var(--ic-db); }
  }
  .section-image-cards__head { text-align: center; margin-bottom: 2rem; }
  .section-image-cards__subheading { margin: 0 0 0.25rem; text-transform: uppercase; letter-spacing: 0.12em; color: rgb(var(--color-accent)); font-weight: 600; }
  .section-image-cards__heading { margin: 0; color: rgb(var(--color-foreground)); }

  .section-image-cards__grid {
    display: grid;
    grid-template-columns: repeat(var(--ic-cols-m, 1), 1fr);
    gap: 12px;
  }
  @media (min-width: 750px) {
    .section-image-cards__grid {
      grid-template-columns: repeat(var(--ic-cols-d, 3), 1fr);
      gap: 16px;
    }
  }

  .section-image-cards__link { display: block; text-decoration: none; color: inherit; }
  .section-image-cards__media {
    position: relative; overflow: hidden; border-radius: 0.5rem;
  }
  .section-image-cards__media--portrait { aspect-ratio: 3 / 4; }
  .section-image-cards__media--square { aspect-ratio: 1; }
  .section-image-cards__media--landscape { aspect-ratio: 16 / 9; }

  .section-image-cards__img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform 0.5s ease;
  }
  .section-image-cards__item:hover .section-image-cards__img { transform: scale(1.05); }

  .section-image-cards__ph {
    width: 100%; height: 100%; min-height: 200px;
    background: rgba(var(--color-foreground), 0.04);
    display: flex; align-items: center; justify-content: center;
  }
  .section-image-cards__ph svg { width: 30%; opacity: 0.1; }

  .section-image-cards__overlay {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 1rem;
    background: linear-gradient(rgba(0,0,0,0.1), rgba(0,0,0,0.4));
    color: #fff;
  }
  .section-image-cards__card-heading {
    margin: 0; font-size: 1.125rem; font-weight: 700;
    text-shadow: 0 1px 4px rgba(0,0,0,0.3);
  }
  .section-image-cards__card-sub {
    font-size: 0.8125rem; opacity: 0.85;
    text-shadow: 0 1px 2px rgba(0,0,0,0.3);
  }

  .section-image-cards__card-title {
    margin: 0.5rem 0 0; font-size: 0.9375rem; font-weight: 700;
    color: rgb(var(--color-foreground));
  }
  .section-image-cards__card-desc {
    margin: 0.125rem 0 0; font-size: 0.8125rem;
    color: rgba(var(--color-foreground), 0.6);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Image cards",
  "tag": "section",
  "class": "section-image-cards-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "subheading_size",
      "label": "Subheading size",
      "options": [
        {
          "value": "xs",
          "label": "XS"
        },
        {
          "value": "sm",
          "label": "S"
        }
      ],
      "default": "sm"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "sm",
          "label": "S"
        },
        {
          "value": "md",
          "label": "M"
        },
        {
          "value": "lg",
          "label": "L"
        }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Desktop columns",
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "portrait",
          "label": "Portrait (3:4)"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "landscape",
          "label": "Landscape (16:9)"
        }
      ],
      "default": "landscape"
    },
    {
      "type": "checkbox",
      "id": "overlay_text",
      "label": "Text on image overlay",
      "default": true
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "fixed",
          "label": "Fixed"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ],
      "default": "fixed"
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom",
      "default": 50
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Card heading"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext",
          "default": "Brief description"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Image cards",
      "category": "Image",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "heading": "New collection",
            "subtext": "Explore the latest styles"
          }
        },
        {
          "type": "card",
          "settings": {
            "heading": "Best sellers",
            "subtext": "Our most loved products"
          }
        },
        {
          "type": "card",
          "settings": {
            "heading": "Sale",
            "subtext": "Up to 50% off"
          }
        }
      ]
    }
  ]
}
{% endschema %}
