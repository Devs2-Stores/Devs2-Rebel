{%- comment %}
  Section: Instagram Feed
  Mô tả: Grid ảnh Instagram — dùng image blocks (không cần API bên ngoài).
{% endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-instagram color-{{ section.settings.color_scheme }}"
  style="
    --ig-dt: {{ section.settings.padding_top_desktop }}px;
    --ig-db: {{ section.settings.padding_bottom_desktop }}px;
    --ig-mt: {{ section.settings.padding_top_mobile }}px;
    --ig-mb: {{ section.settings.padding_bottom_mobile }}px;
    --ig-cols-d: {{ section.settings.columns_desktop }};
  "
>
  <div class="{% if section.settings.section_width == 'fixed' %}page-width{% endif %}">
    {%- if section.settings.heading != blank -%}
      <div class="section-instagram__head page-width">
        {%- if section.settings.subheading != blank -%}
          <p class="section-instagram__subheading subheading-size-sm">{{ section.settings.subheading }}</p>
        {%- endif -%}
        <{{ section.settings.heading_tag }} class="section-instagram__heading heading-size-{{ section.settings.heading_size }}">
          {{- section.settings.heading -}}
        </{{ section.settings.heading_tag }}>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="section-instagram__grid">
        {%- for block in section.blocks -%}
          <a
            href="{{ block.settings.link | default: section.settings.instagram_url | default: '#' }}"
            class="section-instagram__item"
            target="_blank" rel="noopener"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag:
                widths: '300, 400, 600', sizes: '(max-width: 749px) 33vw, 16vw',
                loading: 'lazy', decoding: 'async',
                class: 'section-instagram__img'
              }}
            {%- else -%}
              <div class="section-instagram__ph">
                {{ 'lifestyle-1' | placeholder_svg_tag }}
              </div>
            {%- endif -%}
            <div class="section-instagram__overlay">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.instagram_url != blank -%}
      <div class="section-instagram__follow page-width">
        <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" class="section-instagram__follow-link">
          {{ section.settings.follow_text | default: 'Follow us on Instagram' }}
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .section-instagram {
    padding-block: var(--ig-mt) var(--ig-mb);
    background: rgb(var(--color-background));
  }
  @media (min-width: 750px) {
    .section-instagram { padding-block: var(--ig-dt) var(--ig-db); }
  }
  .section-instagram__head { text-align: center; margin-bottom: 2rem; }
  .section-instagram__subheading { margin: 0 0 0.25rem; text-transform: uppercase; letter-spacing: 0.12em; color: rgb(var(--color-accent)); font-weight: 600; }
  .section-instagram__heading { margin: 0; color: rgb(var(--color-foreground)); }

  .section-instagram__grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px;
  }
  @media (min-width: 750px) {
    .section-instagram__grid {
      grid-template-columns: repeat(var(--ig-cols-d, 6), 1fr); gap: 6px;
    }
  }

  .section-instagram__item {
    position: relative; aspect-ratio: 1; overflow: hidden; display: block;
  }
  .section-instagram__img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.5s ease;
  }
  .section-instagram__item:hover .section-instagram__img { transform: scale(1.08); }

  .section-instagram__ph {
    width: 100%; height: 100%;
    background: rgba(var(--color-foreground), 0.04);
    display: flex; align-items: center; justify-content: center;
  }
  .section-instagram__ph svg { width: 40%; opacity: 0.1; }

  .section-instagram__overlay {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    background: rgba(0,0,0,0.35); opacity: 0; transition: opacity 0.3s; color: #fff;
  }
  .section-instagram__item:hover .section-instagram__overlay { opacity: 1; }

  .section-instagram__follow { text-align: center; margin-top: 1.5rem; }
  .section-instagram__follow-link {
    display: inline-flex; align-items: center; gap: 0.375rem;
    font-size: 0.875rem; font-weight: 700; color: rgb(var(--color-accent));
    transition: opacity 0.3s;
  }
  .section-instagram__follow-link:hover { opacity: 0.7; }
  .section-instagram__follow-link svg { transition: transform 0.3s; }
  .section-instagram__follow-link:hover svg { transform: translateX(3px); }
{% endstylesheet %}

{% schema %}
{
  "name": "Instagram feed",
  "tag": "section",
  "class": "section-instagram-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "@yourbrand"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Follow us on Instagram"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "sm",
          "label": "S"
        },
        {
          "value": "md",
          "label": "M"
        },
        {
          "value": "lg",
          "label": "L"
        }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 8,
      "step": 1,
      "label": "Desktop columns",
      "default": 6
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "fixed",
          "label": "Fixed"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ],
      "default": "full"
    },
    {
      "type": "header",
      "content": "Instagram"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram profile URL"
    },
    {
      "type": "text",
      "id": "follow_text",
      "label": "Follow button text",
      "default": "Follow us on Instagram"
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom",
      "default": 50
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional. Overrides profile URL."
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Instagram feed",
      "category": "Image",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}
