{%- comment %}
  Section: Team / About Us Grid
{% endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-team color-{{ section.settings.color_scheme }}"
  style="
    --team-dt: {{ section.settings.padding_top_desktop }}px;
    --team-db: {{ section.settings.padding_bottom_desktop }}px;
    --team-mt: {{ section.settings.padding_top_mobile }}px;
    --team-mb: {{ section.settings.padding_bottom_mobile }}px;
    --team-cols-d: {{ section.settings.columns_desktop }};
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-team__head">
        {%- if section.settings.subheading != blank -%}
          <p class="section-team__subheading subheading-size-{{ section.settings.subheading_size }}">{{ section.settings.subheading }}</p>
        {%- endif -%}
        <{{ section.settings.heading_tag }} class="section-team__heading heading-size-{{ section.settings.heading_size }}">
          {{- section.settings.heading -}}
        </{{ section.settings.heading_tag }}>
      </div>
    {%- endif -%}

    {%- assign member_count = section.blocks | where: 'type', 'member' | size -%}
    <div class="section-team__grid{% if member_count == 5 and section.settings.columns_desktop == 4 %} section-team__grid--five{% endif %}">
      {%- for block in section.blocks -%}
        <div class="section-team__member" {{ block.shopify_attributes }}>
          <div class="section-team__avatar-wrap">
            {%- if block.settings.image != blank -%}
              {%- assign avatar_alt = block.settings.image.alt | default: block.settings.name -%}
              {{ block.settings.image | image_url: width: 400 | image_tag:
                loading: 'lazy', class: 'section-team__avatar', alt: avatar_alt
              }}
            {%- else -%}
              <div class="section-team__avatar-ph">
                {{ block.settings.name | default: '?' | slice: 0 | upcase }}
              </div>
            {%- endif -%}
          </div>
          {%- if block.settings.name != blank -%}
            <h3 class="section-team__name">{{ block.settings.name }}</h3>
          {%- endif -%}
          {%- if block.settings.role != blank -%}
            <p class="section-team__role">{{ block.settings.role }}</p>
          {%- endif -%}
          {%- if block.settings.bio != blank -%}
            <p class="section-team__bio">{{ block.settings.bio }}</p>
          {%- endif -%}
          {%- if block.settings.social_1 != blank or block.settings.social_2 != blank -%}
            <div class="section-team__socials">
              {%- for i in (1..2) -%}
                {%- liquid
                  assign social_key = 'social_' | append: i
                  assign social_url = block.settings[social_key]
                  if social_url == blank
                    continue
                  endif
                  assign social_host = social_url | downcase | split: '//' | last | split: '/' | first | remove_first: 'www.'
                  assign social_icon = 'arrow'
                  assign social_platform = social_host
                  if social_host contains 'facebook.com'
                    assign social_icon = 'facebook'
                    assign social_platform = 'general.social.links.facebook' | t
                  elsif social_host contains 'instagram.com'
                    assign social_icon = 'instagram'
                    assign social_platform = 'general.social.links.instagram' | t
                  elsif social_host == 'x.com' or social_host contains 'twitter.com'
                    assign social_icon = 'twitter'
                    assign social_platform = 'general.social.links.twitter' | t
                  elsif social_host contains 'tiktok.com'
                    assign social_icon = 'tiktok'
                    assign social_platform = 'general.social.links.tiktok' | t
                  elsif social_host contains 'youtube.com' or social_host == 'youtu.be'
                    assign social_icon = 'youtube'
                    assign social_platform = 'general.social.links.youtube' | t
                  elsif social_host contains 'linkedin.com'
                    assign social_icon = 'linkedin'
                    assign social_platform = 'general.social.links.linkedin' | t
                  elsif social_host contains 'pinterest.'
                    assign social_icon = 'pinterest'
                    assign social_platform = 'general.social.links.pinterest' | t
                  endif
                  if block.settings.name != blank
                    assign social_label = 'sections.team.follow_member' | t: name: block.settings.name, platform: social_platform
                  else
                    assign social_label = 'general.social.follow_on' | t: platform: social_platform
                  endif
                -%}
                <a href="{{ social_url }}" target="_blank" rel="noopener" class="section-team__social-link" aria-label="{{ social_label | escape }}">
                  {%- render 'icon', name: social_icon -%}
                </a>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .section-team {
    padding-block: var(--team-mt) var(--team-mb);
    background: rgb(var(--color-background));
    color: rgba(var(--color-foreground), 0.85);
  }
  @media (min-width: 750px) {
    .section-team { padding-block: var(--team-dt) var(--team-db); }
  }
  .section-team__head { text-align: center; margin-bottom: var(--section-head-gap); }
  .section-team__subheading {
    margin: 0 0 0.5rem;
    font-weight: var(--eyebrow-weight);
    letter-spacing: var(--eyebrow-tracking);
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .section-team__heading {
    margin: 0;
    color: var(--color-ink);
    letter-spacing: var(--heading-tracking);
  }

  .section-team__grid {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem;
    text-align: center;
  }
  @media (min-width: 750px) {
    .section-team__grid {
      grid-template-columns: repeat(var(--team-cols-d, 4), 1fr); gap: 2rem;
    }
    .section-team__grid--five .section-team__member:last-child { grid-column: 2 / span 2; }
  }

  .section-team__member { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
  .section-team__avatar-wrap { width: 120px; height: 120px; border-radius: 50%; overflow: hidden; flex-shrink: 0; margin-bottom: 0.25rem; }
  @media (min-width: 750px) {
    .section-team__avatar-wrap { width: 150px; height: 150px; }
  }
  .section-team__avatar { width: 100%; height: 100%; object-fit: cover; }
  .section-team__avatar-ph {
    width: 100%; height: 100%;
    background: rgba(var(--color-foreground), 0.06);
    display: flex; align-items: center; justify-content: center;
    font-size: 2rem; font-weight: 700; color: rgba(var(--color-foreground), 0.2);
  }

  .section-team__name { margin: 0; font-size: 1rem; font-weight: 600; color: var(--color-ink); }
  .section-team__role {
    margin: 0;
    font-size: var(--eyebrow-size);
    font-weight: var(--eyebrow-weight);
    letter-spacing: var(--eyebrow-tracking);
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .section-team__bio { margin: 0; font-size: 0.875rem; color: var(--color-muted); line-height: 1.6; max-width: 20rem; }

  .section-team__socials { display: flex; gap: 0.5rem; margin-top: 0.5rem; }
  .section-team__social-link {
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.5rem; height: 2.5rem;
    border-radius: var(--buttons-radius, 0);
    border: 1px solid var(--color-hairline);
    background: transparent;
    color: var(--color-ink);
    transition: color var(--duration-default) ease, background-color var(--duration-default) ease, border-color var(--duration-default) ease;
  }
  .section-team__social-link svg { width: 16px; height: 16px; }
  .section-team__social-link:hover {
    color: rgb(var(--color-background));
    border-color: var(--color-ink);
    background: var(--color-ink);
  }
  .section-team__social-link:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.team.name",
  "tag": "section",
  "class": "section-team-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.team.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.team.settings.header__heading.content"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:sections.team.settings.subheading.label"
    },
    {
      "type": "select",
      "id": "subheading_size",
      "label": "t:sections.team.settings.subheading_size.label",
      "options": [
        {
          "value": "xs",
          "label": "t:sections.team.settings.subheading_size.options.xs"
        },
        {
          "value": "sm",
          "label": "t:sections.team.settings.subheading_size.options.sm"
        },
        {
          "value": "md",
          "label": "t:sections.team.settings.subheading_size.options.md"
        }
      ],
      "default": "sm"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.team.settings.heading.label",
      "default": "t:sections.team.settings.heading.default"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.team.settings.heading_size.label",
      "options": [
        {
          "value": "sm",
          "label": "t:sections.team.settings.heading_size.options.sm"
        },
        {
          "value": "md",
          "label": "t:sections.team.settings.heading_size.options.md"
        },
        {
          "value": "lg",
          "label": "t:sections.team.settings.heading_size.options.lg"
        },
        {
          "value": "xl",
          "label": "t:sections.team.settings.heading_size.options.xl"
        }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.team.settings.heading_tag.label",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.team.settings.heading_tag.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.team.settings.heading_tag.options.h3"
        }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "t:sections.team.settings.header__layout.content"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "t:sections.team.settings.columns_desktop.label",
      "default": 4
    },
    {
      "type": "header",
      "content": "t:sections.team.settings.header__desktop_spacing.content"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "t:sections.team.settings.padding_top_desktop.label",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "t:sections.team.settings.padding_bottom_desktop.label",
      "default": 50
    },
    {
      "type": "header",
      "content": "t:sections.team.settings.header__mobile_spacing.content"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:sections.team.settings.padding_top_mobile.label",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:sections.team.settings.padding_bottom_mobile.label",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "t:sections.team.blocks.member.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.team.blocks.member.settings.image.label"
        },
        {
          "type": "text",
          "id": "name",
          "label": "t:sections.team.blocks.member.settings.name.label",
          "default": "t:sections.team.blocks.member.settings.name.default"
        },
        {
          "type": "text",
          "id": "role",
          "label": "t:sections.team.blocks.member.settings.role.label",
          "default": "t:sections.team.blocks.member.settings.role.default"
        },
        {
          "type": "text",
          "id": "bio",
          "label": "t:sections.team.blocks.member.settings.bio.label"
        },
        {
          "type": "url",
          "id": "social_1",
          "label": "t:sections.team.blocks.member.settings.social_1.label"
        },
        {
          "type": "url",
          "id": "social_2",
          "label": "t:sections.team.blocks.member.settings.social_2.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.team.presets.team.name",
      "category": "Custom",
      "blocks": [
        {
          "type": "member"
        },
        {
          "type": "member"
        },
        {
          "type": "member"
        },
        {
          "type": "member"
        }
      ]
    }
  ]
}
{% endschema %}
