{{ 'section-newsletter.css' | asset_url | stylesheet_tag }}
{%- comment %}
  Section: Newsletter
  Newsletter signup form.
{% endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-newsletter color-{{ section.settings.color_scheme }}"
  style="
    --nl-dt: {{ section.settings.padding_top_desktop }}px;
    --nl-db: {{ section.settings.padding_bottom_desktop }}px;
    --nl-mt: {{ section.settings.padding_top_mobile }}px;
    --nl-mb: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="page-width">
    <div class="section-newsletter__inner section-newsletter__inner--{{ section.settings.text_align }}">
      {%- if section.settings.subheading != blank -%}
        <p class="section-newsletter__subheading subheading-size-{{ section.settings.subheading_size }}">
          {{- section.settings.subheading -}}
        </p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <{{ section.settings.heading_tag }}
          class="section-newsletter__heading heading-size-{{ section.settings.heading_size }}"
        >
          {{- section.settings.heading -}}
        </{{ section.settings.heading_tag }}>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="section-newsletter__desc content-size-{{ section.settings.description_size }}">
          {{- section.settings.description -}}
        </div>
      {%- endif -%}

      {%- form 'customer', id: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="section-newsletter__form">
          <input
            type="email"
            name="contact[email]"
            class="section-newsletter__input"
            placeholder="{{ 'general.newsletter.email_placeholder' | t }}"
            required
            autocomplete="email"
            aria-label="{{ 'general.newsletter.email_label' | t }}"
          >
          <button type="submit" class="section-newsletter__btn button-size-{{ section.settings.button_size }}">
            {%- liquid
              assign submit_label = section.settings.button_label
              if submit_label == blank
                assign submit_label = 'newsletter.button_label' | t
              endif
            -%}
            {{ submit_label | escape }}
          </button>
        </div>
        {%- if form.posted_successfully? -%}
          <p class="section-newsletter__success">
            {{ 'general.newsletter.success' | t }}
          </p>
        {%- endif -%}
        {%- if form.errors -%}
          <p class="section-newsletter__error">
            {{ form.errors.messages['email'] }}
          </p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>


{% schema %}
{
  "name": "t:sections.newsletter.name",
  "tag": "section",
  "class": "section-newsletter-wrapper",
  "limit": 1,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.newsletter.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.newsletter.settings.header__content.content"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:sections.newsletter.settings.subheading.label"
    },
    {
      "type": "select",
      "id": "subheading_size",
      "label": "t:sections.newsletter.settings.subheading_size.label",
      "options": [
        {
          "value": "xs",
          "label": "t:sections.newsletter.settings.subheading_size.options.xs"
        },
        {
          "value": "sm",
          "label": "t:sections.newsletter.settings.subheading_size.options.sm"
        },
        {
          "value": "md",
          "label": "t:sections.newsletter.settings.subheading_size.options.md"
        }
      ],
      "default": "sm"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.newsletter.settings.heading.label",
      "default": "t:sections.newsletter.settings.heading.default"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.newsletter.settings.heading_size.label",
      "options": [
        {
          "value": "sm",
          "label": "t:sections.newsletter.settings.heading_size.options.sm"
        },
        {
          "value": "md",
          "label": "t:sections.newsletter.settings.heading_size.options.md"
        },
        {
          "value": "lg",
          "label": "t:sections.newsletter.settings.heading_size.options.lg"
        },
        {
          "value": "xl",
          "label": "t:sections.newsletter.settings.heading_size.options.xl"
        }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.newsletter.settings.heading_tag.label",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.newsletter.settings.heading_tag.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.newsletter.settings.heading_tag.options.h3"
        }
      ],
      "default": "h2"
    },
    {
      "type": "inline_richtext",
      "id": "description",
      "label": "t:sections.newsletter.settings.description.label",
      "default": "t:sections.newsletter.settings.description.default"
    },
    {
      "type": "select",
      "id": "description_size",
      "label": "t:sections.newsletter.settings.description_size.label",
      "options": [
        {
          "value": "sm",
          "label": "t:sections.newsletter.settings.description_size.options.sm"
        },
        {
          "value": "md",
          "label": "t:sections.newsletter.settings.description_size.options.md"
        },
        {
          "value": "lg",
          "label": "t:sections.newsletter.settings.description_size.options.lg"
        }
      ],
      "default": "md"
    },
    {
      "type": "header",
      "content": "t:sections.newsletter.settings.header__form.content"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.newsletter.settings.button_label.label",
      "default": "t:sections.newsletter.settings.button_label.default"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "t:sections.newsletter.settings.button_size.label",
      "options": [
        {
          "value": "sm",
          "label": "t:sections.newsletter.settings.button_size.options.sm"
        },
        {
          "value": "md",
          "label": "t:sections.newsletter.settings.button_size.options.md"
        },
        {
          "value": "lg",
          "label": "t:sections.newsletter.settings.button_size.options.lg"
        }
      ],
      "default": "md"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "t:sections.newsletter.settings.text_align.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.newsletter.settings.text_align.options.left"
        },
        {
          "value": "center",
          "label": "t:sections.newsletter.settings.text_align.options.center"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:sections.newsletter.settings.header__desktop_spacing.content"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "t:sections.newsletter.settings.padding_top_desktop.label",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "t:sections.newsletter.settings.padding_bottom_desktop.label",
      "default": 50
    },
    {
      "type": "header",
      "content": "t:sections.newsletter.settings.header__mobile_spacing.content"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:sections.newsletter.settings.padding_top_mobile.label",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:sections.newsletter.settings.padding_bottom_mobile.label",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "t:sections.newsletter.presets.newsletter.name",
      "category": "t:categories.forms"
    }
  ]
}
{% endschema %}
