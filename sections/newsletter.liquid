{%- comment %}
  Section: Newsletter
  Newsletter signup form.
{% endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-newsletter color-{{ section.settings.color_scheme }}"
  style="
    --nl-dt: {{ section.settings.padding_top_desktop }}px;
    --nl-db: {{ section.settings.padding_bottom_desktop }}px;
    --nl-mt: {{ section.settings.padding_top_mobile }}px;
    --nl-mb: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="page-width">
    <div class="section-newsletter__inner section-newsletter__inner--{{ section.settings.text_align }}">
      {%- if section.settings.subheading != blank -%}
        <p class="section-newsletter__subheading subheading-size-{{ section.settings.subheading_size }}">
          {{- section.settings.subheading -}}
        </p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <{{ section.settings.heading_tag }}
          class="section-newsletter__heading heading-size-{{ section.settings.heading_size }}"
        >
          {{- section.settings.heading -}}
        </{{ section.settings.heading_tag }}>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="section-newsletter__desc content-size-{{ section.settings.description_size }}">
          {{- section.settings.description -}}
        </div>
      {%- endif -%}

      {%- form 'customer', id: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="section-newsletter__form">
          <input
            type="email"
            name="contact[email]"
            class="section-newsletter__input"
            placeholder="{{ 'general.newsletter.email_placeholder' | t }}"
            required
            autocomplete="email"
            aria-label="{{ 'general.newsletter.email_label' | t }}"
          >
          <button type="submit" class="section-newsletter__btn button-size-{{ section.settings.button_size }}">
            {%- liquid
              assign submit_label = section.settings.button_label
              if submit_label == blank
                assign submit_label = 'newsletter.button_label' | t
              endif
            -%}
            {{ submit_label | escape }}
          </button>
        </div>
        {%- if form.posted_successfully? -%}
          <p class="section-newsletter__success">
            {{ 'general.newsletter.success' | t }}
          </p>
        {%- endif -%}
        {%- if form.errors -%}
          <p class="section-newsletter__error">
            {{ form.errors.messages['email'] }}
          </p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .section-newsletter {
    padding-block: var(--nl-mt) var(--nl-mb);
    background: rgb(var(--color-background));
    color: rgba(var(--color-foreground), 0.85);
  }
  @media (min-width: 750px) {
    .section-newsletter { padding-block: var(--nl-dt) var(--nl-db); }
  }

  .section-newsletter__inner {
    width: 100%; max-width: 36rem; display: flex; flex-direction: column; gap: 0.75rem;
  }
  .section-newsletter__inner--left { text-align: left; }
  .section-newsletter__inner--center { text-align: center; margin: 0 auto; align-items: center; }

  .section-newsletter__subheading {
    margin: 0;
    font-weight: var(--eyebrow-weight);
    letter-spacing: var(--eyebrow-tracking);
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .section-newsletter__heading {
    margin: 0;
    color: var(--color-ink);
    line-height: 1.15;
    letter-spacing: var(--heading-tracking);
  }
  .section-newsletter__desc {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.6;
    max-width: 52ch;
  }

  .section-newsletter__form {
    display: flex; gap: 0; margin-top: 0.75rem;
    width: min(100%, 32rem);
    max-width: 100%;
    border: var(--inputs-border);
    border-radius: var(--inputs-radius);
    box-shadow: var(--inputs-shadow);
    overflow: hidden;
    transition: border-color var(--duration-default) ease;
  }
  .section-newsletter__form:focus-within {
    border-color: var(--color-ink);
  }
  .section-newsletter__form:has(:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .section-newsletter__input {
    flex: 1; border: none;
    outline: 2px solid transparent;
    outline-offset: -2px;
    min-width: 0;
    min-height: var(--btn-height);
    padding: 0 1rem;
    font-size: 0.9375rem;
    background: transparent;
    color: var(--color-ink);
    font-family: inherit;
  }
  .section-newsletter__input::placeholder {
    color: var(--color-muted);
  }

  .section-newsletter__input:focus-visible {
    outline: none;
  }

  .section-newsletter__btn {
    min-height: var(--btn-height);
    padding: 0 var(--btn-padding-x);
    font-size: var(--btn-font-size);
    font-weight: var(--btn-font-weight);
    letter-spacing: var(--btn-letter-spacing);
    background: var(--color-primary);
    color: rgb(var(--color-button-text));
    border: none; cursor: pointer;
    white-space: nowrap;
    transition: background-color var(--duration-default) ease, color var(--duration-default) ease;
    border-radius: var(--buttons-radius, 0);
  }
  .section-newsletter__btn:hover {
    background: var(--color-primary-strong);
    color: rgb(var(--color-button-text));
  }
  @media (max-width: 576px) {
    .section-newsletter__form {
      flex-direction: column;
      width: 100%;
    }
    .section-newsletter__input,
    .section-newsletter__btn {
      width: 100%;
    }
  }

  .section-newsletter__success {
    margin: 0.5rem 0 0; font-size: 0.875rem; color: var(--color-success-text);
  }
  .section-newsletter__error {
    margin: 0.5rem 0 0; font-size: 0.875rem; color: var(--color-error-text);
  }
{% endstylesheet %}

