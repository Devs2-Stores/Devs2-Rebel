{%- comment %}
  Section: Layered Images with Text
  Mô tả: 2-3 ảnh xếp chồng lệch + text bên cạnh. Subtle depth effect.
{% endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-layered color-{{ section.settings.color_scheme }}"
  style="
    --ly-dt: {{ section.settings.padding_top_desktop }}px;
    --ly-db: {{ section.settings.padding_bottom_desktop }}px;
    --ly-mt: {{ section.settings.padding_top_mobile }}px;
    --ly-mb: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="page-width">
    <div class="section-layered__grid section-layered__grid--{{ section.settings.image_position }}">
      {%- comment %} Layered images {% endcomment -%}
      <div class="section-layered__images">
        {%- if section.settings.image_1 != blank -%}
          <div class="section-layered__layer section-layered__layer--1">
            {{ section.settings.image_1 | image_url: width: 600 | image_tag:
              loading: 'lazy', class: 'section-layered__img'
            }}
          </div>
        {%- endif -%}
        {%- if section.settings.image_2 != blank -%}
          <div class="section-layered__layer section-layered__layer--2">
            {{ section.settings.image_2 | image_url: width: 400 | image_tag:
              loading: 'lazy', class: 'section-layered__img'
            }}
          </div>
        {%- endif -%}
        {%- if section.settings.image_3 != blank -%}
          <div class="section-layered__layer section-layered__layer--3">
            {{ section.settings.image_3 | image_url: width: 300 | image_tag:
              loading: 'lazy', class: 'section-layered__img'
            }}
          </div>
        {%- endif -%}
        {%- if section.settings.image_1 == blank and section.settings.image_2 == blank and section.settings.image_3 == blank -%}
          <div class="section-layered__layer section-layered__layer--1">
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg section-layered__img' }}
          </div>
          <div class="section-layered__layer section-layered__layer--2">
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg section-layered__img' }}
          </div>
        {%- endif -%}
      </div>

      {%- comment %} Text content {% endcomment -%}
      <div class="section-layered__content">
        {%- if section.settings.subheading != blank -%}
          <p class="section-layered__subheading subheading-size-{{ section.settings.subheading_size }}">{{ section.settings.subheading }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <{{ section.settings.heading_tag }} class="section-layered__heading heading-size-{{ section.settings.heading_size }}">
            {{- section.settings.heading -}}
          </{{ section.settings.heading_tag }}>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="section-layered__text content-size-{{ section.settings.text_size }}">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}{%- continue -%}{%- endif -%}
          <div class="section-layered__feature" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <div class="section-layered__feature-icon">
                {{ block.settings.icon | image_url: width: 48 | image_tag: loading: 'lazy' }}
              </div>
            {%- endif -%}
            <div>
              {%- if block.settings.heading != blank -%}
                <strong class="section-layered__feature-title">{{ block.settings.heading }}</strong>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="section-layered__feature-text">{{ block.settings.text }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}

        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a href="{{ section.settings.button_link }}" class="section-layered__btn section-layered__btn--{{ section.settings.button_style }} button-size-{{ section.settings.button_size }}">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
    {%- capture app_blocks -%}
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}{%- render block -%}{%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if app_blocks != blank -%}
      <div class="section-apps">{{ app_blocks }}</div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .section-layered {
    padding-block: var(--ly-mt) var(--ly-mb);
    background: rgb(var(--color-background));
    color: rgba(var(--color-foreground), 0.85);
    overflow: hidden;
  }
  @media (min-width: 750px) {
    .section-layered { padding-block: var(--ly-dt) var(--ly-db); }
  }

  .section-layered__grid { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 990px) {
    .section-layered__grid { grid-template-columns: 1fr 1fr; gap: 4rem; }
    .section-layered__grid--right .section-layered__images { order: 2; }
    .section-layered__grid--right .section-layered__content { order: 1; }
  }

  .section-layered__images {
    position: relative;
    min-height: 430px;
  }
  @media (min-width: 750px) {
    .section-layered__images {
      min-height: 520px;
    }
  }
  @media (min-width: 990px) {
    .section-layered__images {
      min-height: 620px;
    }
  }

  .section-layered__layer {
    position: absolute; border-radius: var(--media-radius); overflow: hidden;
    box-shadow: none;
    transition: transform var(--duration-long) ease;
  }
  @media (hover: hover) {
    .section-layered__layer:hover { transform: translateY(-2px); }
  }

  .section-layered__layer--1 {
    position: relative; width: 65%; z-index: 1;
  }
  .section-layered__layer--2 {
    width: 50%; bottom: 0; right: 0; z-index: 2;
  }
  .section-layered__layer--3 {
    width: 35%; top: 50%; left: 55%; transform: translateY(-50%); z-index: 3;
  }
  @media (hover: hover) {
    .section-layered__layer--3:hover { transform: translateY(calc(-50% - 2px)); }
  }

  .section-layered__img { width: 100%; height: auto; display: block; }

  .section-layered__content {
    display: flex; flex-direction: column; gap: 1rem;
  }
  .section-layered__subheading {
    margin: 0;
    font-weight: var(--eyebrow-weight);
    letter-spacing: var(--eyebrow-tracking);
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .section-layered__heading {
    margin: 0 0 0.5rem;
    color: var(--color-ink);
    line-height: 1.15;
    letter-spacing: var(--heading-tracking);
  }
  .section-layered__text { color: var(--color-muted); line-height: 1.65; max-width: 60ch; }
  .section-layered__text p { margin: 0; }

  .section-layered__feature {
    display: flex; gap: 1rem; align-items: flex-start;
    padding-top: 1rem;
    border-top: 1px solid var(--color-hairline);
  }
  .section-layered__feature-icon { width: 2rem; height: 2rem; flex-shrink: 0; }
  .section-layered__feature-icon img { width: 100%; height: 100%; object-fit: contain; }
  .section-layered__feature-title { display: block; font-size: 1rem; font-weight: 600; color: var(--color-ink); margin-bottom: 0.25rem; }
  .section-layered__feature-text { margin: 0; font-size: 0.9375rem; color: var(--color-muted); line-height: 1.6; max-width: 56ch; }

  .section-layered__btn {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: var(--btn-height);
    padding: 0 var(--btn-padding-x);
    font-size: var(--btn-font-size);
    font-weight: var(--btn-font-weight);
    letter-spacing: var(--btn-letter-spacing);
    text-decoration: none; border-radius: var(--buttons-radius, 0);
    cursor: pointer; transition: background-color var(--duration-default) ease, color var(--duration-default) ease, border-color var(--duration-default) ease;
    align-self: flex-start; margin-top: 0.5rem;
  }
  .section-layered__btn--primary { background: var(--color-primary); color: rgb(var(--color-button-text)); border: 1px solid var(--color-primary); }
  .section-layered__btn--primary:hover { background: var(--color-primary-strong); border-color: var(--color-primary-strong); color: rgb(var(--color-button-text)); }
  .section-layered__btn--secondary { background: transparent; color: var(--color-ink); border: 1px solid var(--color-ink); }
  .section-layered__btn--secondary:hover { background: var(--color-ink); color: rgb(var(--color-background)); border-color: var(--color-ink); }
{% endstylesheet %}

