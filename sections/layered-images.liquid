{%- comment %}
  Section: Layered Images with Text
  Mô tả: 2-3 ảnh xếp chồng lệch + text bên cạnh. Subtle depth effect.
{% endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-layered color-{{ section.settings.color_scheme }}"
  style="
    --ly-dt: {{ section.settings.padding_top_desktop }}px;
    --ly-db: {{ section.settings.padding_bottom_desktop }}px;
    --ly-mt: {{ section.settings.padding_top_mobile }}px;
    --ly-mb: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="page-width">
    <div class="section-layered__grid section-layered__grid--{{ section.settings.image_position }}">
      {%- comment %} Layered images {% endcomment -%}
      <div class="section-layered__images">
        {%- if section.settings.image_1 != blank -%}
          <div class="section-layered__layer section-layered__layer--1">
            {{ section.settings.image_1 | image_url: width: 600 | image_tag:
              loading: 'lazy', class: 'section-layered__img'
            }}
          </div>
        {%- endif -%}
        {%- if section.settings.image_2 != blank -%}
          <div class="section-layered__layer section-layered__layer--2">
            {{ section.settings.image_2 | image_url: width: 400 | image_tag:
              loading: 'lazy', class: 'section-layered__img'
            }}
          </div>
        {%- endif -%}
        {%- if section.settings.image_3 != blank -%}
          <div class="section-layered__layer section-layered__layer--3">
            {{ section.settings.image_3 | image_url: width: 300 | image_tag:
              loading: 'lazy', class: 'section-layered__img'
            }}
          </div>
        {%- endif -%}
      </div>

      {%- comment %} Text content {% endcomment -%}
      <div class="section-layered__content">
        {%- if section.settings.subheading != blank -%}
          <p class="section-layered__subheading subheading-size-{{ section.settings.subheading_size }}">{{ section.settings.subheading }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <{{ section.settings.heading_tag }} class="section-layered__heading heading-size-{{ section.settings.heading_size }}">
            {{- section.settings.heading -}}
          </{{ section.settings.heading_tag }}>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="section-layered__text content-size-{{ section.settings.text_size }}">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- for block in section.blocks -%}
          <div class="section-layered__feature" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <div class="section-layered__feature-icon">
                {{ block.settings.icon | image_url: width: 48 | image_tag: loading: 'lazy' }}
              </div>
            {%- endif -%}
            <div>
              {%- if block.settings.heading != blank -%}
                <strong class="section-layered__feature-title">{{ block.settings.heading }}</strong>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="section-layered__feature-text">{{ block.settings.text }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}

        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="section-layered__btn section-layered__btn--{{ section.settings.button_style }} button-size-{{ section.settings.button_size }}">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .section-layered {
    padding-block: var(--ly-mt) var(--ly-mb);
    background: rgb(var(--color-background));
    color: rgba(var(--color-foreground), 0.85);
  }
  @media (min-width: 750px) {
    .section-layered { padding-block: var(--ly-dt) var(--ly-db); }
  }

  .section-layered__grid { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 990px) {
    .section-layered__grid { grid-template-columns: 1fr 1fr; gap: 4rem; }
    .section-layered__grid--right .section-layered__images { order: 2; }
    .section-layered__grid--right .section-layered__content { order: 1; }
  }

  .section-layered__images {
    position: relative; min-height: 350px;
    padding: 2rem;
  }
  @media (min-width: 990px) {
    .section-layered__images { min-height: 450px; padding: 3rem; }
  }

  .section-layered__layer {
    position: absolute; border-radius: 0.75rem; overflow: hidden;
    box-shadow: 0 12px 40px rgba(0,0,0,0.12);
    transition: transform 0.5s ease;
  }
  .section-layered__layer:hover { transform: translateY(-4px); }

  .section-layered__layer--1 {
    width: 65%; top: 0; left: 0; z-index: 1;
  }
  .section-layered__layer--2 {
    width: 50%; bottom: 0; right: 0; z-index: 2;
  }
  .section-layered__layer--3 {
    width: 35%; top: 50%; left: 55%; transform: translateY(-50%); z-index: 3;
  }
  .section-layered__layer--3:hover { transform: translateY(calc(-50% - 4px)); }

  .section-layered__img { width: 100%; height: auto; display: block; }

  .section-layered__content {
    display: flex; flex-direction: column; gap: 0.875rem;
  }
  .section-layered__subheading { margin: 0; text-transform: uppercase; letter-spacing: 0.12em; color: rgb(var(--color-accent)); font-weight: 600; }
  .section-layered__heading { margin: 0; color: rgb(var(--color-foreground)); line-height: 1.2; }
  .section-layered__text { color: rgba(var(--color-foreground), 0.7); line-height: 1.7; }
  .section-layered__text p { margin: 0; }

  .section-layered__feature {
    display: flex; gap: 0.75rem; align-items: flex-start;
  }
  .section-layered__feature-icon { width: 2rem; height: 2rem; flex-shrink: 0; }
  .section-layered__feature-icon img { width: 100%; height: 100%; object-fit: contain; }
  .section-layered__feature-title { display: block; font-size: 0.875rem; color: rgb(var(--color-foreground)); }
  .section-layered__feature-text { margin: 0.125rem 0 0; font-size: 0.8125rem; color: rgba(var(--color-foreground), 0.6); line-height: 1.5; }

  .section-layered__btn {
    display: inline-flex; align-items: center; justify-content: center;
    font-weight: 600; text-decoration: none; border-radius: var(--buttons-radius, 0);
    cursor: pointer; transition: opacity 0.2s; align-self: flex-start; margin-top: 0.5rem;
  }
  .section-layered__btn:hover { opacity: 0.85; }
  .section-layered__btn--primary { background: rgb(var(--color-button)); color: rgb(var(--color-button-text)); border: 1px solid rgb(var(--color-button)); }
  .section-layered__btn--secondary { background: transparent; color: rgb(var(--color-foreground)); border: 1px solid rgba(var(--color-foreground), 0.3); }
{% endstylesheet %}

