{{ 'section-layered-images.css' | asset_url | stylesheet_tag }}
{%- comment %}
  Section: Layered Images with Text
{% endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-layered color-{{ section.settings.color_scheme }}"
  style="
    --ly-dt: {{ section.settings.padding_top_desktop }}px;
    --ly-db: {{ section.settings.padding_bottom_desktop }}px;
    --ly-mt: {{ section.settings.padding_top_mobile }}px;
    --ly-mb: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="page-width">
    <div class="section-layered__grid section-layered__grid--{{ section.settings.image_position }}">
      {%- comment %} Layered images {% endcomment -%}
      <div class="section-layered__images">
        {%- if section.settings.image_1 != blank -%}
          <div class="section-layered__layer section-layered__layer--1">
            {{ section.settings.image_1 | image_url: width: 600 | image_tag:
              loading: 'lazy', class: 'section-layered__img'
            }}
          </div>
        {%- endif -%}
        {%- if section.settings.image_2 != blank -%}
          <div class="section-layered__layer section-layered__layer--2">
            {{ section.settings.image_2 | image_url: width: 400 | image_tag:
              loading: 'lazy', class: 'section-layered__img'
            }}
          </div>
        {%- endif -%}
        {%- if section.settings.image_3 != blank -%}
          <div class="section-layered__layer section-layered__layer--3">
            {{ section.settings.image_3 | image_url: width: 300 | image_tag:
              loading: 'lazy', class: 'section-layered__img'
            }}
          </div>
        {%- endif -%}
        {%- if section.settings.image_1 == blank and section.settings.image_2 == blank and section.settings.image_3 == blank -%}
          <div class="section-layered__layer section-layered__layer--1">
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg section-layered__img' }}
          </div>
          <div class="section-layered__layer section-layered__layer--2">
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg section-layered__img' }}
          </div>
        {%- endif -%}
      </div>

      {%- comment %} Text content {% endcomment -%}
      <div class="section-layered__content">
        {%- if section.settings.subheading != blank -%}
          <p class="section-layered__subheading subheading-size-{{ section.settings.subheading_size }}">{{ section.settings.subheading }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <{{ section.settings.heading_tag }} class="section-layered__heading heading-size-{{ section.settings.heading_size }}">
            {{- section.settings.heading -}}
          </{{ section.settings.heading_tag }}>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="section-layered__text content-size-{{ section.settings.text_size }}">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- for block in section.blocks -%}
          <div class="section-layered__feature" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <div class="section-layered__feature-icon">
                {{ block.settings.icon | image_url: width: 48 | image_tag: loading: 'lazy' }}
              </div>
            {%- endif -%}
            <div>
              {%- if block.settings.heading != blank -%}
                <strong class="section-layered__feature-title">{{ block.settings.heading }}</strong>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="section-layered__feature-text">{{ block.settings.text }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}

        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a href="{{ section.settings.button_link }}" class="section-layered__btn section-layered__btn--{{ section.settings.button_style }} button-size-{{ section.settings.button_size }}">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>


