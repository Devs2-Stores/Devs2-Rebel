<header class="password-header">
  <div class="page-width">
    <div class="password-header__inner">
      {%- if settings.logo != blank -%}
        {%- liquid
          assign logo_alt = settings.logo.alt | default: shop.name | escape
          assign logo_sizes = settings.logo_width | append: 'px'
        -%}
        {{
          settings.logo
          | image_url: width: 600
          | image_tag:
            alt: logo_alt,
            width: settings.logo_width,
            widths: '150, 300, 450, 600',
            sizes: logo_sizes,
            loading: 'eager',
            class: 'password-header__logo-image'
        }}
      {%- else -%}
        <span class="password-header__logo-text">{{ shop.name | escape }}</span>
      {%- endif -%}
    </div>
  </div>
</header>

{% schema %}
{
  "name": "t:sections.main_password_header.name",
  "tag": "div",
  "class": "section-password-header"
}
{% endschema %}
