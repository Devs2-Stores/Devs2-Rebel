{%- comment -%}
  Section: Cookie Banner
  Mô tả: GDPR banner bottom — accept/reject + privacy policy link.
{%- endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-cookie color-{{ section.settings.color_scheme }}"
  data-cookie-banner
  style="display:none;"
>
  <div class="page-width section-cookie__inner">
    <div class="section-cookie__content">
      {%- if section.settings.icon != blank -%}
        <span class="section-cookie__icon">{{ section.settings.icon }}</span>
      {%- endif -%}
      <div class="section-cookie__text">
        <p class="section-cookie__msg">{{ section.settings.message }}</p>
        {%- if section.settings.privacy_text != blank -%}
          <a href="{{ section.settings.privacy_link | default: '/policies/privacy-policy' }}" class="section-cookie__privacy">{{ section.settings.privacy_text }}</a>
        {%- endif -%}
      </div>
    </div>
    <div class="section-cookie__actions">
      <button class="section-cookie__btn section-cookie__btn--accept" data-cookie-accept>
        {{ section.settings.accept_label | default: 'Accept' }}
      </button>
      {%- if section.settings.show_reject -%}
        <button class="section-cookie__btn section-cookie__btn--reject" data-cookie-reject>
          {{ section.settings.reject_label | default: 'Decline' }}
        </button>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
(function() {
  var banner = document.querySelector('[data-cookie-banner]');
  if (!banner) return;
  if (localStorage.getItem('cookie_consent_{{ section.id }}')) return;
  
  setTimeout(function() { banner.style.display = 'block'; }, 1000);

  banner.querySelector('[data-cookie-accept]').addEventListener('click', function() {
    localStorage.setItem('cookie_consent_{{ section.id }}', 'accepted');
    banner.classList.add('is-closing');
    setTimeout(function() { banner.style.display = 'none'; }, 400);
  });

  var reject = banner.querySelector('[data-cookie-reject]');
  if (reject) {
    reject.addEventListener('click', function() {
      localStorage.setItem('cookie_consent_{{ section.id }}', 'rejected');
      banner.classList.add('is-closing');
      setTimeout(function() { banner.style.display = 'none'; }, 400);
    });
  }
})();
</script>

{% stylesheet %}
  .section-cookie {
    position: fixed; bottom: 0; left: 0; right: 0; z-index: var(--z-toast, 900);
    background: rgb(var(--color-background));
    border-top: 1px solid rgba(var(--color-foreground), 0.08);
    box-shadow: 0 -4px 20px rgba(0,0,0,0.08);
    padding: 1rem;
    animation: cookieSlideUp 0.4s ease;
  }
  .section-cookie.is-closing { animation: cookieSlideDown 0.4s ease forwards; }

  @keyframes cookieSlideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
  @keyframes cookieSlideDown { from { transform: translateY(0); } to { transform: translateY(100%); } }

  .section-cookie__inner {
    display: flex; align-items: center; justify-content: space-between;
    gap: 1rem; flex-wrap: wrap;
  }

  .section-cookie__content { display: flex; align-items: center; gap: 0.625rem; flex: 1; }
  .section-cookie__icon { font-size: 1.5rem; }
  .section-cookie__msg {
    font-size: 0.8125rem; color: rgba(var(--color-foreground), 0.75);
    margin: 0; line-height: 1.5;
  }
  .section-cookie__privacy {
    font-size: 0.75rem; font-weight: 600; color: rgb(var(--color-accent));
    text-decoration: underline; text-underline-offset: 3px;
  }

  .section-cookie__actions { display: flex; gap: 0.5rem; flex-shrink: 0; }
  .section-cookie__btn {
    padding: 0.5rem 1.25rem; border-radius: var(--buttons-radius, 0);
    font-size: 0.8125rem; font-weight: 600; cursor: pointer;
    transition: opacity 0.2s; border: none;
  }
  .section-cookie__btn:hover { opacity: 0.85; }
  .section-cookie__btn--accept { background: rgb(var(--color-button)); color: rgb(var(--color-button-text)); }
  .section-cookie__btn--reject { background: transparent; color: rgba(var(--color-foreground), 0.6); border: 1px solid rgba(var(--color-foreground), 0.15); }
{% endstylesheet %}

{% schema %}
{
  "name": "Cookie banner",
  "tag": "div",
  "class": "section-cookie-wrapper",
  "limit": 1,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "icon", "label": "Icon", "default": "🍪" },
    { "type": "textarea", "id": "message", "label": "Message", "default": "We use cookies to ensure you get the best experience on our website." },
    { "type": "text", "id": "privacy_text", "label": "Privacy link text", "default": "Privacy policy" },
    { "type": "url", "id": "privacy_link", "label": "Privacy link" },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "accept_label", "label": "Accept label", "default": "Accept" },
    { "type": "checkbox", "id": "show_reject", "label": "Show decline button", "default": true },
    { "type": "text", "id": "reject_label", "label": "Decline label", "default": "Decline" }
  ],
  "presets": [{ "name": "Cookie banner", "category": "Utility" }]
}
{% endschema %}
