
<stores-page
  class="page-stores"
  data-all-districts="{{ 'sections.page_stores.all_districts' | t | escape }}"
  data-count-template="{{ 'sections.page_stores.count' | t | escape }}"
  data-open-label="{{ 'sections.page_stores.open_now' | t | escape }}"
  data-closed-label="{{ 'sections.page_stores.closed_now' | t | escape }}"
>
  <section class="stores-hero">
    <div class="page-width">
      <div class="stores-hero__wrap">
        <h1 class="stores-hero__title">{% if section.settings.title != blank %}{{ section.settings.title | escape }}{% else %}{{ 'sections.page_stores.default_title' | t }}{% endif %}</h1>
        {%- if section.settings.description != blank -%}
        <p class="stores-hero__description">{{ section.settings.description | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </section>

  <section class="stores-main section-padding">
    <div class="page-width">
      <div class="stores-main__wrap">
        <aside class="stores-sidebar" id="stores-sidebar">
          <div class="stores-sidebar__inner">
            <div class="stores-sidebar__search">
              <label for="stores-search" class="sr-only">{{ 'sections.page_stores.search_label' | t }}</label>
              <div class="stores-sidebar__search-box">
                {%- render 'icon', name: 'search', size: '18' -%}
                <input type="text" id="stores-search" class="stores-sidebar__search-input" placeholder="{{ 'sections.page_stores.search_placeholder' | t }}" autocomplete="off">
              </div>
            </div>
            <div class="stores-sidebar__filter">
              <label for="stores-province" class="stores-sidebar__label">{{ 'sections.page_stores.province' | t }}</label>
              <select id="stores-province" class="stores-sidebar__select">
                <option value="">{{ 'sections.page_stores.all_provinces' | t }}</option>
              </select>
            </div>
            <div class="stores-sidebar__filter">
              <label for="stores-district" class="stores-sidebar__label">{{ 'sections.page_stores.district' | t }}</label>
              <select id="stores-district" class="stores-sidebar__select" disabled>
                <option value="">{{ 'sections.page_stores.all_districts' | t }}</option>
              </select>
            </div>
            <div class="stores-sidebar__meta">
              <span class="stores-sidebar__count" id="stores-count" role="status" aria-live="polite"></span>
              <button type="button" class="stores-sidebar__clear" id="stores-clear" style="display:none">
                {%- render 'icon', name: 'close', size: '12' -%}
                <span>{{ 'sections.page_stores.clear_filter' | t }}</span>
              </button>
            </div>
          </div>
        </aside>

        <div class="stores-grid" id="stores-grid">
          {%- for block in section.blocks -%}
          {%- if block.type == 'store' -%}
          <div class="stores-card"
               data-store-name="{{ block.settings.name | escape }}"
               data-store-address="{{ block.settings.address | escape }}"
               data-store-province="{{ block.settings.province | escape }}"
               data-store-district="{{ block.settings.district | escape }}"
               data-store-hours="{{ block.settings.hours | escape }}"
               {{ block.shopify_attributes }}>
            {%- assign store_image_alt = 'sections.page_stores.store_image_alt' | t: store: block.settings.name -%}
            <div class="stores-card__media is-loading" data-store-image>
              <span class="stores-card__media-fallback" aria-hidden="true">
                {%- render 'icon', name: 'store', size: '28' -%}
              </span>
              {%- if block.settings.store_image != blank -%}
                {{- block.settings.store_image | image_url: width: 960 | image_tag: widths: '320, 480, 640, 800, 960', sizes: '(min-width: 1200px) 33vw, (min-width: 769px) 50vw, 100vw', loading: 'lazy', alt: store_image_alt -}}
              {%- endif -%}
            </div>
            <div class="stores-card__content">
              <h3 class="stores-card__name">
                {%- render 'icon', name: 'store', size: '18' -%}
                {{ block.settings.name | escape }}
              </h3>
              {%- if block.settings.address != blank -%}
               <address class="stores-card__info">
                {%- render 'icon', name: 'location', size: '16' -%}
                <span>{{ block.settings.address | escape }}</span>
               </address>
              {%- endif -%}
              {%- if block.settings.phone != blank -%}
              <div class="stores-card__info">
                {%- render 'icon', name: 'phone', size: '16' -%}
                <a href="tel:{{ block.settings.phone | replace: ' ', '' | replace: '.', '' }}" title="{{ 'sections.page_contact.call' | t }} {{ block.settings.phone | escape }}">{{ block.settings.phone | escape }}</a>
              </div>
              {%- endif -%}
              {%- if block.settings.email != blank -%}
              <div class="stores-card__info">
                {%- render 'icon', name: 'email', size: '16' -%}
                <a href="mailto:{{ block.settings.email }}" title="Email {{ block.settings.email | escape }}">{{ block.settings.email | escape }}</a>
              </div>
              {%- endif -%}
              {%- if block.settings.hours != blank -%}
              <div class="stores-card__info">
                {%- render 'icon', name: 'calendar', size: '16' -%}
                <span>{{ block.settings.hours | escape }}</span>
                <span class="stores-card__status" data-store-status aria-live="polite"></span>
              </div>
              {%- endif -%}
              {%- if block.settings.address != blank -%}
              <a href="https://maps.google.com/?daddr={{ block.settings.address | url_encode }}" target="_blank" rel="noopener noreferrer" class="stores-card__direction" title="{{ 'sections.page_stores.view_map' | t }}">
                {%- render 'icon', name: 'location', size: '16' -%}
                <span>{{ 'sections.page_stores.view_map' | t }}</span>
              </a>
              {%- endif -%}
            </div>
          </div>
          {%- if block.settings.name != blank and block.settings.address != blank -%}
          <script type="application/ld+json">
            {
              "@context": "https://schema.org",
              "@type": "LocalBusiness",
              "name": {{ block.settings.name | json }},
              "address": {
                "@type": "PostalAddress",
                "streetAddress": {{ block.settings.address | json }}{%- if block.settings.address_region != blank -%},
                "addressRegion": {{ block.settings.address_region | json }}{%- endif -%}{%- if block.settings.postal_code != blank -%},
                "postalCode": {{ block.settings.postal_code | json }}{%- endif -%}{%- if block.settings.country != blank -%},
                "addressCountry": {{ block.settings.country | json }}{%- endif -%}
              }{%- if block.settings.phone != blank -%},
              "telephone": {{ block.settings.phone | json }}{%- endif -%}{%- if block.settings.latitude != blank and block.settings.longitude != blank -%},
              "geo": {
                "@type": "GeoCoordinates",
                "latitude": {{ block.settings.latitude | json }},
                "longitude": {{ block.settings.longitude | json }}
              }{%- endif -%}
            }
          </script>
          {%- endif -%}
          {%- endif -%}
          {%- endfor -%}

          <div class="stores-empty" id="stores-empty" role="status" aria-live="polite" style="display:none">
            {%- render 'icon', name: 'sad', size: '48' -%}
            <p>{{ 'sections.page_stores.no_results' | t }}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {%- if page.content != blank -%}
  <section class="stores-content section-padding">
    <div class="page-width">
      <div class="stores-content__wrap">
        {{ page.content }}
      </div>
    </div>
  </section>
  {%- endif -%}
</stores-page>

{% schema %}
{
  "name": "t:sections.page_stores.name",
  "tag": "section",
  "class": "section-page-stores",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.page_stores.settings.title.label"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:sections.page_stores.settings.description.label"
    }
  ],
  "blocks": [
    {
      "type": "store",
      "name": "t:sections.page_stores.blocks.store.name",
      "limit": 50,
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "t:sections.page_stores.blocks.store.settings.name.label"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "t:sections.page_stores.blocks.store.settings.address.label"
        },
        {
          "type": "text",
          "id": "province",
          "label": "t:sections.page_stores.blocks.store.settings.province.label"
        },
        {
          "type": "text",
          "id": "district",
          "label": "t:sections.page_stores.blocks.store.settings.district.label"
        },
        {
          "type": "text",
          "id": "address_region",
          "label": "t:sections.page_stores.blocks.store.settings.address_region.label"
        },
        {
          "type": "text",
          "id": "postal_code",
          "label": "t:sections.page_stores.blocks.store.settings.postal_code.label"
        },
        {
          "type": "text",
          "id": "country",
          "label": "t:sections.page_stores.blocks.store.settings.country.label"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "t:sections.page_stores.blocks.store.settings.phone.label"
        },
        {
          "type": "text",
          "id": "email",
          "label": "t:sections.page_stores.blocks.store.settings.email.label"
        },
        {
          "type": "text",
          "id": "hours",
          "label": "t:sections.page_stores.blocks.store.settings.hours.label"
        },
        {
          "type": "image_picker",
          "id": "store_image",
          "label": "t:sections.page_stores.blocks.store.settings.store_image.label",
          "info": "t:sections.page_stores.blocks.store.settings.store_image.info"
        },
        {
          "type": "url",
          "id": "map_url",
          "label": "t:sections.page_stores.blocks.store.settings.map_url.label",
          "info": "t:sections.page_stores.blocks.store.settings.map_url.info"
        },
        {
          "type": "text",
          "id": "latitude",
          "label": "t:sections.page_stores.blocks.store.settings.latitude.label"
        },
        {
          "type": "text",
          "id": "longitude",
          "label": "t:sections.page_stores.blocks.store.settings.longitude.label"
        }
      ]
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
