{%- comment -%}
  Section: Collapsible Content / FAQ
  Mô tả: Accordion — dùng cho FAQ, chính sách, shipping info.
{%- endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-collapsible color-{{ section.settings.color_scheme }}"
  style="
    --faq-dt: {{ section.settings.padding_top_desktop }}px;
    --faq-db: {{ section.settings.padding_bottom_desktop }}px;
    --faq-mt: {{ section.settings.padding_top_mobile }}px;
    --faq-mb: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-collapsible__head">
        {%- if section.settings.subheading != blank -%}
          <p class="section-collapsible__subheading subheading-size-{{ section.settings.subheading_size }}">
            {{- section.settings.subheading -}}
          </p>
        {%- endif -%}
        <{{ section.settings.heading_tag }}
          class="section-collapsible__heading heading-size-{{ section.settings.heading_size }}"
        >
          {{- section.settings.heading -}}
        </{{ section.settings.heading_tag }}>
      </div>
    {%- endif -%}

    <div class="section-collapsible__list">
      {%- for block in section.blocks -%}
        <details class="section-collapsible__item" {{ block.shopify_attributes }}{% if section.settings.open_first and forloop.first %} open{% endif %}>
          <summary class="section-collapsible__trigger">
            <span class="section-collapsible__trigger-text heading-size-{{ block.settings.heading_size }}">
              {{ block.settings.heading | default: 'Question' }}
            </span>
            <span class="section-collapsible__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            </span>
          </summary>
          <div class="section-collapsible__body content-size-{{ block.settings.content_size }}">
            {{ block.settings.content }}
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .section-collapsible {
    padding-block: var(--faq-mt) var(--faq-mb);
    background: rgb(var(--color-background));
    color: rgba(var(--color-foreground), 0.85);
  }
  @media (min-width: 750px) {
    .section-collapsible { padding-block: var(--faq-dt) var(--faq-db); }
  }
  .section-collapsible__head { text-align: center; margin-bottom: 2.5rem; }
  .section-collapsible__subheading {
    margin: 0 0 0.25rem; text-transform: uppercase;
    letter-spacing: 0.12em; color: rgb(var(--color-accent)); font-weight: 600;
  }
  .section-collapsible__heading { margin: 0; color: rgb(var(--color-foreground)); }

  .section-collapsible__list {
    max-width: 48rem; margin: 0 auto;
    border-top: 1px solid rgba(var(--color-foreground), 0.1);
  }

  .section-collapsible__item {
    border-bottom: 1px solid rgba(var(--color-foreground), 0.1);
  }

  .section-collapsible__trigger {
    display: flex; align-items: center; justify-content: space-between;
    gap: 1rem; padding: 1.25rem 0;
    cursor: pointer; list-style: none;
    color: rgb(var(--color-foreground)); font-weight: 600;
    transition: color 0.3s;
  }
  .section-collapsible__trigger::-webkit-details-marker { display: none; }
  .section-collapsible__trigger::marker { display: none; content: ''; }
  .section-collapsible__trigger:hover { color: rgb(var(--color-accent)); }

  .section-collapsible__trigger-text { flex: 1; }

  .section-collapsible__icon {
    flex-shrink: 0; display: flex;
    transition: transform 0.3s;
  }
  .section-collapsible__icon line:first-child {
    transition: transform 0.3s; transform-origin: center;
  }
  details[open] .section-collapsible__icon {
    transform: rotate(45deg);
  }

  .section-collapsible__body {
    padding: 0 0 1.25rem;
    color: rgba(var(--color-foreground), 0.7);
    line-height: 1.7;
  }
  .section-collapsible__body p:last-child { margin-bottom: 0; }
{% endstylesheet %}

{% schema %}
{
  "name": "Collapsible content",
  "tag": "section",
  "class": "section-collapsible-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "subheading_size",
      "label": "Subheading size",
      "options": [
        {
          "value": "xs",
          "label": "XS"
        },
        {
          "value": "sm",
          "label": "S"
        },
        {
          "value": "md",
          "label": "M"
        }
      ],
      "default": "sm"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "sm",
          "label": "S"
        },
        {
          "value": "md",
          "label": "M"
        },
        {
          "value": "lg",
          "label": "L"
        },
        {
          "value": "xl",
          "label": "XL"
        }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open first item by default",
      "default": true
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom",
      "default": 50
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "collapsible_row",
      "name": "Collapsible row",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Collapsible row"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "options": [
            {
              "value": "xs",
              "label": "XS"
            },
            {
              "value": "sm",
              "label": "S"
            },
            {
              "value": "md",
              "label": "M"
            }
          ],
          "default": "xs"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Answer to the question goes here.</p>"
        },
        {
          "type": "select",
          "id": "content_size",
          "label": "Content size",
          "options": [
            {
              "value": "sm",
              "label": "S"
            },
            {
              "value": "md",
              "label": "M"
            },
            {
              "value": "lg",
              "label": "L"
            }
          ],
          "default": "md"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Collapsible content",
      "category": "Custom",
      "blocks": [
        {
          "type": "collapsible_row"
        },
        {
          "type": "collapsible_row"
        },
        {
          "type": "collapsible_row"
        },
        {
          "type": "collapsible_row"
        }
      ]
    }
  ]
}
{% endschema %}
