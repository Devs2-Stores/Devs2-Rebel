{{ 'section-collapsible-content.css' | asset_url | stylesheet_tag }}
{%- comment %}
  Section: Collapsible Content / FAQ
{% endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-collapsible color-{{ section.settings.color_scheme }}"
  style="
    --faq-dt: {{ section.settings.padding_top_desktop }}px;
    --faq-db: {{ section.settings.padding_bottom_desktop }}px;
    --faq-mt: {{ section.settings.padding_top_mobile }}px;
    --faq-mb: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-collapsible__head">
        {%- if section.settings.subheading != blank -%}
          <p class="section-collapsible__subheading subheading-size-{{ section.settings.subheading_size }}">
            {{- section.settings.subheading -}}
          </p>
        {%- endif -%}
        <{{ section.settings.heading_tag }}
          class="section-collapsible__heading heading-size-{{ section.settings.heading_size }}"
        >
          {{- section.settings.heading -}}
        </{{ section.settings.heading_tag }}>
      </div>
    {%- endif -%}

    <div class="section-collapsible__list">
      {%- assign row_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- assign row_index = row_index | plus: 1 -%}
        {%- if block.settings.heading == blank -%}{%- continue -%}{%- endif -%}
        <details class="section-collapsible__item" {{ block.shopify_attributes }}{% if section.settings.open_first and row_index == 1 %} open{% endif %}>
          <summary class="section-collapsible__trigger">
            <span class="section-collapsible__trigger-text heading-size-{{ block.settings.heading_size }}">
              {{ block.settings.heading | escape }}
            </span>
            <span class="section-collapsible__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            </span>
          </summary>
          <div class="section-collapsible__body content-size-{{ block.settings.content_size }}">
            {{ block.settings.content }}
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>


