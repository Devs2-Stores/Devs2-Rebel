{%- comment %}
  Section: Collapsible Content / FAQ
{% endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-collapsible color-{{ section.settings.color_scheme }}"
  style="
    --faq-dt: {{ section.settings.padding_top_desktop }}px;
    --faq-db: {{ section.settings.padding_bottom_desktop }}px;
    --faq-mt: {{ section.settings.padding_top_mobile }}px;
    --faq-mb: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-collapsible__head">
        {%- if section.settings.subheading != blank -%}
          <p class="section-collapsible__subheading subheading-size-{{ section.settings.subheading_size }}">
            {{- section.settings.subheading -}}
          </p>
        {%- endif -%}
        <{{ section.settings.heading_tag }}
          class="section-collapsible__heading heading-size-{{ section.settings.heading_size }}"
        >
          {{- section.settings.heading -}}
        </{{ section.settings.heading_tag }}>
      </div>
    {%- endif -%}

    <div class="section-collapsible__list">
      {%- assign row_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- assign row_index = row_index | plus: 1 -%}
        {%- if block.settings.heading == blank -%}{%- continue -%}{%- endif -%}
        <details class="section-collapsible__item" {{ block.shopify_attributes }}{% if section.settings.open_first and row_index == 1 %} open{% endif %}>
          <summary class="section-collapsible__trigger">
            <span class="section-collapsible__trigger-text heading-size-{{ block.settings.heading_size }}">
              {{ block.settings.heading | escape }}
            </span>
            <span class="section-collapsible__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            </span>
          </summary>
          <div class="section-collapsible__body content-size-{{ block.settings.content_size }}">
            {{ block.settings.content }}
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .section-collapsible {
    padding-block: var(--faq-mt) var(--faq-mb);
    background: rgb(var(--color-background));
    color: rgba(var(--color-foreground), 0.85);
  }
  @media (min-width: 750px) {
    .section-collapsible { padding-block: var(--faq-dt) var(--faq-db); }
  }
  .section-collapsible__head { text-align: center; margin-bottom: var(--section-head-gap); }
  .section-collapsible__subheading {
    margin: 0 0 0.5rem;
    font-weight: var(--eyebrow-weight);
    letter-spacing: var(--eyebrow-tracking);
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .section-collapsible__heading {
    margin: 0;
    color: var(--color-ink);
    letter-spacing: var(--heading-tracking);
  }

  .section-collapsible__list {
    max-width: 48rem; margin: 0 auto;
    border-top: 1px solid var(--color-hairline);
  }

  .section-collapsible__item {
    border-bottom: 1px solid var(--color-hairline);
  }

  .section-collapsible__trigger {
    display: flex; align-items: center; justify-content: space-between;
    gap: 1rem; padding: 1.25rem 0;
    cursor: pointer; list-style: none;
    color: var(--color-ink); font-weight: 600;
  }
  .section-collapsible__trigger::-webkit-details-marker { display: none; }
  .section-collapsible__trigger::marker { display: none; content: ''; }
  .section-collapsible__trigger:hover { color: var(--color-ink); }

  .section-collapsible__trigger-text { flex: 1; }

  .section-collapsible__icon {
    flex-shrink: 0; display: flex;
    transition: transform 0.25s ease;
  }
  .section-collapsible__icon line:first-child {
    transition: transform 0.25s ease; transform-origin: center;
  }
  details[open] .section-collapsible__icon {
    transform: rotate(45deg);
  }

  .section-collapsible__body {
    padding: 0 0 1.25rem;
    color: var(--color-muted);
    line-height: 1.65;
    max-width: 65ch;
  }
  .section-collapsible__body p:last-child { margin-bottom: 0; }
{% endstylesheet %}

