{%- comment %}
  Section: Logo List / Brand Bar
  Mô tả: Hiển thị logo đối tác/thương hiệu dạng grid hoặc marquee tự chạy.
{% endcomment -%}

{%- liquid
  assign layout = section.settings.layout
  assign logo_count = 0
  for block in section.blocks
    if block.type == '@app'
      continue
    endif
    if block.settings.image != blank or request.design_mode
      assign logo_count = logo_count | plus: 1
    endif
  endfor
-%}

{%- capture app_blocks -%}
  {%- for block in section.blocks -%}
    {%- if block.type == '@app' -%}{%- render block -%}{%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if logo_count > 0 or app_blocks != blank or request.design_mode -%}
<div
  id="section-{{ section.id }}"
  class="section-logo-list color-{{ section.settings.color_scheme }}"
  style="
    --ll-dt: {{ section.settings.padding_top_desktop }}px;
    --ll-db: {{ section.settings.padding_bottom_desktop }}px;
    --ll-mt: {{ section.settings.padding_top_mobile }}px;
    --ll-mb: {{ section.settings.padding_bottom_mobile }}px;
    --ll-logo-h: {{ section.settings.logo_height }}px;
    --ll-marquee-speed: {{ section.settings.marquee_speed }}s;
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-logo-list__head">
        <{{ section.settings.heading_tag }}
          class="section-logo-list__heading heading-size-{{ section.settings.heading_size }}"
        >
          {{- section.settings.heading -}}
        </{{ section.settings.heading_tag }}>
      </div>
    {%- endif -%}
  </div>

  {%- if logo_count > 0 -%}
    {%- if layout == 'marquee' -%}
      <div class="section-logo-list__marquee">
        <div class="section-logo-list__track">
          {%- for i in (1..2) -%}
            {%- for block in section.blocks -%}
              {%- if block.type == '@app' -%}{%- continue -%}{%- endif -%}
              {%- unless block.settings.image != blank or request.design_mode -%}{%- continue -%}{%- endunless -%}
              <div class="section-logo-list__item"{% if i == 1 %} {{ block.shopify_attributes }}{% else %} aria-hidden="true" inert{% endif %}>
                {%- if block.settings.image != blank -%}
                  {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="section-logo-list__link">{%- endif -%}
                    {%- assign logo_alt = 'accessibility.brand_logo' | t -%}
                    {%- assign logo_alt = block.settings.image.alt | default: logo_alt -%}
                    {{ block.settings.image | image_url: height: 120 | image_tag:
                      loading: 'lazy', decoding: 'async',
                      alt: logo_alt,
                      class: 'section-logo-list__logo'
                    }}
                  {%- if block.settings.link != blank -%}</a>{%- endif -%}
                {%- else -%}
                  <div class="section-logo-list__ph">
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
    {%- else -%}
      <div class="page-width">
        <div class="section-logo-list__grid" style="--ll-cols: {{ section.settings.columns_desktop }};">
          {%- for block in section.blocks -%}
            {%- if block.type == '@app' -%}{%- continue -%}{%- endif -%}
            {%- unless block.settings.image != blank or request.design_mode -%}{%- continue -%}{%- endunless -%}
            <div class="section-logo-list__item" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="section-logo-list__link">{%- endif -%}
                  {%- assign logo_alt = 'accessibility.brand_logo' | t -%}
                  {%- assign logo_alt = block.settings.image.alt | default: logo_alt -%}
                  {{ block.settings.image | image_url: height: 120 | image_tag:
                    loading: 'lazy', decoding: 'async',
                    alt: logo_alt,
                    class: 'section-logo-list__logo'
                  }}
                {%- if block.settings.link != blank -%}</a>{%- endif -%}
              {%- else -%}
                <div class="section-logo-list__ph">
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}
  {%- if app_blocks != blank -%}
    <div class="page-width">
      <div class="section-apps">{{ app_blocks }}</div>
    </div>
  {%- endif -%}
</div>
{%- endif -%}

{% stylesheet %}
  .section-logo-list {
    padding-block: var(--ll-mt) var(--ll-mb);
    background: rgb(var(--color-background));
    border-top: 1px solid var(--color-hairline);
    overflow: hidden;
  }
  @media (min-width: 750px) {
    .section-logo-list { padding-block: var(--ll-dt) var(--ll-db); }
  }
  .section-logo-list__head { text-align: center; margin-bottom: 1.75rem; }
  .section-logo-list__heading {
    margin: 0;
    font-weight: var(--eyebrow-weight);
    letter-spacing: var(--eyebrow-tracking);
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .section-logo-list__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-items: center;
    justify-items: center;
  }
  @media (min-width: 750px) {
    .section-logo-list__grid {
      grid-template-columns: repeat(var(--ll-cols, 5), 1fr);
      gap: 2rem;
    }
  }

  .section-logo-list__item { display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .section-logo-list__link { display: flex; transition: opacity var(--duration-medium); }
  .section-logo-list__link:hover { opacity: 0.6; }

  .section-logo-list__logo {
    height: var(--ll-logo-h, 40px);
    width: auto;
    object-fit: contain;
    opacity: 0.55;
    filter: grayscale(100%);
    transition: opacity var(--duration-medium), filter var(--duration-medium);
  }
  .section-logo-list__item:hover .section-logo-list__logo {
    opacity: 1;
    filter: grayscale(0%);
  }

  .section-logo-list__ph { height: var(--ll-logo-h, 40px); width: 80px; opacity: 0.12; }
  .section-logo-list__ph svg { height: 100%; width: auto; }

  @keyframes logo-marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .section-logo-list__marquee { overflow: hidden; width: 100%; }
  .section-logo-list__marquee:hover .section-logo-list__track { animation-play-state: paused; }
  .section-logo-list__track {
    display: flex;
    align-items: center;
    gap: 3rem;
    width: fit-content;
    animation: logo-marquee var(--ll-marquee-speed, 30s) linear infinite;
  }
  @media (min-width: 750px) {
    .section-logo-list__track { gap: 4rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.logo_list.name",
  "tag": "section",
  "class": "section-logo-list-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.logo_list.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.logo_list.settings.header__heading.content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.logo_list.settings.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.logo_list.settings.heading_size.label",
      "options": [
        {
          "value": "xs",
          "label": "t:sections.logo_list.settings.heading_size.options.xs"
        },
        {
          "value": "sm",
          "label": "t:sections.logo_list.settings.heading_size.options.sm"
        },
        {
          "value": "md",
          "label": "t:sections.logo_list.settings.heading_size.options.md"
        },
        {
          "value": "lg",
          "label": "t:sections.logo_list.settings.heading_size.options.lg"
        }
      ],
      "default": "sm"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.logo_list.settings.heading_tag.label",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.logo_list.settings.heading_tag.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.logo_list.settings.heading_tag.options.h3"
        },
        {
          "value": "p",
          "label": "t:sections.logo_list.settings.heading_tag.options.p"
        }
      ],
      "default": "h3"
    },
    {
      "type": "header",
      "content": "t:sections.logo_list.settings.header__layout.content"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.logo_list.settings.layout.label",
      "options": [
        {
          "value": "grid",
          "label": "t:sections.logo_list.settings.layout.options.grid"
        },
        {
          "value": "marquee",
          "label": "t:sections.logo_list.settings.layout.options.marquee"
        }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 8,
      "step": 1,
      "label": "t:sections.logo_list.settings.columns_desktop.label",
      "default": 5,
      "visible_if": "{{ section.settings.layout == 'grid' }}"
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "t:sections.logo_list.settings.logo_height.label",
      "default": 40
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "t:sections.logo_list.settings.marquee_speed.label",
      "default": 30,
      "visible_if": "{{ section.settings.layout == 'marquee' }}"
    },
    {
      "type": "header",
      "content": "t:sections.logo_list.settings.header__desktop_spacing.content"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "t:sections.logo_list.settings.padding_top_desktop.label",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "t:sections.logo_list.settings.padding_bottom_desktop.label",
      "default": 40
    },
    {
      "type": "header",
      "content": "t:sections.logo_list.settings.header__mobile_spacing.content"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:sections.logo_list.settings.padding_top_mobile.label",
      "default": 25
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:sections.logo_list.settings.padding_bottom_mobile.label",
      "default": 25
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "t:sections.logo_list.blocks.logo.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.logo_list.blocks.logo.settings.image.label",
          "info": "t:sections.logo_list.blocks.logo.settings.image.info"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.logo_list.blocks.logo.settings.link.label"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:sections.logo_list.presets.logo_list.name",
      "category": "Image",
      "blocks": [
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        }
      ]
    }
  ]
}
{% endschema %}
