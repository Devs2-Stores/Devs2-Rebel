{%- comment %}
  Section: Age Verification
  Mô tả: Gate overlay — "Are you 18+?" với confirm/deny.
{% endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-agegate color-{{ section.settings.color_scheme }}"
  data-agegate
  style="display:none;"
>
  <div class="section-agegate__backdrop"></div>
  <div class="section-agegate__modal" role="dialog" aria-modal="true" aria-labelledby="agegate-heading-{{ section.id }}">
    {%- if section.settings.logo != blank -%}
      <div class="section-agegate__logo">
        {{ section.settings.logo | image_url: width: 150 | image_tag: loading: 'eager' }}
      </div>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 id="agegate-heading-{{ section.id }}" class="section-agegate__heading heading-size-{{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="section-agegate__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}
    <div class="section-agegate__actions">
      <button class="section-agegate__btn section-agegate__btn--confirm button-size-lg" data-agegate-confirm>
        {{ section.settings.confirm_label | default: 'Yes, I am' | escape }}
      </button>
      <button class="section-agegate__btn section-agegate__btn--deny button-size-lg" data-agegate-deny>
        {{ section.settings.deny_label | default: 'No, I am not' | escape }}
      </button>
    </div>
    {%- if section.settings.disclaimer != blank -%}
      <p class="section-agegate__disclaimer">{{ section.settings.disclaimer | escape }}</p>
    {%- endif -%}
  </div>
</div>

<script>
(function() {
  var gate = document.querySelector('[data-agegate]');
  if (!gate) return;
  if (localStorage.getItem('age_verified_{{ section.id }}')) return;

  gate.style.display = 'flex';
  document.body.style.overflow = 'hidden';

  gate.querySelector('[data-agegate-confirm]').addEventListener('click', function() {
    localStorage.setItem('age_verified_{{ section.id }}', '1');
    gate.classList.add('is-closing');
    document.body.style.overflow = '';
    setTimeout(function() { gate.style.display = 'none'; }, 500);
  });

  gate.querySelector('[data-agegate-deny]').addEventListener('click', function() {
    window.location.href = {{ section.settings.deny_redirect | default: '/' | json }};
  });
})();
</script>

{% stylesheet %}
  .section-agegate {
    position: fixed; inset: 0; z-index: var(--z-overlay, 9500);
    display: flex; align-items: center; justify-content: center;
    animation: ageFadeIn 0.4s ease;
  }
  .section-agegate.is-closing { animation: ageFadeOut 0.5s ease forwards; }

  @keyframes ageFadeIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes ageFadeOut { from { opacity: 1; } to { opacity: 0; } }

  .section-agegate__backdrop {
    position: absolute; inset: 0;
    background: rgba(0, 0, 0, 0.7); backdrop-filter: blur(8px);
  }

  .section-agegate__modal {
    position: relative; z-index: 2;
    background: rgb(var(--color-background)); color: rgb(var(--color-foreground));
    border-radius: 1rem; padding: 2.5rem 2rem;
    max-width: 420px; width: 90%; text-align: center;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    display: flex; flex-direction: column; align-items: center; gap: 1rem;
    animation: ageModalIn 0.5s 0.1s ease both;
  }
  @keyframes ageModalIn { from { opacity: 0; transform: scale(0.9) translateY(20px); } to { opacity: 1; transform: scale(1) translateY(0); } }

  .section-agegate__logo { max-width: 120px; margin-bottom: 0.25rem; }
  .section-agegate__logo img { width: 100%; height: auto; }
  .section-agegate__heading { margin: 0; color: rgb(var(--color-foreground)); line-height: 1.2; }
  .section-agegate__text { margin: 0; font-size: 0.875rem; color: rgba(var(--color-foreground), 0.6); line-height: 1.5; }

  .section-agegate__actions { display: flex; gap: 0.75rem; width: 100%; flex-wrap: wrap; }
  .section-agegate__btn {
    flex: 1; min-width: 120px; display: flex; align-items: center; justify-content: center;
    font-weight: 700; border-radius: var(--buttons-radius, 0); cursor: pointer;
    transition: opacity 0.2s; border: none;
  }
  .section-agegate__btn:hover { opacity: 0.85; }
  .section-agegate__btn--confirm { background: rgb(var(--color-button)); color: rgb(var(--color-button-text)); }
  .section-agegate__btn--deny { background: transparent; color: rgba(var(--color-foreground), 0.5); border: 1px solid rgba(var(--color-foreground), 0.15); }

  .section-agegate__disclaimer { font-size: 0.6875rem; color: rgba(var(--color-foreground), 0.35); margin: 0; line-height: 1.4; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.age_verification.name",
  "tag": "div",
  "class": "section-agegate-wrapper",
  "limit": 1,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.age_verification.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.age_verification.settings.logo.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.age_verification.settings.heading.label",
      "default": "Age verification"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.age_verification.settings.heading_size.label",
      "options": [
        {
          "value": "md",
          "label": "M"
        },
        {
          "value": "lg",
          "label": "L"
        }
      ],
      "default": "lg"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.age_verification.settings.text.label",
      "default": "You must be 18 years or older to enter this site."
    },
    {
      "type": "text",
      "id": "confirm_label",
      "label": "t:sections.age_verification.settings.confirm_label.label",
      "default": "Yes, I am 18+"
    },
    {
      "type": "text",
      "id": "deny_label",
      "label": "t:sections.age_verification.settings.deny_label.label",
      "default": "No, I am not"
    },
    {
      "type": "url",
      "id": "deny_redirect",
      "label": "t:sections.age_verification.settings.deny_url.label"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "t:sections.age_verification.settings.disclaimer.label",
      "default": "By entering this site you agree to our Terms & Conditions."
    }
  ],
  "presets": [
    {
      "name": "t:sections.age_verification.presets.age_verification.name",
      "category": "Utility"
    }
  ]
}
{% endschema %}
