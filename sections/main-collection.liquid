          "default": 10
        },
        {
          "type": "header",
          "content": "t:sections.all.spacing.header.content"
        },
        {
          "type": "range",
          "id": "padding_top",
          "label": "t:sections.all.spacing.padding_top.label",
          "min": 0,
          "max": 100,
          "step": 4,
          "unit": "px",
          "default": 16
        },
        {
          "type": "range",
          "id": "padding_bottom",
