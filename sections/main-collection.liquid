        {
          "value": "1",
          "label": "t:sections.main_collection.settings.columns_desktop.options._1"
        },
        {
          "value": "2",
          "label": "t:sections.main_collection.settings.columns_desktop.options._2"
        },
        {
          "value": "3",
          "label": "t:sections.main_collection.settings.columns_desktop.options._3"
        },
        {
          "value": "4",
          "label": "t:sections.main_collection.settings.columns_desktop.options._4"
        },
        {
          "value": "5",
          "label": "t:sections.main_collection.settings.columns_desktop.options._5"
        }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.all.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.main_collection.settings.columns_mobile.options._1"
        },
        {
          "value": "2",
          "label": "t:sections.main_collection.settings.columns_mobile.options._2"
        }
      ],
