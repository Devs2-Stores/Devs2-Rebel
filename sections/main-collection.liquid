          "label": "t:sections.main_collection.settings.filter_layout.options__modal.label"
        },
        {
          "value": "horizontal",
          "label": "t:sections.main_collection.settings.filter_layout.options__horizontal.label"
        }
      ],
      "default": "sidebar"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "t:sections.main_collection.settings.enable_filtering.label",
