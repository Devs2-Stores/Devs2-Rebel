    },
    {
      "type": "header",
      "content": "t:sections.main_collection.settings.header__layout.content"
    },
    {
      "type": "select",
      "id": "default_view",
      "label": "t:sections.main_collection.settings.default_view.label",
      "options": [
        {
          "value": "grid",
          "label": "t:sections.main_collection.settings.default_view.options__grid.label"
        },
        {
          "value": "list",
          "label": "t:sections.main_collection.settings.default_view.options__list.label"
