{{ 'footer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'footer.js' | asset_url }}" defer="defer"></script>
<global-footer class="footer color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}
        {%- capture block_markup -%}<div class="footer-block footer-block--app">{%- render block -%}</div>{%- endcapture -%}
        {%- assign block_region = 'columns' -%}
      {%- else -%}
        {%- capture block_markup -%}{%- render 'footer-block', block: block, section: section -%}{%- endcapture -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            {%- assign block_region = 'columns' -%}
          {%- when 'newsletter' -%}
            {%- assign block_region = 'top' -%}
          {%- else -%}
            {%- assign block_region = block.settings.placement | default: 'columns' -%}
        {%- endcase -%}
      {%- endif -%}
      {%- case block_region -%}
        {%- when 'brand' -%}
          {%- assign brand_markup = brand_markup | append: block_markup -%}
        {%- when 'top' -%}
          {%- assign top_markup = top_markup | append: block_markup -%}
        {%- when 'bottom' -%}
          {%- assign bottom_markup = bottom_markup | append: block_markup -%}
        {%- else -%}
          {%- assign columns_markup = columns_markup | append: block_markup -%}
      {%- endcase -%}
    {%- endfor -%}
    {%- capture policies_markup -%}
      {%- if section.settings.show_policies -%}
        {%- for policy in shop.policies -%}
          {%- if policy.body != blank -%}
            <li class="footer-policies__item"><a class="footer-policies__link" href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endcapture -%}
    <div class="footer-wrapper{% if brand_markup == blank %} footer-wrapper--no-info{% endif %}">
      {%- if brand_markup != blank -%}
        <div class="footer-info">{{ brand_markup }}</div>
      {%- endif -%}
      {%- if top_markup != blank or columns_markup != blank -%}
        <div class="footer-actions">
          {%- if top_markup != blank -%}
            <div class="footer-top">{{ top_markup }}</div>
          {%- endif -%}
          {%- if columns_markup != blank -%}
            <div class="footer-actions-menus">{{ columns_markup }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
    <div class="footer-bottom">
      <div class="footer-copyright">
        <p class="footer-copyright__text">&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}, {{ powered_by_link }}</p>
        {%- if policies_markup != blank -%}
          <nav class="footer-policies" aria-label="{{ 'sections.footer.policies_label' | t }}">
            <ul class="footer-policies__list" role="list">{{ policies_markup }}</ul>
          </nav>
        {%- endif -%}
        <div class="footer-contact">
          {%- if section.settings.address != blank -%}
          <span class="footer-contact__item">{{ section.settings.address | escape }}</span>
          {%- endif -%}
          {%- if section.settings.email != blank -%}
          <span class="footer-contact__item"><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></span>
          {%- endif -%}
          {%- if section.settings.phone != blank -%}
          <span class="footer-contact__item"><a href="tel:{{ section.settings.phone }}">{{ section.settings.phone }}</a></span>
          {%- endif -%}
          {%- if section.settings.tax_code != blank -%}
          <span class="footer-contact__item">{{ section.settings.tax_code | escape }}</span>
          {%- endif -%}
        </div>
        {{ bottom_markup }}
        {%- if section.settings.show_follow_on_shop -%}
          <div class="footer-follow-on-shop">
            {{ shop | login_button: action: 'follow' }}
          </div>
        {%- endif -%}
      </div>

      {%- capture country_selector -%}
        {%- if section.settings.show_country_selector -%}
          {%- render 'localization-selector', kind: 'country', form_id: 'FooterCountryForm', variant: 'dropup' -%}
        {%- endif -%}
      {%- endcapture -%}
      {%- capture language_selector -%}
        {%- if section.settings.show_language_selector -%}
          {%- render 'localization-selector', kind: 'language', form_id: 'FooterLanguageForm', variant: 'dropup' -%}
        {%- endif -%}
      {%- endcapture -%}
      {%- if country_selector != blank or language_selector != blank -%}
        <div class="footer-localization">
          {%- if country_selector != blank -%}
            <div class="footer-localization__item">{{ country_selector }}</div>
          {%- endif -%}
          {%- if language_selector != blank -%}
            <div class="footer-localization__item">{{ language_selector }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</global-footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "tag": "footer",
  "class": "section-footer",
  "limit": 1,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__contact.content"
    },
    {
      "type": "text",
      "id": "address",
      "label": "t:sections.footer.settings.address.label"
    },
    {
      "type": "text",
      "id": "email",
      "label": "t:sections.footer.settings.email.label"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "t:sections.footer.settings.phone.label"
    },
    {
      "type": "text",
      "id": "tax_code",
      "label": "t:sections.footer.settings.tax_code.label"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__localization.content"
    },
    {
      "type": "checkbox",
      "id": "show_country_selector",
      "label": "t:sections.footer.settings.show_country_selector.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_language_selector",
      "label": "t:sections.footer.settings.show_language_selector.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__bottom.content"
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "t:sections.footer.settings.show_policies.label",
      "info": "t:sections.footer.settings.show_policies.info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_follow_on_shop",
      "label": "t:sections.footer.settings.show_follow_on_shop.label",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "t:sections.footer.blocks.logo.name",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.footer.blocks.logo.settings.info.content"
        },
        {
          "type": "select",
          "id": "placement",
          "label": "t:sections.footer.blocks.placement.label",
          "options": [
            { "value": "brand", "label": "t:sections.footer.blocks.placement.options__1.label" },
            { "value": "columns", "label": "t:sections.footer.blocks.placement.options__2.label" },
            { "value": "bottom", "label": "t:sections.footer.blocks.placement.options__3.label" }
          ],
          "default": "brand"
        }
      ]
    },
    {
      "type": "brand",
      "name": "t:sections.footer.blocks.brand.name",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.footer.blocks.brand.settings.info.content"
        },
        {
          "type": "select",
          "id": "placement",
          "label": "t:sections.footer.blocks.placement.label",
          "options": [
            { "value": "brand", "label": "t:sections.footer.blocks.placement.options__1.label" },
            { "value": "columns", "label": "t:sections.footer.blocks.placement.options__2.label" },
            { "value": "bottom", "label": "t:sections.footer.blocks.placement.options__3.label" }
          ],
          "default": "brand"
        },
        {
          "type": "checkbox",
          "id": "show_image",
          "label": "t:sections.footer.blocks.brand.settings.show_image.label",
          "default": true
        },
        {
          "type": "text",
          "id": "headline",
          "label": "t:sections.footer.blocks.brand.settings.headline.label"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "t:sections.footer.blocks.brand.settings.description.label"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "settings": [
        {
          "type": "select",
          "id": "placement",
          "label": "t:sections.footer.blocks.placement.label",
          "options": [
            { "value": "brand", "label": "t:sections.footer.blocks.placement.options__1.label" },
            { "value": "columns", "label": "t:sections.footer.blocks.placement.options__2.label" },
            { "value": "bottom", "label": "t:sections.footer.blocks.placement.options__3.label" }
          ],
          "default": "columns"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.text.settings.heading.label"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.footer.blocks.text.settings.text.label"
        }
      ]
    },
    {
      "type": "image",
      "name": "t:sections.footer.blocks.image.name",
      "settings": [
        {
          "type": "select",
          "id": "placement",
          "label": "t:sections.footer.blocks.placement.label",
          "options": [
            { "value": "brand", "label": "t:sections.footer.blocks.placement.options__1.label" },
            { "value": "columns", "label": "t:sections.footer.blocks.placement.options__2.label" },
            { "value": "bottom", "label": "t:sections.footer.blocks.placement.options__3.label" }
          ],
          "default": "brand"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.footer.blocks.image.settings.image.label"
        },
        {
          "type": "range",
          "id": "image_width",
          "min": 80,
          "max": 600,
          "step": 20,
          "unit": "px",
          "default": 240,
          "label": "t:sections.footer.blocks.image.settings.image_width.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.footer.blocks.image.settings.link.label"
        }
      ]
    },
    {
      "type": "social",
      "name": "t:sections.footer.blocks.social.name",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.footer.blocks.social.settings.info.content"
        },
        {
          "type": "select",
          "id": "placement",
          "label": "t:sections.footer.blocks.placement.label",
          "options": [
            { "value": "brand", "label": "t:sections.footer.blocks.placement.options__1.label" },
            { "value": "columns", "label": "t:sections.footer.blocks.placement.options__2.label" },
            { "value": "bottom", "label": "t:sections.footer.blocks.placement.options__3.label" }
          ],
          "default": "brand"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.social.settings.heading.label"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "t:sections.footer.blocks.newsletter.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.newsletter.settings.heading.label"
        },
        {
          "type": "checkbox",
          "id": "show_form",
          "label": "t:sections.footer.blocks.newsletter.settings.show_form.label",
          "info": "t:sections.footer.blocks.newsletter.settings.show_form.info",
          "default": true
        }
      ]
    },
    {
      "type": "menu",
      "name": "t:sections.footer.blocks.menu.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.menu.settings.heading.label"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:sections.footer.blocks.menu.settings.menu.label",
          "default": "footer"
        }
      ]
    },
    {
      "type": "payment",
      "name": "t:sections.footer.blocks.payment.name",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "placement",
          "label": "t:sections.footer.blocks.placement.label",
          "options": [
            { "value": "brand", "label": "t:sections.footer.blocks.placement.options__1.label" },
            { "value": "columns", "label": "t:sections.footer.blocks.placement.options__2.label" },
            { "value": "bottom", "label": "t:sections.footer.blocks.placement.options__3.label" }
          ],
          "default": "bottom"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "default": {
    "blocks": [
      { "type": "logo" },
      { "type": "brand" },
      { "type": "social" },
      { "type": "newsletter", "settings": { "heading": "Stay in the know" } },
      { "type": "menu", "settings": { "heading": "Menu" } },
      { "type": "payment" }
    ]
  },
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}