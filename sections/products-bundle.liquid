{%- comment -%}
  Section: Products Bundle
  Mô tả: Chọn nhiều sản phẩm → hiện tổng giá + "Add all to cart" 1 click.
{%- endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-bundle color-{{ section.settings.color_scheme }}"
  style="
    --bn-dt: {{ section.settings.padding_top_desktop }}px;
    --bn-db: {{ section.settings.padding_bottom_desktop }}px;
    --bn-mt: {{ section.settings.padding_top_mobile }}px;
    --bn-mb: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-bundle__head">
        {%- if section.settings.subheading != blank -%}
          <p class="section-bundle__subheading subheading-size-{{ section.settings.subheading_size }}">{{ section.settings.subheading }}</p>
        {%- endif -%}
        <{{ section.settings.heading_tag }} class="section-bundle__heading heading-size-{{ section.settings.heading_size }}">
          {{- section.settings.heading -}}
        </{{ section.settings.heading_tag }}>
      </div>
    {%- endif -%}

    {%- assign total_price = 0 -%}
    {%- assign items_data = '' -%}
    <div class="section-bundle__grid">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- if p != blank -%}
          {%- assign total_price = total_price | plus: p.price -%}
          {%- if items_data != '' -%}{%- assign items_data = items_data | append: ',' -%}{%- endif -%}
          {%- assign items_data = items_data | append: p.variants.first.id -%}
          <div class="section-bundle__product" {{ block.shopify_attributes }}>
            <a href="{{ p.url }}" class="section-bundle__product-link">
              {%- if p.featured_image -%}
                <div class="section-bundle__product-media">
                  {{ p.featured_image | image_url: width: 300 | image_tag:
                    loading: 'lazy', class: 'section-bundle__product-img'
                  }}
                </div>
              {%- endif -%}
              <div class="section-bundle__product-info">
                <span class="section-bundle__product-title">{{ p.title }}</span>
                <span class="section-bundle__product-price">{{ p.price | money }}</span>
              </div>
            </a>
          </div>
          {%- unless forloop.last -%}
            <div class="section-bundle__plus">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </div>
          {%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="section-bundle__summary">
      <div class="section-bundle__total">
        <span class="section-bundle__total-label">{{ 'general.bundle.total' | t | default: 'Bundle price' }}</span>
        <span class="section-bundle__total-price heading-size-md">{{ total_price | money }}</span>
        {%- if section.settings.discount_text != blank -%}
          <span class="section-bundle__discount-badge">{{ section.settings.discount_text }}</span>
        {%- endif -%}
      </div>
      <button
        class="section-bundle__add-all button-size-{{ section.settings.button_size }}"
        data-bundle-add
        data-variants="{{ items_data }}"
      >
        {{ section.settings.button_label | default: 'Add all to cart' }}
      </button>
    </div>
  </div>
</div>

<script>
(function() {
  var btn = document.querySelector('#section-{{ section.id }} [data-bundle-add]');
  if (!btn) return;
  btn.addEventListener('click', function() {
    var ids = btn.getAttribute('data-variants').split(',').filter(Boolean);
    if (!ids.length) return;
    btn.disabled = true;
    btn.textContent = '{{ "general.bundle.adding" | t | default: "Adding..." }}';
    var items = ids.map(function(id) { return { id: parseInt(id), quantity: 1 }; });
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items: items })
    })
    .then(function(r) { return r.json(); })
    .then(function() {
      btn.textContent = '{{ "general.bundle.added" | t | default: "Added! ✓" }}';
      setTimeout(function() {
        btn.textContent = '{{ section.settings.button_label | default: "Add all to cart" }}';
        btn.disabled = false;
      }, 2000);
    })
    .catch(function() {
      btn.textContent = '{{ "general.bundle.error" | t | default: "Error — try again" }}';
      btn.disabled = false;
    });
  });
})();
</script>

{% stylesheet %}
  .section-bundle {
    padding-block: var(--bn-mt) var(--bn-mb);
    background: rgb(var(--color-background));
    color: rgba(var(--color-foreground), 0.85);
  }
  @media (min-width: 750px) {
    .section-bundle { padding-block: var(--bn-dt) var(--bn-db); }
  }
  .section-bundle__head { text-align: center; margin-bottom: 2rem; }
  .section-bundle__subheading { margin: 0 0 0.25rem; text-transform: uppercase; letter-spacing: 0.12em; color: rgb(var(--color-accent)); font-weight: 600; }
  .section-bundle__heading { margin: 0; color: rgb(var(--color-foreground)); }

  .section-bundle__grid {
    display: flex; align-items: center; justify-content: center;
    flex-wrap: wrap; gap: 1rem;
  }

  .section-bundle__product { max-width: 200px; text-align: center; }
  .section-bundle__product-link { display: flex; flex-direction: column; gap: 0.5rem; text-decoration: none; color: inherit; }
  .section-bundle__product-media { border-radius: 0.5rem; overflow: hidden; aspect-ratio: 1; }
  .section-bundle__product-img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.4s;
  }
  .section-bundle__product-link:hover .section-bundle__product-img { transform: scale(1.05); }
  .section-bundle__product-info { display: flex; flex-direction: column; gap: 0.125rem; }
  .section-bundle__product-title { font-size: 0.8125rem; font-weight: 600; color: rgb(var(--color-foreground)); line-height: 1.3; }
  .section-bundle__product-price { font-size: 0.75rem; font-weight: 700; color: rgb(var(--color-accent)); }

  .section-bundle__plus { color: rgba(var(--color-foreground), 0.2); flex-shrink: 0; }

  .section-bundle__summary {
    display: flex; flex-direction: column; align-items: center; gap: 1rem;
    margin-top: 2rem; padding-top: 1.5rem;
    border-top: 1px solid rgba(var(--color-foreground), 0.08);
  }
  .section-bundle__total { display: flex; flex-direction: column; align-items: center; gap: 0.25rem; }
  .section-bundle__total-label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: rgba(var(--color-foreground), 0.5); font-weight: 600; }
  .section-bundle__total-price { font-weight: 800; color: rgb(var(--color-foreground)); }
  .section-bundle__discount-badge {
    display: inline-block; padding: 0.125rem 0.625rem; border-radius: 1rem;
    font-size: 0.6875rem; font-weight: 700; text-transform: uppercase;
    background: #dcfce7; color: #059669;
  }

  .section-bundle__add-all {
    background: rgb(var(--color-button)); color: rgb(var(--color-button-text));
    border: 1px solid rgb(var(--color-button)); border-radius: var(--buttons-radius, 0);
    font-weight: 700; cursor: pointer; transition: opacity 0.2s;
    min-width: 200px;
  }
  .section-bundle__add-all:hover { opacity: 0.85; }
  .section-bundle__add-all:disabled { opacity: 0.6; cursor: wait; }
{% endstylesheet %}

{% schema %}
{
  "name": "Products bundle",
  "tag": "section",
  "class": "section-bundle-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "Save when you bundle"
    },
    {
      "type": "select",
      "id": "subheading_size",
      "label": "Subheading size",
      "options": [
        {
          "value": "xs",
          "label": "XS"
        },
        {
          "value": "sm",
          "label": "S"
        }
      ],
      "default": "sm"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently bought together"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "md",
          "label": "M"
        },
        {
          "value": "lg",
          "label": "L"
        }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add all to cart"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "Button size",
      "options": [
        {
          "value": "md",
          "label": "M"
        },
        {
          "value": "lg",
          "label": "L"
        }
      ],
      "default": "lg"
    },
    {
      "type": "text",
      "id": "discount_text",
      "label": "Discount badge",
      "default": "Save 15%",
      "info": "Leave empty to hide"
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom",
      "default": 50
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "product_item",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Products bundle",
      "category": "Collection",
      "blocks": [
        {
          "type": "product_item"
        },
        {
          "type": "product_item"
        },
        {
          "type": "product_item"
        }
      ]
    }
  ]
}
