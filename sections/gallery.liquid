{{ 'section-gallery.css' | asset_url | stylesheet_tag }}
{%- comment %}
  Section: Gallery / Lookbook
  Responsive image gallery with optional lightbox.
{% endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-gallery color-{{ section.settings.color_scheme }}"
  style="
    --gal-dt: {{ section.settings.padding_top_desktop }}px;
    --gal-db: {{ section.settings.padding_bottom_desktop }}px;
    --gal-mt: {{ section.settings.padding_top_mobile }}px;
    --gal-mb: {{ section.settings.padding_bottom_mobile }}px;
    --gal-cols-d: {{ section.settings.columns_desktop }};
    --gal-cols-m: {{ section.settings.columns_mobile }};
  "
>
  <div class="{% if section.settings.section_width == 'fixed' %}page-width{% endif %}">
    {%- if section.settings.heading != blank -%}
      <div class="page-width">
        <div class="section-gallery__head">
          {%- if section.settings.subheading != blank -%}
            <p class="section-gallery__subheading subheading-size-sm">{{ section.settings.subheading }}</p>
          {%- endif -%}
          <{{ section.settings.heading_tag }} class="section-gallery__heading heading-size-{{ section.settings.heading_size }}">
            {{- section.settings.heading -}}
          </{{ section.settings.heading_tag }}>
        </div>
      </div>
    {%- endif -%}

    <div class="section-gallery__grid section-gallery__grid--{{ section.settings.layout }}">
      {%- assign gallery_index = 0 -%}
      {%- for block in section.blocks -%}
        <div class="section-gallery__item" {{ block.shopify_attributes }} data-gallery-item>
          {%- if block.settings.image != blank -%}
            {%- liquid
              assign item_label = block.settings.caption | default: block.settings.image.alt
              if item_label == blank
                assign item_label = 'accessibility.view_image' | t
              endif
            -%}
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="section-gallery__link" aria-label="{{ item_label | escape }}">
            {%- else -%}
              <button type="button" class="section-gallery__link" aria-label="{{ item_label | escape }}" data-gallery-open="{{ gallery_index }}">
            {%- endif -%}
              {{ block.settings.image | image_url: width: 900 | image_tag:
                widths: '300, 450, 600, 900',
                sizes: '(max-width: 749px) 50vw, 25vw',
                loading: 'lazy', decoding: 'async',
                class: 'section-gallery__img'
              }}
              {%- if block.settings.caption != blank -%}
                <div class="section-gallery__caption">
                  <span>{{ block.settings.caption }}</span>
                </div>
              {%- endif -%}
            {%- if block.settings.link != blank -%}</a>{%- else -%}</button>{%- endif -%}
          {%- else -%}
            <div class="section-gallery__ph">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>
          {%- endif -%}
        </div>
        {%- assign gallery_index = gallery_index | plus: 1 -%}
      {%- endfor -%}
    </div>
  </div>

  {%- comment %} Lightbox {% endcomment -%}
  <div class="section-gallery__lightbox" data-gallery-lightbox role="dialog" aria-modal="true" aria-label="{{ 'accessibility.image_lightbox' | t }}" hidden>
    <button class="section-gallery__lightbox-close" data-gallery-close aria-label="{{ 'accessibility.close' | t }}">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <img class="section-gallery__lightbox-img" data-gallery-lightbox-img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg'/%3E" alt="" width="900" height="900" loading="lazy">
  </div>
</div>

<script>
(function() {
  var w = document.getElementById('section-{{ section.id }}');
  if (!w) return;
  var lb = w.querySelector('[data-gallery-lightbox]');
  var lbImg = w.querySelector('[data-gallery-lightbox-img]');
  var items = w.querySelectorAll('[data-gallery-open]');

  items.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var img = btn.querySelector('img');
      if (!img) return;
      lbImg.src = img.currentSrc || img.src;
      lbImg.alt = img.alt || btn.getAttribute('aria-label') || '';
      lb.hidden = false;
      if (window.ThemeUtils) {
        ThemeUtils.lockScroll();
        ThemeUtils.trapFocus(lb, btn);
      }
    });
  });

  var closeLightbox = function() {
    lb.hidden = true;
    if (window.ThemeUtils) {
      ThemeUtils.unlockScroll();
      ThemeUtils.releaseFocus(lb);
    }
  };
  w.querySelector('[data-gallery-close]').addEventListener('click', closeLightbox);
  lb.addEventListener('click', function(e) {
    if (e.target === lb) closeLightbox();
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && !lb.hidden) closeLightbox();
  });
})();
</script>


{% schema %}
{
