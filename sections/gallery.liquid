{%- comment %}
  Section: Gallery / Lookbook
  Responsive image gallery with optional lightbox.
{% endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-gallery color-{{ section.settings.color_scheme }}"
  style="
    --gal-dt: {{ section.settings.padding_top_desktop }}px;
    --gal-db: {{ section.settings.padding_bottom_desktop }}px;
    --gal-mt: {{ section.settings.padding_top_mobile }}px;
    --gal-mb: {{ section.settings.padding_bottom_mobile }}px;
    --gal-cols-d: {{ section.settings.columns_desktop }};
    --gal-cols-m: {{ section.settings.columns_mobile }};
  "
>
  <div class="{% if section.settings.section_width == 'fixed' %}page-width{% endif %}">
    {%- if section.settings.heading != blank -%}
      <div class="page-width">
        <div class="section-gallery__head">
          {%- if section.settings.subheading != blank -%}
            <p class="section-gallery__subheading subheading-size-sm">{{ section.settings.subheading }}</p>
          {%- endif -%}
          <{{ section.settings.heading_tag }} class="section-gallery__heading heading-size-{{ section.settings.heading_size }}">
            {{- section.settings.heading -}}
          </{{ section.settings.heading_tag }}>
        </div>
      </div>
    {%- endif -%}

    <div class="section-gallery__grid section-gallery__grid--{{ section.settings.layout }}">
      {%- assign gallery_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}{%- continue -%}{%- endif -%}
        <div class="section-gallery__item" {{ block.shopify_attributes }} data-gallery-item>
          {%- if block.settings.image != blank -%}
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="section-gallery__link">
            {%- else -%}
              <button type="button" class="section-gallery__link" data-gallery-open="{{ gallery_index }}">
            {%- endif -%}
              {{ block.settings.image | image_url: width: 900 | image_tag:
                widths: '300, 450, 600, 900',
                sizes: '(max-width: 749px) 50vw, 25vw',
                loading: 'lazy', decoding: 'async',
                class: 'section-gallery__img'
              }}
              {%- if block.settings.caption != blank -%}
                <div class="section-gallery__caption">
                  <span>{{ block.settings.caption }}</span>
                </div>
              {%- endif -%}
            {%- if block.settings.link != blank -%}</a>{%- else -%}</button>{%- endif -%}
          {%- else -%}
            <div class="section-gallery__ph">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>
          {%- endif -%}
        </div>
        {%- assign gallery_index = gallery_index | plus: 1 -%}
      {%- endfor -%}
    </div>
    {%- capture app_blocks -%}
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}{%- render block -%}{%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if app_blocks != blank -%}
      <div class="section-apps">{{ app_blocks }}</div>
    {%- endif -%}
  </div>

  {%- comment %} Lightbox {% endcomment -%}
  <div class="section-gallery__lightbox" data-gallery-lightbox role="dialog" aria-modal="true" aria-label="{{ 'accessibility.image_lightbox' | t }}" hidden>
    <button class="section-gallery__lightbox-close" data-gallery-close aria-label="{{ 'accessibility.close' | t }}">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <img class="section-gallery__lightbox-img" data-gallery-lightbox-img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg'/%3E" alt="" width="900" height="900" loading="lazy">
  </div>
</div>

<script>
(function() {
  var w = document.getElementById('section-{{ section.id }}');
  if (!w) return;
  var lb = w.querySelector('[data-gallery-lightbox]');
  var lbImg = w.querySelector('[data-gallery-lightbox-img]');
  var items = w.querySelectorAll('[data-gallery-open]');

  items.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var img = btn.querySelector('img');
      if (!img) return;
      lbImg.src = img.currentSrc || img.src;
      lbImg.alt = img.alt;
      lb.hidden = false;
      if (window.ThemeUtils) ThemeUtils.lockScroll();
    });
  });

  var closeLightbox = function() {
    lb.hidden = true;
    if (window.ThemeUtils) ThemeUtils.unlockScroll();
  };
  w.querySelector('[data-gallery-close]').addEventListener('click', closeLightbox);
  lb.addEventListener('click', function(e) {
    if (e.target === lb) closeLightbox();
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && !lb.hidden) closeLightbox();
  });
})();
</script>

{% stylesheet %}
  .section-gallery {
    padding-block: var(--gal-mt) var(--gal-mb);
    background: rgb(var(--color-background));
  }
  @media (min-width: 750px) {
    .section-gallery { padding-block: var(--gal-dt) var(--gal-db); }
  }
  .section-gallery__head { text-align: center; margin-bottom: var(--section-head-gap); }
  .section-gallery__subheading {
    margin: 0 0 0.5rem;
    font-size: var(--eyebrow-size);
    font-weight: var(--eyebrow-weight);
    letter-spacing: var(--eyebrow-tracking);
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .section-gallery__heading { margin: 0; color: var(--color-ink); letter-spacing: var(--heading-tracking); }

  .section-gallery__grid {
    display: grid;
    grid-template-columns: repeat(var(--gal-cols-m, 2), 1fr);
    gap: 6px;
  }
  @media (min-width: 750px) {
    .section-gallery__grid {
      grid-template-columns: repeat(var(--gal-cols-d, 4), 1fr);
      gap: 8px;
    }
  }
  .section-gallery__grid--uniform .section-gallery__item { aspect-ratio: 1; }

  .section-gallery__item { overflow: hidden; position: relative; border-radius: var(--media-radius); border: var(--media-border); box-shadow: var(--media-shadow); }
  .section-gallery__link {
    display: block; width: 100%; height: 100%;
    border: none; padding: 0; background: none; cursor: pointer;
    position: relative;
  }

  .section-gallery__link:focus-visible,
  .section-gallery__lightbox-close:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .section-gallery__img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform var(--duration-long) ease;
  }
  @media (hover: hover) {
    .section-gallery__item:hover .section-gallery__img { transform: scale(1.05); }
  }

  .section-gallery__caption {
    position: absolute; inset: 0;
    display: flex; align-items: flex-end; padding: 1rem;
    background: linear-gradient(to top, rgba(0,0,0,0.5) 0%, transparent 50%);
    opacity: 0; transition: opacity var(--duration-medium);
    color: var(--color-white); font-size: 0.8125rem; font-weight: 600;
  }
  .section-gallery__item:hover .section-gallery__caption { opacity: 1; }

  .section-gallery__ph {
    aspect-ratio: 1; background: rgba(var(--color-foreground), 0.04);
    display: flex; align-items: center; justify-content: center;
  }
  .section-gallery__ph svg { width: 40%; opacity: 0.1; }

  /* Lightbox */
  .section-gallery__lightbox {
    position: fixed; inset: 0; z-index: var(--z-modal, 9000);
    background: rgba(0,0,0,0.9);
    display: flex; align-items: center; justify-content: center;
    padding: 2rem;
  }
  .section-gallery__lightbox[hidden] { display: none; }
  .section-gallery__lightbox-close {
    position: absolute; top: 1rem; right: 1rem;
    background: none; border: none; color: var(--color-white);
    cursor: pointer; z-index: 2;
  }
  .section-gallery__lightbox-img {
    max-width: 90vw; max-height: 90vh; object-fit: contain; border-radius: var(--media-radius);
  }
{% endstylesheet %}

{% schema %}
