{%- comment -%}
  Section: Press / As seen in
  Mô tả: Logo báo chí + trích dẫn — social proof.
{%- endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-press color-{{ section.settings.color_scheme }}"
  style="
    --pr-dt: {{ section.settings.padding_top_desktop }}px;
    --pr-db: {{ section.settings.padding_bottom_desktop }}px;
    --pr-mt: {{ section.settings.padding_top_mobile }}px;
    --pr-mb: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-press__head">
        <p class="section-press__heading subheading-size-{{ section.settings.heading_size }}">{{ section.settings.heading }}</p>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="section-press__grid">
        {%- for block in section.blocks -%}
          <div class="section-press__item" {{ block.shopify_attributes }}>
            {%- if block.settings.logo != blank -%}
              <div class="section-press__logo">
                {{ block.settings.logo | image_url: height: 80 | image_tag:
                  loading: 'lazy', class: 'section-press__logo-img',
                  alt: block.settings.source | default: 'Press'
                }}
              </div>
            {%- endif -%}
            {%- if block.settings.quote != blank -%}
              <blockquote class="section-press__quote content-size-{{ section.settings.quote_size }}">
                "{{ block.settings.quote }}"
              </blockquote>
            {%- endif -%}
            {%- if block.settings.source != blank -%}
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" target="_blank" rel="noopener" class="section-press__source">— {{ block.settings.source }}</a>
              {%- else -%}
                <cite class="section-press__source">— {{ block.settings.source }}</cite>
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .section-press {
    padding-block: var(--pr-mt) var(--pr-mb);
    background: rgb(var(--color-background));
    color: rgba(var(--color-foreground), 0.85);
  }
  @media (min-width: 750px) {
    .section-press { padding-block: var(--pr-dt) var(--pr-db); }
  }
  .section-press__head { text-align: center; margin-bottom: 2rem; }
  .section-press__heading {
    margin: 0; text-transform: uppercase; letter-spacing: 0.12em;
    color: rgba(var(--color-foreground), 0.4); font-weight: 600;
  }

  .section-press__grid {
    display: grid; grid-template-columns: 1fr; gap: 2rem;
  }
  @media (min-width: 750px) {
    .section-press__grid { grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2.5rem; }
  }

  .section-press__item {
    display: flex; flex-direction: column; align-items: center;
    text-align: center; gap: 0.75rem;
  }

  .section-press__logo { height: 2rem; margin-bottom: 0.25rem; }
  .section-press__logo-img {
    height: 100%; width: auto; object-fit: contain;
    filter: grayscale(1); opacity: 0.5;
    transition: filter 0.3s, opacity 0.3s;
  }
  .section-press__item:hover .section-press__logo-img {
    filter: grayscale(0); opacity: 1;
  }

  .section-press__quote {
    margin: 0; font-style: italic;
    color: rgba(var(--color-foreground), 0.7);
    line-height: 1.6; max-width: 24rem;
  }

  .section-press__source {
    font-size: 0.75rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.06em;
    color: rgba(var(--color-foreground), 0.4);
    font-style: normal; text-decoration: none;
    transition: color 0.3s;
  }
  a.section-press__source:hover { color: rgb(var(--color-accent)); }
{% endstylesheet %}

{% schema %}
{
  "name": "Press",
  "tag": "section",
  "class": "section-press-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "As seen in"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "xs",
          "label": "XS"
        },
        {
          "value": "sm",
          "label": "S"
        },
        {
          "value": "md",
          "label": "M"
        }
      ],
      "default": "sm"
    },
    {
      "type": "select",
      "id": "quote_size",
      "label": "Quote size",
      "options": [
        {
          "value": "sm",
          "label": "S"
        },
        {
          "value": "md",
          "label": "M"
        }
      ],
      "default": "sm"
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom",
      "default": 40
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top",
      "default": 25
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom",
      "default": 25
    }
  ],
  "blocks": [
    {
      "type": "press_item",
      "name": "Press mention",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Publication logo"
        },
        {
          "type": "text",
          "id": "quote",
          "label": "Quote",
          "default": "A must-have brand for anyone who values quality craftsmanship."
        },
        {
          "type": "text",
          "id": "source",
          "label": "Source name",
          "default": "Vogue"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Article link"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Press",
      "category": "Custom",
      "blocks": [
        {
          "type": "press_item",
          "settings": {
            "quote": "A must-have brand for anyone who values quality craftsmanship.",
            "source": "Vogue"
          }
        },
        {
          "type": "press_item",
          "settings": {
            "quote": "Beautifully designed products that stand the test of time.",
            "source": "GQ"
          }
        },
        {
          "type": "press_item",
          "settings": {
            "quote": "The perfect blend of form and function.",
            "source": "Forbes"
          }
        }
      ]
    }
  ]
}
{% endschema %}
