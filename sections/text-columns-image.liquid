{%- comment -%}
  Section: Text Columns with Image
  Mô tả: 2-3 cột text + 1 ảnh lớn — editorial/magazine layout.
{%- endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-textcol color-{{ section.settings.color_scheme }}"
  style="
    --tc-dt: {{ section.settings.padding_top_desktop }}px;
    --tc-db: {{ section.settings.padding_bottom_desktop }}px;
    --tc-mt: {{ section.settings.padding_top_mobile }}px;
    --tc-mb: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-textcol__head">
        {%- if section.settings.subheading != blank -%}
          <p class="section-textcol__subheading subheading-size-{{ section.settings.subheading_size }}">{{ section.settings.subheading }}</p>
        {%- endif -%}
        <{{ section.settings.heading_tag }} class="section-textcol__heading heading-size-{{ section.settings.heading_size }}">
          {{- section.settings.heading -}}
        </{{ section.settings.heading_tag }}>
      </div>
    {%- endif -%}

    <div class="section-textcol__grid section-textcol__grid--{{ section.settings.layout }}">
      {%- if section.settings.image != blank -%}
        <div class="section-textcol__image">
          {{ section.settings.image | image_url: width: 800 | image_tag:
            loading: 'lazy', class: 'section-textcol__img'
          }}
        </div>
      {%- endif -%}

      <div class="section-textcol__columns">
        {%- for block in section.blocks -%}
          <div class="section-textcol__col" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h3 class="section-textcol__col-title">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="section-textcol__col-text content-size-{{ block.settings.text_size }}">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .section-textcol {
    padding-block: var(--tc-mt) var(--tc-mb);
    background: rgb(var(--color-background));
    color: rgba(var(--color-foreground), 0.85);
  }
  @media (min-width: 750px) {
    .section-textcol { padding-block: var(--tc-dt) var(--tc-db); }
  }
  .section-textcol__head { text-align: center; margin-bottom: 2.5rem; }
  .section-textcol__subheading { margin: 0 0 0.25rem; text-transform: uppercase; letter-spacing: 0.12em; color: rgb(var(--color-accent)); font-weight: 600; }
  .section-textcol__heading { margin: 0; color: rgb(var(--color-foreground)); }

  .section-textcol__grid { display: grid; gap: 2rem; }
  @media (min-width: 990px) {
    .section-textcol__grid--image-left { grid-template-columns: 1fr 1.2fr; }
    .section-textcol__grid--image-right { grid-template-columns: 1.2fr 1fr; }
    .section-textcol__grid--image-right .section-textcol__image { order: 2; }
    .section-textcol__grid--image-right .section-textcol__columns { order: 1; }
    .section-textcol__grid { gap: 3rem; align-items: center; }
  }

  .section-textcol__image { border-radius: 0.75rem; overflow: hidden; }
  .section-textcol__img { width: 100%; height: auto; display: block; }

  .section-textcol__columns {
    display: flex; flex-direction: column; gap: 1.5rem;
  }
  @media (min-width: 750px) {
    .section-textcol__grid--image-center .section-textcol__columns {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem;
    }
  }

  .section-textcol__col { display: flex; flex-direction: column; gap: 0.375rem; }
  .section-textcol__col-title {
    margin: 0; font-size: 0.9375rem; font-weight: 700;
    color: rgb(var(--color-foreground)); line-height: 1.3;
  }
  .section-textcol__col-text { color: rgba(var(--color-foreground), 0.65); line-height: 1.7; }
  .section-textcol__col-text p { margin: 0; }
{% endstylesheet %}

{% schema %}
{
  "name": "Text columns with image",
  "tag": "section",
  "class": "section-textcol-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "subheading_size",
      "label": "Subheading size",
      "options": [
        {
          "value": "xs",
          "label": "XS"
        },
        {
          "value": "sm",
          "label": "S"
        }
      ],
      "default": "sm"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Our story"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "md",
          "label": "M"
        },
        {
          "value": "lg",
          "label": "L"
        }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Tag",
      "options": [
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "image-left",
          "label": "Image left"
        },
        {
          "value": "image-right",
          "label": "Image right"
        },
        {
          "value": "image-center",
          "label": "Image top, columns below"
        }
      ],
      "default": "image-left"
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom",
      "default": 60
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Our mission"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>We believe in creating products that combine beauty with functionality.</p>"
        },
        {
          "type": "select",
          "id": "text_size",
          "label": "Text size",
          "options": [
            {
              "value": "sm",
              "label": "S"
            },
            {
              "value": "md",
              "label": "M"
            }
          ],
          "default": "sm"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Text columns with image",
      "category": "Custom",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "heading": "Our mission",
            "text": "<p>We create beautifully crafted products that bring joy to everyday life.</p>"
          }
        },
        {
          "type": "column",
          "settings": {
            "heading": "Our values",
            "text": "<p>Sustainability, quality, and customer satisfaction drive everything we do.</p>"
          }
        },
        {
          "type": "column",
          "settings": {
            "heading": "Our promise",
            "text": "<p>Every product comes with our lifetime guarantee and 24/7 support.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
