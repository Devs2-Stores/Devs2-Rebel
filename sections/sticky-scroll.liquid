{%- comment -%}
  Section: Sticky Scroll Reveal
  Mô tả: Cột trái sticky, cột phải scroll qua nhiều content blocks.
{%- endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-sticky-scroll color-{{ section.settings.color_scheme }}"
  style="
    --ss-dt: {{ section.settings.padding_top_desktop }}px;
    --ss-db: {{ section.settings.padding_bottom_desktop }}px;
    --ss-mt: {{ section.settings.padding_top_mobile }}px;
    --ss-mb: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="page-width">
    <div class="section-sticky-scroll__grid section-sticky-scroll__grid--{{ section.settings.sticky_side }}">
      {%- comment -%} Sticky column {%- endcomment -%}
      <div class="section-sticky-scroll__sticky">
        {%- if section.settings.sticky_image != blank -%}
          <div class="section-sticky-scroll__media">
            {{ section.settings.sticky_image | image_url: width: 800 | image_tag:
              loading: 'lazy', class: 'section-sticky-scroll__img'
            }}
          </div>
        {%- endif -%}
        {%- if section.settings.sticky_heading != blank -%}
          <{{ section.settings.heading_tag }} class="section-sticky-scroll__heading heading-size-{{ section.settings.heading_size }}">
            {{- section.settings.sticky_heading -}}
          </{{ section.settings.heading_tag }}>
        {%- endif -%}
        {%- if section.settings.sticky_text != blank -%}
          <p class="section-sticky-scroll__text content-size-{{ section.settings.text_size }}">{{ section.settings.sticky_text }}</p>
        {%- endif -%}
      </div>

      {%- comment -%} Scroll column {%- endcomment -%}
      <div class="section-sticky-scroll__scroll">
        {%- for block in section.blocks -%}
          <div class="section-sticky-scroll__item" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="section-sticky-scroll__item-media">
                {{ block.settings.image | image_url: width: 600 | image_tag:
                  loading: 'lazy', class: 'section-sticky-scroll__item-img'
                }}
              </div>
            {%- endif -%}
            {%- if block.settings.number != blank -%}
              <span class="section-sticky-scroll__item-num">{{ block.settings.number }}</span>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h3 class="section-sticky-scroll__item-heading heading-size-{{ block.settings.heading_size }}">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="section-sticky-scroll__item-text content-size-{{ block.settings.text_size }}">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .section-sticky-scroll {
    padding-block: var(--ss-mt) var(--ss-mb);
    background: rgb(var(--color-background));
    color: rgba(var(--color-foreground), 0.85);
  }
  @media (min-width: 750px) {
    .section-sticky-scroll { padding-block: var(--ss-dt) var(--ss-db); }
  }

  .section-sticky-scroll__grid { display: grid; gap: 2rem; }
  @media (min-width: 990px) {
    .section-sticky-scroll__grid { grid-template-columns: 1fr 1fr; gap: 4rem; }
    .section-sticky-scroll__grid--right .section-sticky-scroll__sticky { order: 2; }
    .section-sticky-scroll__grid--right .section-sticky-scroll__scroll { order: 1; }
  }

  .section-sticky-scroll__sticky {
    display: flex; flex-direction: column; gap: 1rem;
  }
  @media (min-width: 990px) {
    .section-sticky-scroll__sticky {
      position: sticky; top: 6rem; align-self: start;
    }
  }

  .section-sticky-scroll__media { border-radius: 0.5rem; overflow: hidden; }
  .section-sticky-scroll__img { width: 100%; height: auto; display: block; }
  .section-sticky-scroll__heading { margin: 0; color: rgb(var(--color-foreground)); line-height: 1.2; }
  .section-sticky-scroll__text { margin: 0; color: rgba(var(--color-foreground), 0.7); line-height: 1.7; }

  .section-sticky-scroll__scroll {
    display: flex; flex-direction: column; gap: 2.5rem;
  }
  @media (min-width: 990px) {
    .section-sticky-scroll__scroll { gap: 3.5rem; }
  }

  .section-sticky-scroll__item {
    display: flex; flex-direction: column; gap: 0.625rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.08);
  }
  .section-sticky-scroll__item:last-child { border-bottom: none; padding-bottom: 0; }

  .section-sticky-scroll__item-media { border-radius: 0.5rem; overflow: hidden; }
  .section-sticky-scroll__item-img { width: 100%; height: auto; display: block; }

  .section-sticky-scroll__item-num {
    font-size: 2.5rem; font-weight: 800; color: rgba(var(--color-accent), 0.2);
    line-height: 1; font-variant-numeric: tabular-nums;
  }
  .section-sticky-scroll__item-heading { margin: 0; color: rgb(var(--color-foreground)); line-height: 1.3; }
  .section-sticky-scroll__item-text { color: rgba(var(--color-foreground), 0.7); line-height: 1.7; }
  .section-sticky-scroll__item-text p { margin: 0; }
{% endstylesheet %}

{% schema %}
{
  "name": "Sticky scroll reveal",
  "tag": "section",
  "class": "section-sticky-scroll-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Sticky column"
    },
    {
      "type": "image_picker",
      "id": "sticky_image",
      "label": "Image"
    },
    {
      "type": "inline_richtext",
      "id": "sticky_heading",
      "label": "Heading",
      "default": "Why choose us"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "md",
          "label": "M"
        },
        {
          "value": "lg",
          "label": "L"
        },
        {
          "value": "xl",
          "label": "XL"
        }
      ],
      "default": "xl"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ],
      "default": "h2"
    },
    {
      "type": "inline_richtext",
      "id": "sticky_text",
      "label": "Text",
      "default": "We're committed to quality, sustainability, and your satisfaction."
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Text size",
      "options": [
        {
          "value": "sm",
          "label": "S"
        },
        {
          "value": "md",
          "label": "M"
        }
      ],
      "default": "md"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "sticky_side",
      "label": "Sticky column position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom",
      "default": 60
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "content_block",
      "name": "Content block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "number",
          "label": "Step number",
          "info": "E.g. 01, 02"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "Premium materials"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "options": [
            {
              "value": "sm",
              "label": "S"
            },
            {
              "value": "md",
              "label": "M"
            }
          ],
          "default": "md"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>We source only the finest materials from trusted suppliers worldwide.</p>"
        },
        {
          "type": "select",
          "id": "text_size",
          "label": "Text size",
          "options": [
            {
              "value": "sm",
              "label": "S"
            },
            {
              "value": "md",
              "label": "M"
            }
          ],
          "default": "md"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Sticky scroll reveal",
      "category": "Custom",
      "blocks": [
        {
          "type": "content_block",
          "settings": {
            "number": "01",
            "heading": "Premium materials",
            "text": "<p>We source only the finest materials from trusted suppliers worldwide.</p>"
          }
        },
        {
          "type": "content_block",
          "settings": {
            "number": "02",
            "heading": "Expert craftsmanship",
            "text": "<p>Each piece is carefully handcrafted by skilled artisans with decades of experience.</p>"
          }
        },
        {
          "type": "content_block",
          "settings": {
            "number": "03",
            "heading": "Sustainable practices",
            "text": "<p>Our commitment to the environment drives every decision we make.</p>"
          }
        },
        {
          "type": "content_block",
          "settings": {
            "number": "04",
            "heading": "Lifetime warranty",
            "text": "<p>We stand behind our products with a comprehensive lifetime warranty.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
