{{ 'section-featured-collection.css' | asset_url | stylesheet_tag }}
{%- if section.settings.layout == 'editorial' -%}
  {{ 'section-list-layouts.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{%- comment %}
  Section: Featured Collection
  Shows products from one collection as a grid or slider.
  Reuses snippets/product-card.liquid.
{% endcomment -%}

{%- liquid
  assign collection = section.settings.collection
  assign products_to_show = section.settings.products_to_show
  assign columns_desktop = section.settings.columns_desktop
  assign columns_mobile = section.settings.columns_mobile
  assign layout = section.settings.layout
  assign show_view_all = section.settings.show_view_all

  assign show_vendor = section.settings.show_vendor
  assign show_secondary_image = section.settings.show_secondary_image
  assign image_ratio = section.settings.image_ratio
-%}

<script src="{{ 'product-card.js' | asset_url }}" defer="defer"></script>
<div
  id="section-{{ section.id }}"
  class="section-featured-collection color-{{ section.settings.color_scheme }}"
  style="
    --fc-dt: {{ section.settings.padding_top_desktop }}px;
    --fc-db: {{ section.settings.padding_bottom_desktop }}px;
    --fc-mt: {{ section.settings.padding_top_mobile }}px;
    --fc-mb: {{ section.settings.padding_bottom_mobile }}px;
    --fc-columns-d: {{ columns_desktop }};
    --fc-columns-m: {{ columns_mobile }};
  "
>
  <div class="page-width">
    {%- comment %} Header {% endcomment -%}
    {%- if section.settings.heading != blank or show_view_all -%}
      <div class="section-featured-collection__head">
        <div class="section-featured-collection__head-left">
          {%- if section.settings.subheading != blank -%}
            <p class="section-featured-collection__subheading subheading-size-{{ section.settings.subheading_size }}">
              {{- section.settings.subheading -}}
            </p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <{{ section.settings.heading_tag }}
              class="section-featured-collection__heading heading-size-{{ section.settings.heading_size }}"
            >
              {{- section.settings.heading -}}
            </{{ section.settings.heading_tag }}>
          {%- endif -%}
        </div>
        {%- if show_view_all and collection != blank -%}
          <a href="{{ collection.url }}" class="section-featured-collection__view-all">
            {{ 'general.view_all' | t }}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment %} Products {% endcomment -%}
    {%- if collection != blank and collection.products.size > 0 -%}
      {%- if layout == 'slider' -%}
        <div class="section-featured-collection__slider">
          <div class="section-featured-collection__swiper swiper" data-fc-slider>
            <div class="swiper-wrapper">
              {%- for product in collection.products limit: products_to_show -%}
                <div class="swiper-slide">
                  {%- render 'product-card',
                    product: product,
                    show_vendor: show_vendor,
                    show_secondary_image: show_secondary_image,
                    image_ratio: image_ratio
                  -%}
                </div>
              {%- endfor -%}
            </div>
          </div>
          <button class="section-featured-collection__nav section-featured-collection__nav--prev" aria-label="{{ 'accessibility.previous_slide' | t }}">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          <button class="section-featured-collection__nav section-featured-collection__nav--next" aria-label="{{ 'accessibility.next_slide' | t }}">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>
      {%- else -%}
        <div
          class="section-featured-collection__grid"
          {%- if layout == 'editorial' %} data-list-layout="editorial"{% endif %}
        >
          {%- for product in collection.products limit: products_to_show -%}
            {%- render 'product-card',
              product: product,
              show_vendor: show_vendor,
              show_secondary_image: show_secondary_image,
              columns: columns_desktop,
              columns_mobile: columns_mobile,
              image_ratio: image_ratio
            -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="section-featured-collection__grid">
        {%- for i in (1..products_to_show) -%}
          <div class="section-featured-collection__placeholder">
            {{ 'product-1' | placeholder_svg_tag: 'section-featured-collection__placeholder-svg' }}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{%- if layout == 'slider' -%}
<script>
  (function() {
    var wrapper = document.getElementById('section-{{ section.id }}');
    if (!wrapper) return;
    var el = wrapper.querySelector('[data-fc-slider]');
    if (!el) return;
    var initialized = false;
    var initialize = function() {
      if (initialized) return;
      initialized = true;
      (window.swiperReady || function(cb){ cb(); })(function(){
        new Swiper(el, {
          slidesPerView: {{ columns_mobile }},
          spaceBetween: 12,
          speed: 600,
          breakpoints: {
            750: { slidesPerView: 3, spaceBetween: 16 },
            1024: { slidesPerView: {{ columns_desktop }}, spaceBetween: 20 }
          },
          navigation: {
            prevEl: wrapper.querySelector('.section-featured-collection__nav--prev'),
            nextEl: wrapper.querySelector('.section-featured-collection__nav--next')
          }
        });
      });
    };
    if (!('IntersectionObserver' in window)) {
      initialize();
      return;
    }
    var observer = new IntersectionObserver(function(entries) {
      if (!entries[0].isIntersecting) return;
      observer.disconnect();
      initialize();
    }, { rootMargin: '300px 0px' });
    observer.observe(wrapper);
  })();
</script>
{%- endif -%}


{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "tag": "section",
  "class": "section-featured-collection-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.featured_collection.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured_collection.settings.collection.label"
    },
    {
      "type": "header",
      "content": "t:sections.featured_collection.settings.header__heading.content"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:sections.featured_collection.settings.subheading.label"
    },
    {
      "type": "select",
      "id": "subheading_size",
      "label": "t:sections.featured_collection.settings.subheading_size.label",
      "options": [
        {
          "value": "xs",
          "label": "t:sections.featured_collection.settings.subheading_size.options.xs"
        },
        {
          "value": "sm",
          "label": "t:sections.featured_collection.settings.subheading_size.options.sm"
        },
        {
          "value": "md",
          "label": "t:sections.featured_collection.settings.subheading_size.options.md"
        },
        {
          "value": "lg",
          "label": "t:sections.featured_collection.settings.subheading_size.options.lg"
        }
      ],
      "default": "sm"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.featured_collection.settings.heading.label",
      "default": "t:sections.featured_collection.settings.heading.default"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.featured_collection.settings.heading_size.label",
      "options": [
        {
          "value": "xs",
          "label": "t:sections.featured_collection.settings.heading_size.options.xs"
        },
        {
          "value": "sm",
          "label": "t:sections.featured_collection.settings.heading_size.options.sm"
        },
        {
          "value": "md",
          "label": "t:sections.featured_collection.settings.heading_size.options.md"
        },
        {
          "value": "lg",
          "label": "t:sections.featured_collection.settings.heading_size.options.lg"
        },
        {
          "value": "xl",
          "label": "t:sections.featured_collection.settings.heading_size.options.xl"
        },
        {
          "value": "2xl",
          "label": "t:sections.featured_collection.settings.heading_size.options._2xl"
        }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.featured_collection.settings.heading_tag.label",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.featured_collection.settings.heading_tag.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.featured_collection.settings.heading_tag.options.h3"
        },
        {
          "value": "p",
          "label": "t:sections.featured_collection.settings.heading_tag.options.p"
        }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "t:sections.featured_collection.settings.header__layout.content"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.featured_collection.settings.layout.label",
      "options": [
        {
          "value": "grid",
          "label": "t:sections.featured_collection.settings.layout.options.grid"
        },
        {
          "value": "slider",
          "label": "t:sections.featured_collection.settings.layout.options.slider"
        },
        {
          "value": "editorial",
          "label": "t:sections.featured_collection.settings.layout.options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "t:sections.featured_collection.settings.products_to_show.label",
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "t:sections.featured_collection.settings.columns_desktop.label",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "t:sections.featured_collection.settings.columns_mobile.label",
      "default": 2
