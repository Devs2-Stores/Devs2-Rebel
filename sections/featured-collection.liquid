    {
      "type": "header",
      "content": "t:sections.featured_collection.settings.header__product_card.content"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.featured_collection.settings.image_ratio.label",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.featured_collection.settings.image_ratio.options.adapt"
        },
        {
          "value": "portrait",
          "label": "t:sections.featured_collection.settings.image_ratio.options.portrait"
        },
        {
          "value": "square",
          "label": "t:sections.featured_collection.settings.image_ratio.options.square"
        },
        {
          "value": "landscape",
          "label": "t:sections.featured_collection.settings.image_ratio.options.landscape"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:sections.featured_collection.settings.show_vendor.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "t:sections.featured_collection.settings.show_secondary_image.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.featured_collection.settings.header__desktop_spacing.content"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "t:sections.featured_collection.settings.padding_top_desktop.label",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "t:sections.featured_collection.settings.padding_bottom_desktop.label",
      "default": 50
    },
    {
      "type": "header",
      "content": "t:sections.featured_collection.settings.header__mobile_spacing.content"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:sections.featured_collection.settings.padding_top_mobile.label",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:sections.featured_collection.settings.padding_bottom_mobile.label",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_collection.presets.featured_collection.name",
      "category": "t:categories.collections"
    }
  ]
}
{% endschema %}
