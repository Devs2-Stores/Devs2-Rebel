{%- comment -%}
  Section: Featured Collection
  Mô tả: Hiển thị sản phẩm từ 1 collection dưới dạng grid hoặc slider.
  Tái sử dụng snippet product-card.liquid.
{%- endcomment -%}

{%- liquid
  assign collection = section.settings.collection
  assign products_to_show = section.settings.products_to_show
  assign columns_desktop = section.settings.columns_desktop
  assign columns_mobile = section.settings.columns_mobile
  assign layout = section.settings.layout
  assign show_view_all = section.settings.show_view_all

  assign show_vendor = section.settings.show_vendor
  assign show_secondary_image = section.settings.show_secondary_image
  assign image_ratio = section.settings.image_ratio
-%}

<div
  id="section-{{ section.id }}"
  class="section-featured-collection color-{{ section.settings.color_scheme }}"
  style="
    --fc-dt: {{ section.settings.padding_top_desktop }}px;
    --fc-db: {{ section.settings.padding_bottom_desktop }}px;
    --fc-mt: {{ section.settings.padding_top_mobile }}px;
    --fc-mb: {{ section.settings.padding_bottom_mobile }}px;
    --fc-columns-d: {{ columns_desktop }};
    --fc-columns-m: {{ columns_mobile }};
  "
>
  <div class="page-width">
    {%- comment -%} Header {%- endcomment -%}
    {%- if section.settings.heading != blank or show_view_all -%}
      <div class="section-featured-collection__head">
        <div class="section-featured-collection__head-left">
          {%- if section.settings.subheading != blank -%}
            <p class="section-featured-collection__subheading subheading-size-{{ section.settings.subheading_size }}">
              {{- section.settings.subheading -}}
            </p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <{{ section.settings.heading_tag }}
              class="section-featured-collection__heading heading-size-{{ section.settings.heading_size }}"
            >
              {{- section.settings.heading -}}
            </{{ section.settings.heading_tag }}>
          {%- endif -%}
        </div>
        {%- if show_view_all and collection != blank -%}
          <a href="{{ collection.url }}" class="section-featured-collection__view-all">
            {{ 'general.view_all' | t }}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} Products {%- endcomment -%}
    {%- if collection != blank and collection.products.size > 0 -%}
      {%- if layout == 'slider' -%}
        <div class="section-featured-collection__slider">
          <div class="section-featured-collection__swiper swiper" data-fc-slider>
            <div class="swiper-wrapper">
              {%- for product in collection.products limit: products_to_show -%}
                <div class="swiper-slide">
                  {%- render 'product-card',
                    product: product,
                    show_vendor: show_vendor,
                    show_secondary_image: show_secondary_image,
                    image_ratio: image_ratio
                  -%}
                </div>
              {%- endfor -%}
            </div>
          </div>
          <button class="section-featured-collection__nav section-featured-collection__nav--prev" aria-label="{{ 'accessibility.previous_slide' | t }}">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          <button class="section-featured-collection__nav section-featured-collection__nav--next" aria-label="{{ 'accessibility.next_slide' | t }}">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>
      {%- else -%}
        <div class="section-featured-collection__grid">
          {%- for product in collection.products limit: products_to_show -%}
            {%- render 'product-card',
              product: product,
              show_vendor: show_vendor,
              show_secondary_image: show_secondary_image,
              image_ratio: image_ratio
            -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="section-featured-collection__grid">
        {%- for i in (1..products_to_show) -%}
          <div class="section-featured-collection__placeholder">
            {{ 'product-1' | placeholder_svg_tag: 'section-featured-collection__placeholder-svg' }}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{%- if layout == 'slider' -%}
<script>
  (function() {
    var wrapper = document.getElementById('section-{{ section.id }}');
    if (!wrapper) return;
    var el = wrapper.querySelector('[data-fc-slider]');
    if (!el) return;
    (window.swiperReady || function(cb){ cb(); })(function(){
    new Swiper(el, {
      slidesPerView: {{ columns_mobile }},
      spaceBetween: 12,
      speed: 600,
      breakpoints: {
        480: { slidesPerView: 2, spaceBetween: 12 },
        750: { slidesPerView: 3, spaceBetween: 16 },
        1024: { slidesPerView: {{ columns_desktop }}, spaceBetween: 20 }
      },
      navigation: {
        prevEl: wrapper.querySelector('.section-featured-collection__nav--prev'),
        nextEl: wrapper.querySelector('.section-featured-collection__nav--next')
      }
    });
    });
  })();
</script>
{%- endif -%}

{% stylesheet %}
  /* ── Featured Collection ── */
  .section-featured-collection {
    padding-block-start: var(--fc-mt);
    padding-block-end: var(--fc-mb);
    background-color: rgb(var(--color-background));
    color: rgba(var(--color-foreground), 0.85);
  }

  @media (min-width: 750px) {
    .section-featured-collection {
      padding-block-start: var(--fc-dt);
      padding-block-end: var(--fc-db);
    }
  }

  /* ── Header ── */
  .section-featured-collection__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .section-featured-collection__head-left {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .section-featured-collection__subheading {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgb(var(--color-accent));
    font-weight: 600;
  }

  .section-featured-collection__heading {
    margin: 0;
    color: rgb(var(--color-foreground));
    line-height: 1.2;
  }

  .section-featured-collection__view-all {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: rgb(var(--color-accent));
    transition: opacity 0.3s ease;
  }

  .section-featured-collection__view-all:hover {
    opacity: 0.7;
  }

  .section-featured-collection__view-all svg {
    transition: transform 0.3s ease;
  }

  .section-featured-collection__view-all:hover svg {
    transform: translateX(0.25rem);
  }

  /* ── Grid ── */
  .section-featured-collection__grid {
    display: grid;
    grid-template-columns: repeat(var(--fc-columns-m, 2), 1fr);
    gap: 12px;
  }

  @media (min-width: 750px) {
    .section-featured-collection__grid {
      grid-template-columns: repeat(var(--fc-columns-d, 4), 1fr);
      gap: 20px;
    }
  }

  /* ── Slider ── */
  .section-featured-collection__slider {
    position: relative;
  }

  .section-featured-collection__swiper {
    overflow: hidden;
  }

  .section-featured-collection__nav {
    position: absolute;
    top: 35%;
    transform: translateY(-50%);
    z-index: 5;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: rgb(var(--color-background));
    border: 1px solid rgb(var(--color-border, 229 231 235));
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    color: rgb(var(--color-foreground));
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    outline: none;
  }

  .section-featured-collection__nav:hover {
    background: rgb(var(--color-accent));
    border-color: rgb(var(--color-accent));
    color: #fff;
  }

  .section-featured-collection__nav--prev { left: -1rem; }
  .section-featured-collection__nav--next { right: -1rem; }

  @media (max-width: 1300px) {
    .section-featured-collection__nav--prev { left: 0; }
    .section-featured-collection__nav--next { right: 0; }
  }

  @media (max-width: 749px) {
    .section-featured-collection__nav { display: none; }
  }

  /* ── Placeholder ── */
  .section-featured-collection__placeholder {
    aspect-ratio: 4 / 5;
    background: rgba(var(--color-foreground), 0.04);
    border-radius: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .section-featured-collection__placeholder-svg {
    width: 60%;
    opacity: 0.15;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "class": "section-featured-collection-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "subheading_size",
      "label": "Subheading size",
      "options": [
        { "value": "xs", "label": "Extra small" },
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Large" }
      ],
      "default": "sm"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Featured collection"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "xs", "label": "Extra small" },
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Large" },
        { "value": "xl", "label": "Extra large" },
        { "value": "2xl", "label": "2X large" }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag (SEO)",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "p", "label": "Paragraph" }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "slider", "label": "Slider" }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Desktop columns",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Mobile columns",
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show \"View all\" link",
      "default": true
    },
    {
      "type": "header",
      "content": "Product card"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "adapt", "label": "Adapt" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top spacing",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 50
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top spacing",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "Featured collection",
      "category": "Collection"
    }
  ]
}
{% endschema %}
