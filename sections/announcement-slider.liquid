{%- comment -%}
  Section: Announcement Slider
  Mô tả: Multi-message ticker bar — xoay vòng 3-5 thông báo.
{%- endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-announce-slider color-{{ section.settings.color_scheme }}"
  data-as-section
>
  <div class="section-announce-slider__track" data-as-track>
    {%- for block in section.blocks -%}
      <div class="section-announce-slider__item{% if forloop.first %} is-active{% endif %}" data-as-item {{ block.shopify_attributes }}>
        {%- if block.settings.icon != blank -%}
          <span class="section-announce-slider__icon">{{ block.settings.icon }}</span>
        {%- endif -%}
        <span class="section-announce-slider__msg">
          {{ block.settings.text }}
          {%- if block.settings.link_text != blank -%}
            <a href="{{ block.settings.link | default: '#' }}" class="section-announce-slider__link">{{ block.settings.link_text }}</a>
          {%- endif -%}
        </span>
      </div>
    {%- endfor -%}
  </div>
  {%- if section.blocks.size > 1 -%}
    <div class="section-announce-slider__dots">
      {%- for block in section.blocks -%}
        <button class="section-announce-slider__dot{% if forloop.first %} is-active{% endif %}" data-as-dot="{{ forloop.index0 }}" aria-label="{{ 'accessibility.slide_number' | t: number: forloop.index }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

<script>
(function() {
  var section = document.getElementById('section-{{ section.id }}');
  if (!section) return;
  var items = section.querySelectorAll('[data-as-item]');
  var dots = section.querySelectorAll('[data-as-dot]');
  if (items.length <= 1) return;
  var idx = 0;
  var speed = {{ section.settings.speed | times: 1000 }};
  var timer;

  function go(to) {
    items.forEach(function(i) { i.classList.remove('is-active'); });
    dots.forEach(function(d) { d.classList.remove('is-active'); });
    idx = to;
    items[idx].classList.add('is-active');
    if (dots[idx]) dots[idx].classList.add('is-active');
  }

  function start() { timer = setInterval(function() { go((idx + 1) % items.length); }, speed); }
  function stop() { clearInterval(timer); }

  start();

  document.addEventListener('visibilitychange', function() {
    if (document.hidden) stop(); else start();
  });

  dots.forEach(function(d) {
    d.addEventListener('click', function() { go(parseInt(d.dataset.asDot)); });
  });
})();
</script>

{% stylesheet %}
  .section-announce-slider {
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    padding: 0.625rem 1rem;
    text-align: center; position: relative;
    overflow: hidden;
  }

  .section-announce-slider__track { position: relative; min-height: 1.5em; }

  .section-announce-slider__item {
    display: none; align-items: center; justify-content: center;
    gap: 0.375rem; font-size: 0.8125rem; font-weight: 500;
    animation: asFadeIn 0.4s ease;
  }
  .section-announce-slider__item.is-active { display: flex; }

  @keyframes asFadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

  .section-announce-slider__icon { font-size: 1rem; }
  .section-announce-slider__msg { line-height: 1.4; }
  .section-announce-slider__link {
    font-weight: 700; text-decoration: underline;
    text-underline-offset: 3px; transition: opacity 0.2s;
    color: inherit;
  }
  .section-announce-slider__link:hover { opacity: 0.7; }

  .section-announce-slider__dots {
    display: flex; justify-content: center; gap: 0.375rem;
    margin-top: 0.375rem;
  }
  .section-announce-slider__dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: rgba(var(--color-foreground), 0.2);
    border: none; cursor: pointer; padding: 0;
    transition: background 0.3s;
  }
  .section-announce-slider__dot.is-active { background: rgb(var(--color-foreground)); }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement slider",
  "tag": "section",
  "class": "section-announce-slider-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Rotation speed",
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Emoji icon",
          "default": "🎉"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Message",
          "default": "Free shipping on orders over $50"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Announcement slider",
      "category": "Custom",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "icon": "🚚",
            "text": "Free shipping on orders over $50"
          }
        },
        {
          "type": "message",
          "settings": {
            "icon": "🎉",
            "text": "New collection just dropped!",
            "link_text": "Shop now",
            "link": "shopify://collections"
          }
        },
        {
          "type": "message",
          "settings": {
            "icon": "↩️",
            "text": "30-day free returns on all orders"
          }
        }
      ]
    }
  ]
}
{% endschema %}
