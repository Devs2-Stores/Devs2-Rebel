{%- comment -%}
  Section: Related Blog Posts
  Mô tả: Grid bài viết blog — cho homepage hoặc landing page.
{%- endcomment -%}

{%- liquid
  assign blog = section.settings.blog
  assign posts_to_show = section.settings.posts_to_show
  assign columns_d = section.settings.columns_desktop
-%}

<div
  id="section-{{ section.id }}"
  class="section-blog-posts color-{{ section.settings.color_scheme }}"
  style="
    --bp-dt: {{ section.settings.padding_top_desktop }}px;
    --bp-db: {{ section.settings.padding_bottom_desktop }}px;
    --bp-mt: {{ section.settings.padding_top_mobile }}px;
    --bp-mb: {{ section.settings.padding_bottom_mobile }}px;
    --bp-cols-d: {{ columns_d }};
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-blog-posts__head">
        <div>
          {%- if section.settings.subheading != blank -%}
            <p class="section-blog-posts__subheading subheading-size-{{ section.settings.subheading_size }}">{{ section.settings.subheading }}</p>
          {%- endif -%}
          <{{ section.settings.heading_tag }} class="section-blog-posts__heading heading-size-{{ section.settings.heading_size }}">
            {{- section.settings.heading -}}
          </{{ section.settings.heading_tag }}>
        </div>
        {%- if section.settings.show_view_all and blog != blank -%}
          <a href="{{ blog.url }}" class="section-blog-posts__view-all">
            {{ 'general.view_all' | t | default: 'View all' }}
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if blog != blank and blog.articles.size > 0 -%}
      <div class="section-blog-posts__grid">
        {%- for article in blog.articles limit: posts_to_show -%}
          <article class="section-blog-posts__card">
            {%- if article.image -%}
              <a href="{{ article.url }}" class="section-blog-posts__media">
                {{ article.image | image_url: width: 600 | image_tag:
                  widths: '300, 400, 600',
                  sizes: '(max-width: 749px) 100vw, 33vw',
                  loading: 'lazy', class: 'section-blog-posts__img'
                }}
              </a>
            {%- endif -%}
            <div class="section-blog-posts__info">
              {%- if section.settings.show_date -%}
                <time class="section-blog-posts__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                  {{ article.published_at | date: format: 'abbreviated_date' }}
                </time>
              {%- endif -%}
              <h3 class="section-blog-posts__title">
                <a href="{{ article.url }}">{{ article.title | escape }}</a>
              </h3>
              {%- if section.settings.show_excerpt and article.excerpt != blank -%}
                <p class="section-blog-posts__excerpt">{{ article.excerpt | strip_html | truncate: 120 }}</p>
              {%- endif -%}
              <a href="{{ article.url }}" class="section-blog-posts__read-more">
                {{ 'blogs.article.read_more' | t | default: 'Read more' }}
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </a>
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="section-blog-posts__empty">
        <p>Select a blog to display posts</p>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .section-blog-posts {
    padding-block: var(--bp-mt) var(--bp-mb);
    background: rgb(var(--color-background));
    color: rgba(var(--color-foreground), 0.85);
  }
  @media (min-width: 750px) {
    .section-blog-posts { padding-block: var(--bp-dt) var(--bp-db); }
  }

  .section-blog-posts__head {
    display: flex; align-items: flex-end; justify-content: space-between;
    flex-wrap: wrap; gap: 1rem; margin-bottom: 2rem;
  }
  .section-blog-posts__subheading { margin: 0 0 0.25rem; text-transform: uppercase; letter-spacing: 0.12em; color: rgb(var(--color-accent)); font-weight: 600; }
  .section-blog-posts__heading { margin: 0; color: rgb(var(--color-foreground)); }
  .section-blog-posts__view-all {
    display: inline-flex; align-items: center; gap: 0.25rem;
    font-size: 0.875rem; font-weight: 700; color: rgb(var(--color-accent));
    transition: opacity 0.3s;
  }
  .section-blog-posts__view-all:hover { opacity: 0.7; }
  .section-blog-posts__view-all svg { transition: transform 0.3s; }
  .section-blog-posts__view-all:hover svg { transform: translateX(3px); }

  .section-blog-posts__grid {
    display: grid; grid-template-columns: 1fr; gap: 1.5rem;
  }
  @media (min-width: 750px) {
    .section-blog-posts__grid {
      grid-template-columns: repeat(var(--bp-cols-d, 3), 1fr); gap: 2rem;
    }
  }

  .section-blog-posts__card { display: flex; flex-direction: column; }
  .section-blog-posts__media {
    display: block; aspect-ratio: 16 / 10; overflow: hidden;
    border-radius: 0.5rem;
  }
  .section-blog-posts__img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.5s;
  }
  .section-blog-posts__media:hover .section-blog-posts__img { transform: scale(1.05); }

  .section-blog-posts__info { padding: 0.75rem 0; display: flex; flex-direction: column; gap: 0.375rem; }
  .section-blog-posts__date { font-size: 0.75rem; color: rgba(var(--color-foreground), 0.4); text-transform: uppercase; letter-spacing: 0.06em; }
  .section-blog-posts__title {
    margin: 0; font-size: 1rem; font-weight: 700;
    color: rgb(var(--color-foreground)); line-height: 1.4;
  }
  .section-blog-posts__title a { color: inherit; text-decoration: none; }
  .section-blog-posts__title a:hover { opacity: 0.8; }
  .section-blog-posts__excerpt { margin: 0; font-size: 0.8125rem; color: rgba(var(--color-foreground), 0.6); line-height: 1.6; }

  .section-blog-posts__read-more {
    display: inline-flex; align-items: center; gap: 0.25rem;
    font-size: 0.8125rem; font-weight: 600; color: rgb(var(--color-accent));
    transition: opacity 0.3s;
  }
  .section-blog-posts__read-more:hover { opacity: 0.7; }

  .section-blog-posts__empty { text-align: center; padding: 2rem; color: rgba(var(--color-foreground), 0.3); }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog posts",
  "tag": "section",
  "class": "section-blog-posts-wrapper",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "header", "content": "Heading" },
    { "type": "inline_richtext", "id": "subheading", "label": "Subheading" },
    { "type": "select", "id": "subheading_size", "label": "Subheading size", "options": [{ "value": "xs", "label": "XS" },{ "value": "sm", "label": "S" },{ "value": "md", "label": "M" }], "default": "sm" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "From the blog" },
    { "type": "select", "id": "heading_size", "label": "Heading size", "options": [{ "value": "sm", "label": "S" },{ "value": "md", "label": "M" },{ "value": "lg", "label": "L" },{ "value": "xl", "label": "XL" }], "default": "lg" },
    { "type": "select", "id": "heading_tag", "label": "Heading tag", "options": [{ "value": "h2", "label": "H2" },{ "value": "h3", "label": "H3" }], "default": "h2" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "posts_to_show", "min": 2, "max": 6, "step": 1, "label": "Posts to show", "default": 3 },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop columns", "default": 3 },
    { "type": "checkbox", "id": "show_date", "label": "Show date", "default": true },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show excerpt", "default": true },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'View all'", "default": true },
    { "type": "header", "content": "Desktop spacing" },
    { "type": "range", "id": "padding_top_desktop", "min": 0, "max": 150, "step": 5, "unit": "px", "label": "Top", "default": 50 },
    { "type": "range", "id": "padding_bottom_desktop", "min": 0, "max": 150, "step": 5, "unit": "px", "label": "Bottom", "default": 50 },
    { "type": "header", "content": "Mobile spacing" },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "Top", "default": 30 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "Bottom", "default": 30 }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Blog posts", "category": "Blog" }]
}
{% endschema %}
