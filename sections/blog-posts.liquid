{%- comment %}
  Section: Related Blog Posts
  Mô tả: Grid bài viết blog — cho homepage hoặc landing page.
{% endcomment -%}

{%- liquid
  assign blog = section.settings.blog
  assign posts_to_show = section.settings.posts_to_show
  assign columns_d = section.settings.columns_desktop
-%}

<div
  id="section-{{ section.id }}"
  class="section-blog-posts color-{{ section.settings.color_scheme }}"
  style="
    --bp-dt: {{ section.settings.padding_top_desktop }}px;
    --bp-db: {{ section.settings.padding_bottom_desktop }}px;
    --bp-mt: {{ section.settings.padding_top_mobile }}px;
    --bp-mb: {{ section.settings.padding_bottom_mobile }}px;
    --bp-cols-d: {{ columns_d }};
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-blog-posts__head">
        <div>
          {%- if section.settings.subheading != blank -%}
            <p class="section-blog-posts__subheading subheading-size-{{ section.settings.subheading_size }}">{{ section.settings.subheading }}</p>
          {%- endif -%}
          <{{ section.settings.heading_tag }} class="section-blog-posts__heading heading-size-{{ section.settings.heading_size }}">
            {{- section.settings.heading -}}
          </{{ section.settings.heading_tag }}>
        </div>
        {%- if section.settings.show_view_all and blog != blank -%}
          <a href="{{ blog.url }}" class="section-blog-posts__view-all">
            {{ 'general.view_all' | t }}
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if blog != blank and blog.articles.size > 0 -%}
      <div class="section-blog-posts__grid">
        {%- for article in blog.articles limit: posts_to_show -%}
          <article class="section-blog-posts__card">
            {%- if article.image -%}
              <a href="{{ article.url }}" class="section-blog-posts__media">
                {{ article.image | image_url: width: 600 | image_tag:
                  widths: '300, 400, 600',
                  sizes: '(max-width: 749px) 100vw, 33vw',
                  loading: 'lazy', class: 'section-blog-posts__img'
                }}
              </a>
            {%- endif -%}
            <div class="section-blog-posts__info">
              {%- if section.settings.show_date -%}
                <time class="section-blog-posts__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                  {{ article.published_at | date: format: 'abbreviated_date' }}
                </time>
              {%- endif -%}
              <h3 class="section-blog-posts__title">
                <a href="{{ article.url }}">{{ article.title | escape }}</a>
              </h3>
              {%- if section.settings.show_excerpt and article.excerpt != blank -%}
                <p class="section-blog-posts__excerpt">{{ article.excerpt | strip_html | truncate: 120 }}</p>
              {%- endif -%}
              <a href="{{ article.url }}" class="section-blog-posts__read-more">
                {{ 'blogs.article.read_more' | t }}
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </a>
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- elsif request.design_mode -%}
      <div class="section-blog-posts__empty">
        <p>{{ 'sections.featured_blog.empty' | t }}</p>
      </div>
    {%- endif -%}
    {%- capture app_blocks -%}
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}{%- render block -%}{%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if app_blocks != blank -%}
      <div class="section-apps">{{ app_blocks }}</div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .section-blog-posts {
    padding-block: var(--bp-mt) var(--bp-mb);
    background: rgb(var(--color-background));
    color: rgba(var(--color-foreground), 0.85);
  }
  @media (min-width: 750px) {
    .section-blog-posts { padding-block: var(--bp-dt) var(--bp-db); }
  }

  .section-blog-posts__head {
    display: flex; align-items: flex-end; justify-content: space-between;
    flex-wrap: wrap; gap: 1rem; margin-bottom: var(--section-head-gap);
  }
  .section-blog-posts__subheading {
    margin: 0 0 0.5rem;
    font-weight: var(--eyebrow-weight);
    letter-spacing: var(--eyebrow-tracking);
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .section-blog-posts__heading {
    margin: 0;
    color: var(--color-ink);
    letter-spacing: var(--heading-tracking);
  }
  .section-blog-posts__view-all {
    display: inline-flex; align-items: center; gap: 0.25rem;
    font-size: 0.875rem; font-weight: 500; color: var(--color-ink);
    text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 0.25em;
    transition: text-decoration-color var(--duration-default) ease;
  }
  .section-blog-posts__view-all:hover { color: var(--color-ink); text-decoration-color: currentColor; }
  .section-blog-posts__view-all svg { transition: transform var(--duration-default) ease; }
  @media (hover: hover) {
    .section-blog-posts__view-all:hover svg { transform: translateX(3px); }
  }

  .section-blog-posts__grid {
    display: grid; grid-template-columns: 1fr; gap: 1.5rem;
  }
  @media (min-width: 750px) {
    .section-blog-posts__grid {
      grid-template-columns: repeat(var(--bp-cols-d, 3), 1fr); gap: 2rem;
    }
  }

  .section-blog-posts__card { display: flex; flex-direction: column; }
  .section-blog-posts__media {
    display: block; aspect-ratio: 16 / 10; overflow: hidden;
    border-radius: var(--media-radius);
    border: var(--media-border); box-shadow: var(--media-shadow);
  }
  .section-blog-posts__img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform var(--duration-long);
  }
  @media (hover: hover) {
    .section-blog-posts__media:hover .section-blog-posts__img { transform: scale(1.05); }
  }

  .section-blog-posts__info { padding: 1rem 0 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .section-blog-posts__date { font-size: var(--meta-size); color: var(--color-muted); text-transform: uppercase; letter-spacing: 0.08em; }
  .section-blog-posts__title {
    margin: 0; font-size: 1.0625rem; font-weight: 600;
    color: var(--color-ink); line-height: 1.35;
  }
  .section-blog-posts__title a { color: inherit; text-decoration: none; }
  .section-blog-posts__title a:hover { color: var(--color-ink); text-decoration: underline; text-underline-offset: 0.2em; }
  .section-blog-posts__excerpt { margin: 0; font-size: 0.875rem; color: var(--color-muted); line-height: 1.6; }

  .section-blog-posts__read-more {
    display: inline-flex; align-items: center; gap: 0.25rem;
    font-size: var(--meta-size); font-weight: 500; color: var(--color-ink);
    text-decoration: underline; text-underline-offset: 0.25em;
    margin-top: 0.25rem;
  }
  .section-blog-posts__read-more:hover { color: var(--color-ink); }

  .section-blog-posts__empty { text-align: center; padding: 2rem; color: rgba(var(--color-foreground), 0.3); }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.blog_posts.name",
  "tag": "section",
  "class": "section-blog-posts-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.blog_posts.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "t:sections.blog_posts.settings.blog.label"
    },
    {
      "type": "header",
      "content": "t:sections.blog_posts.settings.header__heading.content"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:sections.blog_posts.settings.subheading.label"
    },
    {
      "type": "select",
      "id": "subheading_size",
      "label": "t:sections.blog_posts.settings.subheading_size.label",
      "options": [
        {
          "value": "xs",
          "label": "t:sections.blog_posts.settings.subheading_size.options.xs"
        },
        {
          "value": "sm",
          "label": "t:sections.blog_posts.settings.subheading_size.options.sm"
        },
        {
          "value": "md",
          "label": "t:sections.blog_posts.settings.subheading_size.options.md"
        }
      ],
      "default": "sm"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.blog_posts.settings.heading.label",
      "default": "t:sections.blog_posts.settings.heading.default"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.blog_posts.settings.heading_size.label",
      "options": [
        {
          "value": "sm",
          "label": "t:sections.blog_posts.settings.heading_size.options.sm"
        },
        {
          "value": "md",
          "label": "t:sections.blog_posts.settings.heading_size.options.md"
        },
        {
          "value": "lg",
          "label": "t:sections.blog_posts.settings.heading_size.options.lg"
        },
        {
          "value": "xl",
          "label": "t:sections.blog_posts.settings.heading_size.options.xl"
        }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.blog_posts.settings.heading_tag.label",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.blog_posts.settings.heading_tag.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.blog_posts.settings.heading_tag.options.h3"
        }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "t:sections.blog_posts.settings.header__layout.content"
    },
    {
      "type": "range",
      "id": "posts_to_show",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "t:sections.blog_posts.settings.posts_to_show.label",
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "t:sections.blog_posts.settings.columns_desktop.label",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "t:sections.blog_posts.settings.show_date.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "t:sections.blog_posts.settings.show_excerpt.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:sections.blog_posts.settings.show_view_all.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.blog_posts.settings.header__desktop_spacing.content"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "t:sections.blog_posts.settings.padding_top_desktop.label",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "t:sections.blog_posts.settings.padding_bottom_desktop.label",
      "default": 50
    },
    {
      "type": "header",
      "content": "t:sections.blog_posts.settings.header__mobile_spacing.content"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:sections.blog_posts.settings.padding_top_mobile.label",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:sections.blog_posts.settings.padding_bottom_mobile.label",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:sections.blog_posts.presets.blog_posts.name",
      "category": "Blog"
    }
  ]
}
{% endschema %}
