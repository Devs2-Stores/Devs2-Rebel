{%- comment %}
  Section: Timeline / History
  Mô tả: Vertical timeline — dùng cho About, Brand story.
{% endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-timeline color-{{ section.settings.color_scheme }}"
  style="
    --tl-dt: {{ section.settings.padding_top_desktop }}px;
    --tl-db: {{ section.settings.padding_bottom_desktop }}px;
    --tl-mt: {{ section.settings.padding_top_mobile }}px;
    --tl-mb: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-timeline__head">
        {%- if section.settings.subheading != blank -%}
          <p class="section-timeline__subheading subheading-size-{{ section.settings.subheading_size }}">{{ section.settings.subheading }}</p>
        {%- endif -%}
        <{{ section.settings.heading_tag }} class="section-timeline__heading heading-size-{{ section.settings.heading_size }}">
          {{- section.settings.heading -}}
        </{{ section.settings.heading_tag }}>
      </div>
    {%- endif -%}

    <div class="section-timeline__list">
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}{%- continue -%}{%- endif -%}
        <div class="section-timeline__item" {{ block.shopify_attributes }}>
          <div class="section-timeline__marker">
            <div class="section-timeline__dot"></div>
          </div>
          <div class="section-timeline__content">
            {%- if block.settings.year != blank -%}
              <span class="section-timeline__year">{{ block.settings.year }}</span>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h3 class="section-timeline__item-heading heading-size-{{ block.settings.heading_size }}">
                {{ block.settings.heading }}
              </h3>
            {%- endif -%}
            {%- if block.settings.image != blank -%}
              <div class="section-timeline__image">
                {{ block.settings.image | image_url: width: 600 | image_tag:
                  loading: 'lazy', class: 'section-timeline__img'
                }}
              </div>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="section-timeline__text content-size-{{ block.settings.text_size }}">
                {{ block.settings.text }}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
    {%- capture app_blocks -%}
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}{%- render block -%}{%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if app_blocks != blank -%}
      <div class="section-apps">{{ app_blocks }}</div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .section-timeline {
    padding-block: var(--tl-mt) var(--tl-mb);
    background: rgb(var(--color-background));
    color: rgba(var(--color-foreground), 0.85);
  }
  @media (min-width: 750px) {
    .section-timeline { padding-block: var(--tl-dt) var(--tl-db); }
  }
  .section-timeline__head { text-align: center; margin-bottom: var(--section-head-gap); }
  .section-timeline__subheading {
    margin: 0 0 0.5rem;
    font-weight: var(--eyebrow-weight);
    letter-spacing: var(--eyebrow-tracking);
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .section-timeline__heading {
    margin: 0;
    color: var(--color-ink);
    letter-spacing: var(--heading-tracking);
  }

  .section-timeline__list {
    max-width: 40rem; margin: 0 auto;
    position: relative; padding-left: 2rem;
  }
  .section-timeline__list::before {
    content: ''; position: absolute; left: 4px; top: 0.375rem; bottom: 0;
    width: 1px; background: var(--color-hairline);
  }

  .section-timeline__item {
    position: relative; padding-bottom: 2.5rem;
  }
  .section-timeline__item:last-child { padding-bottom: 0; }

  .section-timeline__marker {
    position: absolute; left: -2rem; top: 0.375rem;
  }
  .section-timeline__dot {
    width: 9px; height: 9px; border-radius: 0;
    background: var(--color-ink);
    border: none;
    box-shadow: none;
  }

  .section-timeline__content { display: flex; flex-direction: column; gap: 0.5rem; }
  .section-timeline__year {
    font-size: var(--eyebrow-size);
    font-weight: var(--eyebrow-weight);
    letter-spacing: var(--eyebrow-tracking);
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .section-timeline__item-heading {
    margin: 0;
    color: var(--color-ink);
    line-height: 1.25;
    letter-spacing: var(--heading-tracking);
  }

  .section-timeline__image {
    border-radius: var(--media-radius); border: var(--media-border); box-shadow: var(--media-shadow); overflow: hidden; margin: 0.5rem 0;
  }
  .section-timeline__img { width: 100%; height: auto; display: block; }

  .section-timeline__text { color: var(--color-muted); line-height: 1.65; max-width: 65ch; }
  .section-timeline__text p:last-child { margin-bottom: 0; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.timeline.name",
  "tag": "section",
  "class": "section-timeline-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.timeline.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.timeline.settings.header__heading.content"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:sections.timeline.settings.subheading.label"
    },
    {
      "type": "select",
      "id": "subheading_size",
      "label": "t:sections.timeline.settings.subheading_size.label",
      "options": [
        {
          "value": "xs",
          "label": "t:sections.timeline.settings.subheading_size.options.xs"
        },
        {
          "value": "sm",
          "label": "t:sections.timeline.settings.subheading_size.options.sm"
        },
        {
          "value": "md",
          "label": "t:sections.timeline.settings.subheading_size.options.md"
        }
      ],
      "default": "sm"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.timeline.settings.heading.label",
      "default": "t:sections.timeline.settings.heading.default"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.timeline.settings.heading_size.label",
      "options": [
        {
          "value": "sm",
          "label": "t:sections.timeline.settings.heading_size.options.sm"
        },
        {
          "value": "md",
          "label": "t:sections.timeline.settings.heading_size.options.md"
        },
        {
          "value": "lg",
          "label": "t:sections.timeline.settings.heading_size.options.lg"
        },
        {
          "value": "xl",
          "label": "t:sections.timeline.settings.heading_size.options.xl"
        }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.timeline.settings.heading_tag.label",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.timeline.settings.heading_tag.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.timeline.settings.heading_tag.options.h3"
        }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "t:sections.timeline.settings.header__desktop_spacing.content"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "t:sections.timeline.settings.padding_top_desktop.label",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "t:sections.timeline.settings.padding_bottom_desktop.label",
      "default": 50
    },
    {
      "type": "header",
      "content": "t:sections.timeline.settings.header__mobile_spacing.content"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:sections.timeline.settings.padding_top_mobile.label",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:sections.timeline.settings.padding_bottom_mobile.label",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "event",
      "name": "t:sections.timeline.blocks.event.name",
      "settings": [
        {
          "type": "text",
          "id": "year",
          "label": "t:sections.timeline.blocks.event.settings.year.label",
          "default": "2020"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "t:sections.timeline.blocks.event.settings.heading.label",
          "default": "t:sections.timeline.blocks.event.settings.heading.default"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "t:sections.timeline.blocks.event.settings.heading_size.label",
          "options": [
            {
              "value": "xs",
              "label": "t:sections.timeline.blocks.event.settings.heading_size.options.xs"
            },
            {
              "value": "sm",
              "label": "t:sections.timeline.blocks.event.settings.heading_size.options.sm"
            },
            {
              "value": "md",
              "label": "t:sections.timeline.blocks.event.settings.heading_size.options.md"
            }
          ],
          "default": "sm"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.timeline.blocks.event.settings.image.label"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.timeline.blocks.event.settings.text.label",
          "default": "t:sections.timeline.blocks.event.settings.text.default"
        },
        {
          "type": "select",
          "id": "text_size",
          "label": "t:sections.timeline.blocks.event.settings.text_size.label",
          "options": [
            {
              "value": "sm",
              "label": "t:sections.timeline.blocks.event.settings.text_size.options.sm"
            },
            {
              "value": "md",
              "label": "t:sections.timeline.blocks.event.settings.text_size.options.md"
            }
          ],
          "default": "sm"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:sections.timeline.presets.timeline.name",
      "category": "Custom",
      "blocks": [
        {
          "type": "event",
          "settings": {
            "year": "2020",
            "heading": "The beginning"
          }
        },
        {
          "type": "event",
          "settings": {
            "year": "2022",
            "heading": "Growing fast"
          }
        },
        {
          "type": "event",
          "settings": {
            "year": "2024",
            "heading": "Where we are now"
          }
        }
      ]
    }
  ]
}
{% endschema %}
