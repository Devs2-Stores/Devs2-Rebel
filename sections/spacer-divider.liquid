{{ 'section-spacer-divider.css' | asset_url | stylesheet_tag }}
{%- comment %}
  Section: Spacer & Divider
{% endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-spacer color-{{ section.settings.color_scheme }}"
  style="
    --spacer-dt: {{ section.settings.padding_top_desktop }}px;
    --spacer-db: {{ section.settings.padding_bottom_desktop }}px;
    --spacer-mt: {{ section.settings.padding_top_mobile }}px;
    --spacer-mb: {{ section.settings.padding_bottom_mobile }}px;
    --divider-height: {{ section.settings.divider_height }}px;
    --divider-width: {{ section.settings.divider_width }}%;
  "
>
  {%- if section.settings.show_divider -%}
    <div class="page-width">
      <div class="section-spacer__line section-spacer__line--{{ section.settings.divider_align }} section-spacer__color--{{ section.settings.divider_color }}">
        {%- if section.settings.divider_style == 'gradient' -%}
          <div class="section-spacer__hr section-spacer__hr--gradient"></div>
        {%- elsif section.settings.divider_style == 'shadow' -%}
          <div class="section-spacer__hr section-spacer__hr--shadow"></div>
        {%- elsif section.settings.divider_style == 'zigzag' -%}
          <div class="section-spacer__hr section-spacer__hr--zigzag"></div>
        {%- else -%}
          <hr class="section-spacer__hr section-spacer__hr--{{ section.settings.divider_style }}">
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</div>


{% schema %}
{
  "name": "t:sections.spacer_divider.name",
  "tag": "div",
  "class": "section-spacer-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.spacer_divider.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.spacer_divider.settings.header__divider.content"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "t:sections.spacer_divider.settings.show_divider.label",
      "default": true
    },
    {
      "type": "select",
      "id": "divider_style",
      "label": "t:sections.spacer_divider.settings.divider_style.label",
      "options": [
        {
          "value": "solid",
          "label": "t:sections.spacer_divider.settings.divider_style.options.solid"
        },
        {
          "value": "dashed",
          "label": "t:sections.spacer_divider.settings.divider_style.options.dashed"
        },
        {
          "value": "dotted",
          "label": "t:sections.spacer_divider.settings.divider_style.options.dotted"
        },
        {
          "value": "double",
          "label": "t:sections.spacer_divider.settings.divider_style.options.double"
        },
        {
          "value": "gradient",
          "label": "t:sections.spacer_divider.settings.divider_style.options.gradient"
        },
        {
          "value": "shadow",
          "label": "t:sections.spacer_divider.settings.divider_style.options.shadow"
        },
        {
          "value": "zigzag",
          "label": "t:sections.spacer_divider.settings.divider_style.options.zigzag"
        }
      ],
      "default": "solid"
    },
    {
      "type": "select",
      "id": "divider_align",
      "label": "t:sections.spacer_divider.settings.divider_align.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.spacer_divider.settings.divider_align.options.left"
        },
        {
          "value": "center",
          "label": "t:sections.spacer_divider.settings.divider_align.options.center"
        },
        {
          "value": "right",
          "label": "t:sections.spacer_divider.settings.divider_align.options.right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "divider_color",
      "label": "t:sections.spacer_divider.settings.divider_color.label",
      "options": [
        {
          "value": "border",
          "label": "t:sections.spacer_divider.settings.divider_color.options.border"
        },
        {
          "value": "accent",
          "label": "t:sections.spacer_divider.settings.divider_color.options.accent"
        },
        {
          "value": "button",
          "label": "t:sections.spacer_divider.settings.divider_color.options.button"
        },
        {
          "value": "text",
          "label": "t:sections.spacer_divider.settings.divider_color.options.text"
        }
      ],
      "default": "border"
    },
    {
      "type": "range",
      "id": "divider_height",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "t:sections.spacer_divider.settings.divider_height.label",
      "default": 1
    },
    {
      "type": "range",
      "id": "divider_width",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "t:sections.spacer_divider.settings.divider_width.label",
      "default": 100
    },
    {
      "type": "header",
      "content": "t:sections.spacer_divider.settings.header__desktop_spacing.content"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "t:sections.spacer_divider.settings.padding_top_desktop.label",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "t:sections.spacer_divider.settings.padding_bottom_desktop.label",
      "default": 40
    },
    {
      "type": "header",
      "content": "t:sections.spacer_divider.settings.header__mobile_spacing.content"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:sections.spacer_divider.settings.padding_top_mobile.label",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:sections.spacer_divider.settings.padding_bottom_mobile.label",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "t:sections.spacer_divider.presets.spacer_divider.name",
      "category": "Custom"
    }
  ]
}
{% endschema %}
