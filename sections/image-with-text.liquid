{%- comment %}
  Section: Image with Text
  Mô tả: Section 2 cột — image + text content.
  Hỗ trợ: Color scheme, image position (left/right), responsive, overlay.
{% endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-iwt color-{{ section.settings.color_scheme }}"
  style="
    --iwt-dt: {{ section.settings.padding_top_desktop }}px;
    --iwt-db: {{ section.settings.padding_bottom_desktop }}px;
    --iwt-mt: {{ section.settings.padding_top_mobile }}px;
    --iwt-mb: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="{% if section.settings.section_width == 'fixed' %}page-width{% endif %}">
    <div class="section-iwt__grid section-iwt__grid--{{ section.settings.image_position }}{% if section.settings.section_width == 'full' %} section-iwt__grid--full{% endif %}">

      {%- comment %} Image Column {% endcomment -%}
      <div class="section-iwt__media">
        {%- if section.settings.image != blank -%}
          {%- assign iwt_alt = section.settings.image.alt | default: shop.name -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag:
            widths: '375, 550, 750, 1000, 1200',
            sizes: '(max-width: 749px) 100vw, 50vw',
            alt: iwt_alt,
            loading: 'lazy',
            decoding: 'async',
            class: 'section-iwt__img'
          }}
        {%- else -%}
          <div class="section-iwt__placeholder">
            {{ 'image' | placeholder_svg_tag: 'section-iwt__placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

      {%- comment %} Content Column {% endcomment -%}
      <div class="section-iwt__content section-iwt__content--{{ section.settings.text_align }}">
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'subheading' -%}
              <p
                class="section-iwt__subheading subheading-size-{{ block.settings.subheading_size }}"
                {{ block.shopify_attributes }}
              >
                {{- block.settings.subheading -}}
              </p>

            {%- when 'heading' -%}
              <{{ block.settings.heading_tag }}
                class="section-iwt__heading heading-size-{{ block.settings.heading_size }}"
                {{ block.shopify_attributes }}
              >
                {{- block.settings.heading -}}
              </{{ block.settings.heading_tag }}>

            {%- when 'text' -%}
              <div
                class="section-iwt__text rte content-size-{{ block.settings.content_size }}"
                {{ block.shopify_attributes }}
              >
                {{- block.settings.text -}}
              </div>

            {%- when 'button' -%}
              <div class="section-iwt__buttons" {{ block.shopify_attributes }}>
                {%- if block.settings.button_label_1 != blank -%}
                  <a
                    href="{{ block.settings.button_link_1 | default: '#' }}"
                    class="section-iwt__btn section-iwt__btn--{{ block.settings.button_style_1 }} button-size-{{ block.settings.button_size }}"
                  >
                    {{- block.settings.button_label_1 -}}
                  </a>
                {%- endif -%}
                {%- if block.settings.button_label_2 != blank -%}
                  <a
                    href="{{ block.settings.button_link_2 | default: '#' }}"
                    class="section-iwt__btn section-iwt__btn--{{ block.settings.button_style_2 }} button-size-{{ block.settings.button_size }}"
                  >
                    {{- block.settings.button_label_2 -}}
                  </a>
                {%- endif -%}
              </div>

            {%- when 'empty_space' -%}
              <div
                class="block-empty-space"
                style="--block-spacer: {{ block.settings.spacing }}px;"
                {{ block.shopify_attributes }}
              ></div>

          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
    {%- capture app_blocks -%}
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}{%- render block -%}{%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if app_blocks != blank -%}
      <div class="section-apps">{{ app_blocks }}</div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  /* ── Image with Text ── */
  .section-iwt {
    padding-block-start: var(--iwt-mt);
    padding-block-end: var(--iwt-mb);
    background-color: rgb(var(--color-background));
    color: rgba(var(--color-foreground), 0.85);
  }

  @media (min-width: 750px) {
    .section-iwt {
      padding-block-start: var(--iwt-dt);
      padding-block-end: var(--iwt-db);
    }
  }

  /* ── Grid ── */
  .section-iwt__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 750px) {
    .section-iwt__grid {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  .section-iwt__grid--right .section-iwt__media {
    order: 1;
  }

  @media (min-width: 750px) {
    .section-iwt__grid--right .section-iwt__media {
      order: 2;
    }
    .section-iwt__grid--right .section-iwt__content {
      order: 1;
    }
  }

  /* Full width: no gap, image stretches */
  .section-iwt__grid--full {
    gap: 0;
  }

  .section-iwt__grid--full .section-iwt__content {
    padding-inline: 15px;
  }

  @media (min-width: 750px) {
    .section-iwt__grid--full {
      gap: 0;
    }
    .section-iwt__grid--full .section-iwt__content {
      padding: 2rem 3rem;
    }
  }

  /* ── Media ── */
  .section-iwt__media {
    overflow: hidden;
    border-radius: var(--media-radius);
    border: var(--media-border);
    box-shadow: var(--media-shadow);
  }

  .section-iwt__grid--full .section-iwt__media {
    border-radius: 0;
  }

  .section-iwt__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .section-iwt__placeholder {
    aspect-ratio: 1 / 1;
    background: rgba(var(--color-foreground), 0.04);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .section-iwt__placeholder-svg {
    width: 50%;
    opacity: 0.15;
  }

  /* ── Content ── */
  .section-iwt__content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0 0 1rem;
  }

  @media (min-width: 750px) {
    .section-iwt__content {
      padding: 1rem 0;
    }
  }

  .section-iwt__content--left { text-align: left; }
  .section-iwt__content--center { text-align: center; align-items: center; }
  .section-iwt__content--right { text-align: right; align-items: flex-end; }

  .section-iwt__subheading {
    margin: 0;
    font-weight: var(--eyebrow-weight);
    letter-spacing: var(--eyebrow-tracking);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .section-iwt__heading {
    margin: 0;
    color: var(--color-ink);
    line-height: 1.15;
    letter-spacing: var(--heading-tracking);
  }

  .section-iwt__text {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.65;
    max-width: 65ch;
  }

  .section-iwt__text:last-child {
    margin-block-end: 0;
  }

  /* ── Buttons ── */
  .section-iwt__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-block-start: 0.5rem;
  }

  .section-iwt__content--center .section-iwt__buttons { justify-content: center; }
  .section-iwt__content--right .section-iwt__buttons { justify-content: flex-end; }

  .section-iwt__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--btn-height);
    padding: 0 var(--btn-padding-x);
    font-size: var(--btn-font-size);
    font-weight: var(--btn-font-weight);
    letter-spacing: var(--btn-letter-spacing);
    text-decoration: none;
    border-radius: var(--buttons-radius, 0);
    transition: background-color var(--duration-default) ease, color var(--duration-default) ease, border-color var(--duration-default) ease;
    cursor: pointer;
  }

  .section-iwt__btn--primary {
    background: var(--color-primary);
    color: rgb(var(--color-button-text));
    border: 1px solid var(--color-primary);
  }

  .section-iwt__btn--primary:hover {
    background: var(--color-primary-strong);
    border-color: var(--color-primary-strong);
    color: rgb(var(--color-button-text));
  }

  .section-iwt__btn--secondary {
    background: transparent;
    color: var(--color-ink);
    border: 1px solid var(--color-ink);
  }

  .section-iwt__btn--secondary:hover {
    background: var(--color-ink);
    color: rgb(var(--color-background));
    border-color: var(--color-ink);
  }

  .section-iwt__btn--link {
    background: none;
    border: none;
    color: var(--color-ink);
    padding: 0;
    min-height: auto;
    min-width: auto;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
{% endstylesheet %}

