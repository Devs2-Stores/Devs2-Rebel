{{ 'section-image-with-text.css' | asset_url | stylesheet_tag }}
{%- comment %}
  Section: Image with Text
{% endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-iwt color-{{ section.settings.color_scheme }}"
  style="
    --iwt-dt: {{ section.settings.padding_top_desktop }}px;
    --iwt-db: {{ section.settings.padding_bottom_desktop }}px;
    --iwt-mt: {{ section.settings.padding_top_mobile }}px;
    --iwt-mb: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="{% if section.settings.section_width == 'fixed' %}page-width{% endif %}">
    <div class="section-iwt__grid section-iwt__grid--{{ section.settings.image_position }}{% if section.settings.section_width == 'full' %} section-iwt__grid--full{% endif %}">

      {%- comment %} Image Column {% endcomment -%}
      <div class="section-iwt__media">
        {%- if section.settings.image != blank -%}
          {%- assign iwt_alt = section.settings.image.alt | default: shop.name -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag:
            widths: '375, 550, 750, 1000, 1200',
            sizes: '(max-width: 749px) 100vw, 50vw',
            alt: iwt_alt,
            loading: 'lazy',
            decoding: 'async',
            class: 'section-iwt__img'
          }}
        {%- else -%}
          <div class="section-iwt__placeholder">
            {{ 'image' | placeholder_svg_tag: 'section-iwt__placeholder-svg' }}
          </div>
        {%- endif -%}
        {%- if section.settings.video != blank or section.settings.video_url != blank -%}
          {%- assign iwt_video_label = section.settings.image.alt -%}
          {%- if iwt_video_label == blank -%}
            {%- assign iwt_video_label = 'accessibility.background_video' | t -%}
          {%- endif -%}
          {%- render 'video-media',
            id: section.id,
            video: section.settings.video,
            video_url: section.settings.video_url,
            poster: section.settings.image,
            label: iwt_video_label
          -%}
          {%- render 'video-control', id: section.id -%}
        {%- endif -%}
      </div>

      {%- comment %} Content Column {% endcomment -%}
      <div class="section-iwt__content section-iwt__content--{{ section.settings.text_align }}">
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'subheading' -%}
              <p
                class="section-iwt__subheading subheading-size-{{ block.settings.subheading_size }}"
                {{ block.shopify_attributes }}
              >
                {{- block.settings.subheading -}}
              </p>

            {%- when 'heading' -%}
              <{{ block.settings.heading_tag }}
                class="section-iwt__heading heading-size-{{ block.settings.heading_size }}"
                {{ block.shopify_attributes }}
              >
                {{- block.settings.heading -}}
              </{{ block.settings.heading_tag }}>

            {%- when 'text' -%}
              <div
                class="section-iwt__text rte content-size-{{ block.settings.content_size }}"
                {{ block.shopify_attributes }}
              >
                {{- block.settings.text -}}
              </div>

            {%- when 'button' -%}
              <div class="section-iwt__buttons" {{ block.shopify_attributes }}>
                {%- if block.settings.button_label_1 != blank -%}
                  <a
                    href="{{ block.settings.button_link_1 | default: '#' }}"
                    class="section-iwt__btn section-iwt__btn--{{ block.settings.button_style_1 }} button-size-{{ block.settings.button_size }}"
                  >
                    {{- block.settings.button_label_1 -}}
                  </a>
                {%- endif -%}
                {%- if block.settings.button_label_2 != blank -%}
                  <a
                    href="{{ block.settings.button_link_2 | default: '#' }}"
                    class="section-iwt__btn section-iwt__btn--{{ block.settings.button_style_2 }} button-size-{{ block.settings.button_size }}"
                  >
                    {{- block.settings.button_label_2 -}}
                  </a>
                {%- endif -%}
              </div>

            {%- when 'empty_space' -%}
              <div
                class="block-empty-space"
                style="--block-spacer: {{ block.settings.spacing }}px;"
                {{ block.shopify_attributes }}
              ></div>

          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>


