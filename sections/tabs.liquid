{%- comment %}
  Section: Tabs
{% endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-tabs color-{{ section.settings.color_scheme }}"
  style="
    --tabs-dt: {{ section.settings.padding_top_desktop }}px;
    --tabs-db: {{ section.settings.padding_bottom_desktop }}px;
    --tabs-mt: {{ section.settings.padding_top_mobile }}px;
    --tabs-mb: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-tabs__head">
        <{{ section.settings.heading_tag }} class="section-tabs__heading heading-size-{{ section.settings.heading_size }}">
          {{- section.settings.heading -}}
        </{{ section.settings.heading_tag }}>
      </div>
    {%- endif -%}

    {%- assign tab_count = section.blocks | where: 'type', 'tab' | size -%}
    {%- if tab_count > 0 -%}
      <div class="section-tabs__nav" role="tablist">
        {%- assign tab_index = 0 -%}
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="section-tabs__trigger{% if tab_index == 0 %} section-tabs__trigger--active{% endif %}"
            role="tab"
            id="tab-btn-{{ section.id }}-{{ tab_index }}"
            aria-selected="{% if tab_index == 0 %}true{% else %}false{% endif %}"
            aria-controls="tab-panel-{{ section.id }}-{{ tab_index }}"
            data-tabs-btn="{{ tab_index }}"
          >
            {%- assign untitled_tab = 'general.tabs.untitled' | t -%}
            {{ block.settings.tab_label | default: untitled_tab }}
          </button>
          {%- assign tab_index = tab_index | plus: 1 -%}
        {%- endfor -%}
      </div>

      {%- assign panel_index = 0 -%}
      {%- for block in section.blocks -%}
        <div
          class="section-tabs__panel{% if panel_index == 0 %} section-tabs__panel--active{% endif %}"
          role="tabpanel"
          id="tab-panel-{{ section.id }}-{{ panel_index }}"
          aria-labelledby="tab-btn-{{ section.id }}-{{ panel_index }}"
          data-tabs-panel="{{ panel_index }}"
          {{ block.shopify_attributes }}
          {% unless panel_index == 0 %}hidden{% endunless %}
        >
          <div class="section-tabs__content rte content-size-{{ block.settings.content_size }}">
            {{ block.settings.content }}
          </div>
        </div>
        {%- assign panel_index = panel_index | plus: 1 -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

<script>
(function() {
  function init() {
    var s = document.getElementById('section-{{ section.id }}');
    if (!s) return;
    var btns = s.querySelectorAll('[data-tabs-btn]');
    var panels = s.querySelectorAll('[data-tabs-panel]');

    btns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var idx = btn.getAttribute('data-tabs-btn');
        btns.forEach(function(b) {
          b.classList.remove('section-tabs__trigger--active');
          b.setAttribute('aria-selected', 'false');
        });
        panels.forEach(function(p) {
          p.classList.remove('section-tabs__panel--active');
          p.hidden = true;
        });
        btn.classList.add('section-tabs__trigger--active');
        btn.setAttribute('aria-selected', 'true');
        var panel = s.querySelector('[data-tabs-panel="' + idx + '"]');
        if (panel) { panel.classList.add('section-tabs__panel--active'); panel.hidden = false; }
      });
    });
    if (window.ThemeUtils) window.ThemeUtils.bindTablistKeys(btns);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>

{% stylesheet %}
  .section-tabs {
    padding-block: var(--tabs-mt) var(--tabs-mb);
    background: rgb(var(--color-background));
    color: rgba(var(--color-foreground), 0.85);
  }
  @media (min-width: 750px) {
    .section-tabs { padding-block: var(--tabs-dt) var(--tabs-db); }
  }
  .section-tabs__head { text-align: center; margin-bottom: var(--section-head-gap); }
  .section-tabs__heading { margin: 0; color: var(--color-ink); letter-spacing: var(--heading-tracking); }

  .section-tabs__nav {
    display: flex; gap: 0; border-bottom: 1px solid var(--color-hairline);
    overflow-x: auto; -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .section-tabs__nav::-webkit-scrollbar { display: none; }

  .section-tabs__trigger {
    flex-shrink: 0; padding: 0.75rem 1.25rem;
    background: none; border: none; border-bottom: 2px solid transparent;
    margin-bottom: -1px; cursor: pointer;
    font-size: 0.875rem; font-weight: 600;
    color: var(--color-muted);
    transition: color var(--duration-default) ease, border-color var(--duration-default) ease;
    white-space: nowrap;
  }
  .section-tabs__trigger:hover { color: var(--color-ink); }
  .section-tabs__trigger--active {
    color: var(--color-ink);
    border-bottom-color: var(--color-ink);
  }

  .section-tabs__panel { padding: 1.5rem 0; }
  .section-tabs__panel[hidden] { display: none; }
  .section-tabs__content { color: var(--color-muted); line-height: 1.65; max-width: 65ch; }
  .section-tabs__content p:last-child { margin-bottom: 0; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.tabs.name",
  "tag": "section",
  "class": "section-tabs-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.tabs.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.tabs.settings.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.tabs.settings.heading_size.label",
      "options": [
        {
          "value": "sm",
          "label": "t:sections.tabs.settings.heading_size.options.sm"
        },
        {
          "value": "md",
          "label": "t:sections.tabs.settings.heading_size.options.md"
        },
        {
          "value": "lg",
          "label": "t:sections.tabs.settings.heading_size.options.lg"
        }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.tabs.settings.heading_tag.label",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.tabs.settings.heading_tag.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.tabs.settings.heading_tag.options.h3"
        }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "t:sections.tabs.settings.header__desktop_spacing.content"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "t:sections.tabs.settings.padding_top_desktop.label",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "t:sections.tabs.settings.padding_bottom_desktop.label",
      "default": 50
    },
    {
      "type": "header",
      "content": "t:sections.tabs.settings.header__mobile_spacing.content"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:sections.tabs.settings.padding_top_mobile.label",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:sections.tabs.settings.padding_bottom_mobile.label",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "t:sections.tabs.blocks.tab.name",
      "settings": [
        {
          "type": "text",
          "id": "tab_label",
          "label": "t:sections.tabs.blocks.tab.settings.tab_label.label",
          "default": "t:sections.tabs.blocks.tab.settings.tab_label.default"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:sections.tabs.blocks.tab.settings.content.label",
          "default": "t:sections.tabs.blocks.tab.settings.content.default"
        },
        {
          "type": "select",
          "id": "content_size",
          "label": "t:sections.tabs.blocks.tab.settings.content_size.label",
          "options": [
            {
              "value": "sm",
              "label": "t:sections.tabs.blocks.tab.settings.content_size.options.sm"
            },
            {
              "value": "md",
              "label": "t:sections.tabs.blocks.tab.settings.content_size.options.md"
            },
            {
              "value": "lg",
              "label": "t:sections.tabs.blocks.tab.settings.content_size.options.lg"
            }
          ],
          "default": "md"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.tabs.presets.tabs.name",
      "category": "Custom",
      "blocks": [
        {
          "type": "tab",
          "settings": {
            "tab_label": "Details"
          }
        },
        {
          "type": "tab",
          "settings": {
            "tab_label": "Shipping"
          }
        },
        {
          "type": "tab",
          "settings": {
            "tab_label": "Returns"
          }
        }
      ]
    }
  ]
}
{% endschema %}
