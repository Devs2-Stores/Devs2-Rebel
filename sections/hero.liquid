  "tag": "section",
  "class": "section-hero-wrapper",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.hero.settings.header__image.content"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
