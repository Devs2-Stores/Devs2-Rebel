{%- comment %}
  Section: Hero
  Full-width hero banner with image background, overlay, countdown, and block-based content.
{% endcomment -%}

{%- liquid
  assign desktop_img = section.settings.image_desktop
  assign mobile_img = section.settings.image_mobile | default: desktop_img
  assign img_alt = section.settings.image_alt | default: shop.name
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
  assign text_align = section.settings.text_align
  assign has_content = false
  for block in section.blocks
    if block.type != 'empty_space'
      assign has_content = true
      break
    endif
  endfor
  assign hero_loading = 'eager'
  assign fetch_priority = 'high'
  if section.index > 2
    assign fetch_priority = 'auto'
  endif
  if section.index > 3
    assign hero_loading = 'lazy'
  endif
  assign has_mobile_art = false
  if desktop_img != blank and mobile_img != desktop_img
    assign has_mobile_art = true
  endif
-%}

<div
  id="section-{{ section.id }}"
  class="section-hero color-{{ section.settings.color_scheme }}"
  style="
    --hero-height-d: {{ section.settings.height_desktop }}vh;
    --hero-height-m: {{ section.settings.height_mobile }}vh;
    --hero-overlay: {{ overlay_opacity }};
    --hero-content-max: {{ section.settings.content_max_width }}px;
    --hero-pt-d: {{ section.settings.padding_top_desktop }}px;
    --hero-pb-d: {{ section.settings.padding_bottom_desktop }}px;
    --hero-pt-m: {{ section.settings.padding_top_mobile }}px;
    --hero-pb-m: {{ section.settings.padding_bottom_mobile }}px;
    --hero-object-position-d: {{ desktop_img.presentation.focal_point | default: '50.0% 50.0%' }};
    --hero-object-position-m: {{ mobile_img.presentation.focal_point | default: desktop_img.presentation.focal_point | default: '50.0% 50.0%' }};
  "
>
  <div class="section-hero__media">
    {%- if desktop_img != blank -%}
      <picture>
        {%- if has_mobile_art -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ mobile_img | image_url: width: 375 }} 375w, {{ mobile_img | image_url: width: 550 }} 550w, {{ mobile_img | image_url: width: 750 }} 750w, {{ mobile_img | image_url: width: 1100 }} 1100w, {{ mobile_img | image_url: width: 1500 }} 1500w"
            sizes="100vw"
          >
        {%- endif -%}
        {{ desktop_img | image_url: width: 1920 | image_tag:
          widths: '750, 1080, 1440, 1920, 2560',
          sizes: '100vw',
          alt: img_alt,
          loading: hero_loading,
          fetchpriority: fetch_priority,
          decoding: 'async',
          class: 'section-hero__img'
        }}
      </picture>
    {%- elsif mobile_img != blank -%}
      {{ mobile_img | image_url: width: 1500 | image_tag:
        widths: '375, 550, 750, 1100, 1500',
        sizes: '100vw',
        loading: hero_loading,
        fetchpriority: fetch_priority,
        decoding: 'async',
        class: 'section-hero__img',
        alt: img_alt
      }}
    {%- else -%}
      <div class="section-hero__placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'section-hero__placeholder-svg' }}
      </div>
    {%- endif -%}
  </div>

  {%- comment %} Overlay {% endcomment -%}
  {%- if overlay_opacity > 0 -%}
    <div class="section-hero__overlay{% if section.settings.overlay_gradient %} section-hero__overlay--gradient{% endif %}"></div>
  {%- endif -%}

  {%- comment %} Content blocks {% endcomment -%}
  <div class="section-hero__content section-hero__content--{{ section.settings.content_position }}">
    <div class="section-hero__inner section-hero__inner--{{ text_align }}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'subheading' -%}
            <p
              class="section-hero__subheading subheading-size-{{ block.settings.subheading_size }}"
              {{ block.shopify_attributes }}
            >
              {{- block.settings.subheading -}}
            </p>

          {%- when 'heading' -%}
            {%- liquid
              assign heading_tag = block.settings.heading_tag
              if template.name == 'index' and heading_tag == 'h1'
                assign heading_tag = 'h2'
              endif
            -%}
            <{{ heading_tag }}
              class="section-hero__heading heading-size-{{ block.settings.heading_size }}"
              {{ block.shopify_attributes }}
            >
              {{- block.settings.heading -}}
            </{{ heading_tag }}>

          {%- when 'text' -%}
            <div
              class="section-hero__text rte content-size-{{ block.settings.content_size }}"
              {{ block.shopify_attributes }}
            >
              {{- block.settings.text -}}
            </div>

          {%- when 'button' -%}
            <div class="section-hero__buttons" {{ block.shopify_attributes }}>
              {%- if block.settings.button_label_1 != blank -%}
                <a
                  href="{{ block.settings.button_link_1 | default: '#' }}"
                  class="section-hero__btn section-hero__btn--{{ block.settings.button_style_1 }} button-size-{{ block.settings.button_size }}"
                >
                  {{- block.settings.button_label_1 -}}
                </a>
              {%- endif -%}
              {%- if block.settings.button_label_2 != blank -%}
                <a
                  href="{{ block.settings.button_link_2 | default: '#' }}"
                  class="section-hero__btn section-hero__btn--{{ block.settings.button_style_2 }} button-size-{{ block.settings.button_size }}"
                >
                  {{- block.settings.button_label_2 -}}
                </a>
              {%- endif -%}
            </div>

          {%- when 'countdown' -%}
            <div
              {% if block.settings.end_date == blank %}hidden{% endif %}
              class="section-hero__countdown"
              {{ block.shopify_attributes }}
              data-countdown-end="{{ block.settings.end_date }}"
              data-countdown-label-days="{{ block.settings.label_days }}"
              data-countdown-label-hours="{{ block.settings.label_hours }}"
              data-countdown-label-mins="{{ block.settings.label_mins }}"
              data-countdown-label-secs="{{ block.settings.label_secs }}"
            >
              <div class="section-hero__countdown-item">
                <span class="section-hero__countdown-value" data-countdown="days">00</span>
                <span class="section-hero__countdown-label">{{ block.settings.label_days }}</span>
              </div>
              <span class="section-hero__countdown-sep">:</span>
              <div class="section-hero__countdown-item">
                <span class="section-hero__countdown-value" data-countdown="hours">00</span>
                <span class="section-hero__countdown-label">{{ block.settings.label_hours }}</span>
              </div>
              <span class="section-hero__countdown-sep">:</span>
              <div class="section-hero__countdown-item">
                <span class="section-hero__countdown-value" data-countdown="mins">00</span>
                <span class="section-hero__countdown-label">{{ block.settings.label_mins }}</span>
              </div>
              <span class="section-hero__countdown-sep">:</span>
              <div class="section-hero__countdown-item">
                <span class="section-hero__countdown-value" data-countdown="secs">00</span>
                <span class="section-hero__countdown-label">{{ block.settings.label_secs }}</span>
              </div>
            </div>

          {%- when 'empty_space' -%}
            <div
              class="section-hero__spacer"
              style="--spacer-height: {{ block.settings.spacing }}px;"
              {{ block.shopify_attributes }}
            ></div>

        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- if has_content == false and request.design_mode -%}
  <div class="section-hero__onboarding">
    {{ 'sections.hero.onboarding' | t }}
  </div>
{%- endif -%}

<script>
  (function() {
    var countdowns = document.querySelectorAll('#section-{{ section.id }} .section-hero__countdown');
    if (!countdowns.length) return;

    countdowns.forEach(function(el) {
      var endDate = new Date(el.dataset.countdownEnd).getTime();
      if (isNaN(endDate)) { el.hidden = true; return; }

      var daysEl = el.querySelector('[data-countdown="days"]');
      var hoursEl = el.querySelector('[data-countdown="hours"]');
      var minsEl = el.querySelector('[data-countdown="mins"]');
      var secsEl = el.querySelector('[data-countdown="secs"]');

      function tick() {
        var now = Date.now();
        var diff = Math.max(0, endDate - now);
        if (diff === 0) { el.hidden = true; return; }

        var days = Math.floor(diff / 86400000);
        var hours = Math.floor((diff % 86400000) / 3600000);
        var mins = Math.floor((diff % 3600000) / 60000);
        var secs = Math.floor((diff % 60000) / 1000);

        if (daysEl) daysEl.textContent = String(days).padStart(2, '0');
        if (hoursEl) hoursEl.textContent = String(hours).padStart(2, '0');
        if (minsEl) minsEl.textContent = String(mins).padStart(2, '0');
        if (secsEl) secsEl.textContent = String(secs).padStart(2, '0');

        if (diff > 0) {
          requestAnimationFrame(function() { setTimeout(tick, 1000); });
        }
      }

      tick();
    });
  })();
</script>

{% stylesheet %}
  /* ── Hero ── */
  .section-hero {
    position: relative;
    min-height: var(--hero-height-m, 60vh);
    display: flex;
    color: var(--color-white);
    overflow: hidden;
    padding-block-start: var(--hero-pt-m);
    padding-block-end: var(--hero-pb-m);
  }
  .section-hero__onboarding {
    text-align: center;
    padding: 1rem;
    color: rgb(var(--color-foreground));
    font-size: 0.875rem;
  }

  @media (min-width: 750px) {
    .section-hero {
      min-height: var(--hero-height-d, 80vh);
      padding-block-start: var(--hero-pt-d);
      padding-block-end: var(--hero-pb-d);
    }
  }

  /* ── Media ── */
  .section-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .section-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--hero-object-position-m, center center);
  }

  @media (min-width: 750px) {
    .section-hero__img { object-position: var(--hero-object-position-d, center center); }
  }

  .section-hero__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-black);
  }

  .section-hero__placeholder-svg {
    width: 50%;
    max-width: 600px;
    opacity: 0.15;
    color: var(--color-white);
    fill: currentColor;
  }

  /* ── Overlay ── */
  .section-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(0, 0, 0, var(--hero-overlay, 0.3));
    pointer-events: none;
  }

  .section-hero__overlay--gradient {
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, calc(var(--hero-overlay, 0.3) * 1.6)),
      rgba(0, 0, 0, calc(var(--hero-overlay, 0.3) * 0.4))
    );
  }

  /* ── Content ── */
  .section-hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    display: grid;
    padding: 2.5rem max(15px, calc((100% - var(--page-width, 1200px)) / 2 + 15px));
  }

  @media (min-width: 750px) {
    .section-hero__content {
      padding: 3.5rem max(30px, calc((100% - var(--page-width, 1200px)) / 2 + 30px));
    }
  }

  @media (min-width: 1024px) {
    .section-hero__content {
      padding: 4.5rem max(75px, calc((100% - var(--page-width, 1200px)) / 2 + 75px));
    }
  }

  .section-hero__inner {
    max-width: var(--hero-content-max, 700px);
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .section-hero__inner--left   { text-align: left; }
  .section-hero__inner--center { text-align: center; align-items: center; }
  .section-hero__inner--right  { text-align: right; align-items: flex-end; }

  /* ── Content Position (9-point grid) ── */
  .section-hero__content--top-left      { align-items: start;   justify-items: start;   }
  .section-hero__content--top-center    { align-items: start;   justify-items: center;  }
  .section-hero__content--top-right     { align-items: start;   justify-items: end;     }
  .section-hero__content--middle-left   { align-items: center;  justify-items: start;   }
  .section-hero__content--middle-center { align-items: center;  justify-items: center;  }
  .section-hero__content--middle-right  { align-items: center;  justify-items: end;     }
  .section-hero__content--bottom-left   { align-items: end;     justify-items: start;   }
  .section-hero__content--bottom-center { align-items: end;     justify-items: center;  }
  .section-hero__content--bottom-right  { align-items: end;     justify-items: end;     }

  /* ── Typography ── */
  .section-hero__subheading {
    margin: 0;
    font-weight: var(--eyebrow-weight);
    letter-spacing: var(--eyebrow-tracking);
    text-transform: uppercase;
    color: var(--color-white);
  }

  .section-hero__heading {
    margin: 0;
    color: var(--color-white);
    line-height: 1.08;
    letter-spacing: var(--heading-tracking);
  }

  .section-hero__text {
    margin: 0;
    color: var(--color-white);
    line-height: 1.6;
    max-width: 60ch;
  }

  .section-hero__text p {
    margin: 0;
  }

  .section-hero__text a {
    color: var(--color-white);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .section-hero__text a:hover {
    text-decoration-thickness: 2px;
  }

  /* ── Spacer ── */
  .section-hero__spacer {
    height: var(--spacer-height, 20px);
    width: 100%;
  }

  /* ── Buttons ── */
  .section-hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-block-start: 0.25rem;
  }

  .section-hero__inner--center .section-hero__buttons {
    justify-content: center;
  }

  .section-hero__inner--right .section-hero__buttons {
    justify-content: flex-end;
  }

  .section-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--btn-height);
    padding: 0 var(--btn-padding-x);
    font-size: var(--btn-font-size);
    font-weight: var(--btn-font-weight);
    letter-spacing: var(--btn-letter-spacing);
    text-decoration: none;
    border-radius: var(--buttons-radius, 0);
    transition: background-color var(--duration-default) ease, color var(--duration-default) ease, border-color var(--duration-default) ease;
    cursor: pointer;
  }

  .section-hero__btn:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 2px;
  }

  .section-hero__btn--primary {
    background: var(--color-white);
    color: var(--color-black);
    border: 1px solid var(--color-white);
  }

  .section-hero__btn--primary:hover {
    background: rgba(255, 255, 255, 0.88);
    border-color: rgba(255, 255, 255, 0.88);
  }

  .section-hero__btn--secondary {
    background: transparent;
    color: var(--color-white);
    border: 1px solid var(--color-white);
  }

  .section-hero__btn--secondary:hover {
    background: var(--color-white);
    color: var(--color-black);
    border-color: var(--color-white);
  }

  .section-hero__btn--link {
    background: none;
    border: none;
    color: var(--color-white);
    padding: 12px 4px;
    min-width: auto;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* ── Countdown ── */
  .section-hero__countdown {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-block-start: 0.5rem;
  }

  .section-hero__countdown[hidden] {
    display: none;
  }

  .section-hero__inner--center .section-hero__countdown {
    justify-content: center;
  }

  .section-hero__inner--right .section-hero__countdown {
    justify-content: flex-end;
  }

  .section-hero__countdown-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 3.5rem;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--text-boxes-radius);
    padding: 0.5rem 0.75rem;
    backdrop-filter: blur(8px);
  }

  .section-hero__countdown-value {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-white);
    font-variant-numeric: tabular-nums;
  }

  .section-hero__countdown-label {
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.6);
    margin-top: 0.25rem;
  }

  .section-hero__countdown-sep {
    font-size: 1.25rem;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.4);
    padding-bottom: 1rem;
  }

  @media (max-width: 749px) {
    .section-hero__countdown {
      gap: 0.35rem;
      flex-wrap: wrap;
    }

    .section-hero__countdown-item {
      min-width: 2.75rem;
      padding: 0.4rem 0.5rem;
    }

    .section-hero__countdown-value {
      font-size: 1.15rem;
    }

    .section-hero__countdown-label {
      font-size: 0.55rem;
    }

    .section-hero__countdown-sep {
      font-size: 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
