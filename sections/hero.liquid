      "type": "select",
      "id": "height_desktop",
      "label": "t:sections.hero.settings.height_desktop.label",
      "options": [
        {
          "value": "40",
          "label": "t:sections.hero.settings.height_desktop.options._40"
        },
        {
          "value": "60",
          "label": "t:sections.hero.settings.height_desktop.options._60"
        },
        {
          "value": "80",
          "label": "t:sections.hero.settings.height_desktop.options._80"
        },
        {
          "value": "100",
          "label": "t:sections.hero.settings.height_desktop.options._100"
        }
