{%- comment %}
  Section: Animated Counter / Stats
{% endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-stats color-{{ section.settings.color_scheme }}"
  style="
    --st-dt: {{ section.settings.padding_top_desktop }}px;
    --st-db: {{ section.settings.padding_bottom_desktop }}px;
    --st-mt: {{ section.settings.padding_top_mobile }}px;
    --st-mb: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-stats__head">
        {%- if section.settings.subheading != blank -%}
          <p class="section-stats__subheading subheading-size-{{ section.settings.subheading_size }}">{{ section.settings.subheading }}</p>
        {%- endif -%}
        <{{ section.settings.heading_tag }} class="section-stats__heading heading-size-{{ section.settings.heading_size }}">
          {{- section.settings.heading -}}
        </{{ section.settings.heading_tag }}>
      </div>
    {%- endif -%}

    {%- assign stat_count = section.blocks | where: 'type', 'stat' | size -%}
    <div class="section-stats__grid" style="--st-cols: {{ stat_count | at_most: 5 }};">
      {%- for block in section.blocks -%}
        <div class="section-stats__item" {{ block.shopify_attributes }} data-stat data-target="{{ block.settings.number }}" data-prefix="{{ block.settings.prefix | escape }}" data-suffix="{{ block.settings.suffix | escape }}">
          {%- if block.settings.icon != blank -%}
            <div class="section-stats__icon">
              {{ block.settings.icon | image_url: width: 64 | image_tag: loading: 'lazy' }}
            </div>
          {%- endif -%}
          <span class="section-stats__number heading-size-{{ section.settings.number_size }}">
            <span class="section-stats__prefix">{{ block.settings.prefix }}</span><span data-stat-value>0</span><span class="section-stats__suffix">{{ block.settings.suffix }}</span>
          </span>
          {%- if block.settings.label != blank -%}
            <span class="section-stats__label">{{ block.settings.label }}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
(function() {
  var section = document.getElementById('section-{{ section.id }}');
  if (!section) return;
  var items = section.querySelectorAll('[data-stat]');
  var animated = false;

  function easeOut(t) { return 1 - Math.pow(1 - t, 3); }

  function animateCounters() {
    if (animated) return;
    animated = true;
    items.forEach(function(item) {
      var target = parseInt(item.getAttribute('data-target')) || 0;
      var el = item.querySelector('[data-stat-value]');
      var duration = 2000;
      var start = performance.now();
      function step(now) {
        var progress = Math.min((now - start) / duration, 1);
        var val = Math.floor(easeOut(progress) * target);
        el.textContent = val.toLocaleString();
        if (progress < 1) requestAnimationFrame(step);
        else el.textContent = target.toLocaleString();
      }
      requestAnimationFrame(step);
    });
  }

  if ('IntersectionObserver' in window) {
    var obs = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) { animateCounters(); obs.disconnect(); }
      });
    }, { threshold: 0.3 });
    obs.observe(section);
  } else {
    animateCounters();
  }
})();
</script>

{% stylesheet %}
  .section-stats {
    padding-block: var(--st-mt) var(--st-mb);
    background: rgb(var(--color-background));
    color: rgba(var(--color-foreground), 0.85);
  }
  @media (min-width: 750px) {
    .section-stats { padding-block: var(--st-dt) var(--st-db); }
  }
  .section-stats__head { text-align: center; margin-bottom: var(--section-head-gap); }
  .section-stats__subheading {
    margin: 0 0 0.5rem;
    font-weight: var(--eyebrow-weight);
    letter-spacing: var(--eyebrow-tracking);
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .section-stats__heading {
    margin: 0;
    color: var(--color-ink);
    letter-spacing: var(--heading-tracking);
  }

  .section-stats__grid {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem;
    text-align: center;
  }
  @media (min-width: 750px) {
    .section-stats__grid { grid-template-columns: repeat(var(--st-cols, 4), 1fr); gap: 2.5rem; }
  }

  .section-stats__item { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
  .section-stats__icon { width: 2.5rem; height: 2.5rem; margin-bottom: 0.25rem; }
  .section-stats__icon img { width: 100%; height: 100%; object-fit: contain; }

  .section-stats__number {
    font-weight: 700; color: var(--color-ink);
    font-variant-numeric: tabular-nums; line-height: 1;
    letter-spacing: var(--heading-tracking);
  }
  .section-stats__prefix, .section-stats__suffix { color: var(--color-ink); }
  .section-stats__label {
    font-size: var(--eyebrow-size);
    font-weight: var(--eyebrow-weight);
    letter-spacing: var(--eyebrow-tracking);
    text-transform: uppercase;
    color: var(--color-muted);
  }
{% endstylesheet %}

