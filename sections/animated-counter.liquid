{%- comment %}
  Section: Animated Counter / Stats
  Mô tả: Numbers đếm từ 0 → target khi scroll vào view.
{% endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-stats color-{{ section.settings.color_scheme }}"
  style="
    --st-dt: {{ section.settings.padding_top_desktop }}px;
    --st-db: {{ section.settings.padding_bottom_desktop }}px;
    --st-mt: {{ section.settings.padding_top_mobile }}px;
    --st-mb: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-stats__head">
        {%- if section.settings.subheading != blank -%}
          <p class="section-stats__subheading subheading-size-{{ section.settings.subheading_size }}">{{ section.settings.subheading }}</p>
        {%- endif -%}
        <{{ section.settings.heading_tag }} class="section-stats__heading heading-size-{{ section.settings.heading_size }}">
          {{- section.settings.heading -}}
        </{{ section.settings.heading_tag }}>
      </div>
    {%- endif -%}

    <div class="section-stats__grid" style="--st-cols: {{ section.blocks.size | at_most: 5 }};">
      {%- for block in section.blocks -%}
        <div class="section-stats__item" {{ block.shopify_attributes }} data-stat data-target="{{ block.settings.number }}" data-prefix="{{ block.settings.prefix | escape }}" data-suffix="{{ block.settings.suffix | escape }}">
          {%- if block.settings.icon != blank -%}
            <div class="section-stats__icon">
              {{ block.settings.icon | image_url: width: 64 | image_tag: loading: 'lazy' }}
            </div>
          {%- endif -%}
          <span class="section-stats__number heading-size-{{ section.settings.number_size }}">
            <span class="section-stats__prefix">{{ block.settings.prefix }}</span><span data-stat-value>0</span><span class="section-stats__suffix">{{ block.settings.suffix }}</span>
          </span>
          {%- if block.settings.label != blank -%}
            <span class="section-stats__label">{{ block.settings.label }}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
(function() {
  var section = document.getElementById('section-{{ section.id }}');
  if (!section) return;
  var items = section.querySelectorAll('[data-stat]');
  var animated = false;

  function easeOut(t) { return 1 - Math.pow(1 - t, 3); }

  function animateCounters() {
    if (animated) return;
    animated = true;
    items.forEach(function(item) {
      var target = parseInt(item.getAttribute('data-target')) || 0;
      var el = item.querySelector('[data-stat-value]');
      var duration = 2000;
      var start = performance.now();
      function step(now) {
        var progress = Math.min((now - start) / duration, 1);
        var val = Math.floor(easeOut(progress) * target);
        el.textContent = val.toLocaleString();
        if (progress < 1) requestAnimationFrame(step);
        else el.textContent = target.toLocaleString();
      }
      requestAnimationFrame(step);
    });
  }

  if ('IntersectionObserver' in window) {
    var obs = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) { animateCounters(); obs.disconnect(); }
      });
    }, { threshold: 0.3 });
    obs.observe(section);
  } else {
    animateCounters();
  }
})();
</script>

{% stylesheet %}
  .section-stats {
    padding-block: var(--st-mt) var(--st-mb);
    background: rgb(var(--color-background));
    color: rgba(var(--color-foreground), 0.85);
  }
  @media (min-width: 750px) {
    .section-stats { padding-block: var(--st-dt) var(--st-db); }
  }
  .section-stats__head { text-align: center; margin-bottom: 2.5rem; }
  .section-stats__subheading { margin: 0 0 0.25rem; text-transform: uppercase; letter-spacing: 0.12em; color: rgb(var(--color-accent)); font-weight: 600; }
  .section-stats__heading { margin: 0; color: rgb(var(--color-foreground)); }

  .section-stats__grid {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem;
    text-align: center;
  }
  @media (min-width: 750px) {
    .section-stats__grid { grid-template-columns: repeat(var(--st-cols, 4), 1fr); gap: 2.5rem; }
  }

  .section-stats__item { display: flex; flex-direction: column; align-items: center; gap: 0.375rem; }
  .section-stats__icon { width: 2.5rem; height: 2.5rem; margin-bottom: 0.25rem; }
  .section-stats__icon img { width: 100%; height: 100%; object-fit: contain; }

  .section-stats__number {
    font-weight: 800; color: rgb(var(--color-foreground));
    font-variant-numeric: tabular-nums; line-height: 1;
  }
  .section-stats__prefix, .section-stats__suffix { color: rgb(var(--color-accent)); }
  .section-stats__label {
    font-size: 0.8125rem; text-transform: uppercase;
    letter-spacing: 0.08em; color: rgba(var(--color-foreground), 0.5); font-weight: 600;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Animated counter",
  "tag": "section",
  "class": "section-stats-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "subheading_size",
      "label": "Subheading size",
      "options": [
        {
          "value": "xs",
          "label": "XS"
        },
        {
          "value": "sm",
          "label": "S"
        }
      ],
      "default": "sm"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "sm",
          "label": "S"
        },
        {
          "value": "md",
          "label": "M"
        },
        {
          "value": "lg",
          "label": "L"
        }
      ],
      "default": "md"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "number_size",
      "label": "Number size",
      "options": [
        {
          "value": "lg",
          "label": "L"
        },
        {
          "value": "xl",
          "label": "XL"
        },
        {
          "value": "2xl",
          "label": "2XL"
        }
      ],
      "default": "xl"
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom",
      "default": 50
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "number",
          "id": "number",
          "label": "Number",
          "default": 500
        },
        {
          "type": "text",
          "id": "prefix",
          "label": "Prefix",
          "info": "E.g. $, €"
        },
        {
          "type": "text",
          "id": "suffix",
          "label": "Suffix",
          "default": "+",
          "info": "E.g. +, %, K"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Happy customers"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Animated counter",
      "category": "Custom",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "number": 500,
            "suffix": "+",
            "label": "Products"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": 10000,
            "suffix": "+",
            "label": "Happy customers"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": 50,
            "suffix": "+",
            "label": "Countries"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": 99,
            "suffix": "%",
            "label": "Satisfaction"
          }
        }
      ]
    }
  ]
}
{% endschema %}
