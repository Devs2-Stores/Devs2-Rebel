{%- comment %}
  Section: Before/After Slider
  Mô tả: So sánh 2 ảnh bằng thanh trượt kéo.
{% endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-compare color-{{ section.settings.color_scheme }}"
  style="
    --cmp-dt: {{ section.settings.padding_top_desktop }}px;
    --cmp-db: {{ section.settings.padding_bottom_desktop }}px;
    --cmp-mt: {{ section.settings.padding_top_mobile }}px;
    --cmp-mb: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-compare__head">
        {%- if section.settings.subheading != blank -%}
          <p class="section-compare__subheading subheading-size-{{ section.settings.subheading_size }}">{{ section.settings.subheading }}</p>
        {%- endif -%}
        <{{ section.settings.heading_tag }} class="section-compare__heading heading-size-{{ section.settings.heading_size }}">
          {{- section.settings.heading -}}
        </{{ section.settings.heading_tag }}>
      </div>
    {%- endif -%}

    <div class="section-compare__wrapper" data-compare-slider style="--compare-pos: 50%;">
      <div class="section-compare__before">
        {%- if section.settings.image_before != blank -%}
          {{ section.settings.image_before | image_url: width: 1200 | image_tag:
            widths: '375, 750, 1000, 1200', sizes: '(max-width: 749px) 100vw, 60vw',
            loading: 'lazy', class: 'section-compare__img'
          }}
        {%- else -%}
          <div class="section-compare__ph">{{ 'image' | placeholder_svg_tag }}</div>
        {%- endif -%}
        {%- if section.settings.label_before != blank -%}
          <span class="section-compare__label section-compare__label--before">{{ section.settings.label_before }}</span>
        {%- endif -%}
      </div>
      <div class="section-compare__after">
        {%- if section.settings.image_after != blank -%}
          {{ section.settings.image_after | image_url: width: 1200 | image_tag:
            widths: '375, 750, 1000, 1200', sizes: '(max-width: 749px) 100vw, 60vw',
            loading: 'lazy', class: 'section-compare__img'
          }}
        {%- else -%}
          <div class="section-compare__ph">{{ 'image' | placeholder_svg_tag }}</div>
        {%- endif -%}
        {%- if section.settings.label_after != blank -%}
          <span class="section-compare__label section-compare__label--after">{{ section.settings.label_after }}</span>
        {%- endif -%}
      </div>
      <div class="section-compare__handle" role="slider" aria-label="{{ 'accessibility.comparison_slider' | t }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" tabindex="0">
        <div class="section-compare__handle-line"></div>
        <div class="section-compare__handle-knob">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  var el = document.querySelector('#section-{{ section.id }} [data-compare-slider]');
  if (!el) return;
  var handle = el.querySelector('[role="slider"]');
  var dragging = false;
  var currentPos = 0.5;

  function startDrag(x) {
    dragging = true;
    update(x);
  }

  function stopDrag() {
    dragging = false;
  }

  function update(x) {
    var rect = el.getBoundingClientRect();
    currentPos = Math.max(0, Math.min(1, (x - rect.left) / rect.width));
    el.style.setProperty('--compare-pos', (currentPos * 100) + '%');
    if (handle) handle.setAttribute('aria-valuenow', Math.round(currentPos * 100));
  }

  if (handle) {
    handle.addEventListener('mousedown', function(e) { e.preventDefault(); startDrag(e.clientX); });
    handle.addEventListener('touchstart', function(e) { startDrag(e.touches[0].clientX); }, { passive: true });
  }
  el.addEventListener('mousedown', function(e) {
    if (e.target === handle || handle.contains(e.target)) return;
    e.preventDefault();
    startDrag(e.clientX);
  });
  el.addEventListener('touchstart', function(e) {
    startDrag(e.touches[0].clientX);
  }, { passive: true });
  document.addEventListener('mousemove', function(e) { if (dragging) update(e.clientX); });
  document.addEventListener('touchmove', function(e) { if (dragging) update(e.touches[0].clientX); }, { passive: true });
  document.addEventListener('mouseup', stopDrag);
  document.addEventListener('touchend', stopDrag);

  if (handle) {
    handle.addEventListener('keydown', function(e) {
      var step = 0.02;
      if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') { currentPos = Math.max(0, currentPos - step); }
      else if (e.key === 'ArrowRight' || e.key === 'ArrowUp') { currentPos = Math.min(1, currentPos + step); }
      else return;
      e.preventDefault();
      el.style.setProperty('--compare-pos', (currentPos * 100) + '%');
      handle.setAttribute('aria-valuenow', Math.round(currentPos * 100));
    });
  }
})();
</script>

{% stylesheet %}
  .section-compare {
    padding-block: var(--cmp-mt) var(--cmp-mb);
    background: rgb(var(--color-background));
  }
  @media (min-width: 750px) {
    .section-compare { padding-block: var(--cmp-dt) var(--cmp-db); }
  }
  .section-compare__head { text-align: center; margin-bottom: 2rem; }
  .section-compare__subheading { margin: 0 0 0.25rem; text-transform: uppercase; letter-spacing: 0.12em; color: rgb(var(--color-accent)); font-weight: 600; }
  .section-compare__heading { margin: 0; color: rgb(var(--color-foreground)); }

  .section-compare__wrapper {
    position: relative; max-width: 48rem; margin: 0 auto;
    overflow: hidden; border-radius: 0.5rem;
    cursor: ew-resize; user-select: none; -webkit-user-select: none;
  }
  .section-compare__before, .section-compare__after { position: relative; }
  .section-compare__after {
    position: absolute; inset: 0;
    clip-path: inset(0 0 0 var(--compare-pos, 50%));
  }
  .section-compare__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    user-select: none;
    -webkit-user-drag: none;
    pointer-events: none;
  }
  .section-compare__ph { aspect-ratio: 16/9; background: rgba(var(--color-foreground), 0.06); display: flex; align-items: center; justify-content: center; }
  .section-compare__ph svg { width: 30%; opacity: 0.15; }

  .section-compare__label {
    position: absolute; bottom: 1rem; padding: 0.375rem 0.75rem;
    font-size: 0.75rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.08em; border-radius: 4px;
    background: rgba(0,0,0,0.6); color: #fff;
  }
  .section-compare__label--before { left: 1rem; }
  .section-compare__label--after { right: 1rem; }

  .section-compare__handle {
    position: absolute; top: 0; bottom: 0;
    left: var(--compare-pos, 50%); transform: translateX(-50%);
    width: 3rem; display: flex; flex-direction: column; align-items: center;
    pointer-events: auto; z-index: 5;
  }
  .section-compare__handle-line {
    flex: 1; width: 2px; background: #fff;
    box-shadow: 0 0 4px rgba(0,0,0,0.3);
  }
  .section-compare__handle-knob {
    width: 2.5rem; height: 2.5rem; border-radius: 50%;
    background: #fff; box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    display: flex; align-items: center; justify-content: center;
    position: absolute; top: 50%; transform: translateY(-50%);
    pointer-events: auto;
  }
  .section-compare__handle-knob svg { width: 14px; color: #333; }
{% endstylesheet %}

