{{ 'section-before-after.css' | asset_url | stylesheet_tag }}
{%- comment %}
  Section: Before/After Slider
{% endcomment -%}

{%- liquid
  case section.settings.image_ratio
    when 'portrait'
      assign cmp_ratio = '4 / 5'
    when 'square'
      assign cmp_ratio = '1 / 1'
    when 'wide'
      assign cmp_ratio = '16 / 9'
    when 'adapt'
      assign cmp_ratio = section.settings.image_before.aspect_ratio | default: 1.5
    else
      assign cmp_ratio = '3 / 2'
  endcase
-%}
<div
  id="section-{{ section.id }}"
  class="section-compare color-{{ section.settings.color_scheme }}"
  style="
    --cmp-dt: {{ section.settings.padding_top_desktop }}px;
    --cmp-db: {{ section.settings.padding_bottom_desktop }}px;
    --cmp-mt: {{ section.settings.padding_top_mobile }}px;
    --cmp-mb: {{ section.settings.padding_bottom_mobile }}px;
    --cmp-ratio: {{ cmp_ratio }};
    --cmp-max-w: {{ section.settings.max_width }}px;
    --cmp-max-h: {{ section.settings.max_height }}px;
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-compare__head">
        {%- if section.settings.subheading != blank -%}
          <p class="section-compare__subheading subheading-size-{{ section.settings.subheading_size }}">{{ section.settings.subheading }}</p>
        {%- endif -%}
        <{{ section.settings.heading_tag }} class="section-compare__heading heading-size-{{ section.settings.heading_size }}">
          {{- section.settings.heading -}}
        </{{ section.settings.heading_tag }}>
      </div>
    {%- endif -%}

    <div class="section-compare__wrapper" data-compare-slider style="--compare-pos: 50%;">
      <div class="section-compare__before">
        {%- if section.settings.image_before != blank -%}
          {{ section.settings.image_before | image_url: width: 1200 | image_tag:
            widths: '375, 750, 1000, 1200', sizes: '(max-width: 749px) 100vw, 60vw',
            loading: 'lazy', class: 'section-compare__img'
          }}
        {%- else -%}
          <div class="section-compare__ph">{{ 'image' | placeholder_svg_tag }}</div>
        {%- endif -%}
        {%- if section.settings.label_before != blank -%}
          <span class="section-compare__label section-compare__label--before">{{ section.settings.label_before }}</span>
        {%- endif -%}
      </div>
      <div class="section-compare__after">
        {%- if section.settings.image_after != blank -%}
          {{ section.settings.image_after | image_url: width: 1200 | image_tag:
            widths: '375, 750, 1000, 1200', sizes: '(max-width: 749px) 100vw, 60vw',
            loading: 'lazy', class: 'section-compare__img'
          }}
        {%- else -%}
          <div class="section-compare__ph">{{ 'image' | placeholder_svg_tag }}</div>
        {%- endif -%}
        {%- if section.settings.label_after != blank -%}
          <span class="section-compare__label section-compare__label--after">{{ section.settings.label_after }}</span>
        {%- endif -%}
      </div>
      <div class="section-compare__handle" role="slider" aria-label="{{ 'accessibility.comparison_slider' | t }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" tabindex="0">
        <div class="section-compare__handle-line"></div>
        <div class="section-compare__handle-knob">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="15 18 9 12 15 6"/></svg>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="9 18 15 12 9 6"/></svg>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  var ac = new AbortController();
  var el = document.querySelector('#section-{{ section.id }} [data-compare-slider]');
  if (!el) return;
  var handle = el.querySelector('[role="slider"]');
  var pointerId = null;
  var currentPos = 0.5;

  function update(x) {
    var rect = el.getBoundingClientRect();
    currentPos = Math.max(0, Math.min(1, (x - rect.left) / rect.width));
    el.style.setProperty('--compare-pos', (currentPos * 100) + '%');
    if (handle) handle.setAttribute('aria-valuenow', Math.round(currentPos * 100));
  }

  function endDrag(e) {
    if (e.pointerId !== pointerId) return;
    pointerId = null;
    if (el.hasPointerCapture(e.pointerId)) el.releasePointerCapture(e.pointerId);
  }

  el.addEventListener('pointerdown', function(e) {
    if (e.pointerType === 'mouse' && e.button !== 0) return;
    pointerId = e.pointerId;
    el.setPointerCapture(e.pointerId);
    if (e.pointerType === 'mouse') {
      e.preventDefault();
      update(e.clientX);
    }
  }, { signal: ac.signal });
  el.addEventListener('pointermove', function(e) { if (e.pointerId === pointerId) update(e.clientX); }, { signal: ac.signal });
  el.addEventListener('pointerup', function(e) {
    if (e.pointerId === pointerId) update(e.clientX);
    endDrag(e);
  }, { signal: ac.signal });
  el.addEventListener('pointercancel', endDrag, { signal: ac.signal });
  document.addEventListener('shopify:section:unload', function(e) {
    if (e.detail.sectionId === '{{ section.id }}') ac.abort();
  }, { signal: ac.signal });

  if (handle) {
    handle.addEventListener('keydown', function(e) {
      var step = 0.02;
      if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') { currentPos = Math.max(0, currentPos - step); }
      else if (e.key === 'ArrowRight' || e.key === 'ArrowUp') { currentPos = Math.min(1, currentPos + step); }
      else return;
      e.preventDefault();
      el.style.setProperty('--compare-pos', (currentPos * 100) + '%');
      handle.setAttribute('aria-valuenow', Math.round(currentPos * 100));
    });
  }
})();
</script>


