{%- layout none -%}
{%- if cart.item_count > 0 -%}
  {%- for item in cart.items -%}
    <article class="cart-modal-item" data-line-item="{{ forloop.index }}" data-variant-id="{{ item.variant_id }}">
      <a href="{{ item.url }}" title="{{ item.product.title | escape }}" class="cart-modal-item__image">
        {%- if item.image != blank -%}
          {%- assign cart_item_alt = item.image.alt | default: item.product.title | escape -%}
          {{
            item.image
            | image_url: width: 400
            | image_tag:
              widths: '160, 240, 320, 400',
              sizes: '(max-width: 749px) 104px, 144px',
              alt: cart_item_alt,
              loading: 'lazy',
              decoding: 'async'
          }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'cart-modal-item__placeholder' }}
        {%- endif -%}
      </a>

      <div class="cart-modal-item__info">
        <div class="cart-modal-item__details">
          <a href="{{ item.url }}" title="{{ item.product.title | escape }}" class="cart-modal-item__title">{{ item.product.title | escape }}</a>
          {%- render 'cart-line-details', item: item -%}
          {%- render 'cart-line-price', item: item -%}
        </div>

        <div class="cart-modal-item__actions">
          <div class="cart-modal-item__quantity">
            {%- assign drawer_quantity_id = 'drawer-' | append: forloop.index -%}
            {%- render 'quantity-selector',
              form: '',
              name: 'updates[]',
              product: item.product,
              variant: item.variant,
              cart_item: item,
              id_suffix: drawer_quantity_id,
              value: item.quantity
            -%}
          </div>
          <button type="button" class="cart-modal-item__remove" aria-label="{{ 'sections.cart.remove_title' | t: title: item.product.title }}" title="{{ 'sections.cart.remove_title' | t: title: item.product.title }}" data-action="remove-cart-item" data-line="{{ forloop.index }}">
            {%- render 'icon', name: 'trash' -%}
          </button>
        </div>
        <p class="cart-modal-item__quantity-error" data-quantity-error role="alert"></p>
      </div>
    </article>
  {%- endfor -%}
{%- endif -%}
