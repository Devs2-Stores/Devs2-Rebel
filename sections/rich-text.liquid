{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}
{%- comment %}
  Section: Rich Text
{% endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-rich-text color-{{ section.settings.color_scheme }}"
  style="
    --rich-dt: {{ section.settings.padding_top_desktop }}px;
    --rich-db: {{ section.settings.padding_bottom_desktop }}px;
    --rich-mt: {{ section.settings.padding_top_mobile }}px;
    --rich-mb: {{ section.settings.padding_bottom_mobile }}px;
    {%- if section.settings.section_width == 'fixed' -%}
      --rich-max-width: {{ section.settings.content_width }}px;
    {%- endif -%}
  "
>
  <div class="{% if section.settings.section_width == 'fixed' %}page-width{% else %}section-rich-text__full{% endif %}">
    <div class="section-rich-text__inner section-rich-text__align--{{ section.settings.text_align }}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'subheading' -%}
            <p
              class="section-rich-text__subheading subheading-size-{{ block.settings.subheading_size }}"
              {{ block.shopify_attributes }}
            >
              {{- block.settings.subheading -}}
            </p>

          {%- when 'heading' -%}
            <{{ block.settings.heading_tag }}
              class="section-rich-text__heading heading-size-{{ block.settings.heading_size }}"
              {{ block.shopify_attributes }}
            >
              {{- block.settings.heading -}}
            </{{ block.settings.heading_tag }}>

          {%- when 'text' -%}
            <div
              class="section-rich-text__text rte content-size-{{ block.settings.content_size }}"
              {{ block.shopify_attributes }}
            >
              {{- block.settings.text -}}
            </div>

          {%- when 'button' -%}
            <div class="section-rich-text__buttons" {{ block.shopify_attributes }}>
              {%- if block.settings.button_label_1 != blank -%}
                <a
                  href="{{ block.settings.button_link_1 | default: '#' }}"
                  class="section-rich-text__btn section-rich-text__btn--{{ block.settings.button_style_1 }} button-size-{{ block.settings.button_size }}"
                >
                  {{- block.settings.button_label_1 -}}
                </a>
              {%- endif -%}
              {%- if block.settings.button_label_2 != blank -%}
                <a
                  href="{{ block.settings.button_link_2 | default: '#' }}"
                  class="section-rich-text__btn section-rich-text__btn--{{ block.settings.button_style_2 }} button-size-{{ block.settings.button_size }}"
                >
                  {{- block.settings.button_label_2 -}}
                </a>
              {%- endif -%}
            </div>

          {%- when 'empty_space' -%}
            <div
              class="block-empty-space"
              style="--block-spacer: {{ block.settings.spacing }}px;"
              {{ block.shopify_attributes }}
            ></div>

        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>


