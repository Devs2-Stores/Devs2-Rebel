{%- comment %}
  Section: Rich Text
{% endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-rich-text color-{{ section.settings.color_scheme }}"
  style="
    --rich-dt: {{ section.settings.padding_top_desktop }}px;
    --rich-db: {{ section.settings.padding_bottom_desktop }}px;
    --rich-mt: {{ section.settings.padding_top_mobile }}px;
    --rich-mb: {{ section.settings.padding_bottom_mobile }}px;
    {%- if section.settings.section_width == 'fixed' -%}
      --rich-max-width: {{ section.settings.content_width }}px;
    {%- endif -%}
  "
>
  <div class="{% if section.settings.section_width == 'fixed' %}page-width{% else %}section-rich-text__full{% endif %}">
    <div class="section-rich-text__inner section-rich-text__align--{{ section.settings.text_align }}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'subheading' -%}
            <p
              class="section-rich-text__subheading subheading-size-{{ block.settings.subheading_size }}"
              {{ block.shopify_attributes }}
            >
              {{- block.settings.subheading -}}
            </p>

          {%- when 'heading' -%}
            <{{ block.settings.heading_tag }}
              class="section-rich-text__heading heading-size-{{ block.settings.heading_size }}"
              {{ block.shopify_attributes }}
            >
              {{- block.settings.heading -}}
            </{{ block.settings.heading_tag }}>

          {%- when 'text' -%}
            <div
              class="section-rich-text__text rte content-size-{{ block.settings.content_size }}"
              {{ block.shopify_attributes }}
            >
              {{- block.settings.text -}}
            </div>

          {%- when 'button' -%}
            <div class="section-rich-text__buttons" {{ block.shopify_attributes }}>
              {%- if block.settings.button_label_1 != blank -%}
                <a
                  href="{{ block.settings.button_link_1 | default: '#' }}"
                  class="section-rich-text__btn section-rich-text__btn--{{ block.settings.button_style_1 }} button-size-{{ block.settings.button_size }}"
                >
                  {{- block.settings.button_label_1 -}}
                </a>
              {%- endif -%}
              {%- if block.settings.button_label_2 != blank -%}
                <a
                  href="{{ block.settings.button_link_2 | default: '#' }}"
                  class="section-rich-text__btn section-rich-text__btn--{{ block.settings.button_style_2 }} button-size-{{ block.settings.button_size }}"
                >
                  {{- block.settings.button_label_2 -}}
                </a>
              {%- endif -%}
            </div>

          {%- when 'empty_space' -%}
            <div
              class="block-empty-space"
              style="--block-spacer: {{ block.settings.spacing }}px;"
              {{ block.shopify_attributes }}
            ></div>

        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  /* ── Rich Text ── */
  .section-rich-text {
    padding-block-start: var(--rich-mt);
    padding-block-end: var(--rich-mb);
    background-color: rgb(var(--color-background));
    color: rgba(var(--color-foreground), 0.85);
  }

  @media (min-width: 750px) {
    .section-rich-text {
      padding-block-start: var(--rich-dt);
      padding-block-end: var(--rich-db);
    }
  }

  .section-rich-text__inner {
    max-width: var(--rich-max-width, 800px);
  }

  .section-rich-text__full {
    padding-inline: 15px;
  }

  @media (min-width: 750px) {
    .section-rich-text__full {
      padding-inline: 30px;
    }
  }

  .section-rich-text__full .section-rich-text__inner {
    max-width: none;
  }

  /* ── Alignment ── */
  .section-rich-text__align--left {
    text-align: left;
    margin-inline-end: auto;
  }

  .section-rich-text__align--center {
    text-align: center;
    margin-inline: auto;
  }

  .section-rich-text__align--right {
    text-align: right;
    margin-inline-start: auto;
  }

  /* ── Heading ── */
  .section-rich-text__heading {
    color: var(--color-ink);
    margin: 0 0 0.75rem;
    line-height: 1.15;
    letter-spacing: var(--heading-tracking);
  }

  /* ── Subheading ── */
  .section-rich-text__subheading {
    font-weight: var(--eyebrow-weight);
    letter-spacing: var(--eyebrow-tracking);
    text-transform: uppercase;
    color: var(--color-muted);
    margin: 0 0 0.75rem;
  }

  /* ── Text ── */
  .section-rich-text__text {
    margin: 0 0 1.5rem;
    color: var(--color-muted);
    line-height: 1.65;
    max-width: 65ch;
  }

  .section-rich-text__align--center .section-rich-text__text {
    margin-inline: auto;
  }

  .section-rich-text__text:last-child {
    margin-block-end: 0;
  }

  .section-rich-text__text a {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* ── Buttons ── */
  .section-rich-text__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-block-start: 1.5rem;
  }

  .section-rich-text__align--center .section-rich-text__buttons {
    justify-content: center;
  }

  .section-rich-text__align--right .section-rich-text__buttons {
    justify-content: flex-end;
  }

  .section-rich-text__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--btn-height);
    padding: 0 var(--btn-padding-x);
    font-size: var(--btn-font-size);
    font-weight: var(--btn-font-weight);
    letter-spacing: var(--btn-letter-spacing);
    text-decoration: none;
    border-radius: var(--buttons-radius, 0);
    transition: background-color var(--duration-default) ease, color var(--duration-default) ease, border-color var(--duration-default) ease;
    cursor: pointer;
  }

  .section-rich-text__btn--primary {
    background: var(--color-primary);
    color: rgb(var(--color-button-text));
    border: 1px solid var(--color-primary);
  }

  .section-rich-text__btn--primary:hover {
    background: var(--color-primary-strong);
    border-color: var(--color-primary-strong);
    color: rgb(var(--color-button-text));
  }

  .section-rich-text__btn--secondary {
    background: transparent;
    color: var(--color-ink);
    border: 1px solid var(--color-ink);
  }

  .section-rich-text__btn--secondary:hover {
    background: var(--color-ink);
    color: rgb(var(--color-background));
    border-color: var(--color-ink);
  }

  .section-rich-text__btn--link {
    background: none;
    border: none;
    color: var(--color-ink);
    padding: 0;
    min-height: auto;
    min-width: auto;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
{% endstylesheet %}

