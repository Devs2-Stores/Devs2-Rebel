{%- comment %}
  Section: Recently Viewed Products
  Mô tả: Hiển thị sản phẩm đã xem qua localStorage + Section Rendering API.
{% endcomment -%}

{%- liquid
  assign columns_d = section.settings.columns_desktop
  assign max_products = section.settings.max_products
-%}

<div
  id="section-{{ section.id }}"
  class="section-recently-viewed color-{{ section.settings.color_scheme }}"
  style="
    --rv-dt: {{ section.settings.padding_top_desktop }}px;
    --rv-db: {{ section.settings.padding_bottom_desktop }}px;
    --rv-mt: {{ section.settings.padding_top_mobile }}px;
    --rv-mb: {{ section.settings.padding_bottom_mobile }}px;
    --rv-cols-d: {{ columns_d }};
  "
  data-recently-viewed
  data-max="{{ max_products }}"
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-recently-viewed__head">
        <{{ section.settings.heading_tag }} class="section-recently-viewed__heading heading-size-{{ section.settings.heading_size }}">
          {{- section.settings.heading -}}
        </{{ section.settings.heading_tag }}>
      </div>
    {%- endif -%}
    <div class="section-recently-viewed__grid" data-rv-grid></div>
    <div class="section-recently-viewed__empty" data-rv-empty hidden>
      <p>{{ 'general.recently_viewed.empty' | t | default: 'No products viewed yet' }}</p>
    </div>
  </div>
</div>

<script>
(function() {
  var KEY = 'shopify_recently_viewed';
  var section = document.querySelector('#section-{{ section.id }}');
  if (!section) return;
  var grid = section.querySelector('[data-rv-grid]');
  var emptyEl = section.querySelector('[data-rv-empty]');
  var max = parseInt(section.getAttribute('data-max'), 10) || 8;
  var rootUrl = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) ? window.Shopify.routes.root : '/';
  if (rootUrl.charAt(rootUrl.length - 1) !== '/') rootUrl += '/';

  /* Track current product */
  if (window.location.pathname.indexOf('/products/') !== -1) {
    var handle = window.location.pathname.split('/products/')[1].split('?')[0].split('#')[0];
    if (handle) {
      try {
        var stored = JSON.parse(localStorage.getItem(KEY) || '[]');
        stored = stored.filter(function(h) { return h !== handle; });
        stored.unshift(handle);
        if (stored.length > 20) stored = stored.slice(0, 20);
        localStorage.setItem(KEY, JSON.stringify(stored));
      } catch (e) {}
    }
  }

  /* Display */
  var handles;
  try { handles = JSON.parse(localStorage.getItem(KEY) || '[]').slice(0, max); }
  catch (e) { handles = []; }

  if (handles.length === 0) {
    section.style.display = 'none';
    return;
  }

  function formatMoney(cents) {
    var amount = (cents / 100).toFixed(2);
    var symbol = (window.Shopify && window.Shopify.currency && window.Shopify.currency.active) ? window.Shopify.currency.active : '$';
    return symbol + amount;
  }

  function buildCard(p) {
    var item = document.createElement('div');
    item.className = 'section-recently-viewed__item';

    var card = document.createElement('a');
    card.href = rootUrl + 'products/' + p.handle;
    card.className = 'section-recently-viewed__card';

    if (p.featured_image) {
      var media = document.createElement('div');
      media.className = 'section-recently-viewed__media';
      var img = document.createElement('img');
      img.src = p.featured_image.replace(/(\.[^.]+)$/, '_400x$1');
      img.alt = p.title || '';
      img.loading = 'lazy';
      img.className = 'section-recently-viewed__img';
      media.appendChild(img);
      card.appendChild(media);
    }

    var info = document.createElement('div');
    info.className = 'section-recently-viewed__info';

    var title = document.createElement('h3');
    title.className = 'section-recently-viewed__title';
    title.textContent = p.title || '';

    var price = document.createElement('span');
    price.className = 'section-recently-viewed__price';
    price.textContent = formatMoney(p.price || 0);

    info.appendChild(title);
    info.appendChild(price);
    card.appendChild(info);
    item.appendChild(card);
    return item;
  }

  Promise.all(handles.map(function(h) {
    return fetch(rootUrl + 'products/' + encodeURIComponent(h) + '.js')
      .then(function(r) { return r.ok ? r.json() : null; })
      .catch(function() { return null; });
  })).then(function(products) {
    products = products.filter(Boolean);
    if (products.length === 0) {
      emptyEl.hidden = false;
      return;
    }
    var frag = document.createDocumentFragment();
    products.forEach(function(p) { frag.appendChild(buildCard(p)); });
    grid.innerHTML = '';
    grid.appendChild(frag);
  });
})();
</script>

{% stylesheet %}
  .section-recently-viewed {
    padding-block: var(--rv-mt) var(--rv-mb);
    background: rgb(var(--color-background));
    color: rgba(var(--color-foreground), 0.85);
  }
  @media (min-width: 750px) {
    .section-recently-viewed { padding-block: var(--rv-dt) var(--rv-db); }
  }
  .section-recently-viewed__head { margin-bottom: 1.5rem; }
  .section-recently-viewed__heading { margin: 0; color: rgb(var(--color-foreground)); }

  .section-recently-viewed__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  @media (min-width: 750px) {
    .section-recently-viewed__grid {
      grid-template-columns: repeat(var(--rv-cols-d, 4), 1fr);
      gap: 20px;
    }
  }

  .section-recently-viewed__card {
    display: block; text-decoration: none; color: inherit;
    transition: opacity 0.3s;
  }
  .section-recently-viewed__card:hover { opacity: 0.8; }

  .section-recently-viewed__media {
    aspect-ratio: 3 / 4; overflow: hidden;
    border-radius: 0.375rem; background: rgba(var(--color-foreground), 0.04);
  }
  .section-recently-viewed__img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.5s;
  }
  .section-recently-viewed__card:hover .section-recently-viewed__img { transform: scale(1.04); }

  .section-recently-viewed__info { padding: 0.5rem 0; }
  .section-recently-viewed__title {
    margin: 0; font-size: 0.8125rem; font-weight: 500;
    color: rgb(var(--color-foreground)); line-height: 1.4;
    display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .section-recently-viewed__price {
    font-size: 0.8125rem; font-weight: 600;
    color: rgba(var(--color-foreground), 0.7);
  }

  .section-recently-viewed__empty {
    text-align: center; padding: 2rem;
    color: rgba(var(--color-foreground), 0.4); font-size: 0.875rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Recently viewed",
  "tag": "section",
  "class": "section-recently-viewed-wrapper",
  "limit": 1,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Heading" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Recently viewed" },
    { "type": "select", "id": "heading_size", "label": "Heading size", "options": [{ "value": "sm", "label": "S" },{ "value": "md", "label": "M" },{ "value": "lg", "label": "L" }], "default": "md" },
    { "type": "select", "id": "heading_tag", "label": "Heading tag", "options": [{ "value": "h2", "label": "H2" },{ "value": "h3", "label": "H3" }], "default": "h2" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_products", "min": 2, "max": 12, "step": 1, "label": "Max products", "default": 8 },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 6, "step": 1, "label": "Desktop columns", "default": 4 },
    { "type": "header", "content": "Desktop spacing" },
    { "type": "range", "id": "padding_top_desktop", "min": 0, "max": 150, "step": 5, "unit": "px", "label": "Top", "default": 50 },
    { "type": "range", "id": "padding_bottom_desktop", "min": 0, "max": 150, "step": 5, "unit": "px", "label": "Bottom", "default": 50 },
    { "type": "header", "content": "Mobile spacing" },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "Top", "default": 30 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "Bottom", "default": 30 }
  ],
  "presets": [{ "name": "Recently viewed", "category": "Collection" }]
}
{% endschema %}
