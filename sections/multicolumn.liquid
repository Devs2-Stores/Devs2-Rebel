{{ 'section-multicolumn.css' | asset_url | stylesheet_tag }}
{%- comment %}
  Section: Multicolumn
{% endcomment -%}

{%- liquid
  assign columns_d = section.settings.columns_desktop
  assign columns_m = section.settings.columns_mobile
  assign text_align = section.settings.text_align
  assign icon_size = section.settings.icon_size
-%}

<div
  id="section-{{ section.id }}"
  class="section-multicolumn color-{{ section.settings.color_scheme }}"
  style="
    --mc-dt: {{ section.settings.padding_top_desktop }}px;
    --mc-db: {{ section.settings.padding_bottom_desktop }}px;
    --mc-mt: {{ section.settings.padding_top_mobile }}px;
    --mc-mb: {{ section.settings.padding_bottom_mobile }}px;
    --mc-cols-d: {{ columns_d }};
    --mc-cols-m: {{ columns_m }};
    --mc-icon-size: {{ icon_size }}px;
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-multicolumn__head">
        {%- if section.settings.subheading != blank -%}
          <p class="section-multicolumn__subheading subheading-size-{{ section.settings.subheading_size }}">
            {{- section.settings.subheading -}}
          </p>
        {%- endif -%}
        <{{ section.settings.heading_tag }}
          class="section-multicolumn__heading heading-size-{{ section.settings.heading_size }}"
        >
          {{- section.settings.heading -}}
        </{{ section.settings.heading_tag }}>
      </div>
    {%- endif -%}

    <div class="section-multicolumn__grid section-multicolumn__grid--{{ text_align }}">
      {%- for block in section.blocks -%}
        <div class="section-multicolumn__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="section-multicolumn__icon">
              {%- assign icon_alt = block.settings.image.alt | default: block.settings.heading -%}
              {{ block.settings.image | image_url: width: 200 | image_tag:
                loading: 'lazy', decoding: 'async',
                alt: icon_alt,
                class: 'section-multicolumn__icon-img'
              }}
            </div>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h3 class="section-multicolumn__item-heading heading-size-{{ block.settings.heading_size }}">
              {{- block.settings.heading -}}
            </h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="section-multicolumn__item-text content-size-{{ block.settings.text_size }}">
              {{- block.settings.text -}}
            </div>
          {%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <a href="{{ block.settings.button_link | default: '#' }}" class="section-multicolumn__item-link">
              {{ block.settings.button_label }}
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>


{% schema %}
{
  "name": "t:sections.multicolumn.name",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "tag": "section",
  "class": "section-multicolumn-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.multicolumn.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.multicolumn.settings.header__heading.content"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:sections.multicolumn.settings.subheading.label"
    },
    {
      "type": "select",
      "id": "subheading_size",
      "label": "t:sections.multicolumn.settings.subheading_size.label",
      "options": [
        {
          "value": "xs",
          "label": "t:sections.multicolumn.settings.subheading_size.options.xs"
        },
        {
          "value": "sm",
          "label": "t:sections.multicolumn.settings.subheading_size.options.sm"
        },
        {
          "value": "md",
          "label": "t:sections.multicolumn.settings.subheading_size.options.md"
        },
        {
          "value": "lg",
          "label": "t:sections.multicolumn.settings.subheading_size.options.lg"
        }
      ],
      "default": "sm"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.multicolumn.settings.heading.label",
      "default": "t:sections.multicolumn.settings.heading.default"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.multicolumn.settings.heading_size.label",
      "options": [
        {
          "value": "sm",
          "label": "t:sections.multicolumn.settings.heading_size.options.sm"
        },
        {
          "value": "md",
          "label": "t:sections.multicolumn.settings.heading_size.options.md"
        },
        {
          "value": "lg",
          "label": "t:sections.multicolumn.settings.heading_size.options.lg"
        },
        {
          "value": "xl",
          "label": "t:sections.multicolumn.settings.heading_size.options.xl"
        }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.multicolumn.settings.heading_tag.label",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.multicolumn.settings.heading_tag.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.multicolumn.settings.heading_tag.options.h3"
        },
        {
          "value": "p",
          "label": "t:sections.multicolumn.settings.heading_tag.options.p"
        }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "t:sections.multicolumn.settings.header__layout.content"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "t:sections.multicolumn.settings.text_align.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.multicolumn.settings.text_align.options.left"
        },
        {
          "value": "center",
          "label": "t:sections.multicolumn.settings.text_align.options.center"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "t:sections.multicolumn.settings.columns_desktop.label",
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.multicolumn.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.multicolumn.settings.columns_mobile.options._1"
        },
        {
          "value": "2",
          "label": "t:sections.multicolumn.settings.columns_mobile.options._2"
        }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 24,
      "max": 96,
      "step": 8,
      "unit": "px",
      "label": "t:sections.multicolumn.settings.icon_size.label",
      "default": 48
    },
    {
      "type": "header",
      "content": "t:sections.multicolumn.settings.header__desktop_spacing.content"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "t:sections.multicolumn.settings.padding_top_desktop.label",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "t:sections.multicolumn.settings.padding_bottom_desktop.label",
      "default": 50
    },
    {
      "type": "header",
      "content": "t:sections.multicolumn.settings.header__mobile_spacing.content"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:sections.multicolumn.settings.padding_top_mobile.label",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:sections.multicolumn.settings.padding_bottom_mobile.label",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "t:sections.multicolumn.blocks.column.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.multicolumn.blocks.column.settings.image.label"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "t:sections.multicolumn.blocks.column.settings.heading.label",
          "default": "t:sections.multicolumn.blocks.column.settings.heading.default"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "t:sections.multicolumn.blocks.column.settings.heading_size.label",
          "options": [
            {
              "value": "xs",
              "label": "t:sections.multicolumn.blocks.column.settings.heading_size.options.xs"
            },
            {
              "value": "sm",
              "label": "t:sections.multicolumn.blocks.column.settings.heading_size.options.sm"
            },
            {
              "value": "md",
              "label": "t:sections.multicolumn.blocks.column.settings.heading_size.options.md"
            }
          ],
          "default": "sm"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.multicolumn.blocks.column.settings.text.label",
          "default": "t:sections.multicolumn.blocks.column.settings.text.default"
        },
        {
          "type": "select",
          "id": "text_size",
          "label": "t:sections.multicolumn.blocks.column.settings.text_size.label",
          "options": [
            {
              "value": "sm",
              "label": "t:sections.multicolumn.blocks.column.settings.text_size.options.sm"
            },
            {
              "value": "md",
              "label": "t:sections.multicolumn.blocks.column.settings.text_size.options.md"
            },
            {
              "value": "lg",
              "label": "t:sections.multicolumn.blocks.column.settings.text_size.options.lg"
            }
          ],
          "default": "sm"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:sections.multicolumn.blocks.column.settings.button_label.label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.multicolumn.blocks.column.settings.button_link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.multicolumn.presets.multicolumn.name",
      "category": "t:categories.text",
      "blocks": [
        {
          "type": "column"
        },
        {
          "type": "column"
        },
        {
          "type": "column"
        }
      ]
    }
  ]
}
{% endschema %}
