{%- comment %}
  Section: Multicolumn
  Mô tả: Grid linh hoạt — icon/image + heading + text per column.
  Dùng cho USP bar, features, benefits, shipping info.
{% endcomment -%}

{%- liquid
  assign columns_d = section.settings.columns_desktop
  assign columns_m = section.settings.columns_mobile
  assign text_align = section.settings.text_align
  assign icon_size = section.settings.icon_size
-%}

<div
  id="section-{{ section.id }}"
  class="section-multicolumn color-{{ section.settings.color_scheme }}"
  style="
    --mc-dt: {{ section.settings.padding_top_desktop }}px;
    --mc-db: {{ section.settings.padding_bottom_desktop }}px;
    --mc-mt: {{ section.settings.padding_top_mobile }}px;
    --mc-mb: {{ section.settings.padding_bottom_mobile }}px;
    --mc-cols-d: {{ columns_d }};
    --mc-cols-m: {{ columns_m }};
    --mc-icon-size: {{ icon_size }}px;
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-multicolumn__head">
        {%- if section.settings.subheading != blank -%}
          <p class="section-multicolumn__subheading subheading-size-{{ section.settings.subheading_size }}">
            {{- section.settings.subheading -}}
          </p>
        {%- endif -%}
        <{{ section.settings.heading_tag }}
          class="section-multicolumn__heading heading-size-{{ section.settings.heading_size }}"
        >
          {{- section.settings.heading -}}
        </{{ section.settings.heading_tag }}>
      </div>
    {%- endif -%}

    <div class="section-multicolumn__grid section-multicolumn__grid--{{ text_align }}">
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}{%- continue -%}{%- endif -%}
        <div class="section-multicolumn__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="section-multicolumn__icon">
              {%- assign icon_alt = block.settings.image.alt | default: block.settings.heading -%}
              {{ block.settings.image | image_url: width: 200 | image_tag:
                loading: 'lazy', decoding: 'async',
                alt: icon_alt,
                class: 'section-multicolumn__icon-img'
              }}
            </div>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h3 class="section-multicolumn__item-heading heading-size-{{ block.settings.heading_size }}">
              {{- block.settings.heading -}}
            </h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="section-multicolumn__item-text content-size-{{ block.settings.text_size }}">
              {{- block.settings.text -}}
            </div>
          {%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <a href="{{ block.settings.button_link | default: '#' }}" class="section-multicolumn__item-link">
              {{ block.settings.button_label }}
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    {%- capture app_blocks -%}
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}{%- render block -%}{%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if app_blocks != blank -%}
      <div class="section-apps">{{ app_blocks }}</div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .section-multicolumn {
    padding-block: var(--mc-mt) var(--mc-mb);
    background: rgb(var(--color-background));
    color: rgba(var(--color-foreground), 0.85);
  }
  @media (min-width: 750px) {
    .section-multicolumn { padding-block: var(--mc-dt) var(--mc-db); }
  }
  .section-multicolumn__head { text-align: center; margin-bottom: var(--section-head-gap); }
  .section-multicolumn__subheading {
    margin: 0 0 0.5rem;
    font-weight: var(--eyebrow-weight);
    letter-spacing: var(--eyebrow-tracking);
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .section-multicolumn__heading {
    margin: 0;
    color: var(--color-ink);
    line-height: 1.15;
    letter-spacing: var(--heading-tracking);
  }
  .section-multicolumn__grid {
    display: grid;
    grid-template-columns: repeat(var(--mc-cols-m, 1), 1fr);
    gap: 1.5rem;
  }
  @media (min-width: 750px) {
    .section-multicolumn__grid {
      grid-template-columns: repeat(var(--mc-cols-d, 3), 1fr);
      gap: 2rem;
    }
  }
  .section-multicolumn__grid--left { text-align: left; }
  .section-multicolumn__grid--center { text-align: center; }
  .section-multicolumn__grid--center .section-multicolumn__item { align-items: center; }

  .section-multicolumn__item {
    display: flex; flex-direction: column; gap: 0.5rem;
  }
  .section-multicolumn__icon { width: var(--mc-icon-size, 48px); height: var(--mc-icon-size, 48px); flex-shrink: 0; }
  .section-multicolumn__grid--center .section-multicolumn__icon { margin: 0 auto; }
  .section-multicolumn__icon-img { width: 100%; height: 100%; object-fit: contain; }

  .section-multicolumn__item-heading { margin: 0; color: var(--color-ink); letter-spacing: var(--heading-tracking); }
  .section-multicolumn__item-text { margin: 0; color: var(--color-muted); line-height: 1.65; }
  .section-multicolumn__item-text p { margin: 0; }

  .section-multicolumn__item-link {
    display: inline-flex; align-items: center; gap: 0.25rem;
    font-size: 0.875rem; font-weight: 500; color: var(--color-ink);
    text-decoration: underline; text-underline-offset: 0.25em;
  }
  .section-multicolumn__item-link:hover { color: var(--color-ink); }
  .section-multicolumn__item-link svg { transition: transform var(--duration-default) ease; }
  @media (hover: hover) {
    .section-multicolumn__item-link:hover svg { transform: translateX(3px); }
  }
{% endstylesheet %}

