{{ 'section-parallax-image.css' | asset_url | stylesheet_tag }}
{%- comment %}
  Section: Parallax Image Banner
{% endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-parallax color-{{ section.settings.color_scheme }}"
  style="
    --px-height: {{ section.settings.section_height }}vh;
    --px-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  "
  data-parallax-section
>
  <div class="section-parallax__bg" data-parallax-bg>
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag:
        widths: '1080, 1440, 1920, 2400', sizes: '100vw',
        loading: 'lazy', class: 'section-parallax__img'
      }}
    {%- else -%}
      <div class="section-parallax__ph">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {%- endif -%}
  </div>
  <div class="section-parallax__overlay"></div>

  <div class="section-parallax__content section-parallax__content--{{ section.settings.content_position }}">
    <div class="page-width">
      <div class="section-parallax__inner section-parallax__inner--{{ section.settings.text_align }}" style="--parallax-content-max-width: {{ section.settings.content_width }}rem;">
        {%- if section.settings.subheading != blank -%}
          <p class="section-parallax__subheading subheading-size-{{ section.settings.subheading_size }}">{{ section.settings.subheading }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <{{ section.settings.heading_tag }} class="section-parallax__heading heading-size-{{ section.settings.heading_size }}">
            {{- section.settings.heading -}}
          </{{ section.settings.heading_tag }}>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="section-parallax__text content-size-{{ section.settings.text_size }}">{{ section.settings.text }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="section-parallax__btn section-parallax__btn--{{ section.settings.button_style }} button-size-{{ section.settings.button_size }}">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  var ac = new AbortController();
  var section = document.querySelector('#section-{{ section.id }}');
  if (!section) return;
  var bg = section.querySelector('[data-parallax-bg]');
  var speed = {{ section.settings.parallax_speed | default: 0.4 }};

  function onScroll() {
    var rect = section.getBoundingClientRect();
    var viewH = window.innerHeight || 900;
    var maxOffset = rect.height * 0.16;
    var raw = ((viewH * 0.5 - (rect.top + rect.height * 0.5)) / viewH) * (speed * 0.04) * rect.height;
    var offset = Math.max(-maxOffset, Math.min(maxOffset, raw));
    bg.style.transform = 'translate3d(0, ' + offset.toFixed(1) + 'px, 0)';
  }

  window.addEventListener('scroll', onScroll, { passive: true, signal: ac.signal });
  document.addEventListener('shopify:section:unload', function(e) {
    if (e.detail.sectionId === '{{ section.id }}') ac.abort();
  }, { signal: ac.signal });
  onScroll();
})();
</script>


