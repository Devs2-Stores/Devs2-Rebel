{%- comment %}
  Section: Slideshow with Product
  Mô tả: Slideshow nhưng mỗi slide có product card overlay.
{% endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-swp color-{{ section.settings.color_scheme }}"
  style="--swp-height: {{ section.settings.section_height }}vh;"
>
  <div class="swiper section-swp__swiper" data-swp-slider>
    <div class="swiper-wrapper">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        <div class="swiper-slide" {{ block.shopify_attributes }}>
          <div class="section-swp__slide">
            <div class="section-swp__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1920 | image_tag:
                  widths: '750, 1080, 1440, 1920', sizes: '100vw',
                  loading: 'lazy', class: 'section-swp__img'
                }}
              {%- else -%}
                <div class="section-swp__ph" style="background: {% cycle '#1a1a2e', '#16213e', '#0f3460' %};"></div>
              {%- endif -%}
              <div class="section-swp__overlay" style="--swp-ov: {{ block.settings.overlay_opacity | divided_by: 100.0 }};"></div>
            </div>

            <div class="section-swp__content page-width">
              <div class="section-swp__text section-swp__text--{{ block.settings.text_align }}">
                {%- if block.settings.heading != blank -%}
                  <h2 class="section-swp__heading heading-size-{{ block.settings.heading_size }}">{{ block.settings.heading }}</h2>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="section-swp__desc content-size-md">{{ block.settings.text }}</p>
                {%- endif -%}
              </div>

              {%- if p != blank -%}
                <div class="section-swp__product-card">
                  <a href="{{ p.url }}" class="section-swp__product-link">
                    {%- if p.featured_image -%}
                      {{ p.featured_image | image_url: width: 200 | image_tag:
                        loading: 'lazy', class: 'section-swp__product-img'
                      }}
                    {%- endif -%}
                    <div class="section-swp__product-info">
                      <span class="section-swp__product-title">{{ p.title }}</span>
                      <span class="section-swp__product-price">{{ p.price | money }}</span>
                    </div>
                  </a>
                  {%- form 'product', p -%}
                    <input type="hidden" name="id" value="{{ p.variants.first.id }}">
                    <button type="submit" class="section-swp__product-atc button-size-sm">
                      {{ 'products.product.add_to_cart' | t | default: 'Add to cart' }}
                    </button>
                  {%- endform -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
    <div class="section-swp__pagination" data-swp-pagination></div>
    <div class="section-swp__prev" data-swp-prev>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
    </div>
    <div class="section-swp__next" data-swp-next>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
    </div>
  </div>
</div>

<script>
(function() {
  var w = document.getElementById('section-{{ section.id }}');
  if (!w) return;
  (window.swiperReady || function(cb){ cb(); })(function(){
    new Swiper(w.querySelector('[data-swp-slider]'), {
      slidesPerView: 1, loop: true, speed: 600,
      autoplay: { delay: {{ section.settings.autoplay_speed | times: 1000 }}, disableOnInteraction: true },
      pagination: { el: w.querySelector('[data-swp-pagination]'), clickable: true },
      navigation: { prevEl: w.querySelector('[data-swp-prev]'), nextEl: w.querySelector('[data-swp-next]') }
    });
  });
})();
</script>

{% stylesheet %}
  .section-swp { position: relative; }
  .section-swp__swiper { overflow: hidden; }

  .section-swp__slide {
    position: relative; height: var(--swp-height, 70vh);
    min-height: 400px; display: flex; color: #fff;
  }

  .section-swp__media { position: absolute; inset: 0; }
  .section-swp__img { width: 100%; height: 100%; object-fit: cover; }
  .section-swp__ph { width: 100%; height: 100%; }
  .section-swp__overlay {
    position: absolute; inset: 0; background: rgba(0,0,0, var(--swp-ov, 0.3));
  }

  .section-swp__content {
    position: relative; z-index: 2; width: 100%;
    display: flex; align-items: flex-end; justify-content: space-between;
    padding-bottom: 3rem; gap: 1.5rem; flex-wrap: wrap;
  }

  .section-swp__text { display: flex; flex-direction: column; gap: 0.5rem; max-width: 30rem; }
  .section-swp__heading { margin: 0; color: #fff; line-height: 1.1; }
  .section-swp__desc { margin: 0; color: rgba(255,255,255,0.8); }

  .section-swp__product-card {
    background: rgba(255,255,255,0.95); backdrop-filter: blur(10px);
    border-radius: 0.75rem; padding: 0.75rem;
    box-shadow: 0 4px 16px rgba(0,0,0,0.1);
    display: flex; flex-direction: column; gap: 0.5rem;
    min-width: 180px; max-width: 220px;
  }
  .section-swp__product-link { display: flex; gap: 0.625rem; text-decoration: none; }
  .section-swp__product-img {
    width: 60px; height: 60px; border-radius: 0.375rem;
    object-fit: cover; flex-shrink: 0;
  }
  .section-swp__product-info { display: flex; flex-direction: column; gap: 0.125rem; justify-content: center; }
  .section-swp__product-title { font-size: 0.8125rem; font-weight: 600; color: #111; line-height: 1.3; }
  .section-swp__product-price { font-size: 0.75rem; font-weight: 700; color: #059669; }

  .section-swp__product-atc {
    width: 100%; display: flex; align-items: center; justify-content: center;
    background: #111; color: #fff; border: none; border-radius: 0.375rem;
    font-weight: 600; font-size: 0.75rem; cursor: pointer;
    transition: opacity 0.2s;
  }
  .section-swp__product-atc:hover { opacity: 0.85; }

  .section-swp__pagination { position: absolute; bottom: 1rem; left: 50%; transform: translateX(-50%); z-index: 3; }
  .section-swp__pagination .swiper-pagination-bullet { background: rgba(255,255,255,0.6); }
  .section-swp__pagination .swiper-pagination-bullet-active { background: #fff; }

  .section-swp__prev, .section-swp__next {
    position: absolute; top: 50%; transform: translateY(-50%); z-index: 3;
    width: 2.5rem; height: 2.5rem; border-radius: 50%;
    background: rgba(255,255,255,0.15); backdrop-filter: blur(4px);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; color: #fff; transition: background 0.3s;
  }
  .section-swp__prev:hover, .section-swp__next:hover { background: rgba(255,255,255,0.3); }
  .section-swp__prev { left: 1rem; }
  .section-swp__next { right: 1rem; }
  @media (max-width: 749px) {
    .section-swp__prev, .section-swp__next { display: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Slideshow with product",
  "tag": "section",
  "class": "section-swp-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "section_height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Height",
      "default": 70
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay speed",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%",
          "label": "Overlay",
          "default": 30
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "New collection"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "options": [
            {
              "value": "lg",
              "label": "L"
            },
            {
              "value": "xl",
              "label": "XL"
            },
            {
              "value": "2xl",
              "label": "2XL"
            }
          ],
          "default": "xl"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "select",
          "id": "text_align",
          "label": "Text align",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            }
          ],
          "default": "left"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Featured product"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Slideshow with product",
      "category": "Collection",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "heading": "Spring collection",
            "text": "Discover our latest arrivals"
          }
        },
        {
          "type": "slide",
          "settings": {
            "heading": "Summer essentials",
            "text": "Everything you need"
          }
        }
      ]
    }
  ]
}
{% endschema %}
