{%- comment %}
  Section: Slideshow
  Hero banner slideshow powered by Swiper.
{% endcomment -%}

{%- liquid
  assign section_height_desktop = section.settings.height_desktop
  assign section_height_mobile = section.settings.height_mobile
  assign autoplay_speed = section.settings.autoplay_speed | times: 1000
  assign transition_speed = section.settings.transition_speed | times: 100
  assign show_pagination = section.settings.show_pagination
  assign show_arrows = section.settings.show_arrows
  assign auto_slide = section.settings.auto_slide
  assign slide_count = section.blocks | where: 'type', 'slide' | size
  assign slide_index = 0
  assign region_label = section.settings.accessibility_label | default: ''
  if region_label == blank
    assign region_label = 'accessibility.slideshow' | t
  endif
-%}

<div
  id="section-{{ section.id }}"
  class="section-slideshow"
  role="region"
  aria-roledescription="carousel"
  aria-label="{{ region_label | escape }}"
  style="
    --slideshow-height-d: {{ section_height_desktop }}vh;
    --slideshow-height-m: {{ section_height_mobile }}vh;
    --slideshow-autoplay: {{ autoplay_speed }}ms;
  "
>
  {%- if slide_count > 0 -%}
    {%- if auto_slide and slide_count > 1 -%}
      <button
        type="button"
        class="section-slideshow__rotation"
        data-slideshow-rotation
        hidden
        aria-label="{{ 'accessibility.pause_slideshow' | t }}"
      >
        <svg class="section-slideshow__rotation-pause" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
        <svg class="section-slideshow__rotation-play" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="7 4 20 12 7 20 7 4"></polygon></svg>
      </button>
    {%- endif -%}
    <div
      class="section-slideshow__swiper swiper"
      data-slideshow
      data-autoplay="{{ auto_slide }}"
      data-autoplay-speed="{{ autoplay_speed }}"
      data-transition-speed="{{ transition_speed }}"
      data-loop="{{ slide_count | at_least: 2 | at_most: slide_count }}"
    >
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}{%- continue -%}{%- endif -%}
          {%- liquid
            assign slide_index = slide_index | plus: 1
            assign desktop_img = block.settings.image_desktop
            assign mobile_img = block.settings.image_mobile | default: desktop_img
            assign img_alt = desktop_img.alt | default: block.settings.heading | default: shop.name
            assign text_position = block.settings.text_position
            assign overlay_opacity = block.settings.overlay_opacity | divided_by: 100.0
            assign slide_heading_tag = block.settings.heading_tag
            if template.name == 'index' and slide_heading_tag == 'h1'
              assign slide_heading_tag = 'h2'
            endif
            assign has_content = false
            if block.settings.heading != blank or block.settings.subheading != blank or block.settings.text != blank or block.settings.button_label_1 != blank
              assign has_content = true
            endif
          -%}

          <div
            class="section-slideshow__slide swiper-slide"
            role="group"
            aria-roledescription="slide"
            aria-label="{{ slide_index }} / {{ slide_count }}"
            {{ block.shopify_attributes }}
          >
            {%- comment %} Background Images {% endcomment -%}
            <div class="section-slideshow__media">
              {%- if desktop_img -%}
                {%- liquid
                  if slide_index == 1
                    assign img_loading = 'eager'
                    assign img_fetchpriority = 'high'
                  else
                    assign img_loading = 'lazy'
                    assign img_fetchpriority = 'auto'
                  endif
                -%}
                <picture>
                  {%- if mobile_img != desktop_img -%}
                    <source
                      media="(max-width: 749px)"
                      srcset="{{ mobile_img | image_url: width: 375 }} 375w, {{ mobile_img | image_url: width: 550 }} 550w, {{ mobile_img | image_url: width: 750 }} 750w, {{ mobile_img | image_url: width: 1100 }} 1100w, {{ mobile_img | image_url: width: 1500 }} 1500w"
                      sizes="100vw"
                    >
                  {%- endif -%}
                  {{ desktop_img | image_url: width: 1920 | image_tag:
                    widths: '750, 1080, 1440, 1920',
                    sizes: '100vw',
                    alt: img_alt,
                    loading: img_loading,
                    fetchpriority: img_fetchpriority,
                    decoding: 'async',
                    class: 'section-slideshow__img'
                  }}
                </picture>
              {%- else -%}
                <div class="section-slideshow__placeholder">
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'section-slideshow__placeholder-svg' }}
                </div>
              {%- endif -%}
            </div>

            {%- comment %} Overlay {% endcomment -%}
            {%- if overlay_opacity > 0 -%}
              <div
                class="section-slideshow__overlay"
                style="--slideshow-overlay: {{ overlay_opacity }};"
              ></div>
            {%- endif -%}

            {%- comment %} Content {% endcomment -%}
            {%- if has_content -%}
              <div class="section-slideshow__content section-slideshow__content--{{ text_position }} color-{{ block.settings.color_scheme }}">
                <div class="section-slideshow__content-inner">
                  {%- if block.settings.subheading != blank -%}
                    <p class="section-slideshow__subheading subheading-size-{{ block.settings.subheading_size }}">
                      {{- block.settings.subheading -}}
                    </p>
                  {%- endif -%}

                  {%- if block.settings.heading != blank -%}
                    <{{ slide_heading_tag }}
                      class="section-slideshow__heading heading-size-{{ block.settings.heading_size }}"
                    >
                      {{- block.settings.heading -}}
                    </{{ slide_heading_tag }}>
                  {%- endif -%}

                  {%- if block.settings.text != blank -%}
                    <div class="section-slideshow__text content-size-{{ block.settings.text_size }}">
                      {{- block.settings.text -}}
                    </div>
                  {%- endif -%}

                  {%- if block.settings.button_label_1 != blank or block.settings.button_label_2 != blank -%}
                    <div class="section-slideshow__buttons">
                      {%- if block.settings.button_label_1 != blank -%}
                        <a
                          href="{{ block.settings.button_link_1 | default: '#' }}"
                          class="section-slideshow__btn section-slideshow__btn--{{ block.settings.button_style_1 }} button-size-{{ block.settings.button_size }}"
                        >
                          {{- block.settings.button_label_1 -}}
                        </a>
                      {%- endif -%}
                      {%- if block.settings.button_label_2 != blank -%}
                        <a
                          href="{{ block.settings.button_link_2 | default: '#' }}"
                          class="section-slideshow__btn section-slideshow__btn--{{ block.settings.button_style_2 }} button-size-{{ block.settings.button_size }}"
                        >
                          {{- block.settings.button_label_2 -}}
                        </a>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {%- comment %} Pagination {% endcomment -%}
      {%- if show_pagination and slide_count > 1 -%}
        <div class="section-slideshow__pagination"></div>
      {%- endif -%}

      {%- comment %} Slide Counter {% endcomment -%}
      {%- if section.settings.show_counter and slide_count > 1 -%}
        <div class="section-slideshow__counter" aria-hidden="true">
          <span class="section-slideshow__counter-current">1</span>
          <span class="section-slideshow__counter-sep">/</span>
          <span class="section-slideshow__counter-total">{{ slide_count }}</span>
        </div>
      {%- endif -%}

      {%- comment %} Navigation Arrows {% endcomment -%}
      {%- if show_arrows and slide_count > 1 -%}
        <button type="button" class="section-slideshow__nav section-slideshow__nav--prev" aria-label="{{ 'accessibility.previous_slide' | t }}">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <button type="button" class="section-slideshow__nav section-slideshow__nav--next" aria-label="{{ 'accessibility.next_slide' | t }}">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      {%- endif -%}
    </div>
  {%- else -%}
    {%- comment %} Empty state for Theme Editor {% endcomment -%}
    <div class="section-slideshow__empty">
      {{ 'lifestyle-1' | placeholder_svg_tag: 'section-slideshow__placeholder-svg' }}
    </div>
  {%- endif -%}
  {%- capture app_blocks -%}
    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}{%- render block -%}{%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if app_blocks != blank -%}
    <div class="section-apps">{{ app_blocks }}</div>
  {%- endif -%}
</div>

<script>
  (function() {
    var wrapper = document.getElementById('section-{{ section.id }}');
    if (!wrapper) return;
    var el = wrapper.querySelector('[data-slideshow]');
    if (!el) return;
    (window.swiperReady || function(cb){ cb(); })(function(){
    var autoplay = el.getAttribute('data-autoplay') === 'true';
    var autoplaySpeed = parseInt(el.getAttribute('data-autoplay-speed'), 10) || 5000;
    var transitionSpeed = parseInt(el.getAttribute('data-transition-speed'), 10) || 800;
    var slideCount = el.querySelectorAll('.swiper-slide').length;

    var config = {
      loop: slideCount > 1,
      speed: transitionSpeed,
      grabCursor: slideCount > 1,
      effect: 'fade',
      fadeEffect: { crossFade: true },
      touchEventsTarget: 'container',
      allowTouchMove: slideCount > 1
    };

    if (autoplay && slideCount > 1) {
      config.autoplay = {
        delay: autoplaySpeed,
        disableOnInteraction: false
      };
    }

    var paginationEl = wrapper.querySelector('.section-slideshow__pagination');
    if (paginationEl) {
      var bulletLabel = {{ 'accessibility.slide_number' | t: number: '__n__' | json }};
      config.pagination = {
        el: paginationEl,
        clickable: true,
        renderBullet: function(index, className) {
          var label = bulletLabel.replace('__n__', index + 1).replace(/"/g, '&quot;');
          return '<button type="button" class="' + className + '" aria-label="' + label + '"><span class="section-slideshow__progress"></span></button>';
        }
      };
    }

    var prevEl = wrapper.querySelector('.section-slideshow__nav--prev');
    var nextEl = wrapper.querySelector('.section-slideshow__nav--next');
    if (prevEl && nextEl) {
      config.navigation = {
        prevEl: prevEl,
        nextEl: nextEl
      };
    }

    var counterCurrent = wrapper.querySelector('.section-slideshow__counter-current');

    var swiperInstance = new Swiper(el, config);

    var syncHiddenSlides = function() {
      swiperInstance.slides.forEach(function(slide, index) {
        slide.inert = index !== swiperInstance.activeIndex;
      });
    };
    syncHiddenSlides();
    swiperInstance.on('slideChange', syncHiddenSlides);

    if (counterCurrent) {
      swiperInstance.on('slideChange', function() {
        counterCurrent.textContent = swiperInstance.realIndex + 1;
      });
    }

    if (!config.autoplay) return;

    var rotationBtn = wrapper.querySelector('[data-slideshow-rotation]');
    var pauseLabel = {{ 'accessibility.pause_slideshow' | t | json }};
    var playLabel = {{ 'accessibility.play_slideshow' | t | json }};
    var holds = { pointer: false, focus: false, user: false };

    var setHold = function(key, value) {
      holds[key] = value;
      var held = holds.pointer || holds.focus || holds.user;
      if (held && swiperInstance.autoplay.running) swiperInstance.autoplay.stop();
      else if (!held && !swiperInstance.autoplay.running) swiperInstance.autoplay.start();
    };

    swiperInstance.on('autoplayStop', function() {
      wrapper.classList.add('is-rotation-stopped');
      swiperInstance.wrapperEl.setAttribute('aria-live', 'polite');
    });
    swiperInstance.on('autoplayStart', function() {
      wrapper.classList.remove('is-rotation-stopped', 'is-rotation-paused');
      swiperInstance.wrapperEl.setAttribute('aria-live', 'off');
    });
    swiperInstance.on('autoplayPause', function() { wrapper.classList.add('is-rotation-paused'); });
    swiperInstance.on('autoplayResume', function() { wrapper.classList.remove('is-rotation-paused'); });

    wrapper.addEventListener('pointerenter', function(event) {
      if (event.pointerType === 'mouse') setHold('pointer', true);
    });
    wrapper.addEventListener('pointerleave', function(event) {
      if (event.pointerType === 'mouse') setHold('pointer', false);
    });
    wrapper.addEventListener('focusin', function(event) {
      setHold('focus', !(rotationBtn && rotationBtn.contains(event.target)));
    });
    wrapper.addEventListener('focusout', function(event) {
      if (!wrapper.contains(event.relatedTarget)) setHold('focus', false);
    });

    if (rotationBtn) {
      rotationBtn.hidden = false;
      rotationBtn.addEventListener('click', function() {
        var stop = !holds.user;
        rotationBtn.setAttribute('aria-label', stop ? playLabel : pauseLabel);
        wrapper.classList.toggle('is-rotation-user-stopped', stop);
        setHold('user', stop);
      });
    }
    });
  })();
</script>

{% stylesheet %}
  /* ── Slideshow ── */
  .section-slideshow {
    position: relative;
    width: 100%;
    height: var(--slideshow-height-m, 60vh);
    overflow: hidden;
  }

  .section-slideshow__swiper,
  .section-slideshow .swiper-wrapper,
  .section-slideshow__slide {
    position: relative;
    height: var(--slideshow-height-m, 60vh);
    overflow: hidden;
  }

  @media (min-width: 750px) {
    .section-slideshow {
      height: var(--slideshow-height-d, 80vh);
    }

    .section-slideshow__swiper,
    .section-slideshow .swiper-wrapper,
    .section-slideshow__slide {
      height: var(--slideshow-height-d, 80vh);
    }
  }

  /* ── Media ── */
  .section-slideshow__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .section-slideshow__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .section-slideshow__placeholder,
  .section-slideshow__empty {
    width: 100%;
    height: var(--slideshow-height-m, 60vh);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-black);
  }

  @media (min-width: 750px) {
    .section-slideshow__placeholder,
    .section-slideshow__empty {
      height: var(--slideshow-height-d, 80vh);
    }
  }

  .section-slideshow__placeholder-svg {
    width: 50%;
    max-width: 600px;
    opacity: 0.15;
    color: var(--color-white);
    fill: currentColor;
  }

  /* ── Overlay ── */
  .section-slideshow__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(0, 0, 0, var(--slideshow-overlay, 0.3));
    pointer-events: none;
  }

  /* ── Content ── */
  .section-slideshow__content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    padding: 2.5rem max(15px, calc((100% - var(--page-width, 1200px)) / 2 + 15px)) 3.5rem;
    background: transparent;
  }

  @media (min-width: 750px) {
    .section-slideshow__content {
      padding: 3.5rem max(30px, calc((100% - var(--page-width, 1200px)) / 2 + 30px)) 4.5rem;
    }
  }

  @media (min-width: 1024px) {
    .section-slideshow__content {
      padding: 4rem max(75px, calc((100% - var(--page-width, 1200px)) / 2 + 75px)) 5rem;
    }
  }

  .section-slideshow__content-inner {
    max-width: 42rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding: 0;
    background: transparent;
    box-shadow: none;
  }

  @media (max-width: 749px) {
    .section-slideshow__content-inner {
      max-width: min(100%, 22rem);
    }
  }

  /* ── Text Position ── */
  .section-slideshow__content--top_left {
    align-items: start;
    justify-items: start;
  }
  .section-slideshow__content--top_center {
    align-items: start;
    justify-items: center;
    text-align: center;
  }
  .section-slideshow__content--top_right {
    align-items: start;
    justify-items: end;
    text-align: right;
  }
  .section-slideshow__content--middle_left {
    align-items: center;
    justify-items: start;
  }
  .section-slideshow__content--middle_center {
    align-items: center;
    justify-items: center;
    text-align: center;
  }
  .section-slideshow__content--middle_right {
    align-items: center;
    justify-items: end;
    text-align: right;
  }
  .section-slideshow__content--bottom_left {
    align-items: end;
    justify-items: start;
  }
  .section-slideshow__content--bottom_center {
    align-items: end;
    justify-items: center;
    text-align: center;
  }
  .section-slideshow__content--bottom_right {
    align-items: end;
    justify-items: end;
    text-align: right;
  }

  /* ── Slide Text Animation ── */
  .section-slideshow__subheading,
  .section-slideshow__heading,
  .section-slideshow__text,
  .section-slideshow__buttons {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .swiper-slide-active .section-slideshow__subheading {
    opacity: 1; transform: translateY(0); transition-delay: 0.3s;
  }
  .swiper-slide-active .section-slideshow__heading {
    opacity: 1; transform: translateY(0); transition-delay: 0.5s;
  }
  .swiper-slide-active .section-slideshow__text {
    opacity: 1; transform: translateY(0); transition-delay: 0.7s;
  }
  .swiper-slide-active .section-slideshow__buttons {
    opacity: 1; transform: translateY(0); transition-delay: 0.9s;
  }

  /* ── Typography ── */
  .section-slideshow__subheading {
    margin: 0;
    font-weight: var(--eyebrow-weight);
    letter-spacing: var(--eyebrow-tracking);
    text-transform: uppercase;
    color: var(--color-white);
  }

  .section-slideshow__heading {
    margin: 0;
    color: var(--color-white);
    line-height: 1.08;
    letter-spacing: var(--heading-tracking);
  }

  .section-slideshow__text {
    margin: 0;
    color: var(--color-white);
    line-height: 1.6;
    max-width: 60ch;
  }

  /* ── Buttons ── */
  .section-slideshow__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-block-start: 0.5rem;
  }

  .section-slideshow__content--top_center .section-slideshow__buttons,
  .section-slideshow__content--middle_center .section-slideshow__buttons,
  .section-slideshow__content--bottom_center .section-slideshow__buttons {
    justify-content: center;
  }

  .section-slideshow__content--top_right .section-slideshow__buttons,
  .section-slideshow__content--middle_right .section-slideshow__buttons,
  .section-slideshow__content--bottom_right .section-slideshow__buttons {
    justify-content: flex-end;
  }

  .section-slideshow__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--btn-height);
    padding: 0 var(--btn-padding-x);
    font-size: var(--btn-font-size);
    font-weight: var(--btn-font-weight);
    letter-spacing: var(--btn-letter-spacing);
    text-decoration: none;
    border-radius: var(--buttons-radius, 0);
    transition: background-color var(--duration-default) ease, color var(--duration-default) ease, border-color var(--duration-default) ease;
    cursor: pointer;
  }

  .section-slideshow__btn:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 2px;
  }

  .section-slideshow__btn--primary {
    background: var(--color-white);
    color: var(--color-black);
    border: 1px solid var(--color-white);
  }

  .section-slideshow__btn--primary:hover {
    background: rgba(255, 255, 255, 0.88);
    border-color: rgba(255, 255, 255, 0.88);
  }

  .section-slideshow__btn--secondary {
    background: transparent;
    color: var(--color-white);
    border: 1px solid var(--color-white);
  }

  .section-slideshow__btn--secondary:hover {
    background: var(--color-white);
    color: var(--color-black);
    border-color: var(--color-white);
  }

  .section-slideshow__btn--link {
    background: none;
    border: none;
    color: var(--color-white);
    padding: 12px 4px;
    min-width: auto;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* ── Navigation Arrows ── */
  .section-slideshow__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--buttons-radius, 0);
    background: rgba(0, 0, 0, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.4);
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color var(--duration-default) ease, border-color var(--duration-default) ease, color var(--duration-default) ease;
  }

  .section-slideshow__nav:hover {
    background: var(--color-white);
    border-color: var(--color-white);
    color: var(--color-black);
  }

  .section-slideshow__nav:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 3px;
  }

  .section-slideshow__nav--prev { left: 1rem; }
  .section-slideshow__nav--next { right: 1rem; }

  @media (min-width: 750px) {
    .section-slideshow__nav--prev { left: 1.5rem; }
    .section-slideshow__nav--next { right: 1.5rem; }
  }

  @media (max-width: 749px) {
    .section-slideshow__nav {
      width: 2.25rem;
      height: 2.25rem;
    }
    .section-slideshow__nav--prev { left: 0.5rem; }
    .section-slideshow__nav--next { right: 0.5rem; }
    .section-slideshow__nav svg {
      width: 16px;
      height: 16px;
    }
  }

  /* ── Pagination ── */
  .section-slideshow__pagination {
    --swiper-pagination-bottom: 0.75rem;
    position: absolute;
    inset-inline: 0;
    bottom: 0.75rem;
    z-index: 10;
    display: flex;
    justify-content: center;
    gap: 8px;
    pointer-events: none;
  }

  .section-slideshow__pagination .swiper-pagination-bullet {
    width: 2rem;
    height: 1.5rem;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    opacity: 1;
    position: relative;
    cursor: pointer;
    pointer-events: auto;
    transition: width var(--duration-medium) ease;
  }

  .section-slideshow__pagination .swiper-pagination-bullet::before,
  .section-slideshow__progress {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: calc(50% - 1.5px);
    height: 3px;
    border-radius: 2px;
  }

  .section-slideshow__pagination .swiper-pagination-bullet::before {
    background: rgba(255, 255, 255, 0.4);
    transition: background-color var(--duration-medium) ease;
  }

  .section-slideshow__pagination .swiper-pagination-bullet:hover::before {
    background: rgba(255, 255, 255, 0.75);
  }

  .section-slideshow__pagination .swiper-pagination-bullet-active {
    width: 3rem;
  }

  .section-slideshow__pagination .swiper-pagination-bullet-active::before {
    background: rgba(255, 255, 255, 0.5);
  }

  .section-slideshow__progress {
    background: var(--color-white);
    transform-origin: left;
    transform: scaleX(0);
  }

  .swiper-pagination-bullet-active .section-slideshow__progress {
    animation: slideshow-progress var(--slideshow-autoplay, 5000ms) linear forwards;
  }

  @keyframes slideshow-progress {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  [data-autoplay="false"] .section-slideshow__progress {
    display: none;
  }

  [data-autoplay="false"] .section-slideshow__pagination .swiper-pagination-bullet-active::before {
    background: var(--color-white);
  }

  .is-rotation-paused .swiper-pagination-bullet-active .section-slideshow__progress {
    animation-play-state: paused;
  }

  .is-rotation-stopped .swiper-pagination-bullet-active .section-slideshow__progress {
    animation: none;
  }

  .is-rotation-stopped .section-slideshow__pagination .swiper-pagination-bullet-active::before {
    background: var(--color-white);
  }

  /* ── Rotation Control ── */
  .section-slideshow__rotation {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    z-index: 10;
    width: 2rem;
    height: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: var(--buttons-radius, 0);
    background: rgba(0, 0, 0, 0.45);
    color: var(--color-white);
    cursor: pointer;
    transition: background-color var(--duration-default) ease, border-color var(--duration-default) ease, color var(--duration-default) ease;
  }

  .section-slideshow__rotation:hover {
    background: var(--color-white);
    border-color: var(--color-white);
    color: var(--color-black);
  }

  .section-slideshow__rotation:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 3px;
  }

  .section-slideshow__rotation[hidden] {
    display: none;
  }

  .section-slideshow__rotation-play,
  .is-rotation-user-stopped .section-slideshow__rotation-pause {
    display: none;
  }

  .is-rotation-user-stopped .section-slideshow__rotation-play {
    display: block;
  }

  @media (min-width: 750px) {
    .section-slideshow__rotation {
      bottom: 1.125rem;
      left: 1.5rem;
    }
  }

  /* ── Slide Counter ── */
  .section-slideshow__counter {
    position: absolute;
    bottom: 1.25rem;
    right: 1.5rem;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.55);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-white);
    letter-spacing: 0.05em;
  }

  .section-slideshow__counter-current {
    min-width: 1ch;
    text-align: right;
  }
{% endstylesheet %}

