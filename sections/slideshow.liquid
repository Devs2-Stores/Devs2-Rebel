{{ 'section-slideshow.css' | asset_url | stylesheet_tag }}
{%- comment %}
  Section: Slideshow
  Hero banner slideshow powered by Swiper.
{% endcomment -%}

{%- liquid
  assign section_height_desktop = section.settings.height_desktop
  assign section_height_mobile = section.settings.height_mobile
  assign autoplay_speed = section.settings.autoplay_speed | times: 1000
  assign transition_speed = section.settings.transition_speed | times: 100
  assign show_pagination = section.settings.show_pagination
  assign show_arrows = section.settings.show_arrows
  assign auto_slide = section.settings.auto_slide
  assign slide_count = section.blocks | where: 'type', 'slide' | size
  assign slide_index = 0
  assign region_label = section.settings.accessibility_label | default: ''
  if region_label == blank
    assign region_label = 'accessibility.slideshow' | t
  endif
-%}

<div
  id="section-{{ section.id }}"
  class="section-slideshow"
  role="region"
  aria-roledescription="carousel"
  aria-label="{{ region_label | escape }}"
  style="
    --slideshow-height-d: {{ section_height_desktop }}vh;
    --slideshow-height-m: {{ section_height_mobile }}vh;
    --slideshow-autoplay: {{ autoplay_speed }}ms;
  "
>
  {%- if slide_count > 0 -%}
    {%- if auto_slide and slide_count > 1 -%}
      <button
        type="button"
        class="section-slideshow__rotation"
        data-slideshow-rotation
        hidden
        aria-label="{{ 'accessibility.pause_slideshow' | t }}"
      >
        <svg class="section-slideshow__rotation-pause" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
        <svg class="section-slideshow__rotation-play" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="7 4 20 12 7 20 7 4"></polygon></svg>
      </button>
    {%- endif -%}
    <div
      class="section-slideshow__swiper swiper"
      data-slideshow
      data-autoplay="{{ auto_slide }}"
      data-autoplay-speed="{{ autoplay_speed }}"
      data-transition-speed="{{ transition_speed }}"
      data-loop="{{ slide_count | at_least: 2 | at_most: slide_count }}"
    >
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          {%- liquid
            assign slide_index = slide_index | plus: 1
            assign desktop_img = block.settings.image_desktop
            assign mobile_img = block.settings.image_mobile | default: desktop_img
            assign img_alt = desktop_img.alt | default: block.settings.heading | default: shop.name
            assign text_position = block.settings.text_position
            assign overlay_opacity = block.settings.overlay_opacity | divided_by: 100.0
            assign slide_heading_tag = block.settings.heading_tag
            if template.name == 'index' and slide_heading_tag == 'h1'
              assign slide_heading_tag = 'h2'
            endif
            assign has_content = false
            if block.settings.heading != blank or block.settings.subheading != blank or block.settings.text != blank or block.settings.button_label_1 != blank
              assign has_content = true
            endif
          -%}

          <div
            class="section-slideshow__slide swiper-slide"
            role="group"
            aria-roledescription="slide"
            aria-label="{{ slide_index }} / {{ slide_count }}"
            {{ block.shopify_attributes }}
          >
            {%- comment %} Background Images {% endcomment -%}
            <div class="section-slideshow__media">
              {%- if desktop_img -%}
                {%- liquid
                  if slide_index == 1
                    assign img_loading = 'eager'
                    assign img_fetchpriority = 'high'
                  else
                    assign img_loading = 'lazy'
                    assign img_fetchpriority = 'auto'
                  endif
                -%}
                <picture>
                  {%- if mobile_img != desktop_img -%}
                    <source
                      media="(max-width: 749px)"
                      srcset="{{ mobile_img | image_url: width: 375 }} 375w, {{ mobile_img | image_url: width: 550 }} 550w, {{ mobile_img | image_url: width: 750 }} 750w, {{ mobile_img | image_url: width: 1100 }} 1100w, {{ mobile_img | image_url: width: 1500 }} 1500w"
                      sizes="100vw"
                    >
                  {%- endif -%}
                  {{ desktop_img | image_url: width: 1920 | image_tag:
                    widths: '750, 1080, 1440, 1920',
                    sizes: '100vw',
                    alt: img_alt,
                    loading: img_loading,
                    fetchpriority: img_fetchpriority,
                    decoding: 'async',
                    class: 'section-slideshow__img'
                  }}
                </picture>
              {%- else -%}
                <div class="section-slideshow__placeholder">
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'section-slideshow__placeholder-svg' }}
                </div>
              {%- endif -%}
            </div>

            {%- comment %} Overlay {% endcomment -%}
            {%- if overlay_opacity > 0 -%}
              <div
                class="section-slideshow__overlay"
                style="--slideshow-overlay: {{ overlay_opacity }};"
              ></div>
            {%- endif -%}

            {%- comment %} Content {% endcomment -%}
            {%- if has_content -%}
              <div class="section-slideshow__content section-slideshow__content--{{ text_position }} color-{{ block.settings.color_scheme }}">
                <div class="section-slideshow__content-inner">
                  {%- if block.settings.subheading != blank -%}
                    <p class="section-slideshow__subheading subheading-size-{{ block.settings.subheading_size }}">
                      {{- block.settings.subheading -}}
                    </p>
                  {%- endif -%}

                  {%- if block.settings.heading != blank -%}
                    <{{ slide_heading_tag }}
                      class="section-slideshow__heading heading-size-{{ block.settings.heading_size }}"
                    >
                      {{- block.settings.heading -}}
                    </{{ slide_heading_tag }}>
                  {%- endif -%}

                  {%- if block.settings.text != blank -%}
                    <div class="section-slideshow__text content-size-{{ block.settings.text_size }}">
                      {{- block.settings.text -}}
                    </div>
                  {%- endif -%}

                  {%- if block.settings.button_label_1 != blank or block.settings.button_label_2 != blank -%}
                    <div class="section-slideshow__buttons">
                      {%- if block.settings.button_label_1 != blank -%}
                        <a
                          href="{{ block.settings.button_link_1 | default: '#' }}"
                          class="section-slideshow__btn section-slideshow__btn--{{ block.settings.button_style_1 }} button-size-{{ block.settings.button_size }}"
                        >
                          {{- block.settings.button_label_1 -}}
                        </a>
                      {%- endif -%}
                      {%- if block.settings.button_label_2 != blank -%}
                        <a
                          href="{{ block.settings.button_link_2 | default: '#' }}"
                          class="section-slideshow__btn section-slideshow__btn--{{ block.settings.button_style_2 }} button-size-{{ block.settings.button_size }}"
                        >
                          {{- block.settings.button_label_2 -}}
                        </a>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {%- comment %} Pagination {% endcomment -%}
      {%- if show_pagination and slide_count > 1 -%}
        <div class="section-slideshow__pagination"></div>
      {%- endif -%}

      {%- comment %} Slide Counter {% endcomment -%}
      {%- if section.settings.show_counter and slide_count > 1 -%}
        <div class="section-slideshow__counter" aria-hidden="true">
          <span class="section-slideshow__counter-current">1</span>
          <span class="section-slideshow__counter-sep">/</span>
          <span class="section-slideshow__counter-total">{{ slide_count }}</span>
        </div>
      {%- endif -%}

      {%- comment %} Navigation Arrows {% endcomment -%}
      {%- if show_arrows and slide_count > 1 -%}
        <button type="button" class="section-slideshow__nav section-slideshow__nav--prev" aria-label="{{ 'accessibility.previous_slide' | t }}">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <button type="button" class="section-slideshow__nav section-slideshow__nav--next" aria-label="{{ 'accessibility.next_slide' | t }}">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      {%- endif -%}
    </div>
  {%- else -%}
    {%- comment %} Empty state for Theme Editor {% endcomment -%}
    <div class="section-slideshow__empty">
      {{ 'lifestyle-1' | placeholder_svg_tag: 'section-slideshow__placeholder-svg' }}
    </div>
  {%- endif -%}
</div>

<script>
  (function() {
    var wrapper = document.getElementById('section-{{ section.id }}');
    if (!wrapper) return;
    var el = wrapper.querySelector('[data-slideshow]');
    if (!el) return;
    (window.swiperReady || function(cb){ cb(); })(function(){
    var autoplay = el.getAttribute('data-autoplay') === 'true';
    var autoplaySpeed = parseInt(el.getAttribute('data-autoplay-speed'), 10) || 5000;
    var transitionSpeed = parseInt(el.getAttribute('data-transition-speed'), 10) || 800;
    var slideCount = el.querySelectorAll('.swiper-slide').length;

    var config = {
      rewind: slideCount > 1,
      speed: transitionSpeed,
      grabCursor: slideCount > 1,
      effect: 'fade',
      fadeEffect: { crossFade: true },
      touchEventsTarget: 'container',
      allowTouchMove: slideCount > 1
    };

    if (autoplay && slideCount > 1) {
      config.autoplay = {
        delay: autoplaySpeed,
        disableOnInteraction: false
      };
    }

    var paginationEl = wrapper.querySelector('.section-slideshow__pagination');
    if (paginationEl) {
      var bulletLabel = {{ 'accessibility.slide_number' | t: number: '__n__' | json }};
      config.pagination = {
        el: paginationEl,
        clickable: true,
        renderBullet: function(index, className) {
          var label = bulletLabel.replace('__n__', index + 1).replace(/"/g, '&quot;');
          return '<button type="button" class="' + className + '" aria-label="' + label + '"><span class="section-slideshow__progress"></span></button>';
        }
      };
    }

    var prevEl = wrapper.querySelector('.section-slideshow__nav--prev');
    var nextEl = wrapper.querySelector('.section-slideshow__nav--next');
    if (prevEl && nextEl) {
      config.navigation = {
        prevEl: prevEl,
        nextEl: nextEl
      };
    }

    var counterCurrent = wrapper.querySelector('.section-slideshow__counter-current');

    var swiperInstance = new Swiper(el, config);

    var syncHiddenSlides = function() {
      swiperInstance.slides.forEach(function(slide, index) {
        slide.inert = index !== swiperInstance.activeIndex;
      });
    };
    syncHiddenSlides();
    swiperInstance.on('slideChange', syncHiddenSlides);

    if (counterCurrent) {
      swiperInstance.on('slideChange', function() {
        counterCurrent.textContent = swiperInstance.realIndex + 1;
      });
    }

    if (!config.autoplay) return;

    var rotationBtn = wrapper.querySelector('[data-slideshow-rotation]');
    var pauseLabel = {{ 'accessibility.pause_slideshow' | t | json }};
    var playLabel = {{ 'accessibility.play_slideshow' | t | json }};
    var holds = { pointer: false, focus: false, user: false };

    var setHold = function(key, value) {
      holds[key] = value;
      var held = holds.pointer || holds.focus || holds.user;
      if (held && swiperInstance.autoplay.running) swiperInstance.autoplay.stop();
      else if (!held && !swiperInstance.autoplay.running) swiperInstance.autoplay.start();
    };

    swiperInstance.on('autoplayStop', function() {
      wrapper.classList.add('is-rotation-stopped');
      swiperInstance.wrapperEl.setAttribute('aria-live', 'polite');
    });
    swiperInstance.on('autoplayStart', function() {
      wrapper.classList.remove('is-rotation-stopped', 'is-rotation-paused');
      swiperInstance.wrapperEl.setAttribute('aria-live', 'off');
    });
    swiperInstance.on('autoplayPause', function() { wrapper.classList.add('is-rotation-paused'); });
    swiperInstance.on('autoplayResume', function() { wrapper.classList.remove('is-rotation-paused'); });

    wrapper.addEventListener('pointerenter', function(event) {
      if (event.pointerType === 'mouse') setHold('pointer', true);
    });
    wrapper.addEventListener('pointerleave', function(event) {
      if (event.pointerType === 'mouse') setHold('pointer', false);
    });
    wrapper.addEventListener('focusin', function(event) {
      setHold('focus', !(rotationBtn && rotationBtn.contains(event.target)));
    });
    wrapper.addEventListener('focusout', function(event) {
      if (!wrapper.contains(event.relatedTarget)) setHold('focus', false);
    });

    if (rotationBtn) {
      rotationBtn.hidden = false;
      rotationBtn.addEventListener('click', function() {
        var stop = !holds.user;
        rotationBtn.setAttribute('aria-label', stop ? playLabel : pauseLabel);
        wrapper.classList.toggle('is-rotation-user-stopped', stop);
        setHold('user', stop);
      });
    }
    }, el);
  })();
</script>


{% schema %}
{
  "name": "t:sections.slideshow.name",
  "tag": "section",
  "class": "section-slideshow-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.slideshow.settings.header__layout.content"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "t:sections.slideshow.settings.height_desktop.label",
      "default": 80
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "t:sections.slideshow.settings.height_mobile.label",
      "default": 60
    },
    {
      "type": "header",
      "content": "t:sections.slideshow.settings.header__slideshow.content"
    },
    {
      "type": "checkbox",
      "id": "auto_slide",
      "label": "t:sections.slideshow.settings.auto_slide.label",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 9,
      "step": 1,
      "unit": "s",
      "label": "t:sections.slideshow.settings.autoplay_speed.label",
      "default": 5,
      "visible_if": "{{ section.settings.auto_slide }}"
    },
    {
      "type": "range",
      "id": "transition_speed",
      "min": 3,
      "max": 15,
      "step": 1,
      "label": "t:sections.slideshow.settings.transition_speed.label",
      "info": "t:sections.slideshow.settings.transition_speed.info",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "t:sections.slideshow.settings.show_pagination.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "t:sections.slideshow.settings.show_arrows.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_counter",
      "label": "t:sections.slideshow.settings.show_counter.label",
      "default": false
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "t:sections.slideshow.settings.accessibility_label.label",
      "default": "t:sections.slideshow.settings.accessibility_label.default",
      "info": "t:sections.slideshow.settings.accessibility_label.info"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:sections.slideshow.blocks.slide.name",
      "settings": [
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "t:sections.slideshow.blocks.slide.settings.color_scheme.label",
          "default": "scheme-1"
        },
        {
          "type": "header",
          "content": "t:sections.slideshow.blocks.slide.settings.header__image.content"
        },
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "t:sections.slideshow.blocks.slide.settings.image_desktop.label",
          "info": "t:sections.slideshow.blocks.slide.settings.image_desktop.info"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "t:sections.slideshow.blocks.slide.settings.image_mobile.label",
          "info": "t:sections.slideshow.blocks.slide.settings.image_mobile.info"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%",
          "label": "t:sections.slideshow.blocks.slide.settings.overlay_opacity.label",
          "default": 30
        },
        {
          "type": "header",
          "content": "t:sections.slideshow.blocks.slide.settings.header__content.content"
        },
        {
          "type": "select",
          "id": "text_position",
