          "options": [
            {
              "value": "top_left",
              "label": "t:sections.slideshow.blocks.slide.settings.text_position.options.top_left"
            },
            {
              "value": "top_center",
              "label": "t:sections.slideshow.blocks.slide.settings.text_position.options.top_center"
            },
            {
              "value": "top_right",
              "label": "t:sections.slideshow.blocks.slide.settings.text_position.options.top_right"
            },
            {
              "value": "middle_left",
              "label": "t:sections.slideshow.blocks.slide.settings.text_position.options.middle_left"
            },
            {
              "value": "middle_center",
              "label": "t:sections.slideshow.blocks.slide.settings.text_position.options.middle_center"
            },
