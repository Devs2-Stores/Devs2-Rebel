{%- comment %}
  Section: Popup / Modal
  Mô tả: Timed popup — newsletter, promo. Cookie-based dismiss.
{% endcomment -%}

{%- liquid
  assign delay = section.settings.delay | times: 1000
  assign popup_id = section.id
-%}

<div
  id="popup-{{ popup_id }}"
  class="section-popup color-{{ section.settings.color_scheme }}"
  data-popup
  data-popup-id="{{ popup_id }}"
  data-delay="{{ delay }}"
  data-frequency="{{ section.settings.frequency }}"
  hidden
>
  <div class="section-popup__overlay" data-popup-overlay></div>
  <div class="section-popup__modal" role="dialog" aria-modal="true" aria-labelledby="popup-heading-{{ popup_id }}">
    <button class="section-popup__close" data-popup-close aria-label="{{ 'accessibility.close_popup' | t }}">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>

    {%- if section.settings.image != blank -%}
      <div class="section-popup__media">
        {{ section.settings.image | image_url: width: 600 | image_tag:
          loading: 'lazy', class: 'section-popup__img'
        }}
      </div>
    {%- endif -%}

    <div class="section-popup__content">
      {%- if section.settings.heading != blank -%}
        <h2 id="popup-heading-{{ popup_id }}" class="section-popup__heading heading-size-{{ section.settings.heading_size }}">
          {{- section.settings.heading -}}
        </h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="section-popup__text content-size-{{ section.settings.text_size }}">
          {{- section.settings.text -}}
        </div>
      {%- endif -%}

      {%- if section.settings.show_newsletter -%}
        {%- form 'customer', id: 'popup-newsletter' -%}
          <input type="hidden" name="contact[tags]" value="newsletter,popup">
          <div class="section-popup__form">
            <label for="popup-newsletter-email" class="visually-hidden">{{ 'general.newsletter.email_label' | t | default: 'Email' }}</label>
            <input type="email" id="popup-newsletter-email" name="contact[email]" class="section-popup__input"
              placeholder="{{ 'general.newsletter.email_placeholder' | t | default: 'Enter your email' }}"
              aria-label="{{ 'general.newsletter.email_label' | t | default: 'Email' }}"
              required autocomplete="email">
            <button type="submit" class="section-popup__submit button-size-sm">
              {{ section.settings.button_label | default: 'Subscribe' }}
            </button>
          </div>
          {%- if form.posted_successfully? -%}
            <p class="section-popup__success">{{ 'general.newsletter.success' | t | default: 'Thanks!' }}</p>
          {%- endif -%}
        {%- endform -%}
      {%- elsif section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="section-popup__btn button-size-{{ section.settings.button_size }}">
          {{- section.settings.button_label -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
(function() {
  var el = document.getElementById('popup-{{ popup_id }}');
  if (!el) return;
  var id = el.getAttribute('data-popup-id');
  var delay = parseInt(el.getAttribute('data-delay')) || 3000;
  var freq = el.getAttribute('data-frequency');
  var key = 'popup_closed_' + id;

  var dismissed = freq === 'once' ? localStorage.getItem(key) : sessionStorage.getItem(key);
  if (dismissed) return;

  function openPopup() { el.hidden = false; document.body.style.overflow = 'hidden'; }
  function closePopup() {
    el.hidden = true; document.body.style.overflow = '';
    if (freq === 'once') localStorage.setItem(key, '1');
    else sessionStorage.setItem(key, '1');
  }

  setTimeout(openPopup, delay);
  el.querySelector('[data-popup-close]').addEventListener('click', closePopup);
  el.querySelector('[data-popup-overlay]').addEventListener('click', closePopup);
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && !el.hidden) closePopup();
  });
})();
</script>

{% stylesheet %}
  .section-popup[hidden] { display: none; }
  .section-popup {
    position: fixed; inset: 0; z-index: var(--z-modal, 9000);
    display: flex; align-items: center; justify-content: center;
    padding: 1rem;
  }
  .section-popup__overlay {
    position: absolute; inset: 0;
    background: rgba(0,0,0,0.5); backdrop-filter: blur(3px);
  }
  .section-popup__modal {
    position: relative; z-index: 1;
    background: rgb(var(--color-background));
    border-radius: 0.75rem;
    box-shadow: 0 20px 60px rgba(0,0,0,0.2);
    max-width: 28rem; width: 100%;
    overflow: hidden;
  }
  .section-popup__close {
    position: absolute; top: 0.75rem; right: 0.75rem; z-index: 2;
    background: rgba(var(--color-foreground), 0.06); border: none;
    width: 2rem; height: 2rem; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; color: rgb(var(--color-foreground));
    transition: background 0.3s;
  }
  .section-popup__close:hover { background: rgba(var(--color-foreground), 0.12); }

  .section-popup__media { aspect-ratio: 16 / 9; overflow: hidden; }
  .section-popup__img { width: 100%; height: 100%; object-fit: cover; }

  .section-popup__content {
    padding: 1.5rem; display: flex; flex-direction: column; gap: 0.75rem;
    text-align: center;
  }
  .section-popup__heading { margin: 0; color: rgb(var(--color-foreground)); }
  .section-popup__text { margin: 0; color: rgba(var(--color-foreground), 0.7); }

  .section-popup__form {
    display: flex; gap: 0;
    border: 1px solid rgba(var(--color-foreground), 0.15);
    border-radius: var(--buttons-radius, 0); overflow: hidden;
  }
  .section-popup__form:focus-within { border-color: rgb(var(--color-accent)); }
  .section-popup__input {
    flex: 1; border: none; outline: none;
    padding: 0.625rem 0.75rem; font-size: 0.8125rem;
    background: transparent; color: rgb(var(--color-foreground));
    font-family: inherit;
  }
  .section-popup__input::placeholder { color: rgba(var(--color-foreground), 0.4); }
  .section-popup__submit {
    background: rgb(var(--color-button)); color: rgb(var(--color-button-text));
    border: none; cursor: pointer; font-weight: 600; border-radius: 0;
    transition: opacity 0.3s;
  }
  .section-popup__submit:hover { opacity: 0.85; }
  .section-popup__success { margin: 0; font-size: 0.8125rem; color: #059669; }

  .section-popup__btn {
    display: inline-flex; align-items: center; justify-content: center;
    background: rgb(var(--color-button)); color: rgb(var(--color-button-text));
    border: 1px solid rgb(var(--color-button)); border-radius: var(--buttons-radius, 0);
    font-weight: 600; text-decoration: none; cursor: pointer;
    transition: opacity 0.2s; width: 100%;
  }
  .section-popup__btn:hover { opacity: 0.85; }
{% endstylesheet %}

{% schema %}
{
  "name": "Popup",
  "tag": "div",
  "class": "section-popup-wrapper",
  "limit": 1,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Content" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Get 10% off" },
    { "type": "select", "id": "heading_size", "label": "Heading size", "options": [{ "value": "md", "label": "M" },{ "value": "lg", "label": "L" },{ "value": "xl", "label": "XL" }], "default": "lg" },
    { "type": "inline_richtext", "id": "text", "label": "Text", "default": "Subscribe for exclusive offers and updates." },
    { "type": "select", "id": "text_size", "label": "Text size", "options": [{ "value": "sm", "label": "S" },{ "value": "md", "label": "M" }], "default": "sm" },
    { "type": "header", "content": "Action" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter form", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Used when newsletter is off" },
    { "type": "select", "id": "button_size", "label": "Button size", "options": [{ "value": "sm", "label": "S" },{ "value": "md", "label": "M" }], "default": "md" },
    { "type": "header", "content": "Behavior" },
    { "type": "range", "id": "delay", "min": 1, "max": 30, "step": 1, "unit": "s", "label": "Delay before showing", "default": 5 },
    { "type": "select", "id": "frequency", "label": "Show frequency", "options": [{ "value": "session", "label": "Once per session" },{ "value": "once", "label": "Once ever" }], "default": "session" }
  ],
  "presets": [{ "name": "Popup", "category": "Custom" }]
}
{% endschema %}
