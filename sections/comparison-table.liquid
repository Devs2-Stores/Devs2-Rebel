{%- comment %}
  Section: Comparison Table
  Mô tả: Bảng so sánh specs nhiều sản phẩm cạnh nhau.
{% endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-compare-table color-{{ section.settings.color_scheme }}"
  style="
    --ct-dt: {{ section.settings.padding_top_desktop }}px;
    --ct-db: {{ section.settings.padding_bottom_desktop }}px;
    --ct-mt: {{ section.settings.padding_top_mobile }}px;
    --ct-mb: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-compare-table__head">
        {%- if section.settings.subheading != blank -%}
          <p class="section-compare-table__subheading subheading-size-{{ section.settings.subheading_size }}">{{ section.settings.subheading }}</p>
        {%- endif -%}
        <{{ section.settings.heading_tag }} class="section-compare-table__heading heading-size-{{ section.settings.heading_size }}">
          {{- section.settings.heading -}}
        </{{ section.settings.heading_tag }}>
      </div>
    {%- endif -%}

    <div class="section-compare-table__scroll">
      <table class="section-compare-table__table">
        <thead>
          <tr>
            <th class="section-compare-table__label-col"></th>
            {%- for block in section.blocks -%}
              {%- if block.type == 'product_column' -%}
                {%- assign p = block.settings.product -%}
                <th class="section-compare-table__product-col" {{ block.shopify_attributes }}>
                  {%- if p != blank -%}
                    <a href="{{ p.url }}" class="section-compare-table__product-link">
                      {%- if p.featured_image -%}
                        {{ p.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', class: 'section-compare-table__product-img' }}
                      {%- endif -%}
                      <span class="section-compare-table__product-title">{{ p.title }}</span>
                      <span class="section-compare-table__product-price">{{ p.price | money }}</span>
                    </a>
                  {%- else -%}
                    <span class="section-compare-table__product-title">{{ block.settings.custom_title | default: 'Product' }}</span>
                  {%- endif -%}
                  {%- if block.settings.badge != blank -%}
                    <span class="section-compare-table__badge">{{ block.settings.badge }}</span>
                  {%- endif -%}
                </th>
              {%- endif -%}
            {%- endfor -%}
          </tr>
        </thead>
        <tbody>
          {%- for i in (1..10) -%}
            {%- assign row_label_key = 'row_' | append: i | append: '_label' -%}
            {%- assign row_label = section.settings[row_label_key] -%}
            {%- if row_label != blank -%}
              <tr>
                <td class="section-compare-table__label">{{ row_label }}</td>
                {%- for block in section.blocks -%}
                  {%- if block.type == 'product_column' -%}
                    {%- assign val_key = 'row_' | append: i -%}
                    {%- assign val = block.settings[val_key] -%}
                    <td class="section-compare-table__value">
                      {%- if val == '✓' or val == 'yes' or val == 'Yes' -%}
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" class="section-compare-table__check"><polyline points="20 6 9 17 4 12"/></svg>
                      {%- elsif val == '✗' or val == 'no' or val == 'No' -%}
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="section-compare-table__cross"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                      {%- elsif val != blank -%}
                        {{ val }}
                      {%- else -%}
                        <span class="section-compare-table__dash">—</span>
                      {%- endif -%}
                    </td>
                  {%- endif -%}
                {%- endfor -%}
              </tr>
            {%- endif -%}
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</div>

{% stylesheet %}
  .section-compare-table {
    padding-block: var(--ct-mt) var(--ct-mb);
    background: rgb(var(--color-background));
    color: rgba(var(--color-foreground), 0.85);
  }
  @media (min-width: 750px) {
    .section-compare-table { padding-block: var(--ct-dt) var(--ct-db); }
  }
  .section-compare-table__head { text-align: center; margin-bottom: 2.5rem; }
  .section-compare-table__subheading { margin: 0 0 0.25rem; text-transform: uppercase; letter-spacing: 0.12em; color: rgb(var(--color-accent)); font-weight: 600; }
  .section-compare-table__heading { margin: 0; color: rgb(var(--color-foreground)); }

  .section-compare-table__scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .section-compare-table__table {
    width: 100%; border-collapse: collapse; min-width: 600px;
  }
  .section-compare-table__table thead th {
    padding: 1rem 0.75rem; text-align: center; vertical-align: bottom;
    border-bottom: 2px solid rgba(var(--color-foreground), 0.1);
    position: relative;
  }
  .section-compare-table__label-col { width: 20%; }
  .section-compare-table__product-col { width: auto; }

  .section-compare-table__product-link {
    display: flex; flex-direction: column; align-items: center; gap: 0.375rem;
    text-decoration: none; color: inherit;
  }
  .section-compare-table__product-img {
    width: 80px; height: 80px; object-fit: cover; border-radius: 0.375rem;
  }
  .section-compare-table__product-title {
    font-size: 0.8125rem; font-weight: 700; color: rgb(var(--color-foreground));
    text-align: center; line-height: 1.3;
  }
  .section-compare-table__product-price {
    font-size: 0.75rem; font-weight: 600; color: rgb(var(--color-accent));
  }
  .section-compare-table__badge {
    display: inline-block; margin-top: 0.375rem;
    padding: 0.125rem 0.5rem; border-radius: 1rem;
    font-size: 0.625rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.06em;
    background: rgb(var(--color-accent)); color: rgb(var(--color-background));
  }

  .section-compare-table__table tbody td {
    padding: 0.875rem 0.75rem; text-align: center;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.06);
    font-size: 0.8125rem;
  }
  .section-compare-table__table tbody tr:hover {
    background: rgba(var(--color-foreground), 0.02);
  }
  .section-compare-table__label {
    text-align: left !important; font-weight: 600;
    color: rgb(var(--color-foreground));
  }
  .section-compare-table__check { color: #059669; }
  .section-compare-table__cross { color: rgba(var(--color-foreground), 0.2); }
  .section-compare-table__dash { color: rgba(var(--color-foreground), 0.2); }
{% endstylesheet %}

