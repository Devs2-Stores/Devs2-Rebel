{{ 'section-collection-list.css' | asset_url | stylesheet_tag }}
{%- comment %}
  Section: Collection List
{% endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-collection-list color-{{ section.settings.color_scheme }}"
  style="
    --cl-dt: {{ section.settings.padding_top_desktop }}px;
    --cl-db: {{ section.settings.padding_bottom_desktop }}px;
    --cl-mt: {{ section.settings.padding_top_mobile }}px;
    --cl-mb: {{ section.settings.padding_bottom_mobile }}px;
    --cl-cols-d: {{ section.settings.columns_desktop }};
    --cl-cols-m: {{ section.settings.columns_mobile }};
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-collection-list__head">
        {%- if section.settings.subheading != blank -%}
          <p class="section-collection-list__subheading subheading-size-{{ section.settings.subheading_size }}">
            {{- section.settings.subheading -}}
          </p>
        {%- endif -%}
        <{{ section.settings.heading_tag }}
          class="section-collection-list__heading heading-size-{{ section.settings.heading_size }}"
        >
          {{- section.settings.heading -}}
        </{{ section.settings.heading_tag }}>
      </div>
    {%- endif -%}

    {%- liquid
      assign mobile_card_size = '50vw'
      if section.settings.columns_mobile == '1'
        assign mobile_card_size = '100vw'
      endif

      assign desktop_card_size = '33vw'
      case section.settings.columns_desktop
        when 2
          assign desktop_card_size = '50vw'
        when 3
          assign desktop_card_size = '33vw'
        when 4
          assign desktop_card_size = '25vw'
        when 5
          assign desktop_card_size = '20vw'
      endcase

      capture card_sizes
        echo '(max-width: 749px) '
        echo mobile_card_size
        echo ', '
        echo desktop_card_size
      endcapture
    -%}
    <div class="section-collection-list__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = block.settings.collection
          assign card_title = block.settings.custom_title | default: col.title
          if card_title == blank
            assign card_title = 'sections.collection_list.placeholder_title' | t
          endif
          assign card_url = col.url | default: blank
        -%}
        {%- if card_url != blank -%}
          <a
            href="{{ card_url }}"
            class="section-collection-list__card section-collection-list__card--{{ section.settings.image_ratio }}"
            {{ block.shopify_attributes }}
          >
        {%- else -%}
          <div
            class="section-collection-list__card section-collection-list__card--{{ section.settings.image_ratio }} section-collection-list__card--static"
            {{ block.shopify_attributes }}
          >
        {%- endif -%}
            <div class="section-collection-list__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 800 | image_tag:
                  widths: '300, 400, 600, 800',
                  sizes: card_sizes,
                  loading: 'lazy', decoding: 'async',
                  alt: '',
                  class: 'section-collection-list__img'
                }}
              {%- elsif col.featured_image -%}
                {{ col.featured_image | image_url: width: 800 | image_tag:
                  widths: '300, 400, 600, 800',
                  sizes: card_sizes,
                  loading: 'lazy', decoding: 'async',
                  alt: '',
                  class: 'section-collection-list__img'
                }}
              {%- else -%}
                <div class="section-collection-list__placeholder">
                  {{ 'collection-1' | placeholder_svg_tag }}
                </div>
              {%- endif -%}
              <div class="section-collection-list__overlay"></div>
            </div>
            <div class="section-collection-list__info">
              <h3 class="section-collection-list__title">
                {{ card_title | escape }}
              </h3>
              {%- if section.settings.show_count and col != blank -%}
                <span class="section-collection-list__count">{{ 'sections.collection_list.product_count' | t: count: col.products_count }}</span>
              {%- endif -%}
            </div>
        {%- if card_url != blank -%}
          </a>
        {%- else -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>


{% schema %}
{
  "name": "t:sections.collection_list.name",
  "tag": "section",
  "class": "section-collection-list-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.collection_list.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.collection_list.settings.header__heading.content"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:sections.collection_list.settings.subheading.label"
    },
    {
      "type": "select",
      "id": "subheading_size",
      "label": "t:sections.collection_list.settings.subheading_size.label",
      "options": [
        {
          "value": "xs",
          "label": "t:sections.collection_list.settings.subheading_size.options.xs"
        },
        {
          "value": "sm",
          "label": "t:sections.collection_list.settings.subheading_size.options.sm"
        },
        {
          "value": "md",
          "label": "t:sections.collection_list.settings.subheading_size.options.md"
        }
      ],
      "default": "sm"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.collection_list.settings.heading.label",
      "default": "t:sections.collection_list.settings.heading.default"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.collection_list.settings.heading_size.label",
      "options": [
        {
          "value": "sm",
          "label": "t:sections.collection_list.settings.heading_size.options.sm"
        },
        {
          "value": "md",
          "label": "t:sections.collection_list.settings.heading_size.options.md"
        },
        {
          "value": "lg",
          "label": "t:sections.collection_list.settings.heading_size.options.lg"
        },
        {
          "value": "xl",
          "label": "t:sections.collection_list.settings.heading_size.options.xl"
        }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.collection_list.settings.heading_tag.label",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.collection_list.settings.heading_tag.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.collection_list.settings.heading_tag.options.h3"
        }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "t:sections.collection_list.settings.header__layout.content"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "t:sections.collection_list.settings.columns_desktop.label",
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.collection_list.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.collection_list.settings.columns_mobile.options._1"
        },
        {
          "value": "2",
          "label": "t:sections.collection_list.settings.columns_mobile.options._2"
        }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.collection_list.settings.image_ratio.label",
      "options": [
        {
          "value": "portrait",
          "label": "t:sections.collection_list.settings.image_ratio.options.portrait"
        },
        {
          "value": "square",
          "label": "t:sections.collection_list.settings.image_ratio.options.square"
        },
        {
          "value": "landscape",
          "label": "t:sections.collection_list.settings.image_ratio.options.landscape"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "t:sections.collection_list.settings.show_count.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.collection_list.settings.header__desktop_spacing.content"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "t:sections.collection_list.settings.padding_top_desktop.label",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "t:sections.collection_list.settings.padding_bottom_desktop.label",
      "default": 50
    },
    {
      "type": "header",
      "content": "t:sections.collection_list.settings.header__mobile_spacing.content"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:sections.collection_list.settings.padding_top_mobile.label",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:sections.collection_list.settings.padding_bottom_mobile.label",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "t:sections.collection_list.blocks.collection_card.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.collection_list.blocks.collection_card.settings.collection.label"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.collection_list.blocks.collection_card.settings.image.label",
          "info": "t:sections.collection_list.blocks.collection_card.settings.image.info"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "t:sections.collection_list.blocks.collection_card.settings.custom_title.label",
          "info": "t:sections.collection_list.blocks.collection_card.settings.custom_title.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection_list.presets.collection_list.name",
      "category": "Collection",
      "blocks": [
        {
          "type": "collection_card"
        },
        {
          "type": "collection_card"
        },
        {
          "type": "collection_card"
        }
      ]
    }
  ]
}
{% endschema %}
