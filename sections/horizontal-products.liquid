{%- comment %}
  Section: Horizontal Products List
  Mô tả: Products scroll ngang — dùng Swiper.
{% endcomment -%}

{%- liquid
  assign collection = section.settings.collection
  assign products_to_show = section.settings.products_to_show
-%}

<div
  id="section-{{ section.id }}"
  class="section-hpl color-{{ section.settings.color_scheme }}"
  style="
    --hpl-dt: {{ section.settings.padding_top_desktop }}px;
    --hpl-db: {{ section.settings.padding_bottom_desktop }}px;
    --hpl-mt: {{ section.settings.padding_top_mobile }}px;
    --hpl-mb: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-hpl__head">
        <div>
          {%- if section.settings.subheading != blank -%}
            <p class="section-hpl__subheading subheading-size-{{ section.settings.subheading_size }}">{{ section.settings.subheading }}</p>
          {%- endif -%}
          <{{ section.settings.heading_tag }} class="section-hpl__heading heading-size-{{ section.settings.heading_size }}">
            {{- section.settings.heading -}}
          </{{ section.settings.heading_tag }}>
        </div>
        {%- if section.settings.show_view_all and collection != blank -%}
          <a href="{{ collection.url }}" class="section-hpl__view-all">
            {{ 'general.view_all' | t | default: 'View all' }}
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if collection != blank and collection.products.size > 0 -%}
      <div class="section-hpl__slider">
        <div class="section-hpl__swiper swiper" data-hpl-slider>
          <div class="swiper-wrapper">
            {%- for product in collection.products limit: products_to_show -%}
              <div class="swiper-slide">
                {%- render 'product-card', product: product -%}
              </div>
            {%- endfor -%}
          </div>
        </div>
        <div class="section-hpl__nav">
          <button class="section-hpl__nav-btn section-hpl__prev" aria-label="{{ 'accessibility.previous_slide' | t }}">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <button class="section-hpl__nav-btn section-hpl__next" aria-label="{{ 'accessibility.next_slide' | t }}">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>
      </div>
    {%- else -%}
      <p class="section-hpl__empty">Select a collection to display products</p>
    {%- endif -%}
  </div>
</div>

<script>
(function() {
  var w = document.getElementById('section-{{ section.id }}');
  if (!w) return;
  var el = w.querySelector('[data-hpl-slider]');
  if (!el) return;
  (window.swiperReady || function(cb){ cb(); })(function(){
    new Swiper(el, {
      slidesPerView: 2,
      spaceBetween: 12,
      speed: 500,
      breakpoints: {
        750: { slidesPerView: 3, spaceBetween: 16 },
        1024: { slidesPerView: {{ section.settings.slides_desktop }}, spaceBetween: 20 }
      },
      navigation: {
        prevEl: w.querySelector('.section-hpl__prev'),
        nextEl: w.querySelector('.section-hpl__next')
      }
    });
  });
})();
</script>

{% stylesheet %}
  .section-hpl {
    padding-block: var(--hpl-mt) var(--hpl-mb);
    background: rgb(var(--color-background));
  }
  @media (min-width: 750px) {
    .section-hpl { padding-block: var(--hpl-dt) var(--hpl-db); }
  }

  .section-hpl__head {
    display: flex; align-items: flex-end; justify-content: space-between;
    flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem;
  }
  .section-hpl__subheading { margin: 0 0 0.25rem; text-transform: uppercase; letter-spacing: 0.12em; color: rgb(var(--color-accent)); font-weight: 600; }
  .section-hpl__heading { margin: 0; color: rgb(var(--color-foreground)); }
  .section-hpl__view-all {
    display: inline-flex; align-items: center; gap: 0.25rem;
    font-size: 0.875rem; font-weight: 700; color: rgb(var(--color-accent));
    transition: opacity 0.3s;
  }
  .section-hpl__view-all:hover { opacity: 0.7; }

  .section-hpl__slider { position: relative; }
  .section-hpl__swiper { overflow: hidden; }

  .section-hpl__nav {
    display: none; gap: 0.5rem;
    position: absolute; top: -3rem; right: 0;
  }
  @media (min-width: 750px) {
    .section-hpl__nav { display: flex; }
  }
  .section-hpl__nav-btn {
    width: 2.25rem; height: 2.25rem; border-radius: 50%;
    border: 1px solid rgba(var(--color-foreground), 0.15);
    background: rgb(var(--color-background)); cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    color: rgb(var(--color-foreground));
    transition: border-color 0.3s, color 0.3s;
  }
  .section-hpl__nav-btn:hover {
    border-color: rgb(var(--color-accent)); color: rgb(var(--color-accent));
  }
  .section-hpl__nav-btn.swiper-button-disabled { opacity: 0.3; cursor: default; }

  .section-hpl__empty { text-align: center; color: rgba(var(--color-foreground), 0.3); padding: 2rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "Horizontal products list",
  "tag": "section",
  "class": "section-hpl-wrapper",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "header", "content": "Heading" },
    { "type": "inline_richtext", "id": "subheading", "label": "Subheading" },
    { "type": "select", "id": "subheading_size", "label": "Subheading size", "options": [{ "value": "xs", "label": "XS" },{ "value": "sm", "label": "S" }], "default": "sm" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Trending now" },
    { "type": "select", "id": "heading_size", "label": "Heading size", "options": [{ "value": "sm", "label": "S" },{ "value": "md", "label": "M" },{ "value": "lg", "label": "L" }], "default": "md" },
    { "type": "select", "id": "heading_tag", "label": "Heading tag", "options": [{ "value": "h2", "label": "H2" },{ "value": "h3", "label": "H3" }], "default": "h2" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 20, "step": 1, "label": "Products to show", "default": 8 },
    { "type": "range", "id": "slides_desktop", "min": 3, "max": 6, "step": 1, "label": "Desktop slides", "default": 4 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'View all'", "default": true },
    { "type": "header", "content": "Desktop spacing" },
    { "type": "range", "id": "padding_top_desktop", "min": 0, "max": 150, "step": 5, "unit": "px", "label": "Top", "default": 50 },
    { "type": "range", "id": "padding_bottom_desktop", "min": 0, "max": 150, "step": 5, "unit": "px", "label": "Bottom", "default": 50 },
    { "type": "header", "content": "Mobile spacing" },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "Top", "default": 30 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 100, "step": 5, "unit": "px", "label": "Bottom", "default": 30 }
  ],
  "presets": [{ "name": "Horizontal products list", "category": "Collection" }]
}
{% endschema %}
