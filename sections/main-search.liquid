{%- comment %}
  Main Search — Search results template section.
  Displays search form, results grid, pagination, and empty states.
{% endcomment -%}

{%- assign search_query = search.terms | default: '' -%}

<script src="{{ 'product-card.js' | asset_url }}" defer="defer"></script>
<search-template class="search-template color-{{ section.settings.color_scheme }}">
  <div class="page-width">

    <div class="search-template__header">
      <h1 class="search-template__title">
        {%- if search_query != blank -%}
          {{ 'templates.search.search_for' | t: terms: search_query }}
        {%- else -%}
          {{ 'templates.search.title' | t }}
        {%- endif -%}
      </h1>
      {%- if search.performed and search.results_count > 0 -%}
        <p class="search-template__count">{{ 'templates.search.results_count' | t: count: search.results_count }}</p>
      {%- endif -%}
    </div>

    <div class="search-template__form-wrapper">
      <form action="{{ routes.search_url }}" method="get" class="search-template__form" role="search">
        <input type="hidden" name="type" value="product,article,page">
        <div class="search-template__input-group">
          <input
            type="search"
            name="q"
            value="{{ search_query | escape }}"
            placeholder="{{ 'templates.search.placeholder' | t }}"
            class="search-template__input"
            autocomplete="off"
            aria-label="{{ 'templates.search.title' | t }}"
          >
          <button type="submit" class="search-template__submit" aria-label="{{ 'templates.search.search' | t }}">
            {%- render 'icon', name: 'search' -%}
            <span>{{ 'templates.search.search' | t }}</span>
          </button>
        </div>
      </form>
    </div>

    {%- if search.performed -%}
      {%- liquid
        assign active_filter_count = 0
        for filter in search.filters
          if filter.type == 'price_range'
            if filter.min_value.value != nil or filter.max_value.value != nil
              assign active_filter_count = active_filter_count | plus: 1
            endif
          else
            assign active_filter_count = active_filter_count | plus: filter.active_values.size
          endif
        endfor
        assign search_terms_encoded = search.terms | replace: '&amp;', '&' | replace: '&#39;', "'" | replace: '&quot;', '"' | replace: '&lt;', '<' | replace: '&gt;', '>' | url_encode
        assign search_base_url = routes.search_url | append: '?q=' | append: search_terms_encoded | append: '&type=product,article,page'
        if section.settings.enable_filtering == nil
          assign enable_filtering = true
        else
          assign enable_filtering = section.settings.enable_filtering
        endif
        if section.settings.enable_sorting == nil
          assign enable_sorting = true
        else
          assign enable_sorting = section.settings.enable_sorting
        endif
      -%}
      {%- if search.results_count > 0 or active_filter_count > 0 -%}
        {%- paginate search.results by section.settings.products_per_page -%}
        <facet-filters
          class="collection-template__facets search-template__results"
          data-search-results
          data-section-id="{{ section.id }}"
          data-collection-url="{{ search_base_url | escape }}"
          data-pagination-type="pagination"
          data-filter-layout="sidebar"
        >
          {%- assign has_products = false -%}
          {%- assign product_count = 0 -%}
          {%- assign article_count = 0 -%}
          {%- assign page_count = 0 -%}
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}{%- assign has_products = true -%}{%- assign product_count = product_count | plus: 1 -%}{%- endif -%}
            {%- if item.object_type == 'article' -%}{%- assign article_count = article_count | plus: 1 -%}{%- endif -%}
            {%- if item.object_type == 'page' -%}{%- assign page_count = page_count | plus: 1 -%}{%- endif -%}
          {%- endfor -%}
          <div class="search-template__tabs" role="tablist" aria-label="{{ 'templates.search.tabs_types' | t }}">
            <button type="button" class="search-template__tab" role="tab" aria-controls="search-products-panel" data-search-tab="products" aria-selected="false"{% if product_count == 0 and active_filter_count == 0 %} disabled{% endif %}>{{ 'templates.search.products' | t }} <span>{{ product_count }}</span></button>
            <button type="button" class="search-template__tab" role="tab" aria-controls="search-articles-panel" data-search-tab="articles" aria-selected="false"{% if article_count == 0 %} disabled{% endif %}>{{ 'templates.search.articles_tab' | t }} <span>{{ article_count }}</span></button>
            <button type="button" class="search-template__tab" role="tab" aria-controls="search-pages-panel" data-search-tab="pages" aria-selected="false"{% if page_count == 0 %} disabled{% endif %}>{{ 'templates.search.pages' | t }} <span>{{ page_count }}</span></button>
          </div>
          <div class="search-template__results-header" aria-live="polite">
            <span class="search-template__results-info" data-search-tab-count="products" hidden>{{ 'templates.search.results_count' | t: count: product_count }}</span>
            <span class="search-template__results-info" data-search-tab-count="articles" hidden>{{ 'templates.search.results_count' | t: count: article_count }}</span>
            <span class="search-template__results-info" data-search-tab-count="pages" hidden>{{ 'templates.search.results_count' | t: count: page_count }}</span>
          </div>

          <div class="collection-template__body{% unless enable_filtering and search.filters.size > 0 %} collection-template__body--no-sidebar{% endunless %}">
            {%- if search.filters.size > 0 -%}
              {%- render 'collection-filter-drawer',
                enable_filtering: enable_filtering,
                filter_layout: 'sidebar',
                results: search,
                price_filter_style: 'input'
              -%}
            {%- endif -%}

            <div class="collection-template__products-container" id="CollectionProductGrid">
              {%- if enable_filtering and search.filters.size > 0 -%}
                <div class="collection-template__mobile-filter-ctrl">
                  <button
                    type="button"
                    class="collection-template__filter-btn"
                    data-action="open-filter"
                    aria-label="{{ 'products.facets.filter_button' | t }}"
                    aria-expanded="false"
                    aria-controls="CollectionFilterDrawer"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                    <span>{{ 'products.facets.filter_button' | t }}</span>
                    {%- if active_filter_count > 0 -%}
                      <span class="collection-template__filter-badge">{{ active_filter_count }}</span>
                    {%- endif -%}
                  </button>
                </div>
              {%- endif -%}
              {%- render 'collection-sort',
                results: search,
                limit: section.settings.products_per_page,
                paginate: paginate,
                show_product_count: true,
                enable_sorting: enable_sorting,
                enable_filtering: enable_filtering,
                filter_layout: 'sidebar'
              -%}
              {%- render 'collection-active-filters', results: search -%}
              <div id="CollectionLiveRegion" class="visually-hidden" role="status" aria-live="polite"></div>

              {%- if has_products or active_filter_count > 0 -%}
              <section id="search-products-panel" class="search-template__product-group" role="tabpanel" aria-labelledby="search-products-tab" data-search-panel="products">
                <div class="collection-template__products" id="CollectionProducts" tabindex="-1">
                  {%- if has_products -%}
                  <ul class="product-cards search-template__products" role="list">
                    {%- for item in search.results -%}
                      {%- liquid
                        assign lazyload = 'lazy'
                        assign fetchpriority = 'auto'
                        if forloop.index <= 4
                          assign lazyload = 'eager'
                        endif
                        if forloop.first
                          assign fetchpriority = 'high'
                        endif
                      -%}
                      {%- case item.object_type -%}
                        {%- when 'product' -%}
                          <li class="product-cards__item" role="listitem">
                            {%- render 'product-card', product: item, lazyload: lazyload, fetchpriority: fetchpriority, show_vendor: true -%}
                          </li>
                      {%- endcase -%}
                    {%- endfor -%}
                  </ul>
                  {%- else -%}
                    <div class="collection-template__empty">
                      <p>{{ 'sections.collection_template.empty' | t }}</p>
                      <a href="{{ search_base_url }}" class="button-primary theme-btn" data-filter-remove>{{ 'products.facets.clear_all_filters' | t }}</a>
                    </div>
                  {%- endif -%}
                </div>
              </section>
              {%- endif -%}

              {%- assign has_articles = false -%}
              {%- for item in search.results -%}{%- if item.object_type == 'article' -%}{%- assign has_articles = true -%}{%- break -%}{%- endif -%}{%- endfor -%}
              {%- if has_articles -%}
                <section id="search-articles-panel" class="search-template__content-group" role="tabpanel" aria-labelledby="search-articles-tab" data-search-panel="articles">
                  <ul class="search-template__content-list" role="list">
                    {%- for item in search.results -%}{%- if item.object_type == 'article' -%}
                      {%- assign content_loading = 'lazy' -%}
                      {%- if forloop.index <= 3 -%}{%- assign content_loading = 'eager' -%}{%- endif -%}
                      <li class="search-template__content-item" role="listitem">
                        {%- render 'article-card', article: item, layout: 'grid', lazyload: content_loading, show_category: true -%}
                      </li>
                    {%- endif -%}{%- endfor -%}
                  </ul>
                </section>
              {%- endif -%}

              {%- assign has_pages = false -%}
              {%- for item in search.results -%}{%- if item.object_type == 'page' -%}{%- assign has_pages = true -%}{%- break -%}{%- endif -%}{%- endfor -%}
              {%- if has_pages -%}
                <section id="search-pages-panel" class="search-template__content-group" role="tabpanel" aria-labelledby="search-pages-tab" data-search-panel="pages">
                  <ul class="search-template__content-list" role="list">
                    {%- for item in search.results -%}{%- if item.object_type == 'page' -%}
                      <li class="search-template__content-item" role="listitem">
                        <a class="search-page-result" href="{{ item.url }}">
                          <span class="search-page-result__content">
                            <strong class="search-page-result__title">{{ item.title | escape }}</strong>
                            {%- if item.content != blank -%}
                              <span class="search-page-result__excerpt">{{ item.content | strip_html | truncatewords: 24 | escape }}</span>
                            {%- endif -%}
                          </span>
                          <span class="search-page-result__arrow" aria-hidden="true">&rarr;</span>
                        </a>
                      </li>
                    {%- endif -%}{%- endfor -%}
                  </ul>
                </section>
              {%- endif -%}

              <div class="search-template__pagination" id="CollectionPagination">
                {%- if paginate.pages > 1 -%}
                  {%- render 'section-pagination', paginate: paginate -%}
                {%- endif -%}
              </div>
            </div>
          </div>
        </facet-filters>
        {%- endpaginate -%}
      {%- else -%}
        <div class="search-template__empty">
          <div class="search-template__empty-icon">
            {%- render 'icon', name: 'search' -%}
          </div>
          <h2 class="search-template__empty-title">{{ 'templates.search.no_results_title' | t }}</h2>
          <p class="search-template__empty-text">
            {{ 'templates.search.no_results' | t: terms: search_query }}
          </p>
          <div class="search-template__empty-suggestions">
            <p><strong>{{ 'templates.search.suggestions' | t }}:</strong></p>
            <ul>
              <li>{{ 'templates.search.suggestion_1' | t }}</li>
              <li>{{ 'templates.search.suggestion_2' | t }}</li>
              <li>{{ 'templates.search.suggestion_3' | t }}</li>
            </ul>
          </div>
          {%- if section.settings.featured_collection != blank -%}
            <div class="search-template__empty-featured">
              <h2>{{ section.settings.featured_collection.title | escape }}</h2>
              <ul class="product-cards search-template__products" role="list">
                {%- for product in section.settings.featured_collection.products limit: 4 -%}
                  <li class="product-cards__item" role="listitem">
                    {%- render 'product-card', product: product, lazyload: 'lazy', show_vendor: true -%}
                  </li>
                {%- endfor -%}
              </ul>
              <a class="search-template__featured-link button-primary" href="{{ section.settings.featured_collection.url }}">{{ 'general.continue_shopping' | t }}</a>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="search-template__placeholder">
        <div class="search-template__placeholder-icon">
          {%- render 'icon', name: 'search' -%}
        </div>
        <h2 class="search-template__placeholder-title">{{ 'templates.search.title' | t }}</h2>
        <p class="search-template__placeholder-text">{{ 'templates.search.placeholder_text' | t }}</p>
      </div>
    {%- endif -%}

  </div>
</search-template>

{% schema %}
{
  "name": "t:sections.main_search.name",
  "tag": "section",
  "class": "section-main-search",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:sections.main_search.settings.products_per_page.label",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "t:sections.main_collection.settings.enable_filtering.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "t:sections.main_collection.settings.enable_sorting.label",
      "default": true
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "t:sections.main_search.settings.featured_collection.label"
    }
  ]
}
{% endschema %}
