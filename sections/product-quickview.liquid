{%- comment %}
  Product quick view fragment.
  Fetched by assets/quickview-modal.js through the Section Rendering API:
  /products/{handle}?section_id=product-quickview
{% endcomment -%}
{{ 'variant-picker.css' | asset_url | stylesheet_tag }}
{{ 'quantity-selector.css' | asset_url | stylesheet_tag }}
<script src="{{ 'quantity-selector.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign available = product.selected_or_first_available_variant.available
  assign selected_variant = product.selected_or_first_available_variant | default: product.variants.first
  assign quickview_is_contact = false
  assign quickview_on_sale = false
  assign quickview_discount_percent = 0
  if selected_variant.price == 0
    assign quickview_is_contact = true
  endif
  if quickview_is_contact == false and selected_variant.compare_at_price > selected_variant.price
    assign quickview_on_sale = true
    assign quickview_discount_percent = selected_variant.compare_at_price | minus: selected_variant.price | times: 100.0 | divided_by: selected_variant.compare_at_price | round
  endif
-%}
<script type="application/json" id="quickview-product-json">{{ product | json }}</script>
<div class="quickview-product" data-quickview-product>
  <div class="quickview-product__media">
    <div class="swiper quickview-product__slider">
      <div class="swiper-wrapper">
        {%- if product.media.size > 0 -%}
        {%- for media in product.media -%}
        <div
          class="swiper-slide product-template__media-slide product-template__media-slide--{{ media.media_type }}"
          data-media-id="{{ media.id }}"
          {% if media.media_type == 'external_video' %}data-video-host="{{ media.host }}"{% endif %}
        >
          {%- render 'product-media-item',
            media: media,
            product: product,
            sizes: '(min-width: 750px) 50vw, 100vw',
            loading: 'lazy',
            image_class: 'quickview-product__image'
          -%}
        </div>
        {%- endfor -%}
        {%- else -%}
        <div class="swiper-slide">
          {{ 'product-1' | placeholder_svg_tag: 'quickview-product__image quickview-product__image--placeholder' }}
        </div>
        {%- endif -%}
      </div>
      {%- if product.media.size > 1 -%}
      <button type="button" class="swiper-button-next" aria-label="{{ 'accessibility.next' | t }}"></button>
      <button type="button" class="swiper-button-prev" aria-label="{{ 'accessibility.previous' | t }}"></button>
      {%- endif -%}
    </div>
  </div>

  <div class="quickview-product__info">
    <h2 class="quickview-product__title">
      <a href="{{ product.url }}">{{ product.title | escape }}</a>
    </h2>

    <ul class="quickview-product__meta">
      {%- if selected_variant.sku != blank -%}
      <li class="quickview-product__meta-item">
        <span class="quickview-product__meta-label">{{ 'products.product.sku' | t }}:</span>
        <strong data-product-sku>{{ selected_variant.sku }}</strong>
      </li>
      {%- endif -%}
      {%- if product.vendor != blank -%}
      <li class="quickview-product__meta-item">
        <span class="quickview-product__meta-label">{{ 'products.product.vendor' | t }}:</span>
        <strong>{{ product.vendor }}</strong>
      </li>
      {%- endif -%}
      <li class="quickview-product__meta-item">
        <span class="quickview-product__meta-label">{{ 'products.product.availability' | t }}:</span>
        {%- if available -%}
        <strong data-product-available class="quickview-product__status--available">{{ 'products.product.inventory_in_stock' | t }}</strong>
        {%- else -%}
        <strong data-product-available class="quickview-product__status--unavailable">{{ 'products.product.inventory_out_of_stock' | t }}</strong>
        {%- endif -%}
      </li>
    </ul>

    <div class="quickview-product__price" data-product-price-wrapper>
      <span class="quickview-product__price-current{% if quickview_on_sale %} quickview-product__price-current--sale{% endif %}" data-product-price>
        {%- if quickview_is_contact -%}
          {{ 'products.product.price.contact' | t }}
        {%- else -%}
          {%- if settings.price_currency_code_enabled -%}{{ selected_variant.price | money_with_currency }}{%- else -%}{{ selected_variant.price | money }}{%- endif -%}
        {%- endif -%}
      </span>
      <s class="quickview-product__price-compare{% unless quickview_on_sale %} hidden{% endunless %}" data-product-compare>{%- if quickview_on_sale -%}{{ selected_variant.compare_at_price | money }}{%- endif -%}</s>
      <span class="quickview-product__price-sale{% unless quickview_on_sale %} hidden{% endunless %}" data-product-sale>{%- if quickview_on_sale -%}-{{ quickview_discount_percent }}%{%- endif -%}</span>
    </div>

    {%- if product.variants.size > 1 -%}
    <div class="quickview-product__variant-picker">
      {%- render 'quickview-variant-picker', product: product -%}
    </div>
    {%- endif -%}

    <div class="quickview-product__actions">
      {%- if product.requires_selling_plan -%}
      <a href="{{ product.url }}" class="button-primary active quickview-product__add-btn">
        {{- 'products.product.choose_options' | t -}}
      </a>
      {%- else -%}
      {%- render 'quantity-selector', product: product -%}
      <button
        type="button"
        class="button-primary active quickview-product__add-btn"
        data-product-add
        {% unless available or quickview_is_contact %}disabled{% endunless %}
      >
        <span data-add-text>
          {%- if quickview_is_contact -%}
            {{ 'products.product.price.contact' | t }}
          {%- elsif available -%}
            {{ 'products.product.add_to_cart' | t }}
          {%- else -%}
            {{ 'products.product.sold_out' | t }}
          {%- endif -%}
        </span>
      </button>
      {%- endif -%}
    </div>

    <a href="{{ product.url }}" class="quickview-product__full-link">
      {{ 'products.product_card.view_product' | t }}
    </a>
  </div>
</div>
{%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
{%- if first_3d_model -%}
  <script type="application/json" id="ModelJson-quickview-{{ product.id }}">
    {{ product.media | where: 'media_type', 'model' | json }}
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.product_quickview.name"
}
{% endschema %}
