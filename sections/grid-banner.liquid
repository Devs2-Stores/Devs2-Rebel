{%- comment %}
  Section: Grid Banner (Mixed)
  Mô tả: Banner grid mixed sizes — 1 lớn + nhiều nhỏ, flexible layout.
{% endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-grid-banner color-{{ section.settings.color_scheme }}"
  style="
    --gb-dt: {{ section.settings.padding_top_desktop }}px;
    --gb-db: {{ section.settings.padding_bottom_desktop }}px;
    --gb-mt: {{ section.settings.padding_top_mobile }}px;
    --gb-mb: {{ section.settings.padding_bottom_mobile }}px;
    --gb-height: {{ section.settings.row_height }}px;
  "
>
  <div class="{% if section.settings.section_width == 'fixed' %}page-width{% endif %}">
    {%- if section.settings.heading != blank -%}
      <div class="page-width section-grid-banner__head">
        <{{ section.settings.heading_tag }} class="section-grid-banner__heading heading-size-{{ section.settings.heading_size }}">
          {{- section.settings.heading -}}
        </{{ section.settings.heading_tag }}>
      </div>
    {%- endif -%}

    <div class="section-grid-banner__grid section-grid-banner__grid--{{ section.settings.layout }}">
      {%- for block in section.blocks -%}
        <div class="section-grid-banner__item section-grid-banner__item--{{ block.settings.span }}" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="section-grid-banner__link">{%- endif -%}
            <div class="section-grid-banner__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1200 | image_tag:
                  widths: '400, 600, 800, 1200',
                  loading: 'lazy', class: 'section-grid-banner__img'
                }}
              {%- else -%}
                <div class="section-grid-banner__ph" style="background: {% cycle '#1a1a2e40', '#16213e40', '#0f346040' %};"></div>
              {%- endif -%}
              <div class="section-grid-banner__overlay" style="--gb-ov: {{ block.settings.overlay_opacity | divided_by: 100.0 }};"></div>
              <div class="section-grid-banner__content section-grid-banner__content--{{ block.settings.text_position }}">
                {%- if block.settings.heading != blank -%}
                  <h3 class="section-grid-banner__title heading-size-{{ block.settings.heading_size }}">{{ block.settings.heading }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="section-grid-banner__text">{{ block.settings.text }}</p>
                {%- endif -%}
                {%- if block.settings.button_label != blank -%}
                  <span class="section-grid-banner__btn">{{ block.settings.button_label }}</span>
                {%- endif -%}
              </div>
            </div>
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .section-grid-banner {
    padding-block: var(--gb-mt) var(--gb-mb);
    background: rgb(var(--color-background));
  }
  @media (min-width: 750px) {
    .section-grid-banner { padding-block: var(--gb-dt) var(--gb-db); }
  }
  .section-grid-banner__head { text-align: center; margin-bottom: 2rem; }
  .section-grid-banner__heading { margin: 0; color: rgb(var(--color-foreground)); }

  .section-grid-banner__grid {
    display: grid; gap: 8px;
  }
  @media (min-width: 750px) {
    .section-grid-banner__grid { gap: 12px; }
    .section-grid-banner__grid--2-cols { grid-template-columns: repeat(2, 1fr); }
    .section-grid-banner__grid--3-cols { grid-template-columns: repeat(3, 1fr); }
    .section-grid-banner__grid--1-2 { grid-template-columns: 1fr 1fr; }
    .section-grid-banner__item--large { grid-row: span 2; }
    .section-grid-banner__item--wide { grid-column: span 2; }
  }

  .section-grid-banner__link { display: block; text-decoration: none; color: inherit; height: 100%; }

  .section-grid-banner__media {
    position: relative; overflow: hidden; border-radius: 0.5rem;
    height: 100%; min-height: var(--gb-height, 300px);
  }
  .section-grid-banner__img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.5s;
  }
  .section-grid-banner__item:hover .section-grid-banner__img { transform: scale(1.05); }
  .section-grid-banner__ph { width: 100%; height: 100%; min-height: var(--gb-height, 300px); }

  .section-grid-banner__overlay {
    position: absolute; inset: 0;
    background: rgba(0,0,0,var(--gb-ov, 0.25));
  }

  .section-grid-banner__content {
    position: absolute; z-index: 2;
    display: flex; flex-direction: column; gap: 0.375rem;
    padding: 1.25rem; color: #fff;
  }
  .section-grid-banner__content--bottom-left { bottom: 0; left: 0; }
  .section-grid-banner__content--center { inset: 0; align-items: center; justify-content: center; text-align: center; }
  .section-grid-banner__content--top-left { top: 0; left: 0; }

  .section-grid-banner__title { margin: 0; color: #fff; line-height: 1.2; }
  .section-grid-banner__text { margin: 0; font-size: 0.8125rem; color: rgba(255,255,255,0.8); }

  .section-grid-banner__btn {
    display: inline-block; margin-top: 0.25rem;
    font-size: 0.8125rem; font-weight: 600;
    border-bottom: 1px solid rgba(255,255,255,0.6);
    padding-bottom: 2px;
    transition: border-color 0.3s;
  }
  .section-grid-banner__item:hover .section-grid-banner__btn { border-color: #fff; }
{% endstylesheet %}

{% schema %}
{
  "name": "Grid banner",
  "tag": "section",
  "class": "section-grid-banner-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "md",
          "label": "M"
        },
        {
          "value": "lg",
          "label": "L"
        }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Grid layout",
      "options": [
        {
          "value": "2-cols",
          "label": "2 columns"
        },
        {
          "value": "3-cols",
          "label": "3 columns"
        },
        {
          "value": "1-2",
          "label": "1 large + 2 small"
        }
      ],
      "default": "1-2"
    },
    {
      "type": "range",
      "id": "row_height",
      "min": 200,
      "max": 500,
      "step": 25,
      "unit": "px",
      "label": "Min row height",
      "default": 300
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "fixed",
          "label": "Fixed"
        },
        {
          "value": "full",
          "label": "Full"
        }
      ],
      "default": "fixed"
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom",
      "default": 50
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "span",
          "label": "Size",
          "options": [
            {
              "value": "normal",
              "label": "Normal"
            },
            {
              "value": "large",
              "label": "Large (2 rows)"
            },
            {
              "value": "wide",
              "label": "Wide (2 cols)"
            }
          ],
          "default": "normal"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 70,
          "step": 5,
          "unit": "%",
          "label": "Overlay",
          "default": 25
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "Category"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "options": [
            {
              "value": "sm",
              "label": "S"
            },
            {
              "value": "md",
              "label": "M"
            },
            {
              "value": "lg",
              "label": "L"
            }
          ],
          "default": "md"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button text",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "text_position",
          "label": "Text position",
          "options": [
            {
              "value": "bottom-left",
              "label": "Bottom left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "top-left",
              "label": "Top left"
            }
          ],
          "default": "bottom-left"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Grid banner",
      "category": "Image",
      "blocks": [
        {
          "type": "banner",
          "settings": {
            "heading": "Women's collection",
            "span": "large",
            "button_label": "Shop women"
          }
        },
        {
          "type": "banner",
          "settings": {
            "heading": "Men's collection",
            "button_label": "Shop men"
          }
        },
        {
          "type": "banner",
          "settings": {
            "heading": "Accessories",
            "button_label": "Shop accessories"
          }
        }
      ]
    }
  ]
}
{% endschema %}
