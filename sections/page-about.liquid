<about-page
  class="page-about color-{{ section.settings.color_scheme }}"
  style="--about-hero-position-desktop: {{ section.settings.hero_focal_point_desktop }}; --about-hero-position-mobile: {{ section.settings.hero_focal_point_mobile }};"
>
  <section class="about-hero">
    <div class="about-hero__background">
      {%- assign hero_image_desktop = section.settings.hero_image_desktop | default: section.settings.hero_image_mobile -%}
      {%- assign hero_alt = section.settings.hero_title | default: page.title -%}
      {%- if hero_image_desktop != blank -%}
      <picture>
        {%- if section.settings.hero_image_mobile != blank -%}
        <source media="(max-width: 767px)" srcset="{{ section.settings.hero_image_mobile | image_url: width: 375 }} 375w, {{ section.settings.hero_image_mobile | image_url: width: 550 }} 550w, {{ section.settings.hero_image_mobile | image_url: width: 750 }} 750w, {{ section.settings.hero_image_mobile | image_url: width: 900 }} 900w" sizes="100vw">
        {%- endif -%}
        <source media="(min-width: 768px)" srcset="{{ hero_image_desktop | image_url: width: 750 }} 750w, {{ hero_image_desktop | image_url: width: 1100 }} 1100w, {{ hero_image_desktop | image_url: width: 1500 }} 1500w, {{ hero_image_desktop | image_url: width: 1920 }} 1920w" sizes="100vw">
        {{ hero_image_desktop | image_url: width: 1920 | image_tag: widths: '750, 1100, 1500, 1920', sizes: '100vw', loading: 'eager', fetchpriority: 'high', class: 'about-hero__image', alt: hero_alt }}
      </picture>
      {%- else -%}
        <div class="about-hero__placeholder" aria-hidden="true">
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        </div>
      {%- endif -%}
    </div>
    <div class="about-hero__content">
      <div class="page-width">
        {%- if section.settings.hero_subtitle != blank -%}
        <p class="about-hero__subtitle">{{ section.settings.hero_subtitle | escape }}</p>
        {%- endif -%}
        {%- if section.settings.hero_title != blank -%}
        <h1 class="about-hero__title">{{ section.settings.hero_title | escape }}</h1>
        {%- else -%}
        <h1 class="about-hero__title sr-only">{{ page.title | default: 'About us' | escape }}</h1>
        {%- endif -%}
        {%- if section.settings.hero_description != blank -%}
        <div class="about-hero__description">{{ section.settings.hero_description }}</div>
        {%- endif -%}
        {%- if section.settings.hero_primary_label != blank or section.settings.hero_secondary_label != blank -%}
        <div class="about-hero__actions">
          {%- if section.settings.hero_primary_label != blank and section.settings.hero_primary_link != blank -%}
          <a href="{{ section.settings.hero_primary_link }}" class="about-hero__button about-hero__button--primary">{{ section.settings.hero_primary_label | escape }}</a>
          {%- endif -%}
          {%- if section.settings.hero_secondary_label != blank and section.settings.hero_secondary_link != blank -%}
          <a href="{{ section.settings.hero_secondary_link }}" class="about-hero__button about-hero__button--secondary">{{ section.settings.hero_secondary_label | escape }}</a>
          {%- endif -%}
        </div>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- if section.settings.show_mission -%}
  <section class="about-mission section-padding">
    <div class="page-width">
      <div class="about-mission__wrap">
        {%- if section.settings.mission_title != blank -%}
        <h2 class="about-mission__title">{{ section.settings.mission_title | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.mission_description != blank -%}
        <div class="about-mission__description">{{ section.settings.mission_description }}</div>
        {%- endif -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- assign feature_blocks = section.blocks | where: 'type', 'feature' -%}
  {%- if feature_blocks.size > 0 -%}
  <section class="about-features section-padding">
    <div class="page-width">
      <div class="about-features__wrap">
        {%- for block in feature_blocks -%}
        <div class="about-features__item{% if block.settings.reverse %} about-features__item--reverse{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
          {%- assign feature_alt = block.settings.title | default: block.settings.image.alt -%}
          <div class="about-features__item-image">
            {{ block.settings.image | image_url: width: 1200 | image_tag: widths: '400, 600, 800, 1000, 1200', sizes: '(min-width: 1025px) 50vw, 100vw', loading: 'lazy', class: 'about-features__image', alt: feature_alt }}
          </div>
          {%- endif -%}
          <div class="about-features__item-content">
            {%- if block.settings.title != blank -%}
            <h3 class="about-features__item-title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
            <div class="about-features__item-description">{{ block.settings.description }}</div>
            {%- endif -%}
          </div>
        </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- if section.settings.show_story -%}
  <section class="about-story section-padding-bg">
    <div class="page-width">
      <div class="about-story__wrap">
        {%- if section.settings.story_title != blank -%}
        <h2 class="about-story__title">{{ section.settings.story_title | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.story_content != blank -%}
        <div class="about-story__content">{{ section.settings.story_content }}</div>
        {%- endif -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- if section.settings.show_actions -%}
  <section class="about-actions section-padding">
    <div class="page-width">
      <div class="about-actions__wrap">
        {%- if section.settings.actions_subheading != blank or section.settings.actions_title != blank or section.settings.actions_description != blank -%}
        <div class="about-actions__head">
          {%- if section.settings.actions_subheading != blank -%}
          <p class="about-actions__subheading">{{ section.settings.actions_subheading | escape }}</p>
          {%- endif -%}
          {%- if section.settings.actions_title != blank -%}
          <h2 class="about-actions__title">{{ section.settings.actions_title | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.actions_description != blank -%}
          <div class="about-actions__description">{{ section.settings.actions_description }}</div>
          {%- endif -%}
        </div>
        {%- endif -%}
        <div class="about-actions__grid">
          {%- if section.settings.action_1_title != blank or section.settings.action_1_text != blank or section.settings.action_1_label != blank -%}
          <article class="about-actions__item">
            {%- if section.settings.action_1_eyebrow != blank -%}<p class="about-actions__eyebrow">{{ section.settings.action_1_eyebrow | escape }}</p>{%- endif -%}
            {%- if section.settings.action_1_title != blank -%}<h3 class="about-actions__item-title">{{ section.settings.action_1_title | escape }}</h3>{%- endif -%}
            {%- if section.settings.action_1_text != blank -%}<p class="about-actions__item-text">{{ section.settings.action_1_text | escape }}</p>{%- endif -%}
            {%- if section.settings.action_1_label != blank and section.settings.action_1_link != blank -%}<a href="{{ section.settings.action_1_link }}" class="about-actions__link">{{ section.settings.action_1_label | escape }}</a>{%- endif -%}
          </article>
          {%- endif -%}
          {%- if section.settings.action_2_title != blank or section.settings.action_2_text != blank or section.settings.action_2_label != blank -%}
          <article class="about-actions__item">
            {%- if section.settings.action_2_eyebrow != blank -%}<p class="about-actions__eyebrow">{{ section.settings.action_2_eyebrow | escape }}</p>{%- endif -%}
            {%- if section.settings.action_2_title != blank -%}<h3 class="about-actions__item-title">{{ section.settings.action_2_title | escape }}</h3>{%- endif -%}
            {%- if section.settings.action_2_text != blank -%}<p class="about-actions__item-text">{{ section.settings.action_2_text | escape }}</p>{%- endif -%}
            {%- if section.settings.action_2_label != blank and section.settings.action_2_link != blank -%}<a href="{{ section.settings.action_2_link }}" class="about-actions__link">{{ section.settings.action_2_label | escape }}</a>{%- endif -%}
          </article>
          {%- endif -%}
          {%- if section.settings.action_3_title != blank or section.settings.action_3_text != blank or section.settings.action_3_label != blank -%}
          <article class="about-actions__item">
            {%- if section.settings.action_3_eyebrow != blank -%}<p class="about-actions__eyebrow">{{ section.settings.action_3_eyebrow | escape }}</p>{%- endif -%}
            {%- if section.settings.action_3_title != blank -%}<h3 class="about-actions__item-title">{{ section.settings.action_3_title | escape }}</h3>{%- endif -%}
            {%- if section.settings.action_3_text != blank -%}<p class="about-actions__item-text">{{ section.settings.action_3_text | escape }}</p>{%- endif -%}
            {%- if section.settings.action_3_label != blank and section.settings.action_3_link != blank -%}<a href="{{ section.settings.action_3_link }}" class="about-actions__link">{{ section.settings.action_3_label | escape }}</a>{%- endif -%}
          </article>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- assign gallery_blocks = section.blocks | where: 'type', 'gallery_image' -%}
  {%- if section.settings.show_gallery and gallery_blocks.size > 0 -%}
  <section class="about-gallery section-padding">
    <div class="page-width">
      {%- if section.settings.gallery_title != blank -%}
      <h2 class="about-gallery__title">{{ section.settings.gallery_title | escape }}</h2>
      {%- endif -%}
      <div class="about-gallery__grid">
        {%- for block in gallery_blocks -%}
        {%- if block.settings.image != blank -%}
        {%- assign gallery_alt = block.settings.alt | default: block.settings.image.alt -%}
        <div class="about-gallery__item" {{ block.shopify_attributes }}>
          {{ block.settings.image | image_url: width: 800 | image_tag: widths: '320, 480, 640, 800', sizes: '(min-width: 1025px) 33vw, (min-width: 641px) 50vw, 100vw', loading: 'lazy', class: 'about-gallery__image', alt: gallery_alt }}
        </div>
        {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- if block.type == '@app' -%}
      <div class="about-app-block" {{ block.shopify_attributes }}>
        {%- render block -%}
      </div>
    {%- endif -%}
  {%- endfor -%}

  {%- if page.content != blank -%}
  <section class="about-content section-padding">
    <div class="page-width">
      <div class="about-content__wrap">
        {{ page.content }}
      </div>
    </div>
  </section>
  {%- endif -%}
</about-page>

