{{ 'section-custom-liquid.css' | asset_url | stylesheet_tag }}
{%- comment %}
  Section: Custom Liquid
{% endcomment -%}

{%- liquid
  assign border_style = section.settings.border_style
  assign has_border = false
  if border_style != 'none'
    assign has_border = true
  endif
-%}

<div
  id="section-{{ section.id }}"
  class="section-custom-liquid color-{{ section.settings.color_scheme }}"
  style="
    --cl-dt: {{ section.settings.padding_top_desktop }}px;
    --cl-db: {{ section.settings.padding_bottom_desktop }}px;
    --cl-mt: {{ section.settings.padding_top_mobile }}px;
    --cl-mb: {{ section.settings.padding_bottom_mobile }}px;
    --cl-radius: {{ section.settings.corner_radius }}px;
    {%- if has_border -%}
      --cl-border-width: {{ section.settings.border_width }}px;
      --cl-border-style: {{ border_style }};
      --cl-border-opacity: {{ section.settings.border_opacity | divided_by: 100.0 }};
    {%- endif -%}
  "
>
  <div class="{% if section.settings.section_width == 'fixed' %}page-width{% else %}section-custom-liquid__full{% endif %}">
    <div class="section-custom-liquid__inner{% if has_border %} section-custom-liquid__bordered{% endif %}">
      {{ section.settings.liquid_code }}
    </div>
  </div>
</div>




{% schema %}
{
  "name": "t:sections.custom_liquid.name",
  "tag": "section",
  "class": "section-custom-liquid-wrapper",
  "settings": [
    {
      "type": "liquid",
      "id": "liquid_code",
      "label": "t:sections.custom_liquid.settings.liquid_code.label",
      "info": "t:sections.custom_liquid.settings.liquid_code.info"
    },
    {
      "type": "header",
      "content": "t:sections.custom_liquid.settings.header__layout.content"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:sections.custom_liquid.settings.section_width.label",
      "options": [
        {
          "value": "full",
          "label": "t:sections.custom_liquid.settings.section_width.options.full"
        },
        {
          "value": "fixed",
          "label": "t:sections.custom_liquid.settings.section_width.options.fixed"
        }
      ],
      "default": "fixed"
    },
    {
      "type": "header",
      "content": "t:sections.custom_liquid.settings.header__appearance.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.custom_liquid.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "t:sections.custom_liquid.settings.border_style.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.custom_liquid.settings.border_style.options.none"
        },
        {
          "value": "solid",
          "label": "t:sections.custom_liquid.settings.border_style.options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "t:sections.custom_liquid.settings.border_width.label",
      "default": 1,
      "visible_if": "{{ section.settings.border_style != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "t:sections.custom_liquid.settings.border_opacity.label",
      "default": 100,
      "visible_if": "{{ section.settings.border_style != 'none' }}"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "t:sections.custom_liquid.settings.corner_radius.label",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.custom_liquid.settings.header__desktop_spacing.content"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "t:sections.custom_liquid.settings.padding_top_desktop.label",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "t:sections.custom_liquid.settings.padding_bottom_desktop.label",
      "default": 50
    },
    {
      "type": "header",
      "content": "t:sections.custom_liquid.settings.header__mobile_spacing.content"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:sections.custom_liquid.settings.padding_top_mobile.label",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:sections.custom_liquid.settings.padding_bottom_mobile.label",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "t:sections.custom_liquid.presets.custom_liquid.name",
      "category": "t:categories.advanced"
    }
  ]
}
{% endschema %}
