      "default": "top"
    },
    {
      "type": "header",
      "content": "t:sections.custom_section.settings.header__size.content"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:sections.custom_section.settings.section_width.label",
      "options": [
        {
          "value": "page",
          "label": "t:sections.custom_section.settings.section_width.options.page"
        },
        {
          "value": "narrow",
          "label": "t:sections.custom_section.settings.section_width.options.narrow"
        },
        {
          "value": "full",
          "label": "t:sections.custom_section.settings.section_width.options.full"
        }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "t:sections.custom_section.settings.min_height.label",
      "info": "t:sections.custom_section.settings.min_height.info",
      "min": 0,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 0
