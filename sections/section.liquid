{{ 'section-custom.css' | asset_url | stylesheet_tag }}
{{ 'block-generic.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign flow_classes = 'section-custom__flow blocks-flow section-custom__flow--' | append: section.settings.section_width
  if section.settings.direction == 'row'
    if section.settings.stack_on_mobile
      assign flow_classes = flow_classes | append: ' blocks-flow--row-wide'
    else
      assign flow_classes = flow_classes | append: ' blocks-flow--row-always'
    endif
  endif

  case section.settings.alignment
    when 'center'
      assign flow_horizontal = 'center'
    when 'right'
      assign flow_horizontal = 'flex-end'
    else
      assign flow_horizontal = 'flex-start'
  endcase
  case section.settings.vertical_alignment
    when 'center'
      assign flow_vertical = 'center'
    when 'bottom'
      assign flow_vertical = 'flex-end'
    else
      assign flow_vertical = 'flex-start'
  endcase
-%}

<div
  id="section-{{ section.id }}"
  class="section-custom color-{{ section.settings.color_scheme }}"
  style="
    --custom-dt: {{ section.settings.padding_top_desktop }}px;
    --custom-db: {{ section.settings.padding_bottom_desktop }}px;
    --custom-mt: {{ section.settings.padding_top_mobile }}px;
    --custom-mb: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="{% if section.settings.section_width == 'full' %}section-custom__full{% else %}page-width{% endif %}">
    <div
      class="{{ flow_classes }}"
      style="--flow-gap: {{ section.settings.gap }}px; --flow-h: {{ flow_horizontal }}; --flow-v: {{ flow_vertical }}; --flow-text: {{ section.settings.alignment }}; --flow-min-height: {{ section.settings.min_height }}px;"
    >
      {%- content_for 'blocks' -%}
    </div>
  </div>
</div>

{% schema %}
{
