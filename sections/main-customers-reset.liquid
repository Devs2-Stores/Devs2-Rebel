{%- style -%}
  .section-main-customers-reset {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div class="change-password-template">
    <div class="page-width">
    <h1 class="change-password-template__title">{{ 'customer.reset_password.title' | t }}</h1>
    <div{% if customer %} class="account-template__grid"{% endif %}>
      {%- if customer -%}
      <div class="change-password-template__sidebar">
        {%- render 'customer-sidebar' -%}
      </div>
      {%- endif -%}
      <div class="change-password-template__wrapper">
        <div class="change-password-template__form">
          {%- form 'reset_customer_password' -%}
          {%- if form.errors -%}
          <div class="form-error" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          {%- if form.posted_successfully? -%}
          <div class="form-success">
            <p class="form-success__text">{{ 'customer.reset_password.success' | t }}</p>
          </div>
          {%- else -%}
          <div class="form-info">
            <p>{{ 'customer.reset_password.subtext' | t }}</p>
          </div>
          {%- endif -%}
          <change-password-form class="form form-change-password" data-password-mismatch="{{ 'customer.reset_password.password_mismatch' | t }}" data-password-min-length="{{ 'customer.reset_password.password_min_length' | t }}">
            <toggle-password class="form-group">
              <label for="new-password" class="label-password">
                <span class="required">{{ 'customer.reset_password.password' | t }}</span>
              </label>
              <input-field class="form-group-input form-group-input--password">
                {%- render 'icon', name: 'password' -%}
                <input type="password" id="new-password" class="form-control" name="customer[password]" required minlength="8" autocomplete="new-password" placeholder="{{ 'customer.reset_password.password_placeholder' | t }}">
                <button type="button" class="toggle-password__button" aria-controls="new-password" aria-label="{{ 'accessibility.show_password' | t }}" data-label-show="{{ 'accessibility.show_password' | t }}" data-label-hide="{{ 'accessibility.hide_password' | t }}">
                  {%- render 'icon', name: 'eye-show', class: 'icon-eye-show' -%}
                  {%- render 'icon', name: 'eye-hide', class: 'icon-eye-hide' -%}
                </button>
              </input-field>
            </toggle-password>
            <toggle-password class="form-group">
              <label for="confirm-password" class="label-password">
                <span class="required">{{ 'customer.reset_password.password_confirm' | t }}</span>
              </label>
              <input-field class="form-group-input form-group-input--password">
                {%- render 'icon', name: 'password' -%}
                <input type="password" id="confirm-password" class="form-control" name="customer[password_confirmation]" required minlength="8" autocomplete="new-password" placeholder="{{ 'customer.reset_password.password_confirm_placeholder' | t }}">
                <button type="button" class="toggle-password__button" aria-controls="confirm-password" aria-label="{{ 'accessibility.show_password' | t }}" data-label-show="{{ 'accessibility.show_password' | t }}" data-label-hide="{{ 'accessibility.hide_password' | t }}">
                  {%- render 'icon', name: 'eye-show', class: 'icon-eye-show' -%}
                  {%- render 'icon', name: 'eye-hide', class: 'icon-eye-hide' -%}
                </button>
              </input-field>
            </toggle-password>
            <div class="form-group">
              <button type="submit" class="button-primary active form-submit" title="{{ 'customer.reset_password.submit' | t }}">{{ 'customer.reset_password.submit' | t }}</button>
            </div>
            <div class="form-group form-group--text-center">
              <a class="link" href="{{ routes.account_url }}" title="{{ 'customer.reset_password.back_to_account' | t }}">{{ 'customer.reset_password.back_to_account' | t }}</a>
            </div>
          </change-password-form>
          {%- endform -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_customers_reset.name",
  "tag": "section",
  "class": "section-main-customers-reset",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ]
}
{% endschema %}