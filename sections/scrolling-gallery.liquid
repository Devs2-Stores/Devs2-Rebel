{%- comment %}
  Section: Scrolling Gallery (Horizontal)
  Mô tả: Container scrolls ngang — ảnh lớn edge-to-edge, lookbook style.
{% endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-hgallery color-{{ section.settings.color_scheme }}"
  style="
    --hg-dt: {{ section.settings.padding_top_desktop }}px;
    --hg-db: {{ section.settings.padding_bottom_desktop }}px;
    --hg-mt: {{ section.settings.padding_top_mobile }}px;
    --hg-mb: {{ section.settings.padding_bottom_mobile }}px;
    --hg-h: {{ section.settings.image_height }}px;
  "
>
  {%- if section.settings.heading != blank -%}
    <div class="page-width section-hgallery__head">
      {%- if section.settings.subheading != blank -%}
        <p class="section-hgallery__subheading subheading-size-{{ section.settings.subheading_size }}">{{ section.settings.subheading }}</p>
      {%- endif -%}
      <{{ section.settings.heading_tag }} class="section-hgallery__heading heading-size-{{ section.settings.heading_size }}">
        {{- section.settings.heading -}}
      </{{ section.settings.heading_tag }}>
    </div>
  {%- endif -%}

  <div class="section-hgallery__track" data-hgallery-track>
    {%- for block in section.blocks -%}
      <div class="section-hgallery__slide" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="section-hgallery__link">{%- endif -%}
          <div class="section-hgallery__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 900 | image_tag:
                widths: '450, 600, 900', sizes: '40vw',
                loading: 'lazy', class: 'section-hgallery__img'
              }}
            {%- else -%}
              <div class="section-hgallery__ph">{{ 'image' | placeholder_svg_tag }}</div>
            {%- endif -%}
            {%- if block.settings.caption != blank -%}
              <div class="section-hgallery__caption">
                <span>{{ block.settings.caption }}</span>
              </div>
            {%- endif -%}
          </div>
        {%- if block.settings.link != blank -%}</a>{%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  <div class="page-width section-hgallery__controls">
    <div class="section-hgallery__progress">
      <div class="section-hgallery__progress-bar" data-hgallery-progress></div>
    </div>
    <span class="section-hgallery__hint">← Scroll →</span>
  </div>
</div>

<script>
(function() {
  var track = document.querySelector('#section-{{ section.id }} [data-hgallery-track]');
  var bar = document.querySelector('#section-{{ section.id }} [data-hgallery-progress]');
  if (!track || !bar) return;
  track.addEventListener('scroll', function() {
    var max = track.scrollWidth - track.clientWidth;
    if (max <= 0) return;
    bar.style.width = (track.scrollLeft / max * 100) + '%';
  }, { passive: true });
})();
</script>

{% stylesheet %}
  .section-hgallery {
    padding-block: var(--hg-mt) var(--hg-mb);
    background: rgb(var(--color-background));
  }
  @media (min-width: 750px) {
    .section-hgallery { padding-block: var(--hg-dt) var(--hg-db); }
  }
  .section-hgallery__head { margin-bottom: 1.5rem; }
  .section-hgallery__subheading { margin: 0 0 0.25rem; text-transform: uppercase; letter-spacing: 0.12em; color: rgb(var(--color-accent)); font-weight: 600; }
  .section-hgallery__heading { margin: 0; color: rgb(var(--color-foreground)); }

  .section-hgallery__track {
    display: flex; gap: 12px;
    overflow-x: auto; scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; padding: 0 1.5rem;
  }
  .section-hgallery__track::-webkit-scrollbar { display: none; }
  @media (min-width: 750px) {
    .section-hgallery__track { gap: 16px; }
  }

  .section-hgallery__slide {
    flex-shrink: 0; scroll-snap-align: start;
    width: 75vw;
  }
  @media (min-width: 750px) {
    .section-hgallery__slide { width: 35vw; }
  }

  .section-hgallery__link { display: block; text-decoration: none; color: inherit; }

  .section-hgallery__media {
    position: relative; overflow: hidden; border-radius: 0.5rem;
    height: var(--hg-h, 400px);
  }
  .section-hgallery__img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.5s ease;
  }
  .section-hgallery__slide:hover .section-hgallery__img { transform: scale(1.05); }

  .section-hgallery__ph {
    width: 100%; height: 100%; background: rgba(var(--color-foreground), 0.04);
    display: flex; align-items: center; justify-content: center;
  }
  .section-hgallery__ph svg { width: 20%; opacity: 0.1; }

  .section-hgallery__caption {
    position: absolute; bottom: 0; left: 0; right: 0;
    padding: 1rem; background: linear-gradient(transparent, rgba(0,0,0,0.5));
    color: #fff; font-size: 0.875rem; font-weight: 600;
  }

  .section-hgallery__controls {
    display: flex; align-items: center; gap: 1rem;
    margin-top: 1.25rem;
  }
  .section-hgallery__progress {
    flex: 1; height: 3px; background: rgba(var(--color-foreground), 0.08);
    border-radius: 2px; overflow: hidden;
  }
  .section-hgallery__progress-bar {
    height: 100%; width: 0; background: rgb(var(--color-accent));
    border-radius: 2px; transition: width 0.1s;
  }
  .section-hgallery__hint {
    font-size: 0.6875rem; color: rgba(var(--color-foreground), 0.3);
    letter-spacing: 0.04em; flex-shrink: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Scrolling gallery",
  "tag": "section",
  "class": "section-hgallery-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "subheading_size",
      "label": "Subheading size",
      "options": [
        {
          "value": "xs",
          "label": "XS"
        },
        {
          "value": "sm",
          "label": "S"
        }
      ],
      "default": "sm"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Lookbook"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "md",
          "label": "M"
        },
        {
          "value": "lg",
          "label": "L"
        }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "image_height",
      "min": 250,
      "max": 600,
      "step": 25,
      "unit": "px",
      "label": "Image height",
      "default": 400
