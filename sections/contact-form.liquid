{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}
{%- comment %}
  Section: Contact Form
  Reusable contact form section.
{% endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-contact-form color-{{ section.settings.color_scheme }}"
  style="
    --cf-dt: {{ section.settings.padding_top_desktop }}px;
    --cf-db: {{ section.settings.padding_bottom_desktop }}px;
    --cf-mt: {{ section.settings.padding_top_mobile }}px;
    --cf-mb: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="page-width">
    <div class="section-contact-form__grid section-contact-form__grid--{{ section.settings.layout }}">
      {%- comment %} Info column {% endcomment -%}
      {%- if section.settings.heading != blank or section.settings.text != blank -%}
        <div class="section-contact-form__info">
          {%- if section.settings.subheading != blank -%}
            <p class="section-contact-form__subheading subheading-size-{{ section.settings.subheading_size }}">{{ section.settings.subheading }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <{{ section.settings.heading_tag }} class="section-contact-form__heading heading-size-{{ section.settings.heading_size }}">
              {{- section.settings.heading -}}
            </{{ section.settings.heading_tag }}>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <div class="section-contact-form__text content-size-{{ section.settings.text_size }}">{{ section.settings.text }}</div>
          {%- endif -%}
          <div class="section-contact-form__info-list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'info_item' -%}
              <div class="section-contact-form__info-item" {{ block.shopify_attributes }}>
                {%- if block.settings.icon != blank -%}
                  <div class="section-contact-form__info-icon">
                    {{ block.settings.icon | image_url: width: 40 | image_tag: loading: 'lazy' }}
                  </div>
                {%- endif -%}
                <div>
                  {%- if block.settings.label != blank -%}
                    <strong>{{ block.settings.label }}</strong>
                  {%- endif -%}
                  {%- if block.settings.value != blank -%}
                    <span>{{ block.settings.value }}</span>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- comment %} Form {% endcomment -%}
      <div class="section-contact-form__form-wrap">
        {%- form 'contact', id: 'contact-form' -%}
          {%- if form.posted_successfully? -%}
            <p class="section-contact-form__success">{{ 'general.contact.success' | t }}</p>
          {%- endif -%}
          {%- if form.errors -%}
            <p class="section-contact-form__error">{{ form.errors | default_errors }}</p>
          {%- endif -%}
          <div class="section-contact-form__fields">
            <div class="section-contact-form__row">
              <div class="section-contact-form__field">
                <label for="contact-name-{{ section.id }}">{{ 'general.contact.name' | t }} *</label>
                <input type="text" id="contact-name-{{ section.id }}" name="contact[name]" required autocomplete="name">
              </div>
              <div class="section-contact-form__field">
                <label for="contact-email-{{ section.id }}">{{ 'general.contact.email' | t }} *</label>
                <input type="email" id="contact-email-{{ section.id }}" name="contact[email]" required autocomplete="email">
              </div>
            </div>
            {%- if section.settings.show_phone -%}
              <div class="section-contact-form__field">
                <label for="contact-phone-{{ section.id }}">{{ 'general.contact.phone' | t }}</label>
                <input type="tel" id="contact-phone-{{ section.id }}" name="contact[phone]" autocomplete="tel">
              </div>
            {%- endif -%}
            <div class="section-contact-form__field">
              <label for="contact-msg-{{ section.id }}">{{ 'general.contact.message' | t }} *</label>
              <textarea id="contact-msg-{{ section.id }}" name="contact[body]" rows="5" required></textarea>
            </div>
            <button type="submit" class="section-contact-form__submit button-size-{{ section.settings.button_size }}">
              {%- liquid
                assign submit_label = section.settings.button_label
                if submit_label == blank
                  assign submit_label = 'general.contact.send' | t
                endif
              -%}
              {{ submit_label | escape }}
            </button>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>


{% schema %}
{
  "name": "t:sections.contact_form.name",
  "tag": "section",
  "class": "section-contact-form-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.contact_form.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.contact_form.settings.header__content.content"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:sections.contact_form.settings.subheading.label",
      "default": "t:sections.contact_form.settings.subheading.default"
    },
    {
      "type": "select",
      "id": "subheading_size",
      "label": "t:sections.contact_form.settings.subheading_size.label",
      "options": [
        {
          "value": "xs",
          "label": "t:sections.contact_form.settings.subheading_size.options.xs"
        },
        {
          "value": "sm",
          "label": "t:sections.contact_form.settings.subheading_size.options.sm"
        }
      ],
      "default": "sm"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.contact_form.settings.heading.label",
      "default": "t:sections.contact_form.settings.heading.default"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.contact_form.settings.heading_size.label",
      "options": [
        {
          "value": "md",
          "label": "t:sections.contact_form.settings.heading_size.options.md"
        },
        {
          "value": "lg",
          "label": "t:sections.contact_form.settings.heading_size.options.lg"
        },
        {
          "value": "xl",
          "label": "t:sections.contact_form.settings.heading_size.options.xl"
        }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.contact_form.settings.heading_tag.label",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.contact_form.settings.heading_tag.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.contact_form.settings.heading_tag.options.h3"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.contact_form.settings.text.label",
      "default": "t:sections.contact_form.settings.text.default"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "t:sections.contact_form.settings.text_size.label",
      "options": [
        {
          "value": "sm",
          "label": "t:sections.contact_form.settings.text_size.options.sm"
        },
        {
          "value": "md",
          "label": "t:sections.contact_form.settings.text_size.options.md"
        }
      ],
      "default": "md"
    },
    {
      "type": "header",
      "content": "t:sections.contact_form.settings.header__form.content"
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "t:sections.contact_form.settings.show_phone.label",
      "default": false
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.contact_form.settings.button_label.label",
      "default": "t:sections.contact_form.settings.button_label.default"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "t:sections.contact_form.settings.button_size.label",
      "options": [
        {
          "value": "sm",
          "label": "t:sections.contact_form.settings.button_size.options.sm"
        },
        {
          "value": "md",
          "label": "t:sections.contact_form.settings.button_size.options.md"
        },
        {
          "value": "lg",
          "label": "t:sections.contact_form.settings.button_size.options.lg"
        }
      ],
      "default": "md"
    },
    {
      "type": "header",
      "content": "t:sections.contact_form.settings.header__layout.content"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.contact_form.settings.layout.label",
      "options": [
        {
          "value": "stacked",
          "label": "t:sections.contact_form.settings.layout.options.stacked"
        },
        {
          "value": "side-by-side",
          "label": "t:sections.contact_form.settings.layout.options.side_by_side"
        }
      ],
      "default": "side-by-side"
    },
    {
      "type": "header",
      "content": "t:sections.contact_form.settings.header__desktop_spacing.content"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "t:sections.contact_form.settings.padding_top_desktop.label",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "t:sections.contact_form.settings.padding_bottom_desktop.label",
      "default": 50
    },
    {
      "type": "header",
      "content": "t:sections.contact_form.settings.header__mobile_spacing.content"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:sections.contact_form.settings.padding_top_mobile.label",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "t:sections.contact_form.settings.padding_bottom_mobile.label",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "info_item",
      "name": "t:sections.contact_form.blocks.info_item.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "t:sections.contact_form.blocks.info_item.settings.icon.label"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.contact_form.blocks.info_item.settings.label.label",
          "default": "t:sections.contact_form.blocks.info_item.settings.label.default"
        },
        {
          "type": "text",
          "id": "value",
          "label": "t:sections.contact_form.blocks.info_item.settings.value.label",
          "default": "t:sections.contact_form.blocks.info_item.settings.value.default"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact_form.presets.contact_form.name",
      "category": "Custom",
      "blocks": [
        {
          "type": "info_item",
          "settings": {
            "label": "t:sections.contact_form.blocks.info_item.settings.label.default",
            "value": "t:sections.contact_form.blocks.info_item.settings.value.default"
          }
        },
        {
          "type": "info_item",
          "settings": {
            "label": "t:sections.contact_form.presets.contact_form.phone_label",
            "value": "t:sections.contact_form.presets.contact_form.phone_value"
          }
        },
        {
          "type": "info_item",
          "settings": {
            "label": "t:sections.contact_form.presets.contact_form.hours_label",
            "value": "t:sections.contact_form.presets.contact_form.hours_value"
          }
        }
      ]
    }
  ]
}
{% endschema %}
