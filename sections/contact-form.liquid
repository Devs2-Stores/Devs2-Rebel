{%- comment %}
  Section: Contact Form
  Mô tả: Form liên hệ global — dùng được ở bất kỳ page nào.
{% endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-contact-form color-{{ section.settings.color_scheme }}"
  style="
    --cf-dt: {{ section.settings.padding_top_desktop }}px;
    --cf-db: {{ section.settings.padding_bottom_desktop }}px;
    --cf-mt: {{ section.settings.padding_top_mobile }}px;
    --cf-mb: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="page-width">
    <div class="section-contact-form__grid section-contact-form__grid--{{ section.settings.layout }}">
      {%- comment %} Info column {% endcomment -%}
      {%- if section.settings.heading != blank or section.settings.text != blank -%}
        <div class="section-contact-form__info">
          {%- if section.settings.subheading != blank -%}
            <p class="section-contact-form__subheading subheading-size-{{ section.settings.subheading_size }}">{{ section.settings.subheading }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <{{ section.settings.heading_tag }} class="section-contact-form__heading heading-size-{{ section.settings.heading_size }}">
              {{- section.settings.heading -}}
            </{{ section.settings.heading_tag }}>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <div class="section-contact-form__text content-size-{{ section.settings.text_size }}">{{ section.settings.text }}</div>
          {%- endif -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'info_item' -%}
              <div class="section-contact-form__info-item" {{ block.shopify_attributes }}>
                {%- if block.settings.icon != blank -%}
                  <div class="section-contact-form__info-icon">
                    {{ block.settings.icon | image_url: width: 40 | image_tag: loading: 'lazy' }}
                  </div>
                {%- endif -%}
                <div>
                  {%- if block.settings.label != blank -%}
                    <strong>{{ block.settings.label }}</strong>
                  {%- endif -%}
                  {%- if block.settings.value != blank -%}
                    <span>{{ block.settings.value }}</span>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment %} Form {% endcomment -%}
      <div class="section-contact-form__form-wrap">
        {%- form 'contact', id: 'contact-form' -%}
          {%- if form.posted_successfully? -%}
            <p class="section-contact-form__success">{{ 'general.contact.success' | t | default: 'Thank you! We will get back to you shortly.' }}</p>
          {%- endif -%}
          {%- if form.errors -%}
            <p class="section-contact-form__error">{{ form.errors | default_errors }}</p>
          {%- endif -%}
          <div class="section-contact-form__fields">
            <div class="section-contact-form__row">
              <div class="section-contact-form__field">
                <label for="contact-name-{{ section.id }}">{{ 'general.contact.name' | t | default: 'Name' }} *</label>
                <input type="text" id="contact-name-{{ section.id }}" name="contact[name]" required autocomplete="name">
              </div>
              <div class="section-contact-form__field">
                <label for="contact-email-{{ section.id }}">{{ 'general.contact.email' | t | default: 'Email' }} *</label>
                <input type="email" id="contact-email-{{ section.id }}" name="contact[email]" required autocomplete="email">
              </div>
            </div>
            {%- if section.settings.show_phone -%}
              <div class="section-contact-form__field">
                <label for="contact-phone-{{ section.id }}">{{ 'general.contact.phone' | t | default: 'Phone' }}</label>
                <input type="tel" id="contact-phone-{{ section.id }}" name="contact[phone]" autocomplete="tel">
              </div>
            {%- endif -%}
            <div class="section-contact-form__field">
              <label for="contact-msg-{{ section.id }}">{{ 'general.contact.message' | t | default: 'Message' }} *</label>
              <textarea id="contact-msg-{{ section.id }}" name="contact[body]" rows="5" required></textarea>
            </div>
            <button type="submit" class="section-contact-form__submit button-size-{{ section.settings.button_size }}">
              {{ section.settings.button_label | default: 'Send message' }}
            </button>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .section-contact-form {
    padding-block: var(--cf-mt) var(--cf-mb);
    background: rgb(var(--color-background));
    color: rgba(var(--color-foreground), 0.85);
  }
  @media (min-width: 750px) {
    .section-contact-form { padding-block: var(--cf-dt) var(--cf-db); }
  }
  .section-contact-form__grid { display: grid; gap: 2rem; }
  @media (min-width: 750px) {
    .section-contact-form__grid--side-by-side { grid-template-columns: 1fr 1fr; gap: 3rem; align-items: start; }
  }

  .section-contact-form__info { display: flex; flex-direction: column; gap: 0.75rem; }
  .section-contact-form__subheading { margin: 0; text-transform: uppercase; letter-spacing: 0.12em; color: rgb(var(--color-accent)); font-weight: 600; }
  .section-contact-form__heading { margin: 0; color: rgb(var(--color-foreground)); line-height: 1.2; }
  .section-contact-form__text { color: rgba(var(--color-foreground), 0.7); line-height: 1.7; }
  .section-contact-form__text p { margin: 0; }
  .section-contact-form__info-item {
    display: flex; align-items: center; gap: 0.625rem;
    font-size: 0.875rem; color: rgba(var(--color-foreground), 0.7);
    margin-top: 0.25rem;
  }
  .section-contact-form__info-icon { width: 24px; height: 24px; flex-shrink: 0; }
  .section-contact-form__info-icon img { width: 100%; height: 100%; object-fit: contain; }
  .section-contact-form__info-item strong { display: block; color: rgb(var(--color-foreground)); font-size: 0.8125rem; }

  .section-contact-form__fields { display: flex; flex-direction: column; gap: 1rem; }
  .section-contact-form__row { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  @media (min-width: 750px) {
    .section-contact-form__row { grid-template-columns: 1fr 1fr; }
  }
  .section-contact-form__field { display: flex; flex-direction: column; gap: 0.375rem; }
  .section-contact-form__field label {
    font-size: 0.8125rem; font-weight: 600; color: rgb(var(--color-foreground));
  }
  .section-contact-form__field input,
  .section-contact-form__field textarea {
    border: 1px solid rgba(var(--color-foreground), 0.15);
    border-radius: var(--buttons-radius, 0);
    padding: 0.625rem 0.75rem; font-size: 0.875rem;
    background: transparent; color: rgb(var(--color-foreground));
    font-family: inherit; transition: border-color 0.3s;
  }
  .section-contact-form__field input:focus,
  .section-contact-form__field textarea:focus {
    outline: none; border-color: rgb(var(--color-accent));
  }
  .section-contact-form__field textarea { resize: vertical; }

  .section-contact-form__submit {
    background: rgb(var(--color-button)); color: rgb(var(--color-button-text));
    border: 1px solid rgb(var(--color-button)); border-radius: var(--buttons-radius, 0);
    font-weight: 600; cursor: pointer; transition: opacity 0.2s; align-self: flex-start;
  }
  .section-contact-form__submit:hover { opacity: 0.85; }

  .section-contact-form__success { color: #059669; font-size: 0.875rem; margin: 0 0 1rem; }
  .section-contact-form__error { color: #dc2626; font-size: 0.875rem; margin: 0 0 1rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "class": "section-contact-form-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "Get in touch"
    },
    {
      "type": "select",
      "id": "subheading_size",
      "label": "Subheading size",
      "options": [
        {
          "value": "xs",
          "label": "XS"
        },
        {
          "value": "sm",
          "label": "S"
        }
      ],
      "default": "sm"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "We'd love to hear from you"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "md",
          "label": "M"
        },
        {
          "value": "lg",
          "label": "L"
        },
        {
          "value": "xl",
          "label": "XL"
        }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Have a question or feedback? Fill out the form and we'll respond within 24 hours.</p>"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Text size",
      "options": [
        {
          "value": "sm",
          "label": "S"
        },
        {
          "value": "md",
          "label": "M"
        }
      ],
      "default": "md"
    },
    {
      "type": "header",
      "content": "Form"
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Show phone field",
      "default": false
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Send message"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "Button size",
      "options": [
        {
          "value": "sm",
          "label": "S"
        },
        {
          "value": "md",
          "label": "M"
        },
        {
          "value": "lg",
          "label": "L"
        }
      ],
      "default": "md"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "stacked",
          "label": "Stacked"
        },
        {
          "value": "side-by-side",
          "label": "Side by side"
        }
      ],
      "default": "side-by-side"
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Bottom",
      "default": 50
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "info_item",
      "name": "Contact info",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Email"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "hello@example.com"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Contact form",
      "category": "Custom",
      "blocks": [
        {
          "type": "info_item",
          "settings": {
            "label": "Email",
            "value": "hello@example.com"
          }
        },
        {
          "type": "info_item",
          "settings": {
            "label": "Phone",
            "value": "+1 (888) 123-4567"
          }
        },
        {
          "type": "info_item",
          "settings": {
            "label": "Hours",
            "value": "Mon-Fri 9AM-6PM"
          }
        }
      ]
    }
  ]
}
{% endschema %}
