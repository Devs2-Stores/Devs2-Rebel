{%- comment %}
  Section: Promotion Banner
  Description: Stacked promotional strips with repeatable, reorderable blocks.
{% endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-promo color-{{ section.settings.color_scheme }}"
  style="
    --promo-dt: {{ section.settings.padding_top_desktop }}px;
    --promo-db: {{ section.settings.padding_bottom_desktop }}px;
    --promo-mt: {{ section.settings.padding_top_mobile }}px;
    --promo-mb: {{ section.settings.padding_bottom_mobile }}px;
    --promo-gap: {{ section.settings.block_gap }}px;
  "
>
  <div class="page-width">
    <div class="section-promo__blocks">
      {%- for block in section.blocks -%}
        <div
          class="section-promo__item"
          {{ block.shopify_attributes }}
          {% if section.settings.dismissible %}data-promo-banner data-promo-id="{{ block.id }}"{% endif %}
        >
          <div class="section-promo__inner section-promo__inner--{{ section.settings.text_align }}">
            <div class="section-promo__content">
              {%- if block.settings.icon != blank -%}
                <div class="section-promo__icon">
                  {{ block.settings.icon | image_url: height: 48 | image_tag: loading: 'lazy', class: 'section-promo__icon-img' }}
                </div>
              {%- endif -%}
              <div class="section-promo__text-wrap">
                {%- if block.settings.heading != blank -%}
                  <p class="section-promo__heading heading-size-{{ section.settings.heading_size }}">
                    {{- block.settings.heading -}}
                  </p>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="section-promo__text content-size-{{ section.settings.text_size }}">
                    {{- block.settings.text -}}
                  </p>
                {%- endif -%}
              </div>
              {%- if block.settings.button_label != blank -%}
                <a href="{{ block.settings.button_link | default: '#' }}" class="section-promo__btn section-promo__btn--{{ section.settings.button_style }} button-size-{{ section.settings.button_size }}">
                  {{- block.settings.button_label -}}
                </a>
              {%- endif -%}
            </div>
            {%- if section.settings.dismissible -%}
              <button class="section-promo__close" data-promo-close aria-label="{{ 'accessibility.dismiss' | t }}">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            {%- endif -%}
          </div>
        </div>
      {%- else -%}
        {%- if request.design_mode -%}
          <div class="section-promo__item">
            <div class="section-promo__inner section-promo__inner--{{ section.settings.text_align }}">
              <div class="section-promo__content">
                <div class="section-promo__text-wrap">
                  <p class="section-promo__heading heading-size-{{ section.settings.heading_size }}">
                    {{ 'sections.promotion_banner.onboarding' | t }}
                  </p>
                </div>
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- if section.settings.dismissible -%}
<script>
(function() {
  var container = document.getElementById('section-{{ section.id }}');
  if (!container) return;
  container.querySelectorAll('[data-promo-banner]').forEach(function(el) {
    var id = el.getAttribute('data-promo-id');
    var key = 'promo_dismissed_' + id;
    var dismissed = false;
    try { dismissed = !!sessionStorage.getItem(key); } catch (e) {}
    if (dismissed) { el.style.display = 'none'; return; }
    var btn = el.querySelector('[data-promo-close]');
    if (btn) btn.addEventListener('click', function() {
      el.style.display = 'none';
      try { sessionStorage.setItem(key, '1'); } catch (e) {}
    });
  });
})();
</script>
{%- endif -%}

{% stylesheet %}
  .section-promo {
    padding-block: var(--promo-mt) var(--promo-mb);
    background: rgb(var(--color-background));
    color: rgba(var(--color-foreground), 0.85);
  }
  @media (min-width: 750px) {
    .section-promo { padding-block: var(--promo-dt) var(--promo-db); }
  }

  .section-promo__blocks {
    display: flex; flex-direction: column; gap: var(--promo-gap, 8px);
  }

  .section-promo__item {
    position: relative;
  }

  .section-promo__inner {
    display: flex; align-items: center; gap: 1rem;
    position: relative;
  }
  .section-promo__inner--center { justify-content: center; text-align: center; }
  .section-promo__inner--left { justify-content: flex-start; }

  .section-promo__content {
    display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;
  }
  .section-promo__inner--center .section-promo__content { justify-content: center; }

  .section-promo__icon { flex-shrink: 0; }
  .section-promo__icon-img { height: 32px; width: auto; }

  .section-promo__text-wrap { display: flex; flex-direction: column; gap: 0.125rem; }
  .section-promo__heading { margin: 0; color: var(--color-ink); font-weight: 600; letter-spacing: var(--heading-tracking); }
  .section-promo__text { margin: 0; color: var(--color-muted); }

  .section-promo__btn {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: var(--btn-height);
    padding: 0 var(--btn-padding-x);
    font-size: var(--btn-font-size);
    font-weight: var(--btn-font-weight);
    letter-spacing: var(--btn-letter-spacing);
    text-decoration: none;
    border-radius: var(--buttons-radius, 0);
    transition: background-color var(--duration-default) ease, color var(--duration-default) ease, border-color var(--duration-default) ease;
    cursor: pointer; flex-shrink: 0;
  }
  .section-promo__btn--primary {
    background: var(--color-primary); color: rgb(var(--color-button-text));
    border: 1px solid var(--color-primary);
  }
  .section-promo__btn--primary:hover {
    background: var(--color-primary-strong); border-color: var(--color-primary-strong);
    color: rgb(var(--color-button-text));
  }
  .section-promo__btn--secondary {
    background: transparent; color: var(--color-ink);
    border: 1px solid var(--color-ink);
  }
  .section-promo__btn--secondary:hover {
    background: var(--color-ink); color: rgb(var(--color-background));
    border-color: var(--color-ink);
  }

  .section-promo__close {
    position: absolute; right: 0; top: 50%; transform: translateY(-50%);
    background: none; border: none; cursor: pointer;
    color: var(--color-muted);
    transition: color var(--duration-default) ease; padding: 4px;
  }
  .section-promo__close:hover { color: var(--color-ink); }
{% endstylesheet %}

