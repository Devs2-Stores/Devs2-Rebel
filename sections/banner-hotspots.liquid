{{ 'section-banner-hotspots.css' | asset_url | stylesheet_tag }}
{%- comment %}
  Section: Banner with Hotspots
{% endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-hotspot color-{{ section.settings.color_scheme }}"
  style="
    --hs-dt: {{ section.settings.padding_top_desktop }}px;
    --hs-db: {{ section.settings.padding_bottom_desktop }}px;
    --hs-mt: {{ section.settings.padding_top_mobile }}px;
    --hs-mb: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="{% if section.settings.section_width == 'fixed' %}page-width{% endif %}">
    {%- if section.settings.heading != blank -%}
      <div class="page-width">
        <div class="section-hotspot__head">
          <{{ section.settings.heading_tag }} class="section-hotspot__heading heading-size-{{ section.settings.heading_size }}">
            {{- section.settings.heading -}}
          </{{ section.settings.heading_tag }}>
        </div>
      </div>
    {%- endif -%}

    <div class="section-hotspot__wrapper">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1920 | image_tag:
          widths: '750, 1080, 1440, 1920', sizes: '100vw',
          loading: 'lazy', class: 'section-hotspot__img'
        }}
      {%- else -%}
        <div class="section-hotspot__ph">{{ 'lifestyle-2' | placeholder_svg_tag }}</div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- liquid
          assign hotspot_product = block.settings.product
          assign hotspot_product_handle = block.settings.product_handle
          assign hotspot_name = hotspot_product.title | default: block.settings.heading
          if hotspot_name != blank
            assign hotspot_label = 'accessibility.view_details_for' | t: title: hotspot_name
          else
            assign hotspot_label = 'accessibility.view_details' | t
          endif
        -%}
        <div
          class="section-hotspot__dot"
          style="--hs-x: {{ block.settings.position_x }}%; --hs-y: {{ block.settings.position_y }}%;"
          {{ block.shopify_attributes }}
          data-hotspot
        >
          <button
            type="button"
            class="section-hotspot__pulse"
            aria-label="{{ hotspot_label | escape }}"
            aria-expanded="false"
            aria-controls="hotspot-tooltip-{{ block.id }}"
            {% if hotspot_product_handle != blank %}data-label-template="{{ 'accessibility.view_details_for' | t: title: '{title}' | escape }}"{% endif %}
            data-hotspot-btn
          >
            <span class="section-hotspot__plus" aria-hidden="true">+</span>
          </button>
          <div id="hotspot-tooltip-{{ block.id }}" class="section-hotspot__tooltip section-hotspot__tooltip--{{ block.settings.tooltip_position }}" data-hotspot-tooltip data-product-handle="{{ hotspot_product_handle | escape }}">
            {%- if hotspot_product != blank -%}
              <a href="{{ hotspot_product.url }}" class="section-hotspot__tooltip-product">
                {%- if hotspot_product.featured_image -%}
                  {{ hotspot_product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', class: 'section-hotspot__tooltip-img' }}
                {%- endif -%}
                <div class="section-hotspot__tooltip-info">
                  <span class="section-hotspot__tooltip-title">{{ hotspot_product.title | escape }}</span>
                  <span class="section-hotspot__tooltip-price">{{ hotspot_product.price | money }}</span>
                </div>
              </a>
            {%- else -%}
              <div class="section-hotspot__tooltip-custom">
                {%- if block.settings.heading != blank -%}
                  <strong>{{ block.settings.heading }}</strong>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <span>{{ block.settings.text }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
(function() {
  var dots = document.querySelectorAll('#section-{{ section.id }} [data-hotspot]');
  var productCache = {};

  function formatHotspotMoney(cents) {
    if (typeof window.formatMoney === 'function') return window.formatMoney(cents);
    return cents;
  }

  function getProductImage(product) {
    if (!product) return '';
    if (typeof product.featured_image === 'string') return product.featured_image;
    if (product.featured_image && typeof product.featured_image === 'object') {
      return product.featured_image.src || product.featured_image.url || '';
    }
    return '';
  }

  function renderTooltipProduct(tip, product) {
    if (!tip || !product) return;
    var link = document.createElement('a');
    var productUrl = product.url || (product.handle ? '/products/' + encodeURIComponent(product.handle) : '#');
    var imageSrc = getProductImage(product);
    var price = product.priceText || (product.price != null ? formatHotspotMoney(product.price) : '');
    link.href = productUrl;
    link.className = 'section-hotspot__tooltip-product';

    if (imageSrc) {
      var image = document.createElement('img');
      image.className = 'section-hotspot__tooltip-img';
      image.src = imageSrc;
      image.alt = product.title || '';
      image.width = 60;
      image.height = 60;
      image.loading = 'lazy';
      image.decoding = 'async';
      link.appendChild(image);
    }

    var info = document.createElement('div');
    info.className = 'section-hotspot__tooltip-info';

    var title = document.createElement('span');
    title.className = 'section-hotspot__tooltip-title';
    title.textContent = product.title || '';
    info.appendChild(title);

    var priceEl = document.createElement('span');
    priceEl.className = 'section-hotspot__tooltip-price';
    priceEl.textContent = price;
    info.appendChild(priceEl);

    link.appendChild(info);
    tip.replaceChildren(link);
    tip.setAttribute('data-product-loaded', 'true');
  }

  function hydrateTooltip(tip) {
    var handle = tip && tip.getAttribute('data-product-handle');
    if (!tip || !handle || tip.getAttribute('data-product-loaded') === 'true') return Promise.resolve();
    if (productCache[handle]) {
      renderTooltipProduct(tip, productCache[handle]);
      return Promise.resolve();
    }
    var root = (window.themeConfig && window.themeConfig.routes && window.themeConfig.routes.root_url) || '/';
    return fetch(root + 'products/' + encodeURIComponent(handle) + '.js')
      .then(function(res) { if (!res.ok) throw new Error('Failed to load product ' + handle); return res.json(); })
      .then(function(product) {
        productCache[handle] = product;
        renderTooltipProduct(tip, product);
      })
      .catch(function() {
        if (tip) tip.setAttribute('data-product-load-error', 'true');
      });
  }

  function fitTooltip(tip) {
    var frame = tip.closest('.section-hotspot__wrapper');
    tip.style.removeProperty('--hs-shift-x');
    tip.style.removeProperty('--hs-shift-y');
    if (!frame) return;
    var inset = 8;
    var box = frame.getBoundingClientRect();
    var rect = tip.getBoundingClientRect();
    var dx = 0;
    var dy = 0;
    if (rect.left < box.left + inset) dx = box.left + inset - rect.left;
    else if (rect.right > box.right - inset) dx = Math.max(box.right - inset - rect.right, box.left + inset - rect.left);
    if (rect.top < box.top + inset) dy = box.top + inset - rect.top;
    else if (rect.bottom > box.bottom - inset) dy = Math.max(box.bottom - inset - rect.bottom, box.top + inset - rect.top);
    if (dx) tip.style.setProperty('--hs-shift-x', Math.round(dx) + 'px');
    if (dy) tip.style.setProperty('--hs-shift-y', Math.round(dy) + 'px');
  }

  function closeAll() {
    document.querySelectorAll('[data-hotspot-tooltip].is-open').forEach(function(t) { t.classList.remove('is-open'); });
    document.querySelectorAll('[data-hotspot-btn][aria-expanded="true"]').forEach(function(b) { b.setAttribute('aria-expanded', 'false'); });
  }

  function openTooltip(tip, btn) {
    tip.style.transition = 'none';
    tip.classList.add('is-open');
    fitTooltip(tip);
    tip.classList.remove('is-open');
    void tip.offsetWidth;
    tip.style.transition = '';
    tip.classList.add('is-open');
    btn.setAttribute('aria-expanded', 'true');
  }

  function labelFromProduct(btn, tip) {
    var template = btn.getAttribute('data-label-template');
    var product = productCache[tip.getAttribute('data-product-handle')];
    if (template && product && product.title) btn.setAttribute('aria-label', template.replace('{title}', product.title));
  }

  dots.forEach(function(dot) {
    var btn = dot.querySelector('[data-hotspot-btn]');
    var tip = dot.querySelector('[data-hotspot-tooltip]');
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      var isOpen = tip.classList.contains('is-open');
      closeAll();
      if (!isOpen) {
        hydrateTooltip(tip).finally(function() {
          labelFromProduct(btn, tip);
          openTooltip(tip, btn);
        });
      }
    });
    dot.addEventListener('focusout', function(e) {
      if (!e.relatedTarget || dot.contains(e.relatedTarget)) return;
      tip.classList.remove('is-open');
      btn.setAttribute('aria-expanded', 'false');
    });
    dot.addEventListener('keydown', function(e) {
      if (e.key !== 'Escape' || !tip.classList.contains('is-open')) return;
      e.stopPropagation();
      closeAll();
      btn.focus();
    });
  });
  document.addEventListener('click', closeAll);
})();
</script>


