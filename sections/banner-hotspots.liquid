{%- comment %}
  Section: Banner with Hotspots
  Mô tả: Ảnh sản phẩm + chấm tròn clickable → tooltip info/product.
{% endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-hotspot color-{{ section.settings.color_scheme }}"
  style="
    --hs-dt: {{ section.settings.padding_top_desktop }}px;
    --hs-db: {{ section.settings.padding_bottom_desktop }}px;
    --hs-mt: {{ section.settings.padding_top_mobile }}px;
    --hs-mb: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="{% if section.settings.section_width == 'fixed' %}page-width{% endif %}">
    {%- if section.settings.heading != blank -%}
      <div class="page-width">
        <div class="section-hotspot__head">
          <{{ section.settings.heading_tag }} class="section-hotspot__heading heading-size-{{ section.settings.heading_size }}">
            {{- section.settings.heading -}}
          </{{ section.settings.heading_tag }}>
        </div>
      </div>
    {%- endif -%}

    <div class="section-hotspot__wrapper">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1920 | image_tag:
          widths: '750, 1080, 1440, 1920', sizes: '100vw',
          loading: 'lazy', class: 'section-hotspot__img'
        }}
      {%- else -%}
        <div class="section-hotspot__ph">{{ 'lifestyle-2' | placeholder_svg_tag }}</div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}{%- continue -%}{%- endif -%}
        {%- liquid
          assign hotspot_product = block.settings.product
          assign hotspot_product_handle = block.settings.product_handle
        -%}
        <div
          class="section-hotspot__dot"
          style="--hs-x: {{ block.settings.position_x }}%; --hs-y: {{ block.settings.position_y }}%;"
          {{ block.shopify_attributes }}
          data-hotspot
        >
          <button class="section-hotspot__pulse" aria-label="{{ 'accessibility.view_details' | t }}" data-hotspot-btn>
            <span class="section-hotspot__plus">+</span>
          </button>
          <div class="section-hotspot__tooltip section-hotspot__tooltip--{{ block.settings.tooltip_position }}" data-hotspot-tooltip data-product-handle="{{ hotspot_product_handle | escape }}">
            {%- if hotspot_product != blank -%}
              <a href="{{ hotspot_product.url }}" class="section-hotspot__tooltip-product">
                {%- if hotspot_product.featured_image -%}
                  {{ hotspot_product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', class: 'section-hotspot__tooltip-img' }}
                {%- endif -%}
                <div class="section-hotspot__tooltip-info">
                  <span class="section-hotspot__tooltip-title">{{ hotspot_product.title | escape }}</span>
                  <span class="section-hotspot__tooltip-price">{{ hotspot_product.price | money }}</span>
                </div>
              </a>
            {%- else -%}
              <div class="section-hotspot__tooltip-custom">
                {%- if block.settings.heading != blank -%}
                  <strong>{{ block.settings.heading }}</strong>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <span>{{ block.settings.text }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
    {%- capture app_blocks -%}
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}{%- render block -%}{%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if app_blocks != blank -%}
      <div class="section-apps">{{ app_blocks }}</div>
    {%- endif -%}
  </div>
</div>

<script>
(function() {
  var dots = document.querySelectorAll('#section-{{ section.id }} [data-hotspot]');
  var productCache = {};

  function formatHotspotMoney(cents) {
    if (typeof window.formatMoney === 'function') return window.formatMoney(cents);
    return cents;
  }

  function getProductImage(product) {
    if (!product) return '';
    if (typeof product.featured_image === 'string') return product.featured_image;
    if (product.featured_image && typeof product.featured_image === 'object') {
      return product.featured_image.src || product.featured_image.url || '';
    }
    return '';
  }

  function renderTooltipProduct(tip, product) {
    if (!tip || !product) return;
    var link = document.createElement('a');
    var productUrl = product.url || (product.handle ? '/products/' + encodeURIComponent(product.handle) : '#');
    var imageSrc = getProductImage(product);
    var price = product.priceText || (product.price != null ? formatHotspotMoney(product.price) : '');
    link.href = productUrl;
    link.className = 'section-hotspot__tooltip-product';

    if (imageSrc) {
      var image = document.createElement('img');
      image.className = 'section-hotspot__tooltip-img';
      image.src = imageSrc;
      image.alt = product.title || '';
      image.width = 60;
      image.height = 60;
      image.loading = 'lazy';
      image.decoding = 'async';
      link.appendChild(image);
    }

    var info = document.createElement('div');
    info.className = 'section-hotspot__tooltip-info';

    var title = document.createElement('span');
    title.className = 'section-hotspot__tooltip-title';
    title.textContent = product.title || '';
    info.appendChild(title);

    var priceEl = document.createElement('span');
    priceEl.className = 'section-hotspot__tooltip-price';
    priceEl.textContent = price;
    info.appendChild(priceEl);

    link.appendChild(info);
    tip.replaceChildren(link);
    tip.setAttribute('data-product-loaded', 'true');
  }

  function hydrateTooltip(tip) {
    var handle = tip && tip.getAttribute('data-product-handle');
    if (!tip || !handle || tip.getAttribute('data-product-loaded') === 'true') return Promise.resolve();
    if (productCache[handle]) {
      renderTooltipProduct(tip, productCache[handle]);
      return Promise.resolve();
    }
    var root = (window.themeConfig && window.themeConfig.routes && window.themeConfig.routes.root_url) || '/';
    return fetch(root + 'products/' + encodeURIComponent(handle) + '.js')
      .then(function(res) { if (!res.ok) throw new Error('Failed to load product ' + handle); return res.json(); })
      .then(function(product) {
        productCache[handle] = product;
        renderTooltipProduct(tip, product);
      })
      .catch(function() {
        if (tip) tip.setAttribute('data-product-load-error', 'true');
      });
  }

  dots.forEach(function(dot) {
    var btn = dot.querySelector('[data-hotspot-btn]');
    var tip = dot.querySelector('[data-hotspot-tooltip]');
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      var isOpen = tip.classList.contains('is-open');
      document.querySelectorAll('[data-hotspot-tooltip].is-open').forEach(function(t) { t.classList.remove('is-open'); });
      if (!isOpen) {
        hydrateTooltip(tip).finally(function() {
          tip.classList.add('is-open');
        });
      }
    });
  });
  document.addEventListener('click', function() {
    document.querySelectorAll('[data-hotspot-tooltip].is-open').forEach(function(t) { t.classList.remove('is-open'); });
  });
})();
</script>

{% stylesheet %}
  .section-hotspot {
    padding-block: var(--hs-mt) var(--hs-mb);
    background: rgb(var(--color-background));
  }
  @media (min-width: 750px) {
    .section-hotspot { padding-block: var(--hs-dt) var(--hs-db); }
  }
  .section-hotspot__head { text-align: center; margin-bottom: var(--section-head-gap); }
  .section-hotspot__heading { margin: 0; color: var(--color-ink); letter-spacing: var(--heading-tracking); }
  .section-hotspot__wrapper { position: relative; border-radius: var(--media-radius); border: var(--media-border); box-shadow: var(--media-shadow); overflow: hidden; }
  .section-hotspot__img { width: 100%; height: auto; display: block; }
  .section-hotspot__ph { aspect-ratio: 16/9; background: rgba(var(--color-foreground), 0.04); display: flex; align-items: center; justify-content: center; }
  .section-hotspot__ph svg { width: 30%; opacity: 0.1; }

  .section-hotspot__dot {
    position: absolute;
    left: var(--hs-x); top: var(--hs-y);
    transform: translate(-50%, -50%);
    z-index: 3;
  }

  @keyframes hotspot-ping {
    0% { transform: scale(1); opacity: 0.6; }
    100% { transform: scale(2.2); opacity: 0; }
  }

  .section-hotspot__pulse {
    width: 2rem; height: 2rem; border-radius: 50%;
    background: var(--color-white); border: 1px solid var(--color-black);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; position: relative; box-shadow: none;
    transition: transform var(--duration-default) ease, background-color var(--duration-default) ease, color var(--duration-default) ease;
  }
  @media (hover: hover) {
    .section-hotspot__pulse:hover { transform: scale(1.1); }
  }
  .section-hotspot__pulse::before {
    content: ''; position: absolute; inset: -4px;
    border-radius: 50%; border: 1px solid rgba(255,255,255,0.6);
    animation: hotspot-ping 2s ease-out infinite;
  }
  .section-hotspot__plus { font-size: 1rem; font-weight: 600; color: var(--color-black); line-height: 1; }

  .section-hotspot__tooltip {
    position: absolute; z-index: 10;
    background: rgb(var(--color-background));
    border: var(--popup-border); border-radius: var(--popup-corner-radius);
    box-shadow: var(--popup-shadow);
    min-width: 200px; opacity: 0; pointer-events: none;
    transform: translateY(8px); transition: opacity var(--duration-default) ease, transform var(--duration-default) ease;
  }
  .section-hotspot__tooltip.is-open {
    opacity: 1; pointer-events: auto; transform: translateY(0);
  }
  .section-hotspot__tooltip--bottom { top: calc(100% + 12px); left: 50%; transform: translateX(-50%) translateY(8px); }
  .section-hotspot__tooltip--bottom.is-open { transform: translateX(-50%) translateY(0); }
  .section-hotspot__tooltip--top { bottom: calc(100% + 12px); left: 50%; transform: translateX(-50%) translateY(-8px); }
  .section-hotspot__tooltip--top.is-open { transform: translateX(-50%) translateY(0); }
  .section-hotspot__tooltip--left { right: calc(100% + 12px); top: 50%; transform: translateY(-50%) translateX(-8px); }
  .section-hotspot__tooltip--left.is-open { transform: translateY(-50%) translateX(0); }
  .section-hotspot__tooltip--right { left: calc(100% + 12px); top: 50%; transform: translateY(-50%) translateX(8px); }
  .section-hotspot__tooltip--right.is-open { transform: translateY(-50%) translateX(0); }

  .section-hotspot__tooltip-product {
    display: flex; gap: 0.75rem; padding: 0.75rem;
    text-decoration: none; color: inherit;
  }
  .section-hotspot__tooltip-img { width: 60px; height: 60px; border-radius: var(--media-radius); object-fit: cover; flex-shrink: 0; }
  .section-hotspot__tooltip-info { display: flex; flex-direction: column; gap: 0.25rem; justify-content: center; }
  .section-hotspot__tooltip-title { font-size: 0.8125rem; font-weight: 600; color: var(--color-ink); line-height: 1.3; }
  .section-hotspot__tooltip-price { font-size: 0.75rem; font-weight: 500; color: var(--color-ink); }

  .section-hotspot__tooltip-custom { padding: 0.875rem 1rem; display: flex; flex-direction: column; gap: 0.25rem; }
  .section-hotspot__tooltip-custom strong { font-size: 0.8125rem; font-weight: 600; color: var(--color-ink); }
  .section-hotspot__tooltip-custom span { font-size: 0.75rem; color: var(--color-muted); }
{% endstylesheet %}

