      "info": "t:sections.featured_countdown.settings.end_time.info"
    },
    {
      "type": "header",
      "content": "t:sections.featured_countdown.settings.button_header.content"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.featured_countdown.settings.button_label.label",
      "default": "Add to cart — Limited time!"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "t:sections.featured_countdown.settings.button_size.label",
      "options": [
        {
          "value": "md",
          "label": "M"
        },
        {
          "value": "lg",
          "label": "L"
        }
      ],
      "default": "lg"
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
