{{ 'section-product-recommendations.css' | asset_url | stylesheet_tag }}

{%- assign container_width = section.settings.container_width | default: 'fixed' -%}

<product-recommendations
  data-url="{{ routes.product_recommendations_url | default: '/recommendations/products' }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-limit="{{ section.settings.product_limit }}"
  data-intent="related"
  {% unless recommendations.performed and recommendations.products_count > 0 %}hidden{% endunless %}
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <section class="product-recommendations color-{{ section.settings.color_scheme }}" data-recommendation-products>
      <div class="{% if container_width == 'fixed' %}page-width{% endif %}">
        <h2 class="product-recommendations__heading global-heading">{{ section.settings.heading | escape }}</h2>
        <product-template-relate class="product-template__relate">
          <div class="product-template__relate-wrap swiper">
            <ul class="product-cards product-template__relate-grids swiper-wrapper">
              {%- for related_product in recommendations.products limit: section.settings.product_limit -%}
                <li class="product-cards__item swiper-slide">
                  {%- render 'product-card',
                    product: related_product,
                    lazyload: 'lazy',
                    fetchpriority: 'auto',
                    show_vendor: true,
                    image_ratio: section.settings.image_ratio,
                    sizes: '(max-width: 749px) 47vw, (max-width: 1023px) 30vw, 22vw'
                  -%}
                </li>
              {%- endfor -%}
            </ul>
            <button type="button" class="swiper-button-prev" aria-label="{{ 'accessibility.previous' | t }}"></button>
            <button type="button" class="swiper-button-next" aria-label="{{ 'accessibility.next' | t }}"></button>
          </div>
        </product-template-relate>
      </div>
    </section>
  {%- endif -%}
</product-recommendations>


{% schema %}
{
  "name": "t:sections.product_recommendations.name",
  "tag": "section",
  "class": "section-product-recommendations",
  "limit": 1,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "t:sections.all.container_width.label",
      "options": [
        {
          "value": "fixed",
          "label": "t:sections.all.container_width.options__fixed.label"
        },
        {
          "value": "full",
          "label": "t:sections.all.container_width.options__full.label"
        }
      ],
      "default": "fixed"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.product_recommendations.settings.heading.label",
      "default": "t:sections.product_recommendations.settings.heading.default"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "t:sections.product_recommendations.settings.product_limit.label",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.product_recommendations.settings.image_ratio.label",
      "options": [
        { "value": "adapt", "label": "t:sections.product_recommendations.settings.image_ratio.options__adapt.label" },
        { "value": "portrait", "label": "t:sections.product_recommendations.settings.image_ratio.options__portrait.label" },
        { "value": "square", "label": "t:sections.product_recommendations.settings.image_ratio.options__square.label" },
        { "value": "landscape", "label": "t:sections.product_recommendations.settings.image_ratio.options__landscape.label" }
      ],
      "default": "portrait"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
