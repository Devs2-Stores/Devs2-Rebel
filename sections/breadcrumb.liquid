{%- comment %}
  Breadcrumb Section — standalone, can be added to any page via JSON template.
  Auto-detects page type via `template` and renders appropriate breadcrumb trail.
  Structured data comes from snippets/head-meta-tags.liquid.
{% endcomment -%}

{%- liquid
  assign t_home = 'general.breadcrumbs.home' | t
  assign t_all_products = 'general.breadcrumbs.all_products' | t
  assign t_tags = 'general.breadcrumbs.tags' | t
  assign t_not_found = 'general.breadcrumbs.not_found' | t
  assign t_cart = 'general.breadcrumbs.cart' | t
  assign t_search = 'general.breadcrumbs.search' | t
  assign t_login = 'general.breadcrumbs.login' | t
  assign t_register = 'general.breadcrumbs.register' | t
  assign t_account = 'general.breadcrumbs.account' | t
-%}

{%- liquid
  case section.settings.font_size
    when 'xs'
      assign breadcrumb_font_size = 'var(--font-xs)'
    when 'base'
      assign breadcrumb_font_size = 'var(--font-base)'
    else
      assign breadcrumb_font_size = 'var(--meta-size, 0.8125rem)'
  endcase
  case section.settings.text_alignment
    when 'center'
      assign breadcrumb_justify = 'center'
    when 'right'
      assign breadcrumb_justify = 'flex-end'
    else
      assign breadcrumb_justify = 'flex-start'
  endcase
-%}

{%- unless template == 'index' -%}
<div class="section-breadcrumbs color-{{ section.settings.color_scheme }}" style="--breadcrumb-pt: {{ section.settings.padding_top }}px; --breadcrumb-pb: {{ section.settings.padding_bottom }}px; --breadcrumb-fs: {{ breadcrumb_font_size }}; --breadcrumb-justify: {{ breadcrumb_justify }};">
  <div class="{% if section.settings.container_width == 'fixed' %}page-width{% endif %}">
    <nav class="breadcrumb-nav" aria-label="{{ 'general.breadcrumbs.aria_label' | t }}">
      <ol class="breadcrumb">
        {%- comment %} Home {% endcomment -%}
        <li>
          <a href="{{ routes.root_url }}" class="breadcrumb__link" title="{{ t_home }}">
            <span class="breadcrumb__name">{{ t_home }}</span>
          </a>
        </li>

        {%- if template contains 'list-collections' -%}
        <li>
          <span class="breadcrumb__separator" aria-hidden="true">{{ section.settings.separator }}</span>
          <span class="breadcrumb__name">{{ page_title }}</span>
        </li>

        {%- elsif template contains 'collection' and collection -%}
        <li>
          <span class="breadcrumb__separator" aria-hidden="true">{{ section.settings.separator }}</span>
          <span class="breadcrumb__name">
            {%- if collection.handle == 'all' -%}{{ t_all_products }}{%- else -%}{{ collection.title | escape }}{%- endif -%}
          </span>
        </li>
        {%- if current_tags.size > 0 -%}
        <li>
          <span class="breadcrumb__separator" aria-hidden="true">{{ section.settings.separator }}</span>
          <span class="breadcrumb__name">{{ t_tags }}: <strong>{{ current_tags | join: ', ' }}</strong></span>
        </li>
        {%- endif -%}

        {%- elsif template contains 'product' and product -%}
        {%- liquid
          assign product_collection = product.collections | first
          assign bc_collection_title = t_all_products
          assign bc_collection_url = routes.all_products_collection_url | default: '/collections/all'
          if product_collection
            assign bc_collection_title = product_collection.title
            assign bc_collection_url = product_collection.url
          endif
        -%}
        <li>
          <span class="breadcrumb__separator" aria-hidden="true">{{ section.settings.separator }}</span>
          <a class="breadcrumb__link" href="{{ bc_collection_url }}">
            <span class="breadcrumb__name">{{ bc_collection_title | escape }}</span>
          </a>
        </li>
        <li>
          <span class="breadcrumb__separator" aria-hidden="true">{{ section.settings.separator }}</span>
          <span class="breadcrumb__name">{{ product.title | escape }}</span>
        </li>

        {%- elsif template contains 'blog' and blog -%}
        <li>
          <span class="breadcrumb__separator" aria-hidden="true">{{ section.settings.separator }}</span>
          <span class="breadcrumb__name">{{ blog.title | escape }}</span>
        </li>

        {%- elsif template contains 'article' and article -%}
        <li>
          <span class="breadcrumb__separator" aria-hidden="true">{{ section.settings.separator }}</span>
          <a href="{{ blog.url }}" class="breadcrumb__link">
            <span class="breadcrumb__name">{{ blog.title | escape }}</span>
          </a>
        </li>
        <li>
          <span class="breadcrumb__separator" aria-hidden="true">{{ section.settings.separator }}</span>
          <span class="breadcrumb__name">{{ article.title | escape }}</span>
        </li>

        {%- elsif template contains 'page' and page -%}
        <li>
          <span class="breadcrumb__separator" aria-hidden="true">{{ section.settings.separator }}</span>
          <span class="breadcrumb__name">{{ page.title | escape }}</span>
        </li>

        {%- elsif template contains 'cart' -%}
        <li>
          <span class="breadcrumb__separator" aria-hidden="true">{{ section.settings.separator }}</span>
          <span class="breadcrumb__name">{{ t_cart }}</span>
        </li>

        {%- elsif template contains 'search' -%}
        <li>
          <span class="breadcrumb__separator" aria-hidden="true">{{ section.settings.separator }}</span>
          <span class="breadcrumb__name">{{ t_search }}</span>
        </li>

        {%- elsif template contains '404' -%}
        <li>
          <span class="breadcrumb__separator" aria-hidden="true">{{ section.settings.separator }}</span>
          <span class="breadcrumb__name">{{ t_not_found }}</span>
        </li>

        {%- elsif template contains 'customers' -%}
        <li>
          <span class="breadcrumb__separator" aria-hidden="true">{{ section.settings.separator }}</span>
          <span class="breadcrumb__name">
            {%- if template contains 'login' -%}{{ t_login }}
            {%- elsif template contains 'register' -%}{{ t_register }}
            {%- else -%}{{ t_account }}
            {%- endif -%}
          </span>
        </li>
        {%- endif -%}
      </ol>
    </nav>
  </div>
</div>
{%- endunless -%}

{% stylesheet %}
/* Breadcrumb styles */
.section-breadcrumbs {
  padding-top: var(--breadcrumb-pt, 0);
  padding-bottom: var(--breadcrumb-pb, 0);
  color: var(--color-muted);
  font-size: var(--breadcrumb-fs, var(--meta-size, 0.8125rem));
  line-height: var(--line-height-normal);
}
.section-breadcrumbs .breadcrumb {
  display: flex;
  justify-content: var(--breadcrumb-justify, flex-start);
  flex-wrap: nowrap;
  min-width: 0;
  align-items: center;
  gap: 0;
  list-style: none;
  padding: 0;
  margin: 0;
}
.section-breadcrumbs .breadcrumb li {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  max-width: 45%;
  min-width: 0;
  white-space: nowrap;
  color: var(--color-muted);
}
.section-breadcrumbs .breadcrumb li:last-child {
  flex-shrink: 1;
  max-width: none;
  color: var(--color-ink);
  font-weight: var(--font-weight-medium);
}
.section-breadcrumbs .breadcrumb li > .breadcrumb__name,
.section-breadcrumbs .breadcrumb__link,
.section-breadcrumbs .breadcrumb__link > .breadcrumb__name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}
.section-breadcrumbs .breadcrumb__link {
  display: inline-flex;
  align-items: center;
  min-height: 1.5rem;
  color: var(--color-muted);
  text-decoration: none;
  transition: color var(--transition-fast);
}
.section-breadcrumbs .breadcrumb__link:hover {
  color: var(--color-ink);
  text-decoration: underline;
  text-underline-offset: 3px;
}
.section-breadcrumbs .breadcrumb__separator {
  flex-shrink: 0;
  margin: 0 var(--space-xs);
  color: var(--color-muted);
}
@media (min-width: 750px) {
  .section-breadcrumbs .breadcrumb__separator {
    margin: 0 var(--space-sm);
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.breadcrumb.name",
  "tag": "section",
  "class": "section-breadcrumb",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "t:sections.all.container_width.label",
      "options": [
        {
          "value": "full",
          "label": "t:sections.all.container_width.options__full.label"
        },
        {
          "value": "fixed",
          "label": "t:sections.all.container_width.options__fixed.label"
        }
      ],
      "default": "fixed"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:sections.all.text_alignment.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.text_alignment.options__left.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.text_alignment.options__center.label"
        },
        {
          "value": "right",
          "label": "t:sections.all.text_alignment.options__right.label"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "font_size",
      "label": "t:sections.breadcrumb.settings.font_size.label",
      "options": [
        {
          "value": "xs",
          "label": "t:sections.breadcrumb.settings.font_size.options__xs.label"
        },
        {
          "value": "sm",
          "label": "t:sections.breadcrumb.settings.font_size.options__sm.label"
        },
        {
          "value": "base",
          "label": "t:sections.breadcrumb.settings.font_size.options__base.label"
        }
      ],
      "default": "sm"
    },
    {
      "type": "text",
      "id": "separator",
      "label": "t:sections.breadcrumb.settings.separator.label",
      "default": "/"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.all.padding_top.label",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.all.padding_bottom.label",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    }
  ]
}
{% endschema %}
