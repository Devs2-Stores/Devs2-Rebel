{{ 'section-trust-badges.css' | asset_url | stylesheet_tag }}
{%- comment %}
  Section: Trust Badges Bar
{% endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-trust color-{{ section.settings.color_scheme }}"
  style="
    --tr-dt: {{ section.settings.padding_top_desktop }}px;
    --tr-db: {{ section.settings.padding_bottom_desktop }}px;
    --tr-mt: {{ section.settings.padding_top_mobile }}px;
    --tr-mb: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="{% if section.settings.section_width == 'fixed' %}page-width{% endif %}">
    <div class="section-trust__grid section-trust__grid--{{ section.settings.layout }}">
      {%- for block in section.blocks -%}
        <div class="section-trust__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            <div class="section-trust__icon">
              {{ block.settings.icon | image_url: width: 48 | image_tag: loading: 'lazy' }}
            </div>
          {%- elsif block.settings.line_icon != blank and block.settings.line_icon != 'none' -%}
            <span class="section-trust__line-icon">{%- render 'icon-feature', name: block.settings.line_icon -%}</span>
          {%- elsif block.settings.emoji != blank -%}
            <span class="section-trust__emoji" aria-hidden="true">{{ block.settings.emoji }}</span>
          {%- endif -%}
          <div class="section-trust__text-wrap">
            {%- if block.settings.heading != blank -%}
              <span class="section-trust__title">{{ block.settings.heading }}</span>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <span class="section-trust__desc">{{ block.settings.text }}</span>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>


{% schema %}
{
  "name": "t:sections.trust_badges.name",
  "tag": "section",
  "class": "section-trust-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.trust_badges.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.trust_badges.settings.layout.label",
      "options": [
        {
          "value": "inline",
          "label": "t:sections.trust_badges.settings.layout.options.inline"
        },
        {
          "value": "centered",
          "label": "t:sections.trust_badges.settings.layout.options.centered"
        }
      ],
      "default": "inline"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:sections.trust_badges.settings.section_width.label",
      "options": [
        {
          "value": "fixed",
          "label": "t:sections.trust_badges.settings.section_width.options.fixed"
        },
        {
          "value": "full",
          "label": "t:sections.trust_badges.settings.section_width.options.full"
        }
      ],
      "default": "fixed"
    },
    {
      "type": "header",
      "content": "t:sections.trust_badges.settings.header__desktop_spacing.content"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "t:sections.trust_badges.settings.padding_top_desktop.label",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "t:sections.trust_badges.settings.padding_bottom_desktop.label",
      "default": 15
    },
    {
      "type": "header",
      "content": "t:sections.trust_badges.settings.header__mobile_spacing.content"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 40,
      "step": 5,
      "unit": "px",
      "label": "t:sections.trust_badges.settings.padding_top_mobile.label",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 40,
      "step": 5,
      "unit": "px",
      "label": "t:sections.trust_badges.settings.padding_bottom_mobile.label",
      "default": 10
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "t:sections.trust_badges.blocks.badge.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "t:sections.trust_badges.blocks.badge.settings.icon.label"
        },
        {
          "type": "select",
          "id": "line_icon",
          "label": "t:sections.all.line_icon.label",
          "info": "t:sections.all.line_icon.info",
          "options": [
            { "value": "none", "label": "t:sections.all.line_icon.options.none" },
            { "value": "truck", "label": "t:sections.all.line_icon.options.truck" },
            { "value": "package", "label": "t:sections.all.line_icon.options.package" },
            { "value": "rotate-ccw", "label": "t:sections.all.line_icon.options.rotate_ccw" },
            { "value": "shield-check", "label": "t:sections.all.line_icon.options.shield_check" },
            { "value": "lock", "label": "t:sections.all.line_icon.options.lock" },
            { "value": "message-circle", "label": "t:sections.all.line_icon.options.message_circle" },
            { "value": "gift", "label": "t:sections.all.line_icon.options.gift" },
            { "value": "star", "label": "t:sections.all.line_icon.options.star" },
            { "value": "sparkles", "label": "t:sections.all.line_icon.options.sparkles" },
            { "value": "sun", "label": "t:sections.all.line_icon.options.sun" },
            { "value": "scissors", "label": "t:sections.all.line_icon.options.scissors" },
            { "value": "ruler", "label": "t:sections.all.line_icon.options.ruler" },
            { "value": "award", "label": "t:sections.all.line_icon.options.award" },
            { "value": "clock", "label": "t:sections.all.line_icon.options.clock" },
            { "value": "leaf", "label": "t:sections.all.line_icon.options.leaf" },
            { "value": "sprout", "label": "t:sections.all.line_icon.options.sprout" },
            { "value": "droplet", "label": "t:sections.all.line_icon.options.droplet" },
            { "value": "flask-conical", "label": "t:sections.all.line_icon.options.flask_conical" },
            { "value": "recycle", "label": "t:sections.all.line_icon.options.recycle" },
            { "value": "rabbit", "label": "t:sections.all.line_icon.options.rabbit" },
            { "value": "heart", "label": "t:sections.all.line_icon.options.heart" }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "emoji",
          "label": "t:sections.trust_badges.blocks.badge.settings.emoji.label",
          "info": "t:sections.trust_badges.blocks.badge.settings.emoji.info"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.trust_badges.blocks.badge.settings.heading.label",
          "default": "t:sections.trust_badges.blocks.badge.settings.heading.default"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.trust_badges.blocks.badge.settings.text.label",
          "default": "t:sections.trust_badges.blocks.badge.settings.text.default"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.trust_badges.presets.trust_badges.name",
      "category": "t:categories.storytelling",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "line_icon": "truck",
            "heading": "Free Shipping",
            "text": "On orders over $50"
          }
        },
        {
          "type": "badge",
          "settings": {
            "line_icon": "lock",
            "heading": "Secure Payment",
            "text": "SSL encrypted checkout"
          }
        },
        {
          "type": "badge",
          "settings": {
            "line_icon": "rotate-ccw",
            "heading": "Easy Returns",
            "text": "30-day return policy"
          }
        },
        {
          "type": "badge",
          "settings": {
            "line_icon": "message-circle",
            "heading": "24/7 Support",
            "text": "We're here to help"
          }
        }
      ]
    }
  ]
}
{% endschema %}
