{{ 'section-testimonials.css' | asset_url | stylesheet_tag }}
{%- comment %}
  Section: Testimonials
{% endcomment -%}

{%- liquid
  assign layout = section.settings.layout
  assign block_count = section.blocks | where: 'type', 'testimonial' | size
-%}

<div
  id="section-{{ section.id }}"
  class="section-testimonials color-{{ section.settings.color_scheme }}"
  style="
    --tm-dt: {{ section.settings.padding_top_desktop }}px;
    --tm-db: {{ section.settings.padding_bottom_desktop }}px;
    --tm-mt: {{ section.settings.padding_top_mobile }}px;
    --tm-mb: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-testimonials__head">
        {%- if section.settings.subheading != blank -%}
          <p class="section-testimonials__subheading subheading-size-{{ section.settings.subheading_size }}">
            {{- section.settings.subheading -}}
          </p>
        {%- endif -%}
        <{{ section.settings.heading_tag }}
          class="section-testimonials__heading heading-size-{{ section.settings.heading_size }}"
        >
          {{- section.settings.heading -}}
        </{{ section.settings.heading_tag }}>
      </div>
    {%- endif -%}

    {%- if block_count > 0 -%}
      {%- if layout == 'slider' -%}
        <div class="section-testimonials__slider">
          <div class="section-testimonials__swiper swiper" data-tm-slider>
            <div class="swiper-wrapper">
              {%- for block in section.blocks -%}
                <div class="swiper-slide" {{ block.shopify_attributes }}>
                  {%- render 'testimonial-card', block: block -%}
                </div>
              {%- endfor -%}
            </div>
          </div>
          <div class="section-testimonials__pagination"></div>
        </div>
      {%- else -%}
        <div class="section-testimonials__grid" style="--tm-cols: {{ section.settings.columns_desktop }};">
          {%- for block in section.blocks -%}
            <div {{ block.shopify_attributes }}>
              {%- render 'testimonial-card', block: block -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{%- if layout == 'slider' and block_count > 1 -%}
<script>
  (function() {
    var w = document.getElementById('section-{{ section.id }}');
    if (!w) return;
    var el = w.querySelector('[data-tm-slider]');
    if (!el) return;
    var initialized = false;
    var initialize = function() {
      if (initialized) return;
      initialized = true;
      (window.swiperReady || function(cb){ cb(); })(function(){
     new Swiper(el, {
          slidesPerView: 1,
          spaceBetween: 16,
          speed: 600,
          breakpoints: {
            750: { slidesPerView: 2, spaceBetween: 20 },
            1024: { slidesPerView: {{ section.settings.columns_desktop | at_most: 3 }}, spaceBetween: 24 }
          },
       pagination: {
         el: w.querySelector('.section-testimonials__pagination'),
         clickable: true,
         renderBullet: function(index, className) {
           return '<button type="button" class="' + className + '" aria-label="' + {{ 'sections.testimonials.settings.pagination_label' | t | json }} + ' ' + (index + 1) + '"></button>';
         }
       }
        });
      });
    };
    if (!('IntersectionObserver' in window)) {
      initialize();
      return;
    }
    var observer = new IntersectionObserver(function(entries) {
      if (!entries[0].isIntersecting) return;
      observer.disconnect();
      initialize();
    }, { rootMargin: '300px 0px' });
    observer.observe(w);
  })();
</script>
{%- endif -%}


