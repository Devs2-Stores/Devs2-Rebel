{%- comment -%}
  Section: Testimonials
  Mô tả: Đánh giá khách hàng — slider hoặc grid. Avatar + stars + quote.
{%- endcomment -%}

{%- liquid
  assign layout = section.settings.layout
  assign block_count = section.blocks.size
-%}

<div
  id="section-{{ section.id }}"
  class="section-testimonials color-{{ section.settings.color_scheme }}"
  style="
    --tm-dt: {{ section.settings.padding_top_desktop }}px;
    --tm-db: {{ section.settings.padding_bottom_desktop }}px;
    --tm-mt: {{ section.settings.padding_top_mobile }}px;
    --tm-mb: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-testimonials__head">
        {%- if section.settings.subheading != blank -%}
          <p class="section-testimonials__subheading subheading-size-{{ section.settings.subheading_size }}">
            {{- section.settings.subheading -}}
          </p>
        {%- endif -%}
        <{{ section.settings.heading_tag }}
          class="section-testimonials__heading heading-size-{{ section.settings.heading_size }}"
        >
          {{- section.settings.heading -}}
        </{{ section.settings.heading_tag }}>
      </div>
    {%- endif -%}

    {%- if block_count > 0 -%}
      {%- if layout == 'slider' -%}
        <div class="section-testimonials__slider">
          <div class="section-testimonials__swiper swiper" data-tm-slider>
            <div class="swiper-wrapper">
              {%- for block in section.blocks -%}
                <div class="swiper-slide" {{ block.shopify_attributes }}>
                  {%- render 'testimonial-card', block: block -%}
                </div>
              {%- endfor -%}
            </div>
          </div>
          <div class="section-testimonials__pagination"></div>
        </div>
      {%- else -%}
        <div class="section-testimonials__grid" style="--tm-cols: {{ section.settings.columns_desktop }};">
          {%- for block in section.blocks -%}
            <div {{ block.shopify_attributes }}>
              {%- render 'testimonial-card', block: block -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{%- if layout == 'slider' and block_count > 1 -%}
<script>
  (function() {
    var w = document.getElementById('section-{{ section.id }}');
    if (!w) return;
    var el = w.querySelector('[data-tm-slider]');
    if (!el) return;
    (window.swiperReady || function(cb){ cb(); })(function(){
    new Swiper(el, {
      slidesPerView: 1,
      spaceBetween: 16,
      speed: 600,
      breakpoints: {
        750: { slidesPerView: 2, spaceBetween: 20 },
        1024: { slidesPerView: {{ section.settings.columns_desktop | at_most: 3 }}, spaceBetween: 24 }
      },
      pagination: {
        el: w.querySelector('.section-testimonials__pagination'),
        clickable: true
      }
    });
    });
  })();
</script>
{%- endif -%}

{% stylesheet %}
  .section-testimonials {
    padding-block: var(--tm-mt) var(--tm-mb);
    background: rgb(var(--color-background));
    color: rgba(var(--color-foreground), 0.85);
  }
  @media (min-width: 750px) {
    .section-testimonials { padding-block: var(--tm-dt) var(--tm-db); }
  }
  .section-testimonials__head { text-align: center; margin-bottom: 2.5rem; }
  .section-testimonials__subheading {
    margin: 0 0 0.25rem; text-transform: uppercase;
    letter-spacing: 0.12em; color: rgb(var(--color-accent)); font-weight: 600;
  }
  .section-testimonials__heading { margin: 0; color: rgb(var(--color-foreground)); }

  .section-testimonials__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 750px) {
    .section-testimonials__grid {
      grid-template-columns: repeat(var(--tm-cols, 3), 1fr);
      gap: 2rem;
    }
  }

  .section-testimonials__slider { position: relative; }
  .section-testimonials__swiper { overflow: hidden; }
  .section-testimonials__pagination {
    display: flex; justify-content: center; gap: 6px; margin-top: 1.5rem;
  }
  .section-testimonials__pagination .swiper-pagination-bullet {
    width: 8px; height: 8px; border-radius: 50%;
    background: rgba(var(--color-foreground), 0.2); opacity: 1;
    transition: background 0.3s, transform 0.3s; cursor: pointer;
  }
  .section-testimonials__pagination .swiper-pagination-bullet-active {
    background: rgb(var(--color-accent)); transform: scale(1.3);
  }

  /* ── Card (inline — also used by snippet) ── */
  .testimonial-card {
    background: rgba(var(--color-foreground), 0.03);
    border: 1px solid rgba(var(--color-foreground), 0.08);
    border-radius: 0.75rem;
    padding: 1.5rem;
    display: flex; flex-direction: column; gap: 1rem;
    height: 100%;
  }
  .testimonial-card__stars { display: flex; gap: 2px; color: #f59e0b; }
  .testimonial-card__stars svg { width: 16px; height: 16px; }
  .testimonial-card__quote {
    flex: 1; font-style: italic;
    color: rgba(var(--color-foreground), 0.8); line-height: 1.7;
  }
  .testimonial-card__quote p { margin: 0; }
  .testimonial-card__author {
    display: flex; align-items: center; gap: 0.75rem;
    padding-top: 0.75rem; border-top: 1px solid rgba(var(--color-foreground), 0.06);
  }
  .testimonial-card__avatar {
    width: 40px; height: 40px; border-radius: 50%; object-fit: cover;
    background: rgba(var(--color-foreground), 0.08);
  }
  .testimonial-card__avatar-placeholder {
    width: 40px; height: 40px; border-radius: 50%;
    background: rgba(var(--color-foreground), 0.08);
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 0.875rem; color: rgba(var(--color-foreground), 0.4);
  }
  .testimonial-card__name { font-weight: 600; font-size: 0.875rem; color: rgb(var(--color-foreground)); }
  .testimonial-card__title { font-size: 0.75rem; color: rgba(var(--color-foreground), 0.5); }
{% endstylesheet %}

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "section-testimonials-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
