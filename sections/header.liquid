<script src="{{ 'header.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign transparent_here = false
  case request.page_type
    when 'index'
      assign transparent_here = section.settings.transparent_home
    when 'collection'
      assign transparent_here = section.settings.transparent_collection
    when 'product'
      assign transparent_here = section.settings.transparent_product
  endcase

  assign show_country = false
  if section.settings.show_country_selector and localization.available_countries.size > 1
    assign show_country = true
  endif
  assign show_language = false
  if section.settings.show_language_selector and localization.available_languages.size > 1
    assign show_language = true
  endif

  assign clear_text = section.settings.transparent_text_color | default: '#FFFFFF'
  assign clear_scrim = section.settings.transparent_scrim_color | default: '#000000'
  assign clear_logo = section.settings.transparent_logo
-%}
<script>(function(){var bar=document.querySelector('.announcement-bar-section');document.documentElement.style.setProperty('--announcement-height',(bar?bar.getBoundingClientRect().height:0)+'px');})();</script>
<global-header
  class="header color-{{ section.settings.color_scheme }}"
  data-sticky="{{ section.settings.sticky_mode }}"
  {%- if transparent_here %}
  data-transparent
  style="--header-clear-fg: {{ clear_text | color_extract: 'red' }}, {{ clear_text | color_extract: 'green' }}, {{ clear_text | color_extract: 'blue' }}; --header-clear-scrim: {{ clear_scrim | color_extract: 'red' }}, {{ clear_scrim | color_extract: 'green' }}, {{ clear_scrim | color_extract: 'blue' }};"
  {%- endif %}
>
  <div class="page-width">
    <div class="header__wrapper header__wrapper--logo-{{ section.settings.logo_position }} header__wrapper--menu-{{ section.settings.menu_placement }}">
      <button type="button" class="header__hamburger" data-action="open-mobile-menu" aria-label="{{ 'accessibility.open_menu' | t }}">
        {%- render 'icon', name: 'hamburger' -%}
      </button>
      <div class="header__logo">
        <a href="{{ routes.root_url }}" class="header__logo-link" title="{{ shop.name }}" aria-label="{{ shop.name }}">
          {%- if settings.logo != blank -%}
          {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
          {{ settings.logo | image_url: width: 300 | image_tag:
            alt: logo_alt,
            width: settings.logo_width,
            loading: 'eager',
            fetchpriority: 'high',
            class: 'header__logo-image header__logo-image--solid'
          }}
          {%- if transparent_here and clear_logo != blank -%}
          {{ clear_logo | image_url: width: 300 | image_tag:
            alt: '',
            width: settings.logo_width,
            loading: 'eager',
            class: 'header__logo-image header__logo-image--clear'
          }}
          {%- endif -%}
          {%- else -%}
          <span class="header__logo-text">{{ shop.name }}</span>
          {%- endif -%}
        </a>
      </div>
      <div class="header__menu">
        {%- render 'megamenu', menu: section.settings.menu -%}
      </div>
      <div class="header__actions">
        {%- if show_country or show_language -%}
          <div class="header__localization">
            {%- if show_country -%}
              {%- render 'localization-selector', kind: 'country', form_id: 'HeaderCountryForm', variant: 'dropdown' -%}
            {%- endif -%}
            {%- if show_language -%}
              {%- render 'localization-selector', kind: 'language', form_id: 'HeaderLanguageForm', variant: 'dropdown' -%}
            {%- endif -%}
          </div>
        {%- endif -%}
        <button type="button" class="header__action-btn" data-action="open-search-modal" aria-label="{{ 'accessibility.search' | t }}">
          {%- render 'icon', name: 'search' -%}
        </button>
        {%- if shop.customer_accounts_enabled -%}
          <shopify-account menu="{{ section.settings.customer_account_menu }}">
            <span slot="signed-out-avatar" class="header__action-btn">
              {%- render 'icon', name: 'user' -%}
            </span>
          </shopify-account>
        {%- else -%}
          <a href="{{ routes.account_url }}" class="header__action-btn" aria-label="{{ 'accessibility.account' | t }}">
            {%- render 'icon', name: 'user' -%}
          </a>
        {%- endif -%}
        <a href="{{ routes.cart_url }}" class="header__action-btn header__cart-btn"{% unless settings.cart_mode == 'page' %} data-action="open-cart-sidebar"{% endunless %}>
          <span class="visually-hidden">{{ 'accessibility.open_cart' | t }}</span>
          {%- render 'icon', name: 'cart' -%}
          <span class="cart-count" data-cart-count aria-live="polite" aria-atomic="true"{% if cart.item_count == 0 %} data-empty{% endif %}>{{ cart.item_count }}</span>
        </a>
      </div>
    </div>
  </div>
</global-header>
{%- render 'mobile-menu',
  menu_handle: section.settings.menu,
  customer_account_menu: section.settings.customer_account_menu,
  show_country: show_country,
  show_language: show_language
-%}

{% stylesheet %}
global-header {
  display: block;
  background: var(--header-bg, var(--color-bg));
  color: var(--header-text, var(--color-ink));
  border-bottom: 1px solid var(--color-hairline);
  transition: background-color var(--transition-fast), border-color var(--transition-fast), transform var(--transition-base);
}
global-header[data-hidden] {
  transform: translateY(-100%);
}
.shopify-section[data-sticky-header-section] {
  position: sticky;
  top: 0;
  z-index: var(--z-header, 49);
}
global-header .header__wrapper {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: var(--space-sm);
  min-height: 3.75rem;
  padding: var(--space-xs) 0;
}
@media (min-width: 1024px) {
  global-header .header__wrapper {
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'logo menu actions';
    gap: var(--space-4xl);
    min-height: 4.5rem;
    padding: 0;
  }
  global-header .header__wrapper--logo-center {
    grid-template-columns: 1fr auto 1fr;
    grid-template-areas: 'menu logo actions';
  }
  global-header .header__wrapper--menu-below {
    grid-template-columns: auto 1fr;
    grid-template-areas: 'logo actions' 'menu menu';
    gap: 0 var(--space-4xl);
    min-height: 0;
    padding: var(--space-xs) 0;
  }
  global-header .header__wrapper--menu-below.header__wrapper--logo-center {
    grid-template-columns: 1fr auto 1fr;
    grid-template-areas: '. logo actions' 'menu menu menu';
  }
  global-header .header__logo { grid-area: logo; }
  global-header .header__menu { grid-area: menu; }
  global-header .header__actions { grid-area: actions; }
}
@media (min-width: 1200px) {
  global-header .header__wrapper {
    gap: var(--space-5xl);
  }
  global-header .header__wrapper--menu-below {
    gap: 0 var(--space-5xl);
  }
}
global-header .header__logo {
  display: flex;
  align-items: center;
  justify-content: center;
}
@media (min-width: 1024px) {
  global-header .header__logo {
    justify-content: flex-start;
  }
  global-header .header__wrapper--logo-center .header__logo {
    justify-content: center;
  }
}
global-header .header__logo .header__logo-link {
  display: inline-flex;
  align-items: center;
  min-height: 2.5rem;
  text-decoration: none;
  color: var(--color-ink);
}
global-header .header__logo .header__logo-image {
  display: block;
  max-width: 100%;
  height: auto;
}
global-header .header__logo .header__logo-image--clear {
  display: none;
}
global-header .header__logo .header__logo-text {
  font-family: var(--font-heading-family);
  font-size: 1.1875rem;
  font-weight: var(--font-weight-semibold);
  letter-spacing: var(--heading-tracking, -0.02em);
  line-height: 1;
  text-align: center;
  text-wrap: balance;
  overflow-wrap: anywhere;
}
@media (min-width: 1024px) {
  global-header .header__logo .header__logo-text {
    font-size: 1.3125rem;
    white-space: nowrap;
  }
}
global-header .header__menu {
  display: none;
}
@media (min-width: 1024px) {
  global-header .header__menu {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    min-width: 0;
  }
  global-header .header__wrapper--logo-center .header__menu {
    justify-content: flex-start;
  }
  global-header .header__wrapper--menu-below.header__wrapper--logo-center .header__menu {
    justify-content: center;
  }
  global-header .header__wrapper--menu-below.header__wrapper--logo-center .megamenu__list {
    width: max-content;
    margin-inline: auto;
  }
}
global-header .header__actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: var(--space-2xs);
  margin-left: auto;
}
@media (min-width: 1024px) {
  global-header .header__actions {
    gap: var(--space-xs);
  }
}
global-header .header__localization {
  display: none;
}
@media (min-width: 1024px) {
  global-header .header__localization {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }
}
global-header .header__actions .header__action-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2.5rem;
  height: 2.5rem;
  padding: 0;
  background: transparent;
  border: none;
  border-radius: var(--buttons-radius);
  color: var(--color-ink);
  cursor: pointer;
  transition: color var(--transition-fast), background-color var(--transition-fast);
  position: relative;
  text-decoration: none;
}
global-header .header__actions .header__action-btn svg {
  width: 1.25rem;
  height: 1.25rem;
}
global-header .header__actions .header__action-btn:hover {
  color: var(--color-ink);
  background: var(--color-gray-light);
}
global-header .header__actions .header__action-btn:focus-visible,
global-header .header__hamburger:focus-visible,
shopify-account:focus-visible,
shopify-account:focus-within {
  outline: 2px solid var(--color-focus);
  outline-offset: 2px;
}
shopify-account {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
global-header .header__actions .header__cart-btn .cart-count {
  position: absolute;
  top: 0.2rem;
  right: 0.15rem;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 1.125rem;
  height: 1.125rem;
  padding: 0 0.25rem;
  background: var(--color-primary);
  color: rgb(var(--color-button-text));
  font-size: 0.75rem;
  font-weight: var(--font-weight-semibold);
  border-radius: var(--radius-full);
  line-height: 1;
}
global-header .header__actions .header__cart-btn .cart-count[data-empty] {
  opacity: 0;
  transform: scale(0.5);
}
global-header .header__hamburger {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2.5rem;
  height: 2.5rem;
  padding: 0;
  background: transparent;
  border: none;
  border-radius: var(--buttons-radius);
  color: var(--color-ink);
  cursor: pointer;
  justify-self: start;
}
@media (min-width: 1024px) {
  global-header .header__hamburger {
    display: none;
  }
}
global-header .header__hamburger svg {
  width: 1.25rem;
  height: 1.25rem;
}
body:has(main > :is(.shopify-section:first-child, h1:first-child + .shopify-section):is(.section-slideshow-wrapper, .section-hero-wrapper, .section-ito-wrapper, .section-video-wrapper, .section-parallax-wrapper)):has(global-header[data-transparent]) {
  & main {
    margin-block-start: calc(-1 * var(--announcement-height, 0px));
  }
  & .announcement-bar-section {
    position: relative;
    z-index: calc(var(--z-header, 49) - 1);
  }
  & .section-header:not([data-sticky-header-section]) {
    position: relative;
    z-index: var(--z-header, 49);
  }
  & global-header {
    position: absolute;
    inset-inline: 0;
    top: 0;
    isolation: isolate;
  }
  & global-header::before {
    content: '';
    position: absolute;
    inset: 0 0 calc(-1 * var(--space-lg)) 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0;
    background: linear-gradient(
      to bottom,
      rgba(var(--header-clear-scrim), 0.6) calc(100% - var(--space-lg)),
      rgba(var(--header-clear-scrim), 0)
    );
    transition: opacity var(--transition-fast);
  }
  & global-header:not([data-solid]):not(:focus-within) {
    --color-foreground: var(--header-clear-fg);
    --color-border-rgb: var(--header-clear-fg);
    background: transparent;
    border-bottom-color: transparent;
  }
  & global-header:not([data-solid]):not(:focus-within)::before {
    opacity: 1;
  }
  & global-header:not([data-solid]):not(:focus-within) .header__logo-link:has(.header__logo-image--clear) .header__logo-image--solid {
    display: none;
  }
  & global-header:not([data-solid]):not(:focus-within) .header__logo-image--clear {
    display: block;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.header.name",
  "tag": "header",
  "class": "section-header",
  "limit": 1,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.header.settings.header__layout.content"
    },
    {
      "type": "select",
      "id": "logo_position",
      "label": "t:sections.header.settings.logo_position.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.header.settings.logo_position.options__left.label"
        },
        {
          "value": "center",
          "label": "t:sections.header.settings.logo_position.options__center.label"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "menu_placement",
      "label": "t:sections.header.settings.menu_placement.label",
      "info": "t:sections.header.settings.menu_placement.info",
      "options": [
        {
          "value": "inline",
          "label": "t:sections.header.settings.menu_placement.options__inline.label"
        },
        {
          "value": "below",
          "label": "t:sections.header.settings.menu_placement.options__below.label"
        }
      ],
      "default": "inline"
    },
    {
      "type": "header",
      "content": "t:sections.header.settings.header__menu.content"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:sections.header.settings.menu.label",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "t:sections.header.settings.header__account.content"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:sections.header.settings.customer_account_menu.label",
      "default": "customer-account-main-menu"
    },
    {
      "type": "header",
      "content": "t:sections.header.settings.header__localization.content"
    },
    {
      "type": "checkbox",
      "id": "show_country_selector",
      "label": "t:sections.header.settings.show_country_selector.label",
      "info": "t:sections.header.settings.show_country_selector.info",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_language_selector",
      "label": "t:sections.header.settings.show_language_selector.label",
      "info": "t:sections.header.settings.show_language_selector.info",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.header.settings.header__behavior.content"
    },
    {
      "type": "select",
      "id": "sticky_mode",
      "label": "t:sections.header.settings.sticky_mode.label",
      "options": [
        {
          "value": "always",
          "label": "t:sections.header.settings.sticky_mode.options__always.label"
        },
        {
          "value": "scroll-up",
          "label": "t:sections.header.settings.sticky_mode.options__scroll_up.label"
        },
        {
          "value": "never",
          "label": "t:sections.header.settings.sticky_mode.options__never.label"
        }
      ],
      "default": "always"
    },
    {
      "type": "header",
      "content": "t:sections.header.settings.header__transparent.content"
    },
    {
      "type": "checkbox",
      "id": "transparent_home",
      "label": "t:sections.header.settings.transparent_home.label",
      "info": "t:sections.header.settings.transparent_home.info",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "transparent_collection",
      "label": "t:sections.header.settings.transparent_collection.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "transparent_product",
      "label": "t:sections.header.settings.transparent_product.label",
      "default": false
    },
    {
      "type": "color",
      "id": "transparent_text_color",
      "label": "t:sections.header.settings.transparent_text_color.label",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "transparent_scrim_color",
      "label": "t:sections.header.settings.transparent_scrim_color.label",
      "info": "t:sections.header.settings.transparent_scrim_color.info",
      "default": "#000000"
    },
    {
      "type": "image_picker",
      "id": "transparent_logo",
      "label": "t:sections.header.settings.transparent_logo.label",
      "info": "t:sections.header.settings.transparent_logo.info"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
