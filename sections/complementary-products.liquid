{{ 'section-complementary-products.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-card.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-recommendations.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign container_width = section.settings.container_width | default: 'fixed'
  assign picked_count = 0
  for item in section.settings.product_list
    unless item.id == product.id
      assign picked_count = picked_count | plus: 1
    endunless
  endfor
  assign has_products = false
  if picked_count > 0
    assign source_products = section.settings.product_list
    assign has_products = true
  elsif recommendations.performed and recommendations.products_count > 0
    assign source_products = recommendations.products
    assign has_products = true
  endif
-%}

<product-recommendations
  data-url="{{ routes.product_recommendations_url | default: '/recommendations/products' }}"
  data-section-id="{{ section.id }}"
  data-product-id="{% if picked_count == 0 %}{{ product.id }}{% endif %}"
  data-limit="{{ section.settings.product_limit }}"
  data-intent="complementary"
  {% unless has_products %}hidden{% endunless %}
>
  {%- if has_products -%}
    <div class="complementary-products" data-recommendation-products>
      <div class="{% if container_width == 'fixed' %}page-width{% endif %}">
        {%- if section.settings.heading != blank -%}
          <h2 class="complementary-products__heading global-heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        <div class="complementary-products__grid">
          <ul class="product-cards complementary-products__list" role="list">
            {%- assign shown = 0 -%}
            {%- for item in source_products -%}
              {%- if item.id == product.id -%}{%- continue -%}{%- endif -%}
              {%- if shown >= section.settings.product_limit -%}{%- break -%}{%- endif -%}
              {%- assign shown = shown | plus: 1 -%}
              <li class="product-cards__item" role="listitem">
                {%- render 'product-card', product: item, lazyload: 'lazy', fetchpriority: 'auto', show_vendor: true -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      </div>
    </div>
  {%- endif -%}
</product-recommendations>


{% schema %}
{
  "name": "t:sections.complementary_products.name",
  "tag": "section",
  "class": "section-complementary-products",
  "limit": 1,
  "settings": [
    {
      "type": "select",
      "id": "container_width",
      "label": "t:sections.all.container_width.label",
      "options": [
        {
          "value": "fixed",
          "label": "t:sections.all.container_width.options__fixed.label"
        },
        {
          "value": "full",
          "label": "t:sections.all.container_width.options__full.label"
        }
      ],
      "default": "fixed"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.complementary_products.settings.heading.label",
      "default": "t:sections.complementary_products.settings.heading.default"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "t:sections.complementary_products.settings.max_products.label",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "t:sections.complementary_products.settings.products.label",
      "info": "t:sections.complementary_products.settings.products.info",
      "limit": 10
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
