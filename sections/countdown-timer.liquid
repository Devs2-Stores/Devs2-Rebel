{%- comment -%}
  Section: Countdown Timer
  Mô tả: Đếm ngược tới ngày/giờ target. Dùng cho campaign, flash sale.
{%- endcomment -%}

<div
  id="section-{{ section.id }}"
  class="section-countdown color-{{ section.settings.color_scheme }}"
  style="
    --cd-dt: {{ section.settings.padding_top_desktop }}px;
    --cd-db: {{ section.settings.padding_bottom_desktop }}px;
    --cd-mt: {{ section.settings.padding_top_mobile }}px;
    --cd-mb: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="page-width">
    <div class="section-countdown__inner section-countdown__inner--{{ section.settings.text_align }}">
      {%- if section.settings.subheading != blank -%}
        <p class="section-countdown__subheading subheading-size-{{ section.settings.subheading_size }}">
          {{- section.settings.subheading -}}
        </p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <{{ section.settings.heading_tag }}
          class="section-countdown__heading heading-size-{{ section.settings.heading_size }}"
        >
          {{- section.settings.heading -}}
        </{{ section.settings.heading_tag }}>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="section-countdown__desc content-size-{{ section.settings.description_size }}">
          {{- section.settings.description -}}
        </div>
      {%- endif -%}

      <div class="section-countdown__timer" data-countdown data-target="{{ section.settings.target_date }}T{{ section.settings.target_time }}">
        <div class="section-countdown__unit">
          <span class="section-countdown__value" data-cd-days>00</span>
          <span class="section-countdown__label">{{ 'general.countdown.days' | t | default: 'Days' }}</span>
        </div>
        <span class="section-countdown__sep">:</span>
        <div class="section-countdown__unit">
          <span class="section-countdown__value" data-cd-hours>00</span>
          <span class="section-countdown__label">{{ 'general.countdown.hours' | t | default: 'Hours' }}</span>
        </div>
        <span class="section-countdown__sep">:</span>
        <div class="section-countdown__unit">
          <span class="section-countdown__value" data-cd-mins>00</span>
          <span class="section-countdown__label">{{ 'general.countdown.minutes' | t | default: 'Minutes' }}</span>
        </div>
        <span class="section-countdown__sep">:</span>
        <div class="section-countdown__unit">
          <span class="section-countdown__value" data-cd-secs>00</span>
          <span class="section-countdown__label">{{ 'general.countdown.seconds' | t | default: 'Seconds' }}</span>
        </div>
      </div>

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="section-countdown__btn section-countdown__btn--{{ section.settings.button_style }} button-size-{{ section.settings.button_size }}">
          {{- section.settings.button_label -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function() {
    var el = document.querySelector('#section-{{ section.id }} [data-countdown]');
    if (!el) return;
    var target = new Date(el.getAttribute('data-target')).getTime();
    if (isNaN(target)) return;

    var days = el.querySelector('[data-cd-days]');
    var hours = el.querySelector('[data-cd-hours]');
    var mins = el.querySelector('[data-cd-mins]');
    var secs = el.querySelector('[data-cd-secs]');

    function pad(n) { return n < 10 ? '0' + n : n; }

    function tick() {
      var now = Date.now();
      var diff = Math.max(0, target - now);
      var d = Math.floor(diff / 86400000);
      var h = Math.floor((diff % 86400000) / 3600000);
      var m = Math.floor((diff % 3600000) / 60000);
      var s = Math.floor((diff % 60000) / 1000);
      days.textContent = pad(d);
      hours.textContent = pad(h);
      mins.textContent = pad(m);
      secs.textContent = pad(s);
      if (diff > 0) requestAnimationFrame(function() { setTimeout(tick, 1000); });
    }
    tick();
  })();
</script>

{% stylesheet %}
  .section-countdown {
    padding-block: var(--cd-mt) var(--cd-mb);
    background: rgb(var(--color-background));
    color: rgba(var(--color-foreground), 0.85);
  }
  @media (min-width: 750px) {
    .section-countdown { padding-block: var(--cd-dt) var(--cd-db); }
  }
  .section-countdown__inner {
    display: flex; flex-direction: column; gap: 1rem; align-items: center;
  }
  .section-countdown__inner--left { align-items: flex-start; text-align: left; }
  .section-countdown__inner--center { align-items: center; text-align: center; }

  .section-countdown__subheading {
    margin: 0; text-transform: uppercase;
    letter-spacing: 0.12em; color: rgb(var(--color-accent)); font-weight: 600;
  }
  .section-countdown__heading { margin: 0; color: rgb(var(--color-foreground)); line-height: 1.2; }
  .section-countdown__desc { margin: 0; color: rgba(var(--color-foreground), 0.7); max-width: 36rem; }

  .section-countdown__timer {
    display: flex; align-items: center; gap: 0.5rem; margin: 0.5rem 0;
  }
  @media (min-width: 750px) {
    .section-countdown__timer { gap: 1rem; }
  }
  .section-countdown__unit { text-align: center; }
  .section-countdown__value {
    display: block; font-size: 2rem; font-weight: 800;
    color: rgb(var(--color-foreground)); line-height: 1;
    font-variant-numeric: tabular-nums;
    min-width: 2.5rem;
  }
  @media (min-width: 750px) {
    .section-countdown__value { font-size: 3.5rem; min-width: 4rem; }
  }
  .section-countdown__label {
    display: block; font-size: 0.6875rem; text-transform: uppercase;
    letter-spacing: 0.08em; color: rgba(var(--color-foreground), 0.5);
    margin-top: 0.25rem;
  }
  .section-countdown__sep {
    font-size: 1.5rem; font-weight: 700;
    color: rgba(var(--color-foreground), 0.25); margin-top: -1rem;
  }
  @media (min-width: 750px) {
    .section-countdown__sep { font-size: 2.5rem; }
  }

  .section-countdown__btn {
    display: inline-flex; align-items: center; justify-content: center;
    font-weight: 600; text-decoration: none;
    border-radius: var(--buttons-radius, 0);
    transition: opacity 0.2s; cursor: pointer; margin-top: 0.5rem;
  }
  .section-countdown__btn:hover { opacity: 0.85; }
  .section-countdown__btn--primary {
    background: rgb(var(--color-button)); color: rgb(var(--color-button-text));
    border: 1px solid rgb(var(--color-button));
  }
  .section-countdown__btn--secondary {
    background: transparent; color: rgb(var(--color-foreground));
    border: 1px solid rgba(var(--color-foreground), 0.3);
  }
{% endstylesheet %}

