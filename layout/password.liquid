  Distributed via Shopify Theme Store. See LICENSE.md for terms.
{%- endcomment -%}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    {%- render 'head-meta-tags' -%}
    {%- render 'head-fonts' -%}
    {{ 'reset.css' | asset_url | stylesheet_tag }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ 'password.css' | asset_url | stylesheet_tag }}
    {%- render 'head-color-schemes' -%}
    {%- render 'head-design-systems' -%}
    {{ content_for_header }}
  </head>

  <body class="password gradient">
    {%- assign skip_to_content_text = 'accessibility.skip_to_text' | t -%}
    {%- render 'skip-to-content-link', href: '#MainContent', text: skip_to_content_text -%}

    {%- section 'main-password-header' -%}
    <main id="MainContent" class="password-main" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {%- section 'main-password-footer' -%}
  </body>
</html>
