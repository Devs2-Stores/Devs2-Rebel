# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Liquid + Shopify theme files
*.liquid    text eol=lf
*.json      text eol=lf
*.js        text eol=lf
*.css       text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.html      text eol=lf
*.svg       text eol=lf

# Binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.zip       binary
*.pdf       binary
