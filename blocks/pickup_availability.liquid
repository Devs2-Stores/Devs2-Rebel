{% doc %}
  Pickup availability block.

  Renders the pickup-availability custom element that fetches store
  availability for the selected variant.
{% enddoc %}

{%- liquid
  assign selected_variant = product.selected_or_first_available_variant | default: product.variants.first
-%}

<div class="product-template__pickup-availability-wrapper" {{ block.shopify_attributes }}>
  {{ 'pickup-availability.css' | asset_url | stylesheet_tag }}
  {%- assign pick_up_availabilities = selected_variant.store_availabilities | where: 'pick_up_enabled', true -%}
  <pickup-availability
    class="product-template__pickup-availability"
    {% if selected_variant.available and pick_up_availabilities.size > 0 %}available{% endif %}
    data-root-url="{{ routes.root_url }}"
    data-variant-id="{{ selected_variant.id }}"
    data-has-only-default-variant="{{ product.has_only_default_variant }}"
    data-product-page-color-scheme="color-{{ section.settings.color_scheme }}"
  >
    <template>
      <pickup-availability-preview class="pickup-availability-preview">
        {%- render 'icon', name: 'error', size: '18' -%}
        <div class="pickup-availability-info">
          <p class="pickup-availability-title">{{ 'products.product.pickup_availability.unavailable' | t }}</p>
          <button class="pickup-availability-button" type="button">
            {{ 'products.product.pickup_availability.refresh' | t }}
          </button>
        </div>
      </pickup-availability-preview>
    </template>
  </pickup-availability>
  <script src="{{ 'pickup-availability.js' | asset_url }}" defer="defer"></script>
</div>

{% schema %}
{
  "name": "t:sections.main_product.blocks.pickup_availability.name",
  "tag": null,
  "presets": [
    {
      "name": "t:sections.main_product.blocks.pickup_availability.name"
    }
  ]
}
{% endschema %}
