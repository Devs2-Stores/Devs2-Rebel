{% doc %}
  Quantity selector block.

  Renders the quantity input bound to the product form.
{% enddoc %}

{%- assign product = closest.product | default: product -%}
{%- if product != blank -%}
{%- liquid
  assign selected_variant = product.selected_or_first_available_variant | default: product.variants.first
  assign product_form_id = 'product-form-' | append: section.id
  assign min_qty = selected_variant.quantity_rule.min | default: 1
  assign step_qty = selected_variant.quantity_rule.increment | default: 1
  assign max_qty = selected_variant.quantity_rule.max
-%}
{{ 'quantity-selector.css' | asset_url | stylesheet_tag }}
<script src="{{ 'quantity-selector.js' | asset_url }}" defer="defer"></script>

<div class="product-template__quantity-group" {{ block.shopify_attributes }}>
  <label class="product-template__quantity-label">{{ 'products.product.quantity.label' | t }}</label>
  {%- render 'quantity-selector',
    form_id: product_form_id,
    name: 'quantity',
    product: product,
    variant: selected_variant,
    value: min_qty,
    min: min_qty,
    step: step_qty,
    max: max_qty
  -%}
</div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main_product.blocks.quantity_selector.name",
  "tag": null,
  "presets": [
    {
      "name": "t:sections.main_product.blocks.quantity_selector.name"
    }
  ]
}
{% endschema %}
