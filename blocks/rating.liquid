{% doc %}
  Rating block.

  Renders the product rating metafield as stars using the standard
  Shopify rating pattern.
{% enddoc %}

{%- if product.metafields.reviews.rating.value != blank -%}
  {%- liquid
    assign rating_decimal = 0
    assign decimal = product.metafields.reviews.rating.value.rating | modulo: 1
    if decimal >= 0.3 and decimal <= 0.7
      assign rating_decimal = 0.5
    elsif decimal > 0.7
      assign rating_decimal = 1
    endif
  -%}
  <div
    class="product-template__rating rating"
    role="img"
    aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: product.metafields.reviews.rating.value.rating, rating_max: product.metafields.reviews.rating.value.scale_max }}"
    {{ block.shopify_attributes }}
  >
    <span
      aria-hidden="true"
      class="rating-star"
      style="--rating: {{ product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }};"
    ></span>
    <p class="rating-text caption">
      <span aria-hidden="true">
        {{- product.metafields.reviews.rating.value.rating }} / {{ product.metafields.reviews.rating.value.scale_max -}}
      </span>
    </p>
    <p class="rating-count caption">
      <span aria-hidden="true">({{ product.metafields.reviews.rating_count }})</span>
      <span class="visually-hidden">
        {{- product.metafields.reviews.rating_count }} {{ 'accessibility.total_reviews' | t -}}
      </span>
    </p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main_product.blocks.rating.name",
  "tag": null,
  "presets": [
    {
      "name": "t:sections.main_product.blocks.rating.name"
    }
  ]
}
{% endschema %}
