{% doc %}
  Buy buttons block.

  Renders the product form with add-to-cart, buy-now, gift-card recipient
  fields, and dynamic checkout buttons.
{% enddoc %}

{%- liquid
  assign selected_variant = product.selected_or_first_available_variant | default: product.variants.first
  assign available = product.selected_or_first_available_variant.available
  assign product_form_id = 'product-form-' | append: section.id
  assign uid = section.id | append: '-' | append: block.id
  assign contact_default = routes.root_url | append: '/pages/contact' | replace: '//', '/'
-%}

<div class="product-template__buy-buttons" {{ block.shopify_attributes }}>
  {%- form 'product', product, id: product_form_id, class: 'product-template__actions' -%}
    <input type="hidden" name="id" value="{{ selected_variant.id }}" data-product-variant-id>
    {%- if product.gift_card? -%}
      <div class="product-template__gift-card-recipient">
        <details>
          <summary class="product-template__gift-card-toggle">
            <input type="checkbox" name="properties[__shopify_send_gift_card_to_recipient]" id="gift-card-recipient-toggle-{{ uid }}" form="{{ product_form_id }}">
            <input type="hidden" name="properties[__shopify_offset]" data-gift-card-offset form="{{ product_form_id }}" disabled>
            <label for="gift-card-recipient-toggle-{{ uid }}">{{ 'recipient.form.checkbox' | t }}</label>
          </summary>
          <div class="product-template__gift-card-fields">
            {%- if form.errors -%}
              <div class="product-template__gift-card-errors" role="alert">
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}
            <div class="field">
              <label for="gift-card-recipient-email-{{ uid }}">{{ 'recipient.form.email_label' | t }} <span aria-hidden="true">*</span></label>
              <input type="email" id="gift-card-recipient-email-{{ uid }}" name="properties[Recipient email]" value="{{ form.email }}" placeholder="{{ 'recipient.form.email' | t }}" form="{{ product_form_id }}" data-gift-card-field required disabled>
            </div>
            <div class="field">
              <label for="gift-card-recipient-name-{{ uid }}">{{ 'recipient.form.name_label' | t }}</label>
              <input type="text" id="gift-card-recipient-name-{{ uid }}" name="properties[Recipient name]" value="{{ form.name }}" placeholder="{{ 'recipient.form.name' | t }}" form="{{ product_form_id }}" data-gift-card-field disabled>
            </div>
            <div class="field">
              <label for="gift-card-recipient-message-{{ uid }}">{{ 'recipient.form.message_label' | t }}</label>
              <textarea id="gift-card-recipient-message-{{ uid }}" name="properties[Message]" placeholder="{{ 'recipient.form.message' | t }}" maxlength="200" form="{{ product_form_id }}" data-gift-card-field disabled>{{ form.message }}</textarea>
              <span class="field__info">{{ 'recipient.form.max_characters' | t: max_chars: 200 }}</span>
            </div>
            <div class="field">
              <label for="gift-card-recipient-send-on-{{ uid }}">{{ 'recipient.form.send_on_label' | t }}</label>
              <input type="date" id="gift-card-recipient-send-on-{{ uid }}" name="properties[Send on]" value="{{ form.send_on }}" form="{{ product_form_id }}" data-gift-card-field disabled>
            </div>
          </div>
        </details>
      </div>
    {%- endif -%}
    {%- if product.selling_plan_groups.size > 0 -%}
      {%- assign requires_plan = product.requires_selling_plan -%}
      <div class="product-template__selling-plans" data-selling-plans-wrapper>
        <fieldset class="selling-plans-fieldset">
          <legend class="visually-hidden">{{ 'products.product.purchase_options' | t }}</legend>
          {%- unless requires_plan -%}
            <div class="selling-plans__option">
              <label class="selling-plans__radio-label">
                <input
                  type="radio"
                  name="purchase_option_{{ section.id }}"
                  value="one_time"
                  class="selling-plans__radio"
                  checked
                  data-purchase-option-toggle="one_time"
                >
                <span class="selling-plans__radio-text">{{ 'products.product.one_time_purchase' | t }}</span>
              </label>
            </div>
          {%- endunless -%}
          <div class="selling-plans__option">
            <label class="selling-plans__radio-label">
              <input
                type="radio"
                name="purchase_option_{{ section.id }}"
                value="subscription"
                class="selling-plans__radio"
                {% if requires_plan %}checked{% endif %}
                data-purchase-option-toggle="subscription"
              >
              <span class="selling-plans__radio-text">{{ 'products.product.subscribe_and_save' | t }}</span>
            </label>
            <div class="selling-plans__group-select-wrapper" data-subscription-plans{% unless requires_plan %} hidden{% endunless %}>
              {%- assign first_plan_selected = false -%}
              <select
                name="selling_plan"
                class="selling-plans__select"
                aria-label="{{ 'products.product.purchase_options' | t }}"
                data-product-selling-plan
                {% unless requires_plan %}disabled{% endunless %}
              >
                {%- for group in product.selling_plan_groups -%}
                  {%- for plan in group.selling_plans -%}
                    {%- assign plan_allocated = false -%}
                    {%- for allocation in selected_variant.selling_plan_allocations -%}
                      {%- if allocation.selling_plan.id == plan.id -%}
                        {%- assign plan_allocated = true -%}
                      {%- endif -%}
                    {%- endfor -%}
                    {%- assign adjustment = plan.price_adjustments.first -%}
                    <option
                      value="{{ plan.id }}"
                      {% unless plan_allocated %}disabled hidden{% endunless %}
                      {% if plan_allocated and first_plan_selected == false %}selected{% assign first_plan_selected = true %}{% endif %}
                    >
                      {{ plan.name }}
                      {%- if adjustment and adjustment.value > 0 -%}
                        {%- assign adjustment_money = adjustment.value | money -%}
                        {%- case adjustment.value_type -%}
                          {%- when 'percentage' %} - {{ 'products.product.selling_plan_save_percent' | t: value: adjustment.value }}
                          {%- when 'fixed_amount' %} - {{ 'products.product.selling_plan_save_amount' | t: amount: adjustment_money }}
                          {%- when 'price' %} - {{ 'products.product.selling_plan_fixed_price' | t: price: adjustment_money }}
                        {%- endcase -%}
                      {%- endif -%}
                    </option>
                  {%- endfor -%}
                {%- endfor -%}
              </select>
            </div>
          </div>
        </fieldset>
      </div>
    {%- endif -%}
    <div class="product-template__buttons">
      <button
        {% unless available %}
          disabled
        {% endunless %}
        id="product-template__add-{{ uid }}"
        data-product-add
        type="submit"
        name="add"
        class="button-primary active product-template__add-btn"
        aria-label="{{ 'products.product.add_to_cart' | t }}"
      >
        <span class="button-spinner hidden"></span>
        <span class="button-content">
          {%- render 'icon', name: 'cart' -%}
          <span>{{ 'products.product.add_to_cart' | t }}</span>
        </span>
      </button>
      {%- unless block.settings.show_dynamic_checkout -%}
        <button
          {% unless available %}disabled{% endunless %}
          id="product-template__buy-{{ uid }}"
          data-product-buy
          data-contact-link="{{ block.settings.contact_link | default: contact_default }}"
          type="button"
          class="button-primary product-template__buy-btn"
          aria-label="{{ 'products.product.buy_now' | t }}"
        >
          <span class="button-spinner hidden"></span>
          <span class="button-content">{{ 'products.product.buy_now' | t }}</span>
        </button>
      {%- endunless -%}
    </div>
    {%- if block.settings.show_dynamic_checkout -%}
      <div class="product-template__dynamic-checkout" data-dynamic-checkout{% unless available %} hidden{% endunless %}>{{ form | payment_button }}</div>
    {%- endif -%}
  {%- endform -%}
</div>

{% schema %}
{
  "name": "t:sections.main_product.blocks.buy_buttons.name",
  "tag": null,
  "settings": [
    {
      "type": "url",
      "id": "contact_link",
      "label": "t:sections.main_product.settings.contact_link.label"
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "t:sections.main_product.blocks.buy_buttons.settings.show_dynamic_checkout.label",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:sections.main_product.blocks.buy_buttons.name"
    }
  ]
}
{% endschema %}
