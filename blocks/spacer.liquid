{% doc %}
  Generic spacer block.

  Adds empty vertical space, with separate heights for desktop and mobile.
{% enddoc %}

{{ 'block-generic.css' | asset_url | stylesheet_tag }}

<div
  class="block-spacer"
  style="--block-spacer-desktop: {{ block.settings.height_desktop }}px; --block-spacer-mobile: {{ block.settings.height_mobile }}px;"
  {{ block.shopify_attributes }}
></div>

{% schema %}
{
  "name": "t:blocks.spacer.name",
  "tag": null,
  "settings": [
    {
      "type": "range",
      "id": "height_desktop",
      "label": "t:blocks.spacer.settings.height_desktop.label",
      "min": 8,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "t:blocks.spacer.settings.height_mobile.label",
      "min": 8,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "t:blocks.spacer.name",
      "category": "t:blocks.common.categories.layout"
    }
  ]
}
{% endschema %}
